module scratch

// 4x4 matmul via 1D arrays and index arithmetic, checked against a known result.
fn main() -> i32 {
    let mut a: [f32; 16] = [0.0; 16];
    let mut b: [f32; 16] = [0.0; 16];
    let mut c: [f32; 16] = [0.0; 16];
    let mut i: i32 = 0;
    while i < 16 { a[i] = (i as f32) * 0.5; b[i] = (i as f32) + 1.0; i += 1; }

    for r in 0..4 {
        for col in 0..4 {
            let mut s: f32 = 0.0;
            for k in 0..4 {
                s = s + a[r * 4 + k] * b[k * 4 + col];
            }
            c[r * 4 + col] = s;
        }
    }

    // Print the full result matrix as a checksum.
    let mut j: i32 = 0;
    while j < 16 { print(c[j]); j += 1; }
    return 0;
}
