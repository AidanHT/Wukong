module scratch

@parallel
fn matmul(a: [f32; 4096], b: [f32; 4096], c: [f32; 4096]) {
    for r in 0..64 {
        for col in 0..64 {
            let mut s: f32 = 0.0;
            for k in 0..64 {
                s = s + a[r * 64 + k] * b[k * 64 + col];
            }
            c[r * 64 + col] = s;
        }
    }
}

fn main() -> i32 {
    let mut a: [f32; 4096] = [0.0; 4096];
    let mut b: [f32; 4096] = [0.0; 4096];
    let mut c: [f32; 4096] = [0.0; 4096];
    let mut i: i32 = 0;
    while i < 4096 { a[i] = ((i % 7) as f32); b[i] = ((i % 5) as f32); i += 1; }
    matmul(a, b, c);
    let mut s: f32 = 0.0;
    let mut j: i32 = 0;
    while j < 4096 { s = s + c[j]; j += 1; }
    print(s);
    return 0;
}
