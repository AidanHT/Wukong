test ptx_wgmma::tests::dump_wgmma_ptx ... .version 8.0
.target sm_90a
.address_size 64
.extern .shared .align 1024 .b8 wk_dsmem[];
.visible .entry wgmma_nt_f16_128x256x64_s4(
    .param .u32 pM,
    .param .u32 pN,
    .param .u32 pK,
    .param .u64 pC,
    .param .align 64 .b8 tmapA[128],
    .param .align 64 .b8 tmapB[128]
)
.maxntid 384, 1, 1
{
    .reg .pred %p0,%p1,%p2,%q0,%q1,%q2,%q3,%pd0,%pd1,%ptrue,%pfirst;
    .reg .b32 %M,%N,%K,%lin,%wgi,%lane,%wrp,%kt,%ktiles,%stg,%phf,%phe,%tmp,%tmp2,%row0,%row1,%col,%col1,%colb,%ctam,%ctan,%cwg;
    .reg .b64 %rdC,%rdS,%rdT,%rdA,%rdB,%rdBar,%rdBarF,%rdTmA,%rdTmB,%rdAddr,%rdOffA,%descA,%descB,%rdSt;
    .reg .f32 %acc<128>;

    ld.param.u32 %M,[pM];
    ld.param.u32 %N,[pN];
    ld.param.u32 %K,[pK];
    ld.param.u64 %rdC,[pC];
    cvta.to.global.u64 %rdC,%rdC;
    mov.b64 %rdTmA,tmapA;
    cvta.param.u64 %rdTmA,%rdTmA;
    mov.b64 %rdTmB,tmapB;
    cvta.param.u64 %rdTmB,%rdTmB;
    mov.u64 %rdS,wk_dsmem;
    mov.u32 %lin,%tid.x;
    shr.u32 %wgi,%lin,7;
    mov.u32 %lane,%laneid;
    mov.u32 %tmp,%ctaid.x;
    mul.lo.s32 %ctan,%tmp,256;
    mov.u32 %tmp,%ctaid.y;
    mul.lo.s32 %ctam,%tmp,128;
