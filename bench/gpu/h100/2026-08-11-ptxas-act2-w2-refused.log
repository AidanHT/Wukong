.version 7.0
.target sm_80
.address_size 64

.visible .entry wk_ptxas_selftest(
    .param .u64 wk_p
)
{
    .reg .b32   %r<3>;
    .reg .f32   %f<4>;
    .reg .b64   %rd<4>;

    ld.param.u64 %rd1, [wk_p];
    cvta.to.global.u64 %rd2, %rd1;
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd3, %r1, 4;
    add.s64 %rd2, %rd2, %rd3;
    ld.global.f32 %f1, [%rd2];
    mov.f32 %f2, 0f3F800000;
    fma.rn.f32 %f3, %f1, %f2, %f2;
    st.global.f32 [%rd2], %f3;
    ret;
}

