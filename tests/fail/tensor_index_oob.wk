// EXPECT-CODE: E0501
module tests.fail.tensor_index_oob

// A constant index past a static tensor dimension is caught at compile time — the same headline
// bounds safety a fixed-size array gets (see `array_index_oob.wk`), extended to the shape-typed
// surface. `Tensor[f32, 2, 2]` has valid indices 0..=1 on each axis, so `a[5, 5]` is out of bounds.
// Without the check this is a silent out-of-bounds read whose behavior diverges between the
// interpreter (traps) and native codegen (reads past the buffer) — a violation of the differential
// invariant that every backend must agree with the oracle.
//
// One diagnostic per offending index, each naming its axis, so the two are told apart on a square
// tensor where both read `index 5 … of length 2`:
//
//     error[E0501]: index 5 is out of bounds for axis 0 of length 2
//     error[E0501]: index 5 is out of bounds for axis 1 of length 2
//
// The first is pinned by `shape_diagnostics_name_the_dim_in_json` in `crates/wukongc/tests/fail.rs`.
fn read(a: Tensor[f32, 2, 2]) -> f32 {
    return a[5, 5];
}

fn main() -> i32 {
    return 0;
}
