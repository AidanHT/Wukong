// EXPECT-CODE: E0401
module tests.fail.io_tensor_dynamic_dim

// A typed read moves exactly as many elements as its destination holds, so the destination's
// element count must be known at the call. A tensor with a `?` dimension has no such count, and a
// read into it would have to guess one: it is rejected at the call (E0401) with a hint to name or
// size the dimension. A fixed array, a slice, or a tensor whose dims are constants or bound
// dimension variables are all accepted.
fn load(mut t: Tensor[f32, ?]) -> i64 {
    return read_f32("io_test_dyn.bin", t);
}

fn main() -> i32 {
    let mut a: [f32; 4] = [0.0; 4];
    let n: i64 = load(a);
    return 0;
}
