// EXPECT-CODE: E0401
module tests.fail.slice_elem_mismatch

// The array→slice unsizing coercion requires the element types to match: a `[i32; N]` array is a
// `[]i32` slice, never a `[]i64`. A mismatched element type would give `s[i]` the wrong stride (it
// would read the wrong bytes — the backends disagree), so it is rejected at the `let`.
fn main() -> i32 {
    let arr: [i32; 3] = [1, 2, 3];
    let s: []i64 = arr;
    return 0;
}
