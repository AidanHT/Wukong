// EXPECT-CODE: E0422
// EXPECT-COUNT: 1
module tests.fail.closure_let_mut

// A closure-bound local names the one closure it is initialized with: calls through it are
// resolved at compile time. A `mut` binding could be reassigned another closure at run time, so
// it is rejected; bind each closure to a name of its own. tests/run/closure_let.wk is the positive
// control.

fn main() -> i32 {
    let mut inc = |x: i32| x + 1; //~ E0422
    print(inc(1));
    return 0;
}
