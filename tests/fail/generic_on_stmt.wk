// EXPECT-CODE: E0306
// EXPECT-COUNT: 1
module tests.fail.generic_on_stmt

// `@generic` is read from a FUNCTION item (recognition off for the whole function) or from a LOOP
// (`for`/`while`: recognition off for that loop and everything nested in it) - see
// `wukong_mir_build`'s `dispatch.rs`. On any other statement nothing reads it, and the parser
// accepts statement attributes and would discard it, so this `let` would have been a promise nothing
// keeps. Placement is E0306, with the fix in the help text - put it on a loop or on the `fn`.
fn scale(x: [f32; 4], mut out: [f32; 4]) {
    @generic //~ E0306
    let k: f32 = 2.0;
    for i in 0..4 {
        out[i] = x[i] * k;
    }
}

fn main() -> i32 {
    let x: [f32; 4] = [1.0, 2.0, 3.0, 4.0];
    let mut out: [f32; 4] = [0.0; 4];
    scale(x, out);
    return 0;
}
