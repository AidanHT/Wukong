// EXPECT-CODE: E0401
module tests.fail.mixed_sign_compare_literal

// A *suffixed* integer literal has a FIXED signedness, so `i32 < 5u32` is a genuine mixed-sign
// comparison whose result depends on which operand's signedness the `Cmp` uses: `a < 5u32` gave 1
// (signed: -1 < 5) while `5u32 > a` gave 0 (unsigned: 5 < 4294967295) — a gate-blind self-
// contradiction both backends agreed on. The mixed-sign guard previously skipped ANY int-literal
// operand (meant for sign-flexible UNSUFFIXED literals), letting the suffixed form bypass it. Must
// be rejected E0401 like the variable form `let b: u32 = 5; a < b`.
fn main() -> i32 {
    let a: i32 = -1;
    if a < 5u32 {
        return 1;
    }
    return 0;
}
