// EXPECT-CODE: E0502
module tests.fail.match_arm_shape_mismatch

// `match` arms merge into one value just like `if` arms, so a tensor ELEMENT-TYPE mismatch across arms
// is rejected. Before, the result typed as the first arm (f32) while the other arm held an i32 tensor:
// the interpreter read the i32 element (300) but the native backend reinterpreted the i32 bits as f32
// (-> ~0), a bit-for-bit backend divergence. The `_` arm keeps it exhaustive, so this is purely the
// arm-shape check (E0502), not exhaustiveness (E0405).
fn pick(sel: i32, a: Tensor[f32, 4], b: Tensor[i32, 4]) -> f32 {
    let c = match sel {
        0 => a,
        _ => b, // i32 tensor vs the f32 first arm — element-type mismatch
    };
    return c[2];
}

fn main() -> i32 {
    let a: [f32; 4] = [1.0, 2.0, 3.0, 4.0];
    let b: [i32; 4] = [100, 200, 300, 400];
    print(pick(1, a, b) as i32);
    return 0;
}
