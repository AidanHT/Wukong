module tests.fail.shape_arg_kind

// A scalar cannot satisfy a tensor parameter — a kind confusion the shape engine now rejects
// instead of silently letting it fall through call unification.
fn sink(a: Tensor[f32, 4, 4]) {}

fn main() -> i32 {
    let x: f32 = 1.0;
    sink(x); //~ E0501
    return 0;
}
