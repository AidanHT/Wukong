// EXPECT-CODE: E0326
module tests.fail.type_alias_cycle

// An alias is replaced by its definition, so one that reaches itself through another alias never
// finishes expanding: `Grid` -> `Cell` -> `Grid`. The cycle is reported at the alias it closes on,
// even though neither alias is used.
type Grid = [Cell; 4];
type Cell = *Grid;

fn main() -> i32 {
    return 0;
}
