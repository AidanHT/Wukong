// EXPECT-CODE: E0419
// EXPECT-COUNT: 1
module tests.fail.closure_param_infer

// An unannotated closure parameter takes its type from the function type it is passed as. Here
// that type is `fn(T) -> T`, and `T` is a generic parameter of `twice` that no other argument of
// the call binds (there is none), so `x` needs an annotation (`|x: i32| x * 2`). When another
// argument does bind it, the closure is checked at that type: tests/run/closure_infer.wk.

fn twice<T>(_f: fn(T) -> T) -> i32 {
    return 2;
}

fn main() -> i32 {
    return twice(|x| x * 2); //~ E0419
}
