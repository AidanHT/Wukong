// EXPECT-CODE: E0401
module tests.fail.array_return_length_lie

// `check_return_shape` wrapped its `unify` in `if matches!(ret, Tensor | Vector) || matches!(val_ty,
// ...)`, so aggregate-vs-aggregate was never compared: a function could declare `-> [i32; 8]` and
// return a `[i32; 2]`. Every caller then believed the declared length — the caller's own
// `let r: [i32; 8] = g()` check passes, because `g`'s signature says 8 — and `r[7]` was an
// interpreter trap against a native read of 0. `unify_decl`'s rigid-mode doc-comment advertises that
// "a generic function cannot lie about the shape it returns"; it could not lie about a TENSOR shape.
fn g() -> [i32; 8] {
    let a: [i32; 2] = [5, 6];
    return a;
}

fn main() -> i32 {
    let r: [i32; 8] = g();
    println(r[7]);
    return 0;
}
