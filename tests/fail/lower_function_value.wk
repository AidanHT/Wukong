// EXPECT-CODE: C0001
module tests.fail.lower_function_value

// A function named outside a call is a function value. Sema rejects one bound to a local, a field
// or an element type (`E0411`), but it types `[square, square]` as `[fn(f32) -> f32; 2]` and a bare
// `square;` statement as `fn(f32) -> f32`, and accepts both. MIR lowering has no storage for a
// function value. It refuses each one as the codegen limit `C0001`. It must never treat one as a
// type sema rejected: that refusal is a panic in a debug build of wukongc, and both forms reached it.

fn square(x: f32) -> f32 {
    return x * x;
}

fn in_an_array() -> i32 {
    let _fs = [square, square];
    return 0;
}

@allow(unused_result)
fn as_a_statement() -> i32 {
    square;
    return 0;
}

fn main() -> i32 {
    return in_an_array() + as_a_statement();
}
