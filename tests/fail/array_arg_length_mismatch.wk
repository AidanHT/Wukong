// EXPECT-CODE: E0501
module tests.fail.array_arg_length_mismatch

// `unify_decl` had no `(Array, Array)` arm at all, so an array argument for an array parameter fell
// to the lenient `_ => {}` and a `[i32; 2]` satisfied a `[i32; 8]`. The program compiled without a
// single diagnostic; the interpreter then reported `error: load out of bounds` while
// `--backend=native` printed 32758, having read 24 bytes past the caller's stack buffer. That is an
// interp-vs-native divergence — the one invariant the differential gate exists to protect — and a
// memory-safety violation, on the language's most common aggregate.
fn f(a: [i32; 8]) -> i32 {
    return a[7];
}

fn main() -> i32 {
    let x: [i32; 2] = [1, 2];
    println(f(x));
    return 0;
}
