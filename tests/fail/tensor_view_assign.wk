// EXPECT-CODE: E0507
module tests.fail.tensor_view_assign

// `dst[i]` on a rank-2 tensor is a VIEW of row `i` — part of `dst`'s buffer — not an element, and a
// view is not a place a value can be stored into: replacing a whole row would have to copy, which
// assignment never does. Copy the row element by element with a full index list.
fn copy_row(mut dst: Tensor[f32, 4, 3], src: Tensor[f32, 4, 3], i: i64) {
    dst[i] = src[i];
}

fn main() -> i32 {
    return 0;
}
