// EXPECT-CODE: E0411
// EXPECT-COUNT: 1
module tests.fail.closure_outside_argument

// A closure is non-escaping: it is legal only as a direct argument of a call whose parameter has
// a function type, where the callee is specialized for it at compile time. Bound to a local it
// would be a run-time function value, which Wukong does not have.

fn main() -> i32 {
    let double = |x: f32| x * 2.0; //~ E0411
    print(3.0);
    return 0;
}
