// EXPECT-CODE: E0440
module tests.fail.mixed_sign_arith

// `u32` and `i32` have no lossless common type: each holds values the other cannot. The operator
// used to compute in whichever type was wider and, on a tie, in the LEFT operand's type — so
// `a / b` was an unsigned 32-bit divide (7 / 4294967294 == 0) while `b / a` was a signed one. Both
// backends agreed, so nothing but this check can see it. Convert explicitly instead.
fn ratio(a: u32, b: i32) -> i32 {
    return a / b;
}

fn main() -> i32 {
    print(ratio(7, -2));
    return 0;
}
