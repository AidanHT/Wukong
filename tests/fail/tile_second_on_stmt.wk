// EXPECT-CODE: E0309
module tests.fail.tile_second_on_stmt

// `tile_requested` and `take_tile_size` both `return`ed inside their loop over the statement's
// attributes on the FIRST one named `tile`, so a second `@tile` on the same statement was never
// read — not applied, not validated, not reported. `tile_sizes_from_attrs` on a function ITEM
// iterates every attribute, so the two positions disagreed about the same spelling: `@tile(4, 0)`
// on an item was an error while `@tile(4) @tile(0)` on a statement compiled clean.
//
// They agree now: several `@tile`s on one statement mean their widths in source order, exactly like
// one `@tile` with several arguments — and the zero below is rejected either way.

@generic
fn f(mut out: [i32; 100]) {
    @tile(4)
    @tile(0)
    for i in 0..100 {
        out[i] = i;
    }
}

fn main() -> i32 {
    let mut o: [i32; 100] = [0; 100];
    f(o);
    return 0;
}
