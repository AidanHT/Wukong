// EXPECT-CODE: E0437
module tests.fail.io_read_at_float_offset

// `read_<T>_at(path, byte_off, buf)` takes a byte offset: an integer. A float offset is rejected at
// the call (E0437) rather than truncated to a position the program did not write.
fn main() -> i32 {
    let mut w: [f32; 4] = [0.0; 4];
    let n: i64 = read_f32_at("io_test_at.bin", 2.5, w);
    return 0;
}
