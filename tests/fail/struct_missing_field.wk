// EXPECT-CODE: E0430
// EXPECT-COUNT: 1
module tests.fail.struct_missing_field

// A struct literal that omits a field used to compile with no diagnostic; then reading the omitted
// field read an uninitialized slot — the interpreter saw 0 while the native backend saw stack
// garbage, a backend divergence. Every declared field must now be initialized (unless `..rest`
// supplies the remainder), and unknown/duplicate fields are rejected at the literal too.
struct Point {
    x: i32,
    y: i32,
}

fn main() -> i32 {
    let p = Point { x: 7 }; // `y` is omitted //~ E0430
    return p.y;
}
