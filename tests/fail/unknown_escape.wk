// EXPECT-CODE: E0401
module tests.fail.unknown_escape

// mir_build's `decode_escape` ends `Some(c) => c as u32`, so any escape outside
// `n r t \ ' " 0 x u` silently decoded to the escaped character itself and neither the lexer (which
// only delimits) nor sema validated it: `println("A\dB")` printed `AdB`. Both backends agree on the
// wrong string, so every differential gate is blind to it. C and Rust both reject an unknown escape.
fn main() -> i32 {
    println("A\dB");
    return 0;
}
