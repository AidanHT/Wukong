// EXPECT-CODE: E0442
module tests.fail.let_refutable_pattern

// A plain `let` pattern must match every value: for a `Shape::Square`, `r` would not exist. The
// destructuring used to compile and bind `r` from whatever the payload bytes held. Write
// `let Shape::Circle(r) = s else { return 0; };`, or a `match`.
enum Shape {
    Circle(i32),
    Square(i32),
}

fn radius(s: Shape) -> i32 {
    let Shape::Circle(r) = s;
    return r;
}

fn main() -> i32 {
    print(radius(Shape::Square(2)));
    return 0;
}
