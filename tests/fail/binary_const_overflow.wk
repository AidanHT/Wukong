// EXPECT-CODE: E0401
module tests.fail.binary_const_overflow

// A constant binary expression that adapts to a narrow type still range-checks its FOLDED value:
// `100 + 100` folds to 200, which overflows `i8` (-128..=127), so it is rejected rather than
// silently wrapping to -56. (Before binary-const adaptation this was already an i32-vs-i8 mismatch;
// now it is the more precise out-of-range diagnostic — still E0401.)
fn main() -> i32 {
    let v: i8 = 100 + 100;
    return v as i32;
}
