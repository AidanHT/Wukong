// EXPECT-CODE: E0406
// EXPECT-COUNT: 1
module tests.fail.generic_array_length

// A generic length is the shape of a PARAMETER (`fn f<N>(a: [f32; N])` is the shape-generic buffer
// `Tensor[f32, N]`, bound per call), but a LOCAL array of generic length would need stack storage
// whose size is only known at run time. It used to be exempted from the name check and evaluate to
// 0 here while mir_build lowered a bare pointer slot — the two-crate desync of
// `array_len_not_constant.wk`. It is reported instead.
fn scratch<N>(a: [f32; N]) -> f32 {
    let mut tmp: [f32; N]; //~ E0406
    tmp[0] = a[0];
    return tmp[0];
}

fn main() -> i32 {
    let x: [f32; 4] = [1.0, 2.0, 3.0, 4.0];
    return scratch(x) as i32;
}
