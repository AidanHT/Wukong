// EXPECT-CODE: E0405
module tests.fail.match_empty

// An empty `match x {}` covers nothing, so it is non-exhaustive for any inhabited scrutinee. It used
// to compile and reach the `Unreachable` fallthrough at runtime (the interpreter traps with exit 1
// while the native backend executes an illegal instruction — a backend divergence). Now rejected at
// compile time.
fn main() -> i32 {
    let n = 5;
    let x = match n {};
    return x;
}
