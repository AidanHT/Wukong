// EXPECT-CODE: E0316
// EXPECT-COUNT: 1
module tests.fail.noalias_reassigned_slice

// A `@noalias` slice parameter names one buffer for the whole call: the optimizer reads its data
// pointer once and files every access through it in an alias class of its own. Re-pointing the
// parameter at another slice (`out = other`) would make `out` and `other` one buffer under two
// names after the promise was made, so a promised view parameter cannot be reassigned. Writing
// THROUGH it (`out[0] = 1.0`) is the point of the attribute and stays legal.
fn fill(@noalias mut out: []f32, other: []f32) {
    out = other; //~ E0316
    out[0] = 1.0;
}

fn main() -> i32 {
    let mut a: [f32; 4] = [0.0; 4];
    let mut b: [f32; 4] = [0.0; 4];
    fill(a, b);
    return 0;
}
