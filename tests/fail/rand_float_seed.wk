// EXPECT-CODE: E0401
module tests.fail.rand_float_seed

// The counter-based RNG is keyed by the 64 bits of an integer seed and an integer counter. A float
// seed has no such bits to offer (truncating 1.5 to 1 would silently alias two seeds), so it is
// rejected at the call (E0401).
fn main() -> i32 {
    let x: f32 = rand_f32(1.5, 0);
    return 0;
}
