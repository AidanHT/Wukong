//! Small geometry helpers, documented and tested by their own examples.
//!
//! ```wk
//! assert(area_of(Rect { w: 2, h: 3 }) == 6);
//! ```
module tests.doc.geometry

/// A rectangle with integer sides.
struct Rect {
    /// The width.
    w: i32,
    /// The height.
    h: i32,
}

/// The area of `r`.
///
/// ```wk
/// let r = Rect { w: 4, h: 5 };
/// assert(area_of(r) == 20);
/// print(area_of(r));
/// ```
fn area_of(r: Rect) -> i32 {
    return r.w * r.h;
}

/// Doubles `x`, which must be an `i32`:
///
/// ```wk,compile_fail,E0401
/// let y = double(1.5);
/// ```
///
/// An example with its own `main`:
///
/// ```wk
/// fn main() -> i32 {
///     if double(21) != 42 {
///         return 1;
///     }
///     return 0;
/// }
/// ```
fn double(x: i32) -> i32 {
    return x * 2;
}

/// Which way a shape faces.
enum Facing {
    /// Toward the viewer.
    Front,
    Back,
}

/// A loop that never ends: compiled, never run.
///
/// ```wk,no_run
/// spin();
/// ```
///
/// A sketch of what is not Wukong yet:
///
/// ```wk,ignore
/// spin(forever = true);
/// ```
///
/// ```text
/// not an example at all
/// ```
fn spin() {
    loop {}
}

fn main() -> i32 {
    print(area_of(Rect { w: 2, h: 3 }));
    print(double(4));
    spin_if(false);
    return 0;
}

/// Spins when `go` is true.
fn spin_if(go: bool) {
    if go {
        spin();
    }
}

/// The larger of `a` and `b`. An example's own items may sit between its statements:
///
/// ```wk
/// let a = larger(3, 9);
/// fn twice(x: i32) -> i32 { return x * 2; }
/// assert(twice(a) == 18);
/// ```
fn larger(a: i32, b: i32) -> i32 {
    if a > b {
        return a;
    }
    return b;
}
