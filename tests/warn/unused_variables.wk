// EXPECT-WARN: W0001
// EXPECT-WARN: W0001
module tests.warn.unused_variables

// Two ways a value goes nowhere: a parameter the body never reads (`factor` — the scaling was
// meant to use it), and an accumulator that is updated on every iteration and never read
// afterwards (`acc` — the sum is computed and dropped).
fn scale(x: f32, factor: f32) -> f32 {
    return x * 2.0;
}

fn main() -> i32 {
    let mut acc: f32 = 0.0;
    for i in 0..4 {
        acc += scale(i as f32, 3.0);
    }
    // Prefixing a name with `_` says "intentionally unused": no warning.
    let _spare: i32 = 1;
    return 0;
}
