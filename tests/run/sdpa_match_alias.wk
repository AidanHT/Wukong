module tests.run.sdpa_match_alias

// `sdpa` whose output is also an input under a SECOND NAME: a `match` arm binding over a
// fixed-array parameter binds the parameter's own storage (an aggregate `Ident` or `x @ _` binds
// the scrutinee's base pointer, no copy). The static disjointness proof once compared parameters
// by their spelled names, saw `x` and `m` (or `o` and `k`) as two parameters the call-site bit
// separates, and emitted a bare `wukong_attention_f32` with an input equal to `out`. The guarded
// form computes into scratch from the ORIGINAL inputs; the bare one let the first 32-row query
// block overwrite K/V rows 0..31 before the second block (row 32) read them. Interp and native call
// the same kernel, so only every lane against the defining formula can see it.
//
// S = 33 (two query blocks), D = 1, scale = 1, non-causal. Each output is printed as
// round(1000 * out). With q_i = 0 for i < 32 every score of rows 0..31 is 0, so their weights are
// uniform and out_i = (sum_j v_j) / 33. Row 32's scores are q_32 * k_j, which are 0 except at j = 32:
//   by_ident   m = [0 x 32, 1]:          rows 0..31: 1/33 = 0.0303 -> 30
//                                        row 32: e / (32 + e) = 0.078295 -> 78
//   by_binding m = [0 x 32, 2]:          rows 0..31: 2/33 = 0.0606 -> 61
//                                        row 32: 2 e^4 / (32 + e^4) = 1.260954 -> 1261
//   by_shadow  q = [0 x 32, 1], k = [0 x 32, 2], v = k, out = k:
//                                        rows 0..31: 2/33 -> 61
//                                        row 32: 2 e^2 / (32 + e^2) = 0.375183 -> 375
//              and the shadowed parameter `o` (all zeros) is untouched: its lane 32 as returned,
//              then all 33 lanes, are 0
// (The unguarded call printed 104, 1228 and 407 for the three row-32 lanes.) Every expected value
// is at least 0.1 from a rounding boundary.

fn by_ident(mut m: [f32; 33]) {
    match m {
        x => {
            sdpa(x, x, x, m, 33, 1, 1.0, 0);
        }
    }
}

fn by_binding(mut m: [f32; 33]) {
    match m {
        x @ _ => {
            sdpa(x, x, x, m, 33, 1, 1.0, 0);
        }
    }
}

// The arm's `o` SHADOWS the parameter `o` and names `k`'s storage: `out` and the K/V inputs are
// one buffer, and the parameter `o` (read back after the arm) is never written.
fn by_shadow(q: [f32; 33], mut k: [f32; 33], o: [f32; 33]) -> f32 {
    match k {
        o => {
            sdpa(q, k, k, o, 33, 1, 1.0, 0);
        }
    }
    return o[32];
}

fn main() -> i32 {
    let mut a: [f32; 33] = [0.0; 33];
    a[32] = 1.0;
    by_ident(a);
    for t in 0..33 {
        print(round(a[t] * 1000.0) as i32);
    }
    let mut b: [f32; 33] = [0.0; 33];
    b[32] = 2.0;
    by_binding(b);
    for t in 0..33 {
        print(round(b[t] * 1000.0) as i32);
    }
    let mut q: [f32; 33] = [0.0; 33];
    q[32] = 1.0;
    let mut k: [f32; 33] = [0.0; 33];
    k[32] = 2.0;
    let r: [f32; 33] = [0.0; 33];
    let r32: f32 = by_shadow(q, k, r);
    print(round(r32 * 1000.0) as i32);
    for t in 0..33 {
        print(round(k[t] * 1000.0) as i32);
    }
    for t in 0..33 {
        print(round(r[t] * 1000.0) as i32);
    }
    return 0;
}
