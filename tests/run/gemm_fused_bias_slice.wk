// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 7500
// EXPECT-OUT: 0
// EXPECT-OUT: 20000
// EXPECT-OUT: 12500
// EXPECT-OUT: -5000
// EXPECT-OUT: -2500
// EXPECT-OUT: 5500
// EXPECT-OUT: 8000
// EXPECT-OUT: -3500
// EXPECT-OUT: 9000
// EXPECT-OUT: 5000
// EXPECT-OUT: 17500
// EXPECT-OUT: -2500
// EXPECT-OUT: -10000
// EXPECT-OUT: 10000
// EXPECT-OUT: 2500
// EXPECT-OUT: -15000
// EXPECT-OUT: -12500
// EXPECT-OUT: -4500
// EXPECT-OUT: -2000
// EXPECT-OUT: -13500
// EXPECT-OUT: -1000
// EXPECT-OUT: -5000
// EXPECT-OUT: 7500
// EXPECT-OUT: 0
// EXPECT-OUT: -13000
// EXPECT-OUT: 12500
// EXPECT-OUT: 5000
// EXPECT-OUT: -10500
// EXPECT-OUT: -2500
// EXPECT-OUT: 0
// EXPECT-OUT: 2500
// EXPECT-OUT: -7000
// EXPECT-OUT: 22000
// EXPECT-OUT: 1500
// EXPECT-OUT: 14000
module gemm_fused_bias_slice

// Differential gate for the fused-bias GEMM store `c[i,j] = bias[<invariant offset> + j] + s` — the
// single-store `q = x·Wᵀ + b` projection GPT-2 writes — dispatched to `wukong_sgemm_nt_epi`, over
// []f32 HEAP SLICES (the only way to hold a runtime-sized weight blob; the real 124M model is all
// slices). Exercises a bare bias, a constant blob offset, and a runtime (layer-stride) blob offset —
// plus the slice base-pointer extraction in `kernel_base_ptr`. Must run bit-identically on the
// interpreter and native, and at -O0 == -O2 (both call the identical serial kernel the interpreter
// marshals as the oracle).
//
// UNTIL 2026-09 THIS FIXTURE ASSERTED NOTHING. It declared neither `EXPECT-EXIT` nor `EXPECT-OUT`,
// and both of `run.rs`'s checks were guarded on their directive being present, so its 36 printed
// numbers were discarded and it passed if the kernel wrote garbage. It is a recognizer fixture, so
// `native_matches_interpreter` and both invariance gates cannot see a wrong value either: the same
// `wukong_sgemm_nt_epi` runs on both backends at every level and is wrong identically. The 36
// lines above are now the whole proof, and they are the whole output buffer, three times over.
//
// WHERE THE EXPECTED VALUES COME FROM — never a compiler run. They are the scalar semantics of the
// three nests below, evaluated in f32 in source order (numpy float32, step by step: each `s + a*w`
// rounded to f32 before the next term). Every input is a multiple of 0.05 or 0.1 and K = 5, so
// each true product is a multiple of 0.005 and each true C entry is a multiple of 0.005 exactly;
// scaled by 100000 that is a multiple of 500, and the printed `round(...)` recovers it from an f32
// error of order 1e-3 — a margin of ~500x to the nearest rounding boundary. That is why the
// expectations are integers ending in 00 and why they do not depend on the kernel's accumulation
// order.
//
// THE POISON. `c` comes from `alloc_f32`, which is `alloc_zeroed`, and three of the 36 expected
// lanes are 0. Over a zeroed buffer a `0` lane cannot tell a correct kernel from one that declined
// and wrote nothing — which is exactly the signature of the recorded slice-param base-pointer
// defect this fixture exists to guard (silent zeros on interp, SIGSEGV natively). Each pass now
// fills `c` with -12345.0 first, so "wrote nothing" prints -1234500000 and fails loudly on every
// lane rather than passing on three of them.

fn main() -> i32 {
    let m: i64 = 3;
    let k: i64 = 5;
    let n: i64 = 4;
    let mut a:  []f32 = alloc_f32(15);
    let mut bq: []f32 = alloc_f32(4);
    let mut w:  []f32 = alloc_f32(2048);   // blob: weights @100, bias @200; "layer l" strided by 1024
    let mut c:  []f32 = alloc_f32(12);
    for i in 0..15   { a[i]  = ((i % 7)  as f32) * 0.1 - 0.3; }
    for i in 0..4    { bq[i] = (i as f32) * 0.05; }
    for i in 0..2048 { w[i]  = ((i % 11) as f32) * 0.05 - 0.2; }

    // (A) bare bias:  c = a·Wᵀ + bq
    for i in 0..12 { c[i] = -12345.0; }
    for i in 0..m { for j in 0..n {
        let mut s: f32 = 0.0;
        for p in 0..k { s = s + a[i * k + p] * w[100 + j * k + p]; }
        c[i * n + j] = bq[j] + s;
    } }
    for i in 0..12 { print(round(c[i] * 100000.0) as i32); }

    // (B) runtime-base blob bias (base = layer stride):  c = a·W_lᵀ + b_l
    for l in 0i64..2 {
        let base: i64 = 1024 * l;
        for i in 0..12 { c[i] = -12345.0; }
        for i in 0..m { for j in 0..n {
            let mut s: f32 = 0.0;
            for p in 0..k { s = s + a[i * k + p] * w[base + 100 + j * k + p]; }
            c[i * n + j] = w[base + 200 + j] + s;
        } }
        for i in 0..12 { print(round(c[i] * 100000.0) as i32); }
    }

    free(a);
    free(bq);
    free(w);
    free(c);
    return 0;
}
