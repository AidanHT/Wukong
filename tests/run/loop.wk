// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 42
module tests.run.loops

// `loop { … }` with `break`/`continue` runs: an unconditional back-edge with `break` as the exit and
// `continue` jumping to the header (the same loops-stack machinery as `while`, minus the condition).
// Sum 0..10 but skip 3 -> 0+1+2+4+5+6+7+8+9 = 42.
fn main() -> i32 {
    let mut i: i32 = 0;
    let mut s: i32 = 0;
    loop {
        if i >= 10 {
            break;
        }
        if i == 3 {
            i = i + 1;
            continue;
        }
        s = s + i;
        i = i + 1;
    }
    print(s); // 42
    return 0;
}
