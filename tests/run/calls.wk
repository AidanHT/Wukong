// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 55
// EXPECT-OUT: 120
module tests.run.calls

fn fib(n: i32) -> i32 {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn fact(n: i32) -> i32 {
    if n < 2 {
        return 1;
    }
    return n * fact(n - 1);
}

fn main() -> i32 {
    print(fib(10));
    print(fact(5));
    return 0;
}
