module tests.run.vectorized_interleave

// Interleaved accesses -- `x[k*i + r]` for every residue r of a stride k -- which the general loop
// vectorizer (`wukong_opt::vectorize`) now widens as interleave groups: k contiguous vector loads
// per part, split per member with lane shuffles, and the mirror image for stores. Before, any
// access whose stride was not 1 kept its whole loop scalar.
//
// The kernels: a complex multiply over (re, im) pairs (two stride-2 load groups, one stride-2 store
// group -- the two stores to `o` are proved never to meet by the GCD test), RGB pixels to gray (a
// stride-3 `u8` load group feeding `f32` math in parts), an IN-PLACE interleaved RoPE (a load group
// and a store group on the same buffer), a stride-4 weighted sum, and a stride-3 `i16` store group.
// The slices are bounds-checked as usual: the check-free copy the loop needs comes from
// bounds-check elimination, which now proves `s[2i + 1]`-shaped indices too.
//
// Odd trip counts (23, 37, 21) leave a scalar epilogue after the vector part. Every element of
// every output is printed, and every expectation was derived by hand from the scalar semantics of
// the loop (all values are small integers, exact in f32, so no rounding question arises):
//
//   cmul     o[2i] = ar*br - ai*bi, o[2i+1] = ar*bi + ai*br, a = (j % 7) - 3, b = (j % 5) + 1.
//   gray     4*g = r + 2*g + b over rgb = (37j + 11) mod 256.
//   rope     x[2i], x[2i+1] <- (x0*c - x1*s, x0*s + x1*c), x = (j % 9) - 4, c = (j % 3) - 1,
//            s = (j % 4) - 2, all 42 elements printed after the call.
//   stride4  o = x0 + 2*x1 + 3*x2 + 4*x3 over x = (j % 11) - 5.
//   expand   o[3i] = v, o[3i+1] = v + 1, o[3i+2] = 2*v at i16, v = 700i - 9000.
//
// Re-check that the loops really widen (interp and native agree whether or not they do):
//     wukongc --emit=mir -O2 tests/run/vectorized_interleave.wk | grep shuffle

fn cmul(a: []f32, b: []f32, mut o: []f32, n: i64) {
    let mut i: i64 = 0;
    while i < n {
        let ar: f32 = a[2 * i];
        let ai: f32 = a[2 * i + 1];
        let br: f32 = b[2 * i];
        let bi: f32 = b[2 * i + 1];
        o[2 * i] = ar * br - ai * bi;
        o[2 * i + 1] = ar * bi + ai * br;
        i = i + 1;
    }
}

fn gray(rgb: []u8, mut g: []f32, n: i64) {
    let mut i: i64 = 0;
    while i < n {
        g[i] = 0.25 * (rgb[3 * i] as f32) + 0.5 * (rgb[3 * i + 1] as f32) + 0.25 * (rgb[3 * i + 2] as f32);
        i = i + 1;
    }
}

fn rope(mut x: []f32, c: []f32, s: []f32, n: i64) {
    let mut i: i64 = 0;
    while i < n {
        let x0: f32 = x[2 * i];
        let x1: f32 = x[2 * i + 1];
        x[2 * i] = x0 * c[i] - x1 * s[i];
        x[2 * i + 1] = x0 * s[i] + x1 * c[i];
        i = i + 1;
    }
}

fn stride4(x: []f32, mut o: []f32, n: i64) {
    let mut i: i64 = 0;
    while i < n {
        o[i] = x[4 * i] + x[4 * i + 1] * 2.0 + x[4 * i + 2] * 3.0 + x[4 * i + 3] * 4.0;
        i = i + 1;
    }
}

fn expand(v: []i16, mut o: []i16, n: i64) {
    let mut i: i64 = 0;
    while i < n {
        o[3 * i] = v[i];
        o[3 * i + 1] = v[i] + (1 as i16);
        o[3 * i + 2] = v[i] * (2 as i16);
        i = i + 1;
    }
}

fn main() -> i32 {
    let mut a: []f32 = alloc_f32(46i64);
    let mut b: []f32 = alloc_f32(46i64);
    let mut o: []f32 = alloc_f32(46i64);
    let mut j: i64 = 0;
    while j < 46 {
        a[j] = ((j % 7) as f32) - 3.0;
        b[j] = ((j % 5) as f32) + 1.0;
        o[j] = -99.0;
        j = j + 1;
    }
    cmul(a, b, o, 23);
    j = 0;
    while j < 46 {
        print(o[j] as i32);
        j = j + 1;
    }

    let mut rgb: []u8 = alloc_u8(111i64);
    let mut g: []f32 = alloc_f32(37i64);
    j = 0;
    while j < 111 {
        rgb[j] = (j * 37 + 11) as u8;
        j = j + 1;
    }
    gray(rgb, g, 37);
    j = 0;
    while j < 37 {
        print((g[j] * 4.0) as i32);
        j = j + 1;
    }

    let mut x: []f32 = alloc_f32(42i64);
    let mut c: []f32 = alloc_f32(21i64);
    let mut s: []f32 = alloc_f32(21i64);
    j = 0;
    while j < 42 {
        x[j] = ((j % 9) as f32) - 4.0;
        j = j + 1;
    }
    j = 0;
    while j < 21 {
        c[j] = ((j % 3) as f32) - 1.0;
        s[j] = ((j % 4) as f32) - 2.0;
        j = j + 1;
    }
    rope(x, c, s, 21);
    j = 0;
    while j < 42 {
        print(x[j] as i32);
        j = j + 1;
    }

    let mut x4: []f32 = alloc_f32(92i64);
    let mut o4: []f32 = alloc_f32(23i64);
    j = 0;
    while j < 92 {
        x4[j] = ((j % 11) as f32) - 5.0;
        j = j + 1;
    }
    stride4(x4, o4, 23);
    j = 0;
    while j < 23 {
        print(o4[j] as i32);
        j = j + 1;
    }

    let mut v: []i16 = alloc_i16(37i64);
    let mut e: []i16 = alloc_i16(111i64);
    j = 0;
    while j < 37 {
        v[j] = (j * 700 - 9000) as i16;
        j = j + 1;
    }
    expand(v, e, 37);
    j = 0;
    while j < 111 {
        print(e[j] as i32);
        j = j + 1;
    }

    free(a);
    free(b);
    free(o);
    free(rgb);
    free(g);
    free(x);
    free(c);
    free(s);
    free(x4);
    free(o4);
    free(v);
    free(e);
    return 0;
}
