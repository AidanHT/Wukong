module tests.run.opt4_fuse_liveout

// Adjacent loops that `wukong_opt::fuse` merges at -O2 although the first one produces a value
// read only after the second (a LIVE-OUT): the fused header still holds the first loop's final
// value when the fused loop exits. `sum_scale` keeps its loops on stack-backed arrays; `slices`
// runs them over three slice parameters, two of them `@noalias` (`@unchecked` drops the bounds
// checks, so each loop is one block) -- the alias analysis proves the slices' elements disjoint, the
// condition for fusing loops over parameter storage. (The divisions keep the front end's
// elementwise vectorizer away, so the optimizer sees the loops.)
//
// a[k] = k*k - 40, src = a; buffers start at -1; `/` truncates toward zero. For n = 0, 3, 16:
//   sum_scale  s = sum over i < n of (a[i]*a[i] - i);   b[j] = a[j]/3 + j (j < n)
//              prints s, then the 16 lanes of b
//   slices     m = max over i < n of (src[i]*src[i] - 50), starting from -1000000;
//              tmp[i] = src[i]/2 - i;  out[j] = tmp[j]/3 + src[j]   (i, j < n)
//              prints m, then the 16 lanes of tmp and of out

fn sum_scale(a: [i32; 16], mut b: [i32; 16], n: i32) -> i32 {
    let mut s = 0;
    for i in 0..n {
        s = s + a[i] * a[i] - i;
    }
    for j in 0..n {
        b[j] = a[j] / 3 + j;
    }
    return s;
}

@unchecked
fn slices(@noalias mut tmp: []i32, @noalias mut out: []i32, src: []i32, n: i64) -> i32 {
    let mut m = 0 - 1000000;
    for i in 0..n {
        tmp[i] = src[i] / 2 - (i as i32);
        m = max(m, src[i] * src[i] - 50);
    }
    for j in 0..n {
        out[j] = tmp[j] / 3 + src[j];
    }
    return m;
}

fn main() -> i32 {
    let mut a: [i32; 16] = [0; 16];
    for k in 0..16 {
        a[k] = k * k - 40;
    }
    let ns: [i32; 3] = [0, 3, 16];
    for q in 0..3 {
        let mut b: [i32; 16] = [0; 16];
        for k in 0..16 {
            b[k] = 0 - 1;
        }
        print(sum_scale(a, b, ns[q]));
        for k in 0..16 {
            print(b[k]);
        }
    }
    for q in 0..3 {
        let mut tmp: [i32; 16] = [0; 16];
        let mut out: [i32; 16] = [0; 16];
        for k in 0..16 {
            tmp[k] = 0 - 1;
            out[k] = 0 - 1;
        }
        print(slices(tmp, out, a, ns[q] as i64));
        for k in 0..16 {
            print(tmp[k]);
        }
        for k in 0..16 {
            print(out[k]);
        }
    }
    return 0;
}
