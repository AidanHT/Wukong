// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 8
// EXPECT-OUT: 8
// EXPECT-OUT: 0
// EXPECT-OUT: -1
// EXPECT-OUT: 127
// EXPECT-OUT: -128
// EXPECT-OUT: 100
// EXPECT-OUT: -100
// EXPECT-OUT: 7
// EXPECT-OUT: 42
module tests.run.io_roundtrip_i8

// File-I/O round-trip for `i8`: `write_i8` a known buffer, `read_i8` it back, print each element
// (widened to `i64`, which sign-extends, so the printed value is unambiguous). The values include
// `i8::MAX` (127) and `i8::MIN` (-128) plus -1 and 0 to exercise the signed edges, and -100 (high
// bit set) — a sign-extension bug on a high-bit byte would print a positive number instead of a
// negative one, and a byte-order or mis-strided decode would print a different number. One byte per
// element, so this pins the element stride at 1. Headerless raw bytes per the frozen contract; the
// interpreter and native JIT must agree byte-for-byte. Unique temp file name avoids collisions with
// the sibling round-trip tests.
fn main() -> i32 {
    let cnt: i64 = 8;
    let mut wbuf: []i8 = alloc_i8(cnt);
    wbuf[0] = 0;
    wbuf[1] = -1;
    wbuf[2] = 127;
    wbuf[3] = -128;
    wbuf[4] = 100;
    wbuf[5] = -100;
    wbuf[6] = 7;
    wbuf[7] = 42;

    let wrote: i64 = write_i8("io_test_i8.bin", wbuf);
    print(wrote); // 8

    let mut rbuf: []i8 = alloc_i8(cnt);
    let n: i64 = read_i8("io_test_i8.bin", rbuf);
    print(n); // 8

    for i in 0..cnt {
        print(rbuf[i] as i64);
    }

    free(wbuf);
    free(rbuf);
    return 0;
}
