module tests.run.spelling_value_bindings

// Respellings that must compute exactly what the loops say (P12.7, P12.10):
//
//   * naming the loaded value first - `let v = x[i]; o[i] = gelu(v);` - the most common respelling
//     in real code, mandatory once the value is used twice (`v * sigmoid(v)`); it keeps the 256-bit
//     elementwise kernels;
//   * the hand-expanded tanh GELU (`0.5*v*(1 + tanh(C0*(v + C1*(v*v*v))))`). It used to be folded
//     into the GELU kernel on the premise that the source's `tanh` is the kernel's internal
//     `1 - 2/(exp(2z)+1)`. The language's `tanh` is now the runtime's piecewise kernel on every
//     spelling, while `gelu` keeps the exp-composed block inside, so the expansion is NOT `gelu`
//     bit for bit (it differs at x = -4, -3.5, -3, -2, -1.5 and 0.5 here) and must compute what it
//     says. Since P12.10 it dispatches the kernel of its OWN expression (`VM_GELU_TANH`, op code 36,
//     wukong_runtime/src/vspell.rs), never `gelu`'s; the flags below hold it to the written loop.
//
// Values: x[i] = 0.5*i - 4 over 16 lanes. The first block is gelu(x)*1000 truncated toward zero,
// the second silu(x) = x/(1+e^-x) *1000 truncated, both from the exact formulas in f64 (every lane
// sits >= 0.05 away from an integer boundary, far beyond the kernels' f32 error); the third is
// 2*x + y = 2*(0.5*i - 4) + i = 2*i - 8, exact. The last block is one flag per lane: 1 iff the
// `for`-loop results equal, BIT FOR BIT, the same formulas evaluated by a `while` loop - which no
// recognizer sees. A partially correct kernel, or a substitution that changed a rounding (the old
// expansion-to-`gelu` fold would print 0 in the six lanes above), prints a 0 in its own lane.

fn gelu_hoisted(x: [f32; 16], mut o: [f32; 16]) {
    for i in 0..16 {
        let v: f32 = x[i];
        o[i] = gelu(v);
    }
}

fn gelu_expanded(x: [f32; 16], mut o: [f32; 16]) {
    for i in 0..16 {
        o[i] = 0.5 * x[i] * (1.0 + tanh(0.7978845608 * (x[i] + 0.044715 * (x[i] * x[i] * x[i]))));
    }
}

fn swish_hoisted(x: [f32; 16], mut o: [f32; 16]) {
    for i in 0..16 {
        let v: f32 = x[i];
        o[i] = v * sigmoid(v);
    }
}

fn axpy_hoisted(x: [f32; 16], y: [f32; 16], mut o: [f32; 16]) {
    for i in 0..16 {
        let a: f32 = x[i];
        let b: f32 = y[i];
        o[i] = 2.0 * a + b;
    }
}

fn main() -> i32 {
    let mut x: [f32; 16] = [0.0; 16];
    let mut y: [f32; 16] = [0.0; 16];
    for i in 0..16 {
        x[i] = (i as f32) * 0.5 - 4.0;
        y[i] = i as f32;
    }
    let mut g1: [f32; 16] = [0.0; 16];
    let mut g2: [f32; 16] = [0.0; 16];
    let mut sw: [f32; 16] = [0.0; 16];
    let mut ax: [f32; 16] = [0.0; 16];
    gelu_hoisted(x, g1);
    gelu_expanded(x, g2);
    swish_hoisted(x, sw);
    axpy_hoisted(x, y, ax);

    for i in 0..16 {
        print((g2[i] * 1000.0) as i32);
    }
    for i in 0..16 {
        print((sw[i] * 1000.0) as i32);
    }
    for i in 0..16 {
        print(ax[i] as i32);
    }

    let mut k: i64 = 0;
    while k < 16 {
        let v: f32 = x[k];
        let gref: f32 = gelu(v);
        let eref: f32 = 0.5 * v * (1.0 + tanh(0.7978845608 * (v + 0.044715 * (v * v * v))));
        let sref: f32 = v * sigmoid(v);
        let mut ok: i32 = 0;
        if g1[k] == gref && g2[k] == eref && sw[k] == sref {
            ok = 1;
        }
        print(ok);
        k = k + 1;
    }
    return 0;
}
