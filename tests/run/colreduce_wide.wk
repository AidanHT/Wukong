module tests.run.colreduce_wide

// Independent oracle: q = [-4,3,-2,5,-6,1,5,-6,2,0], t=(j+1)/4,
// x[i,j]=q[(i+j)%10]*t. Each column rotates all ten coefficients:
// sum(q)=-2, sum(q*q)=156, max(q)=5, min(q)=-6, max(abs(q))=6.
// Thus sum=-2t, max=5t, min=-6t, maxabs=6t, sumsq=156t*t at width 75.
// Width 11 changes q[6]=4 and q[7]=-5: sum=-2, squares=136, extrema 5/-6.
// Its extrema are unique, so argmax=(3-j) mod 10 and argmin=(4-j) mod 10;
// columns 4 and 5 respectively require row 9, catching a dropped final row.
// At width 75 the first winning rows are min((3-j) mod 10,(6-j) mod 10) for argmax
// and min((4-j) mod 10,(7-j) mod 10) for argmin (nonnegative residues).
// These are exact binary fractions throughout; print floats directly, with no casts.
// 75 columns cover two 32-column colreduce tiles, one 8-vector, and 3 tails;
// they also cover the current 64-column colarg tile, one 8-vector, and 3 tails.
// 11 columns cover one 8-vector and 3 tails. Ten rows cross the four-row block:
// additive folds use 4+4+2 rows; first-row-seeded folds use 4+4+1 more rows.
// Every output starts with nonuniform poison. The narrow CLI gate proves all seven
// wukong_col{sum,max,min,maxabs,sumsq}_f32 / colarg{max,min}_i32 dispatches
// and checks all 602 lanes against this oracle with recognition on and off.

fn wide_75() {
    let q: [f32; 10] = [-4.0, 3.0, -2.0, 5.0, -6.0, 1.0, 5.0, -6.0, 2.0, 0.0];
    let mut x: [f32; 750] = [0.0; 750];
    for i in 0..10 {
        for j in 0..75 {
            x[i * 75 + j] = q[(i + j) % 10] * ((j + 1) as f32 * 0.25);
        }
    }
    let mut sum_out: [f32; 75] = [0.0; 75];
    let mut max_out: [f32; 75] = [0.0; 75];
    let mut min_out: [f32; 75] = [0.0; 75];
    let mut maxabs_out: [f32; 75] = [0.0; 75];
    let mut sumsq_out: [f32; 75] = [0.0; 75];
    let mut argmax_out: [i32; 75] = [0; 75];
    let mut argmin_out: [i32; 75] = [0; 75];
    for j in 0..75 {
        sum_out[j] = -1000.0 - j as f32 * 0.5;
        max_out[j] = -1100.0 - j as f32 * 0.5;
        min_out[j] = -1200.0 - j as f32 * 0.5;
        maxabs_out[j] = -1300.0 - j as f32 * 0.5;
        sumsq_out[j] = -1400.0 - j as f32 * 0.5;
        argmax_out[j] = -1500 - j;
        argmin_out[j] = -1600 - j;
    }
    for j in 0..75 {
        let mut s: f32 = 0.0;
        for i in 0..10 { s = s + x[i * 75 + j]; }
        sum_out[j] = s;
    }
    for j in 0..75 {
        let mut s: f32 = x[j];
        for i in 1..10 { s = fmax(s, x[i * 75 + j]); }
        max_out[j] = s;
    }
    for j in 0..75 {
        let mut s: f32 = x[j];
        for i in 1..10 { s = fmin(s, x[i * 75 + j]); }
        min_out[j] = s;
    }
    for j in 0..75 {
        let mut s: f32 = abs(x[j]);
        for i in 1..10 { s = fmax(s, abs(x[i * 75 + j])); }
        maxabs_out[j] = s;
    }
    for j in 0..75 {
        let mut s: f32 = 0.0;
        for i in 0..10 { s = s + x[i * 75 + j] * x[i * 75 + j]; }
        sumsq_out[j] = s;
    }
    for j in 0..75 {
        let mut bv: f32 = x[j];
        let mut bi: i32 = 0;
        for i in 1..10 {
            if x[i * 75 + j] > bv { bv = x[i * 75 + j]; bi = i; }
        }
        argmax_out[j] = bi;
    }
    for j in 0..75 {
        let mut bv: f32 = x[j];
        let mut bi: i32 = 0;
        for i in 1..10 {
            if x[i * 75 + j] < bv { bv = x[i * 75 + j]; bi = i; }
        }
        argmin_out[j] = bi;
    }
    for j in 0..75 { print(sum_out[j]); }
    for j in 0..75 { print(max_out[j]); }
    for j in 0..75 { print(min_out[j]); }
    for j in 0..75 { print(maxabs_out[j]); }
    for j in 0..75 { print(sumsq_out[j]); }
    for j in 0..75 { print(argmax_out[j]); }
    for j in 0..75 { print(argmin_out[j]); }
}

fn wide_11() {
    let q: [f32; 10] = [-4.0, 3.0, -2.0, 5.0, -6.0, 1.0, 4.0, -5.0, 2.0, 0.0];
    let mut x: [f32; 110] = [0.0; 110];
    for i in 0..10 {
        for j in 0..11 {
            x[i * 11 + j] = q[(i + j) % 10] * ((j + 1) as f32 * 0.25);
        }
    }
    let mut sum_out: [f32; 11] = [0.0; 11];
    let mut max_out: [f32; 11] = [0.0; 11];
    let mut min_out: [f32; 11] = [0.0; 11];
    let mut maxabs_out: [f32; 11] = [0.0; 11];
    let mut sumsq_out: [f32; 11] = [0.0; 11];
    let mut argmax_out: [i32; 11] = [0; 11];
    let mut argmin_out: [i32; 11] = [0; 11];
    for j in 0..11 {
        sum_out[j] = -1000.0 - j as f32 * 0.5;
        max_out[j] = -1100.0 - j as f32 * 0.5;
        min_out[j] = -1200.0 - j as f32 * 0.5;
        maxabs_out[j] = -1300.0 - j as f32 * 0.5;
        sumsq_out[j] = -1400.0 - j as f32 * 0.5;
        argmax_out[j] = -1500 - j;
        argmin_out[j] = -1600 - j;
    }
    for j in 0..11 {
        let mut s: f32 = 0.0;
        for i in 0..10 { s = s + x[i * 11 + j]; }
        sum_out[j] = s;
    }
    for j in 0..11 {
        let mut s: f32 = x[j];
        for i in 1..10 { s = fmax(s, x[i * 11 + j]); }
        max_out[j] = s;
    }
    for j in 0..11 {
        let mut s: f32 = x[j];
        for i in 1..10 { s = fmin(s, x[i * 11 + j]); }
        min_out[j] = s;
    }
    for j in 0..11 {
        let mut s: f32 = abs(x[j]);
        for i in 1..10 { s = fmax(s, abs(x[i * 11 + j])); }
        maxabs_out[j] = s;
    }
    for j in 0..11 {
        let mut s: f32 = 0.0;
        for i in 0..10 { s = s + x[i * 11 + j] * x[i * 11 + j]; }
        sumsq_out[j] = s;
    }
    for j in 0..11 {
        let mut bv: f32 = x[j];
        let mut bi: i32 = 0;
        for i in 1..10 {
            if x[i * 11 + j] > bv { bv = x[i * 11 + j]; bi = i; }
        }
        argmax_out[j] = bi;
    }
    for j in 0..11 {
        let mut bv: f32 = x[j];
        let mut bi: i32 = 0;
        for i in 1..10 {
            if x[i * 11 + j] < bv { bv = x[i * 11 + j]; bi = i; }
        }
        argmin_out[j] = bi;
    }
    for j in 0..11 { print(sum_out[j]); }
    for j in 0..11 { print(max_out[j]); }
    for j in 0..11 { print(min_out[j]); }
    for j in 0..11 { print(maxabs_out[j]); }
    for j in 0..11 { print(sumsq_out[j]); }
    for j in 0..11 { print(argmax_out[j]); }
    for j in 0..11 { print(argmin_out[j]); }
}

fn main() -> i32 {
    wide_75();
    wide_11();
    return 0;
}
