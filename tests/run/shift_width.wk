// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: -2147483648
// EXPECT-OUT: 1
// EXPECT-OUT: 2
// EXPECT-OUT: 1073741824
module tests.run.shift_width

/// Shift counts are masked to the operand width on both backends (x86 / Cranelift semantics), so
/// `1i32 << 32 == 1`, not 0. Logical right shift reads the value's own unsigned width window, so a
/// high-bit-set operand shifts in zeros. The interpreter once shifted the wider i128 and diverged
/// from the native backend; the differential gate now pins them equal.
fn main() -> i32 {
    let x: i32 = 1;
    print((x << 31) as i64); // -2147483648 (i32 wrap)
    print((x << 32) as i64); // 1  (32 & 31 == 0)
    print((x << 33) as i64); // 2  (33 & 31 == 1)

    let h: u32 = 2147483648; // 0x80000000
    print((h >> 1) as i64); // logical shift -> 1073741824
    return 0;
}
