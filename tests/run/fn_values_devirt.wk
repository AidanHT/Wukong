// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 15
// EXPECT-OUT: 10
// EXPECT-OUT: 5
// EXPECT-OUT: 3
// EXPECT-OUT: 24
module tests.run.fn_values_devirt

// Function values whose function the optimizer can see. At -O0 every call through `f`, `g` and `h`
// is a `call_indirect` through the loaded pointer; once mem2reg has forwarded the `func_addr` each
// local holds, devirtualization turns each one into a direct `call` (-O1), which -O2 then inlines.
// `crates/wukongc/tests/fn_values.rs` pins those shapes. Expectations by hand:
//   f = scale3: f(5) = 5 * 3                                                = 15
//   g = shift: g(f(2)) = (2 * 3) + 4                                        = 10
//   h = g: h(1) = 1 + 4 = 5; h = f: h(1) = 1 * 3                             = 5, 3
//   via(f, 8): a function-typed parameter given the local `f`, inlined at -O2: 8 * 3 = 24

fn scale3(x: i32) -> i32 {
    return x * 3;
}

fn shift(x: i32) -> i32 {
    return x + 4;
}

fn via(p: fn(i32) -> i32, x: i32) -> i32 {
    return p(x);
}

fn main() -> i32 {
    let f: fn(i32) -> i32 = scale3;
    let g = shift;
    print(f(5));
    print(g(f(2)));
    let mut h = g;
    print(h(1));
    h = f;
    print(h(1));
    print(via(f, 8));
    return 0;
}
