// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 1000
// EXPECT-OUT: 8000
// EXPECT-OUT: 365
module tests.run.batched_affine_rmsnorm

// Batched AFFINE RMSNorm — the real transformer form — over a flat [R, C] matrix: each row r is
// normalized by its own RMS, then scaled by a learned per-COLUMN gamma shared across rows:
// x[r*C+i] = x[r*C+i] * inv_r * g[i]. The outer `for r` loop dispatches to the fused affine norm
// kernel mercury_norm_affine_f32 with rows = R; the data is row-offset-indexed x[r*C+i] while gamma
// stays column-indexed g[i]. mercury_bench proves interp == native.

fn rmsnorm_affine_batch(x: [f32; 12], g: [f32; 4]) { // R = 3 rows, C = 4 cols
    for r in 0..3 {
        let mut s: f32 = 0.0;
        for i in 0..4 { s = s + x[r*4+i] * x[r*4+i]; }
        let inv: f32 = rsqrt(s / 4.0 + 0.00001);
        for i in 0..4 { x[r*4+i] = x[r*4+i] * inv * g[i]; }
    }
}

fn main() -> i32 {
    let mut x: [f32; 12] = [0.0; 12];
    x[0]=1.0; x[1]=2.0; x[2]=3.0; x[3]=4.0;     // row 0
    x[4]=2.0; x[5]=2.0; x[6]=2.0; x[7]=2.0;     // row 1 (uniform 2.0 → inv = 0.5)
    x[8]=0.0; x[9]=0.0; x[10]=0.0; x[11]=4.0;   // row 2
    let mut g: [f32; 4] = [0.0; 4];
    g[0]=1.0; g[1]=2.0; g[2]=3.0; g[3]=4.0;     // per-column learned scale

    rmsnorm_affine_batch(x, g);

    // row 1 uniform 2.0: inv = 1/2, x[4] = 2 * 0.5 * g[0]=1.0 → 1.0
    print(round(x[4] * 1000.0) as i32);  // 1000
    // row 2: inv = 1/2, x[11] = 4 * 0.5 * g[3]=4.0 → 8.0
    print(round(x[11] * 1000.0) as i32); // 8000
    // row 0: meansq 7.5, inv ≈ 0.36515, x[0] = 1 * 0.36515 * g[0]=1.0 ≈ 0.3651
    print(round(x[0] * 1000.0) as i32);  // 365
    return 0;
}
