// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 0
// EXPECT-OUT: 693
// EXPECT-OUT: 2302
// EXPECT-OUT: -693
// EXPECT-OUT: 0
// EXPECT-OUT: 693
// EXPECT-OUT: 2302
// EXPECT-OUT: 4158
module tests.run.log

// Natural log as a first-class intrinsic (Cephes logf polynomial, built from primitive ops so the
// interpreter and native backend agree bit-for-bit). It vectorizes over a unit-stride loop, so
// log-softmax / cross-entropy lower to 128-bit x 4 SIMD instead of scalar libm `logf` calls.
fn main() -> i32 {
    // scalar
    print((log(1.0) * 1000.0) as i32); // ln 1   = 0
    print((log(2.0) * 1000.0) as i32); // ln 2   = 0.6931 * 1000
    print((log(10.0) * 1000.0) as i32); // ln 10 = 2.3026 * 1000
    print((log(0.5) * 1000.0) as i32); // ln 0.5 = -0.6931 * 1000

    let mut a: [f32; 64] = [0.0; 64];
    let mut out: [f32; 64] = [0.0; 64];
    for i in 0..64 {
        a[i] = (i as f32) + 1.0; // 1 .. 64
    }

    // vectorized log.
    for i in 0..64 {
        out[i] = log(a[i]) * 1000.0;
    }
    print(out[0] as i32); // ln 1  = 0
    print(out[1] as i32); // ln 2  = 693
    print(out[9] as i32); // ln 10 = 2302
    print(out[63] as i32); // ln 64 = 4158
    return 0;
}
