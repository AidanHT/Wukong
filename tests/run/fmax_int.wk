// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 5
// EXPECT-OUT: 3
// EXPECT-OUT: 2
// EXPECT-OUT: -7
// EXPECT-OUT: 5
// EXPECT-OUT: 3
module tests.run.fmax_int

// fmax/fmin on integer variables promote the operand to f32 (the float compare-and-select), exactly
// like sqrt/exp/pow. Before, their lowering left an integer operand at its int type and the float
// compare ran on i32 — invalid MIR that crashed the native backend while the interpreter computed an
// integer max: a backend divergence. Now both backends run the identical coerced float compare.
fn main() -> i32 {
    let a: i32 = 5;
    let b: i32 = 3;
    print(fmax(a, b) as i32); // 5
    print(fmin(a, b) as i32); // 3
    let c: i32 = -7;
    let d: i32 = 2;
    print(fmax(c, d) as i32); // 2
    print(fmin(c, d) as i32); // -7
    // float operands are unchanged.
    let x: f32 = 5.0;
    let y: f32 = 3.0;
    print(fmax(x, y) as i32); // 5
    print(fmin(x, y) as i32); // 3
    return 0;
}
