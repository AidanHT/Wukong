const N: i32 = 23;
const NL: i64 = 23;
const CAP: i64 = 26;

/// The classification-loss shape: one lane of the group carries the target's weight.
fn a_onehot(x: []f32, mut o: []f32, t: i32, n: i32) {
    let mut i: i32 = 0;
    while i < n {
        let q: f32 = if i == t { 8.0 } else { 2.0 };
        o[i] = x[i] * q;
        i = i + 1;
    }
}

/// The counter as a float: `sitofp` of the ramp.
fn b_ramp(mut o: []f32, n: i32) {
    let mut i: i32 = 0;
    while i < n {
        o[i] = (i as f32) * 0.25 + 1.0;
        i = i + 1;
    }
}

/// The counter stored as data: the ramp is the store's *value*, its pointer stays uniform.
fn c_index(mut o: []i32, n: i32) {
    let mut i: i32 = 0;
    while i < n {
        o[i] = i;
        i = i + 1;
    }
}

/// A lane mask in front of a float reduction.
fn d_masked_sum(x: []f32, t: i32, n: i32) -> f32 {
    let mut s: f32 = 0.0;
    let mut i: i32 = 0;
    while i < n {
        let w: f32 = if i < t { 1.0 } else { -1.0 };
        s = s + x[i] * w;
        i = i + 1;
    }
    return s;
}

/// The same one-hot from a non-zero start, so the ramp's base is not the loop's first element.
fn e_offset(x: []f32, mut o: []f32, t: i32, n: i32) {
    let mut i: i32 = 3;
    while i < n {
        let q: f32 = if i == t { 8.0 } else { 2.0 };
        o[i] = x[i] * q;
        i = i + 1;
    }
}

/// The one-hot at `<2 x f64>` lanes over an `i64` counter.
fn g_wide(x: []f64, mut o: []f64, t: i64, n: i64) {
    // Named rather than inline, because a bare float literal in an `if` arm is inferred `f32`
    // before the `let`'s annotation reaches it; these two are still loop-invariant uniforms that
    // the widened body splats under the lane mask.
    let hi: f64 = 8.0;
    let lo: f64 = 2.0;
    let mut i: i64 = 0;
    while i < n {
        let q: f64 = if i == t { hi } else { lo };
        o[i] = x[i] * q;
        i = i + 1;
    }
}

fn setf(mut p: []f32, v: f32) {
    let mut k: i64 = 0;
    while k < CAP { p[k] = v; k = k + 1; }
}
fn showf(p: []f32) {
    let mut k: i64 = 0;
    while k < CAP { print(p[k] as i32); k = k + 1; }
}
fn showf4(p: []f32) {
    let mut k: i64 = 0;
    while k < CAP { print((p[k] * 4.0) as i32); k = k + 1; }
}

fn main() -> i32 {
    let mut x: []f32 = alloc_f32(CAP);
    let mut o: []f32 = alloc_f32(CAP);
    let mut q: []i32 = alloc_i32(CAP);
    let mut xd: []f64 = alloc_f64(CAP);
    let mut od: []f64 = alloc_f64(CAP);

    let mut j: i64 = 0;
    while j < CAP {
        x[j] = (j as f32) + 1.0;
        xd[j] = (j as f64) + 1.0;
        j = j + 1;
    }

    setf(o, -777.0); a_onehot(x, o, 3, N);  showf(o);
    setf(o, -777.0); a_onehot(x, o, 17, N); showf(o);
    setf(o, -777.0); a_onehot(x, o, 21, N); showf(o);
    setf(o, -777.0); a_onehot(x, o, 99, N); showf(o);

    setf(o, -0.25);  b_ramp(o, N);          showf4(o);

    j = 0;
    while j < CAP { q[j] = -777; j = j + 1; }
    c_index(q, N);
    j = 0;
    while j < CAP { print(q[j]); j = j + 1; }

    print(d_masked_sum(x, 9, N) as i32);
    print(d_masked_sum(x, 0, N) as i32);
    print(d_masked_sum(x, 23, N) as i32);

    setf(o, -777.0); e_offset(x, o, 14, N); showf(o);

    j = 0;
    while j < CAP { od[j] = -777.0; j = j + 1; }
    g_wide(xd, od, 17, NL);
    j = 0;
    while j < CAP { print(od[j] as i32); j = j + 1; }

    free(od); free(xd); free(q); free(o); free(x);
    return 0;
}
