// EXPECT-OUT: 0
// EXPECT-OUT: 1
// EXPECT-OUT: 1
// EXPECT-OUT: 1
// EXPECT-OUT: 4
// EXPECT-OUT: 4
// EXPECT-OUT: 4
// EXPECT-OUT: 4
// EXPECT-OUT: 4
// EXPECT-OUT: 4
// EXPECT-OUT: 4
// EXPECT-OUT: 4
// EXPECT-OUT: 4
// EXPECT-OUT: 4
// EXPECT-OUT: 4
// EXPECT-OUT: 4
// EXPECT-OUT: 4
// EXPECT-OUT: -1
// EXPECT-OUT: -1
// EXPECT-OUT: 4
// EXPECT-OUT: -1
