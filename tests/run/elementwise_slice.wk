// EXPECT-OUT: -8
// EXPECT-OUT: -4
// EXPECT-OUT: 0
// EXPECT-OUT: 4
// EXPECT-OUT: 8
// EXPECT-OUT: 12
// EXPECT-OUT: 0
// EXPECT-OUT: 4
