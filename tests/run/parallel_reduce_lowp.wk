// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 2080
// EXPECT-OUT: 4160
// EXPECT-OUT: 64
// EXPECT-OUT: 2080
// EXPECT-OUT: 64
// EXPECT-OUT: 16384
module tests.run.parallel_reduce_lowp

// `@parallel` bf16/f16 reductions dispatch to the multicore deterministic low-precision reduction
// kernels (wukong_{sum,dot,reduce}_{bf16,f16}_parallel) instead of the serial symbols — the bf16/f16
// twins of the f32 `wukong_sreduce_f32_parallel` path. Each cuts the array on a fixed RCHUNK boundary
// and folds the per-chunk partials in ascending order, so the result is deterministic (independent of
// thread count); the interpreter marshals the identical parallel kernel, so interp == native bit-for-bit
// and -O0 == -O3. The small arrays fold in a single chunk (so the value also equals the serial
// reduction — easy to pin); `sum_bf16_big` spans two RCHUNK chunks, exercising the real rayon fold.

@parallel
fn sum_bf16(x: [bf16; 64], mut o: [f32; 1]) {
    let mut s: f32 = 0.0;
    for k in 0..64 { s = s + (x[k] as f32); }
    o[0] = s;
}

@parallel
fn dot_bf16(x: [bf16; 64], y: [bf16; 64], mut o: [f32; 1]) {
    let mut s: f32 = 0.0;
    for k in 0..64 { s = s + (x[k] as f32) * (y[k] as f32); }
    o[0] = s;
}

@parallel
fn max_bf16(x: [bf16; 64], mut o: [f32; 1]) {
    let mut m: f32 = -1e30;
    for k in 0..64 { m = fmax(m, (x[k] as f32)); }
    o[0] = m;
}

@parallel
fn sum_f16(x: [f16; 64], mut o: [f32; 1]) {
    let mut s: f32 = 0.0;
    for k in 0..64 { s = s + (x[k] as f32); }
    o[0] = s;
}

@parallel
fn max_f16(x: [f16; 64], mut o: [f32; 1]) {
    let mut m: f32 = -1e30;
    for k in 0..64 { m = fmax(m, (x[k] as f32)); }
    o[0] = m;
}

// Two RCHUNK chunks (RCHUNK = 8192) — the chunked rayon fold actually runs. All-ones is bf16-exact and
// sums exactly in f32, so the chunked partials (8192 + 8192) recombine to 16384 with no rounding.
@parallel
fn sum_bf16_big(x: [bf16; 16384], mut o: [f32; 1]) {
    let mut s: f32 = 0.0;
    for k in 0..16384 { s = s + (x[k] as f32); }
    o[0] = s;
}

fn main() -> i32 {
    let mut x: [bf16; 64] = [0.0 as bf16; 64];
    let mut y: [bf16; 64] = [0.0 as bf16; 64];
    for i in 0..64 { x[i] = ((i + 1) as f32) as bf16; y[i] = 2.0 as bf16; } // x = 1..64, y = 2
    let mut o: [f32; 1] = [0.0; 1];

    sum_bf16(x, o);   print(o[0] as i32); // Σ 1..64 = 2080
    dot_bf16(x, y, o); print(o[0] as i32); // 2·2080 = 4160
    max_bf16(x, o);   print(o[0] as i32); // 64

    let mut xf: [f16; 64] = [0.0 as f16; 64];
    for i in 0..64 { xf[i] = ((i + 1) as f32) as f16; }
    sum_f16(xf, o);   print(o[0] as i32); // 2080
    max_f16(xf, o);   print(o[0] as i32); // 64

    let mut xb: [bf16; 16384] = [1.0 as bf16; 16384];
    sum_bf16_big(xb, o); print(o[0] as i32); // 16384
    return 0;
}
