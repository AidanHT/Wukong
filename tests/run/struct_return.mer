// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 7
// EXPECT-OUT: 20
// EXPECT-OUT: 10
// EXPECT-OUT: 115
module tests.run.struct_return

// Returning an aggregate by value (`fn make(..) -> Pt`) uses an sret ABI modeled entirely in
// mir_build: the function takes a hidden leading pointer parameter and returns void, `return
// Pt{..}` deep-copies into that pointer, and a call site allocates the destination buffer, passes
// it as the hidden first argument, and uses it as the call's value. No aggregate ever rides in a
// register, so the interpreter oracle and the native backend agree bit-for-bit.
struct Pt { x: i32, y: i32 }
struct Inner { a: i32 }
struct Outer { inner: Inner, b: i32 }

fn make(a: i32, b: i32) -> Pt { return Pt { x: a, y: b }; }
fn add(p: Pt, q: Pt) -> Pt { return Pt { x: p.x + q.x, y: p.y + q.y }; }
fn mk_outer(a: i32, b: i32) -> Outer { return Outer { inner: Inner { a: a }, b: b }; }

fn main() -> i32 {
    let p: Pt = make(3, 4);
    print(p.x + p.y);                     // 7

    print(make(10, 20).y);                // 20  — field read off a returned temporary

    let s: Pt = add(make(1, 2), make(3, 4));   // returned structs flow into another call's args
    print(s.x + s.y);                     // (1+3) + (2+4) = 10

    let o: Outer = mk_outer(10, 5);       // nested aggregate returned by value
    print(o.inner.a + o.b + 100);         // 10 + 5 + 100 = 115
    return 0;
}
