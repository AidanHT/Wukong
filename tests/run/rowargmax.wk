// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 1
// EXPECT-OUT: 2
// EXPECT-OUT: 3
// EXPECT-OUT: 3
// EXPECT-OUT: 1
// EXPECT-OUT: 0
module tests.run.rowargmax

// Batched per-row argmax / argmin returning the INDEX (the classification-head / greedy-decode top-1):
// out[r] = {argmax,argmin}_j x[r,j], lowest index wins on a value tie. The recognizer folds each [R=3,
// C=4] nest to one mercury_rowarg{max,min}_i32 call — the (value,index) bookkeeping gcc/rustc keep
// scalar, while the AVX2 kernel tracks 8 (value,index) lanes via blend. It is a pure selection (no
// reassociation), so the differential gate (interp == native) is bit-exact, and out is an i32 buffer.
fn main() -> i32 {
    let x: [f32; 12] = [1.0, 3.0, 2.0, 0.0,   // row 0: max @1, min @3
                        5.0, 1.0, 9.0, 4.0,   // row 1: max @2, min @1
                        2.0, 2.0, 2.0, 8.0];  // row 2: max @3, min @0 (tie 0,1,2 -> lowest 0)
    let mut amax: [i32; 3] = [0; 3];
    let mut amin: [i32; 3] = [0; 3];

    for r in 0..3 {
        let mut bv: f32 = x[r * 4];
        let mut bi: i32 = 0;
        for j in 1..4 { if x[r * 4 + j] > bv { bv = x[r * 4 + j]; bi = j; } }
        amax[r] = bi;
    }
    for r in 0..3 {
        let mut bv: f32 = x[r * 4];
        let mut bi: i32 = 0;
        for j in 1..4 { if x[r * 4 + j] < bv { bv = x[r * 4 + j]; bi = j; } }
        amin[r] = bi;
    }
    for k in 0..3 { print(amax[k]); }
    for k in 0..3 { print(amin[k]); }
    return 0;
}
