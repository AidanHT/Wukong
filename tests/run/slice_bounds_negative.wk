// RUN: --run
// EXPECT-EXIT: 1
// EXPECT-OUT-NONE
// EXPECT-STDERR: index out of bounds: the len is 3 but the index is -1
module tests.run.slice_bounds_negative

// The slice check is one unsigned comparison, `index <u len`, so a negative index (a huge unsigned
// value) fails it like any index past the end, and the diagnostic prints the signed index the
// program computed. Here `prev(a, 0)` reads `s[0 - 1]` from a 3-element slice.

fn prev(s: []i32, i: i64) -> i32 {
    return s[i - 1];
}

fn main() -> i32 {
    let a: [i32; 3] = [7, 8, 9];
    return prev(a, 0);
}
