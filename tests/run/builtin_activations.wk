// EXPECT-OUT: 3000
module tests.run.builtin_activations

// The two-argument activation builtins `act(x, out)` — `exp`, `log`, `tanh`, `sigmoid`, `silu`,
// `gelu`, `relu` — each one wukong_vmath_f32 call over a 13-element buffer (one 8-lane AVX2 group
// plus a 5-element tail), every lane printed. The one-argument forms (`gelu(x)`) are still the
// scalar math intrinsics; only the buffer form is the kernel builtin.
//
// x = -3, -2.5, ..., 3 (exact in f32). The expectations are the defining formulas evaluated in f64,
// independently of the kernel, then scaled and rounded: exp prints round(100·e^x); the others print
// round(1000·y), with log over x + 3.5 (0.5 .. 6.5), sigmoid(x) = 1 / (1 + e^-x),
// silu(x) = x·sigmoid(x), gelu(x) = 0.5·x·(1 + tanh(sqrt(2/pi)·(x + 0.044715·x^3))) (the tanh
// form the runtime and the scalar intrinsic both define), relu(x) = x > 0 ? x : 0. Every expected
// lane is at least 4e-6 relative (plus 1e-3 scaled units) away from a rounding boundary, far more
// than the kernels' f32 error.

fn show(x: []f32, scale: f32) {
    for i in 0..x.len() {
        print(round(x[i] * scale) as i32);
    }
}

fn main() -> i32 {
    let mut x: [f32; 13] = [0.0; 13];
    let mut xp: [f32; 13] = [0.0; 13];
    for i in 0..13 {
        x[i] = (i as f32) * 0.5 - 3.0;
        xp[i] = x[i] + 3.5;
    }
    let mut y: [f32; 13] = [0.0; 13];
    exp(x, y);
    show(y, 100.0);
    log(xp, y);
    show(y, 1000.0);
    tanh(x, y);
    show(y, 1000.0);
    sigmoid(x, y);
    show(y, 1000.0);
    silu(x, y);
    show(y, 1000.0);
    gelu(x, y);
    show(y, 1000.0);
    relu(x, y);
    show(y, 1000.0);
    return 0;
}
