// EXPECT-OUT: -1
// EXPECT-OUT: 2
// EXPECT-OUT: 4
// EXPECT-OUT: -4
// EXPECT-OUT: 2
// EXPECT-OUT: 4
// EXPECT-OUT: -7
// EXPECT-OUT: 2
