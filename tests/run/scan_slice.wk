// EXPECT-OUT: 84
// EXPECT-OUT: 6
// EXPECT-OUT: 12
// EXPECT-OUT: 60
// EXPECT-OUT: 60
// EXPECT-OUT: 1
// EXPECT-OUT: 4
// EXPECT-OUT: 7
// EXPECT-OUT: 7
// EXPECT-OUT: 6
// EXPECT-OUT: 6
// EXPECT-OUT: 6
// EXPECT-OUT: 6
// EXPECT-OUT: 1
// EXPECT-OUT: 1
// EXPECT-OUT: 1
// EXPECT-OUT: 1
// EXPECT-OUT: 6
// EXPECT-OUT: 2
// EXPECT-OUT: 2
// EXPECT-OUT: 1
// EXPECT-OUT: 7
// EXPECT-OUT: 6
// EXPECT-OUT: 12
// EXPECT-OUT: 4
// EXPECT-OUT: 2
// EXPECT-OUT: 0
// EXPECT-OUT: 1
// EXPECT-OUT: 0
// EXPECT-OUT: 0
// EXPECT-OUT: 0
