// RUN: --run
// EXPECT-EXIT: 1
// EXPECT-OUT-NONE
// EXPECT-STDERR: assertion failed at
// EXPECT-STDERR: assert_fail.wk:22:5
module tests.run.assert_fail

/// A failing assertion traps with a nonzero exit code and no stdout.
///
/// WHY THE STDERR DIRECTIVE IS LOAD-BEARING. `EXPECT-EXIT: 1` alone did not witness anything:
/// `wukongc`'s COMPILE_ERROR exit code is also 1 and diagnostics also go to stderr, so a fixture
/// that stopped compiling produced byte-identically the asserted outcome — exit 1, empty stdout —
/// and this, the corpus's only proof that a failing `assert` traps at all, was green. The stderr
/// substring separates the two: a compile error says `error[Ennnn]`, a trapped assert says
/// `assertion failed at <file>:<line>:<col>` — the site of the `assert` call (line 22, column 5
/// below), which every CPU backend reports through `wukong_runtime::assert_failure_message`.
///
/// `EXPECT-OUT-NONE` pins the other half the docstring claimed and nothing checked: stdout empty.
/// It is a positive assertion, not the absence of a directive — the absence used to mean the
/// stdout check was skipped entirely.
fn main() -> i32 {
    assert(1 > 2);
    return 0;
}
