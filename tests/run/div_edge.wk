// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: -2147483648
// EXPECT-OUT: 0
// EXPECT-OUT: 0
// EXPECT-OUT: 0
// EXPECT-OUT: -7
module tests.run.div_edge

/// Division corners that fault an unguarded x86 `idiv`: INT_MIN / -1 (2's-complement overflow) and
/// divide-by-zero. The native backend once crashed here (exit 127) while the interpreter wrapped;
/// both now agree on the interpreter's wrapping/zero semantics. Pinned by the optimizer-invariance
/// and native-vs-interp differential gate.
fn main() -> i32 {
    let mn: i32 = -2147483648; // i32::MIN
    let neg1: i32 = -1;
    print((mn / neg1) as i64); // INT_MIN (wraps, no trap)
    print((mn % neg1) as i64); // 0

    let z: i32 = 0;
    let v: i32 = 7;
    print((v / z) as i64); // 0 (guarded divide-by-zero)
    print((v % z) as i64); // 0

    print((v / neg1) as i64); // -7 (ordinary divide by -1)
    return 0;
}
