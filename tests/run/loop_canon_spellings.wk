// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 0
// EXPECT-OUT: 3
// EXPECT-OUT: 6
// EXPECT-OUT: 9
// EXPECT-OUT: 12
// EXPECT-OUT: 15
// EXPECT-OUT: 18
// EXPECT-OUT: 21
// EXPECT-OUT: 0
// EXPECT-OUT: 3
// EXPECT-OUT: 6
// EXPECT-OUT: 9
// EXPECT-OUT: 12
// EXPECT-OUT: 15
// EXPECT-OUT: 18
// EXPECT-OUT: 21
// EXPECT-OUT: 0
// EXPECT-OUT: 3
// EXPECT-OUT: 6
// EXPECT-OUT: 9
// EXPECT-OUT: 12
// EXPECT-OUT: 15
// EXPECT-OUT: 18
// EXPECT-OUT: 21
// EXPECT-OUT: 64
// EXPECT-OUT: 210
module tests.run.loop_canon_spellings

// The same loop written three ways, plus two shapes `loop_canon` rewrites: a mid-tested
// `loop`+`break` (whose exit test is emitted with the *opposite* polarity to a `while`) and a loop
// with two back edges (which the pass funnels through one latch). Every lane is printed, never a
// reduction, so a canonicalization that quietly corrupted one element cannot hide inside a sum.

fn fill_for(mut o: [i32; 8]) {
    for i in 0..8 {
        o[i] = (i as i32) * 3;
    }
}

fn fill_while(mut o: [i32; 8]) {
    let mut i: i32 = 0;
    while i < 8 {
        o[i] = i * 3;
        i = i + 1;
    }
}

/// Mid-tested: `cond_br (i >= 8), exit, body` before canonicalization, `cond_br (i < 8), body, exit`
/// after. Behaviour must be identical either way.
fn fill_break(mut o: [i32; 8]) {
    let mut i: i32 = 0;
    loop {
        if i >= 8 {
            break;
        }
        o[i] = i * 3;
        i = i + 1;
    }
}

/// Two back edges into one header: the `continue` and the fall-through both branch back, so the
/// loop has two latches until the pass funnels them through one.
fn count_two_latches(n: i32) -> i32 {
    let mut acc: i32 = 0;
    let mut i: i32 = 0;
    while i < n {
        i = i + 1;
        if i % 2 == 0 {
            continue;
        }
        acc = acc + i;
    }
    return acc;
}

/// A nested loop whose inner bound depends on the outer counter, so the inner loop is entered a
/// different number of times per outer iteration — the shape where a mis-wired preheader or latch
/// shows up as a wrong count rather than a crash.
fn triangle(n: i32) -> i32 {
    let mut acc: i32 = 0;
    let mut i: i32 = 0;
    while i < n {
        let mut j: i32 = 0;
        loop {
            if j > i {
                break;
            }
            acc = acc + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    return acc;
}

fn main() -> i32 {
    let mut a: [i32; 8] = [0; 8];
    let mut b: [i32; 8] = [0; 8];
    let mut c: [i32; 8] = [0; 8];
    fill_for(a);
    fill_while(b);
    fill_break(c);
    for i in 0..8 {
        print(a[i]);
    }
    for i in 0..8 {
        print(b[i]);
    }
    for i in 0..8 {
        print(c[i]);
    }
    print(count_two_latches(15)); // the odd values 1..15: 1+3+5+7+9+11+13+15 = 64
    print(triangle(20));          // the inner loop adds i+1 per outer step: 20*21/2 = 210
    return 0;
}
