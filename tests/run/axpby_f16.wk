// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 12
// EXPECT-OUT: 24
// EXPECT-OUT: 36
// EXPECT-OUT: 48
module tests.run.axpby_f16

// f16→f32 streaming axpby: `out[i] = a*(x[i] as f32) + b*(y[i] as f32)` over `[f16]` inputs (f32
// output) lowers to wukong_axpby_f16 — f16 in (F16C widen), f32 out, f32 math. The interpreter
// marshals through the identical kernel, so interp and native agree bit-for-bit.
//
// x = [1,2,3,4], y = [10,20,30,40] (f16-exact), a=2, b=1 → out = 2x + y = [12, 24, 36, 48].
fn main() -> i32 {
    let mut x: [f16; 4] = [0.0 as f16; 4];
    let mut y: [f16; 4] = [0.0 as f16; 4];
    for i in 0..4 {
        x[i] = ((i + 1) as f32) as f16;
        y[i] = (((i + 1) * 10) as f32) as f16;
    }
    let mut out: [f32; 4] = [0.0; 4];
    for i in 0..4 {
        out[i] = 2.0 * (x[i] as f32) + 1.0 * (y[i] as f32);
    }
    print(out[0] as i32); // 12
    print(out[1] as i32); // 24
    print(out[2] as i32); // 36
    print(out[3] as i32); // 48
    return 0;
}
