// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 0
// EXPECT-OUT: 5.5
// EXPECT-OUT: 0
// EXPECT-OUT: 12.5
module tests.run.linear_bias_relu_parallel

// The `@parallel` fused FFN: out = relu(x · Wᵀ + bias), the matmul nest and the bias+ReLU loop fused
// into ONE `wukong_sgemm_nt_epi_parallel` call — the bias+activation folded into the GEMM C
// writeback AND run across cores. Before, the epilogue forced the serial kernel, so a `@parallel`
// fused FFN got the fusion or the cores but not both. The parallel kernel is bit-identical to the
// serial `wukong_sgemm_nt_epi` the interpreter calls (each C tile owned by one task, same per-(i,j)
// accumulation order), so -O0..-O3 and interp/native all agree.
//
// Identical data to the serial linear_bias_relu, deliberately, so this is the parallel kernel's
// proof on the SAME hard case: x=[[1,2],[3,4]], W=[[2,-1],[0.5,3]] (not symmetric, so a transposed
// or mis-strided W read is visible), bias=[-10,-1].
//   x·Wᵀ row0 = [1·2+2·(-1), 1·0.5+2·3] = [0, 6.5];  +bias = [-10, 5.5];  relu = [0, 5.5]
//   x·Wᵀ row1 = [3·2+4·(-1), 3·0.5+4·3] = [2, 13.5];  +bias = [-8, 12.5]; relu = [0, 12.5]
// Every value is an integer or a half (exact in f32 under any accumulation order), so the four
// lanes are printed RAW and compared exactly — no truncating `as i32` tolerance. `out` is poisoned
// with -12345.0, so a kernel that declined and wrote nothing prints -12345 on the two ReLU-clamped
// lanes instead of the buffer's own 0, and fails.
@parallel
fn linear(x: [f32; 4], w: [f32; 4], bias: [f32; 2], mut out: [f32; 4]) {
    for i in 0..2 {
        for j in 0..2 {
            let mut s: f32 = 0.0;
            for k in 0..2 {
                s = s + x[i * 2 + k] * w[j * 2 + k];
            }
            out[i * 2 + j] = s;
        }
    }
    for i in 0..2 {
        for j in 0..2 {
            out[i * 2 + j] = fmax(out[i * 2 + j] + bias[j], 0.0);
        }
    }
}

fn main() -> i32 {
    let x: [f32; 4] = [1.0, 2.0, 3.0, 4.0];
    let w: [f32; 4] = [2.0, -1.0, 0.5, 3.0];
    let bias: [f32; 2] = [-10.0, -1.0];
    let mut out: [f32; 4] = [-12345.0, -12345.0, -12345.0, -12345.0];
    linear(x, w, bias, out);
    print(out[0]);
    print(out[1]);
    print(out[2]);
    print(out[3]);
    return 0;
}
