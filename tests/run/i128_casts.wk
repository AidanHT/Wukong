// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: -2
// EXPECT-OUT: 254
// EXPECT-OUT: -2
// EXPECT-OUT: 65534
// EXPECT-OUT: -2
// EXPECT-OUT: 4294967294
// EXPECT-OUT: -2
// EXPECT-OUT: 18446744073709551614
// EXPECT-OUT: -2
// EXPECT-OUT: 18446744073709551614
// EXPECT-OUT: 340282366920938463463374607431768211454
// EXPECT-OUT: 1147797409030816545
// EXPECT-OUT: -2023406815
// EXPECT-OUT: 33
// EXPECT-OUT: 24197857203266734864629346612071973665
// EXPECT-OUT: -1
// EXPECT-OUT: 340282366920938463463374607431768211455
// EXPECT-OUT: 4294967295
// EXPECT-OUT: 340282366920938463463374607431768211455
// EXPECT-OUT: 18446744073709551615
// EXPECT-OUT: -1
// EXPECT-OUT: 170141183460469231731687303715884105728
// EXPECT-OUT: 1
// EXPECT-OUT: 18014400656965632
// EXPECT-OUT: 18014399583223808
// EXPECT-OUT: 18446744073709551616
// EXPECT-OUT: 18446744073709551616
// EXPECT-OUT: inf
// EXPECT-OUT: 340282366920938463463374607431768211455
// EXPECT-OUT: -170141183460469231731687303715884105728
// EXPECT-OUT: 3
// EXPECT-OUT: -3
// EXPECT-OUT: 170141183460469231731687303715884105727
// EXPECT-OUT: -170141183460469231731687303715884105728
// EXPECT-OUT: 340282366920938463463374607431768211455
// EXPECT-OUT: 0
// EXPECT-OUT: 0
// EXPECT-OUT: 340282346638528859811704183484516925440
module tests.run.i128_casts

// `as` between the 128-bit integers and every other numeric type. Expected lines are the cast rules
// evaluated independently (Python integers and IEEE-754 rounding by hand), never compiler output:
//
// * an integer cast keeps the low bits of the source two's-complement pattern when narrowing, and
//   widens by the SOURCE's signedness (`-1i32 as u128` is u128::MAX, `u32::MAX as i128` stays
//   positive) — the rule of every narrower width;
// * an integer converts to a float rounded ONCE, to nearest with ties to even, straight to the
//   target precision. 2^54 + 2^30 + 1 is just above the midpoint of two neighbouring f32 values, so
//   it rounds up to 2^54 + 2^31; rounding through f64 first would land exactly on the midpoint and
//   tie to the even 2^54 — the double-rounding defect the native runtime conversion must not have;
// * a float converts to an integer truncating toward zero and saturating: past either end clamps to
//   it, a negative float to `u128` is 0, and NaN is 0. u128::MAX is past f32::MAX, so it rounds to
//   infinity.
//
// Each operand is a runtime value (`arg_count()` is 1 on every backend, but opaque to the
// optimizer), so every conversion executes at -O2 as well.
fn main() -> i32 {
    let o: i128 = (arg_count() - 1) as i128;
    let uo: u128 = o as u128;
    let fo: f64 = o as f64;

    // Narrowing keeps the low bits.
    let v: i128 = -2 + o;
    println(v as i8);
    println(v as u8);
    println(v as i16);
    println(v as u16);
    println(v as i32);
    println(v as u32);
    println(v as i64);
    println(v as u64);
    println(v as isize);
    println(v as usize);
    println(v as u128);
    let x: u128 = 0x1234_5678_9abc_def0_0fed_cba9_8765_4321 + uo;
    println(x as u64);
    println(x as i32);
    println(x as u8);
    println(x as i128);

    // Widening by the source's signedness.
    let m8: i8 = (o - 1) as i8;
    let u32max: u32 = (o + 4294967295) as u32;
    let m64: i64 = (o - 1) as i64;
    let u64max: u64 = (o + 18446744073709551615) as u64;
    println(m8 as i128);
    println(m8 as u128);
    println(u32max as i128);
    println(m64 as u128);
    println(u64max as i128);
    println((340282366920938463463374607431768211455 + uo) as i128);
    println((-170141183460469231731687303715884105728 + o) as u128);
    println((true as i128) + o);

    // Integer to float: rounded once.
    let near: i128 = 18014399583223809 + o;
    println((near as f32) as i128);
    println((near as f64) as i128);
    let two64p1: u128 = 18446744073709551617 + uo;
    println((two64p1 as f64) as u128);
    println((two64p1 as f32) as u128);
    let umax: u128 = 340282366920938463463374607431768211455 + uo;
    println(umax as f32);
    println((umax as f64) as u128);
    println(((-170141183460469231731687303715884105728 + o) as f64) as i128);

    // Float to integer: truncating, saturating, NaN to 0.
    println((3.99 + fo) as i128);
    println((-3.99 + fo) as i128);
    println((1.0e40f64 + fo) as i128);
    println((-1.0e40f64 + fo) as i128);
    println((1.0e40f64 + fo) as u128);
    println((-1.5 + fo) as u128);
    println(((0.0 + fo) / (0.0 + fo)) as i128);
    println((340282346638528859811704183484516925440.0f32 + (fo as f32)) as u128);
    return 0;
}
