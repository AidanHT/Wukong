// EXPECT-OUT: 3
// EXPECT-OUT: 3
// EXPECT-OUT: 4
// EXPECT-OUT: 5
// EXPECT-OUT: 4
// EXPECT-OUT: 5
// EXPECT-OUT: 1
// EXPECT-OUT: 7
// EXPECT-OUT: 1
// EXPECT-OUT: 7
