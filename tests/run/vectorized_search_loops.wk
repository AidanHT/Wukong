// EXPECT-OUT: 17
// EXPECT-OUT: 18
// EXPECT-OUT: 18
// EXPECT-OUT: 0
// EXPECT-OUT: 1
// EXPECT-OUT: 2
// EXPECT-OUT: 3
// EXPECT-OUT: 4
// EXPECT-OUT: 5
// EXPECT-OUT: 6
// EXPECT-OUT: 7
