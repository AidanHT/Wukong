// RUN: --run
// A branchy `if`/`else` elementwise loop (relu written as a statement, so its body sits in the
// block TAIL, not `stmts`) adjacent to a straight-line velem loop over the same range must NOT be
// dropped by operator fusion. Regression for the silent miscompile where `fuse_for_bodies` ignored
// a for-body's tail expression: fusion kept only the neighbor loop and the relu vanished, and both
// backends agreed on the wrong answer (escaping the differential gate).
// EXPECT-EXIT: 0
// relu-then-bias: r = relu(x); r = r + 1
// EXPECT-OUT: 6
// EXPECT-OUT: 1
// bias-then-relu: r = x + 1; r = relu(x)   (relu reads the original x)
// EXPECT-OUT: 5
// EXPECT-OUT: 0
// relu-then-scale-to-other-array: r = relu(x); w = r * 2
// EXPECT-OUT: 10
// EXPECT-OUT: 0
fn main() -> i32 {
    let x: [f32; 8] = [-3.0, 5.0, -1.0, 2.0, 8.0, -7.0, 4.0, 6.0];

    let mut r: [f32; 8] = [0.0; 8];
    for i in 0..8 { if x[i] > 0.0 { r[i] = x[i]; } else { r[i] = 0.0; } }
    for i in 0..8 { r[i] = r[i] + 1.0; }
    print(r[1] as i32); // relu(5)=5, +1 = 6
    print(r[0] as i32); // relu(-3)=0, +1 = 1

    let mut r2: [f32; 8] = [0.0; 8];
    for i in 0..8 { r2[i] = x[i] + 1.0; }
    for i in 0..8 { if x[i] > 0.0 { r2[i] = x[i]; } else { r2[i] = 0.0; } }
    print(r2[1] as i32); // relu(5) = 5
    print(r2[0] as i32); // relu(-3) = 0

    let mut r3: [f32; 8] = [0.0; 8];
    let mut w: [f32; 8] = [0.0; 8];
    for i in 0..8 { if x[i] > 0.0 { r3[i] = x[i]; } else { r3[i] = 0.0; } }
    for i in 0..8 { w[i] = r3[i] * 2.0; }
    print(w[1] as i32); // relu(5)*2 = 10
    print(w[0] as i32); // relu(-3)*2 = 0

    return 0;
}
