// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 5120
// EXPECT-OUT: 10240
// EXPECT-OUT: 13312
// EXPECT-OUT: 17408
// EXPECT-OUT: 15360
// EXPECT-OUT: 20480
// EXPECT-OUT: 25600
// EXPECT-OUT: 29696
// EXPECT-OUT: 26624
// EXPECT-OUT: 30720
// EXPECT-OUT: 11264
// EXPECT-OUT: 29696
// EXPECT-OUT: 13312
// EXPECT-OUT: 20480
// EXPECT-OUT: 11264
// EXPECT-OUT: 25600
// EXPECT-OUT: 5120
// EXPECT-OUT: 30720
// EXPECT-OUT: 15360
// EXPECT-OUT: 10240
// EXPECT-OUT: 26624
// EXPECT-OUT: 17408
// EXPECT-OUT: 2048
// EXPECT-OUT: 5120
// EXPECT-OUT: 7168
// EXPECT-OUT: 11264
// EXPECT-OUT: 13312
// EXPECT-OUT: 17408
// EXPECT-OUT: 19456
// EXPECT-OUT: 23552
// EXPECT-OUT: 29696
// EXPECT-OUT: 31744
// EXPECT-OUT: 37888
module tests.run.colstats_wide

// The three column-statistics reductions — rms `sqrt((Σ x²)/rows)`, l2 `sqrt(Σ x²)` and mean
// `(Σ x)/rows` — at **N = 11 columns**, which is what colrms.wk / coll2.wk / colmean.wk (N = 4)
// cannot reach.
//
// WHY 11. The per-column finalize that distinguishes these three kinds from plain colsum runs
// 8 columns per `vdivps`/`vsqrtps` with a scalar `< 8` remainder, so N = 4 exercises only the
// remainder and leaves the packed loop — the whole of the finalize on any real shape — untested by
// the corpus. 11 = one full 8-wide step plus a 3-column tail, so both halves run and a defect at the
// seam (a packed store running past the tail, a tail starting at the wrong column) changes a printed
// lane. Recognized kernels are gate-blind — no differential or opt-invariance gate can see whether
// this kernel is right — so EVERY lane is printed and no lane is a reduction of the others.
//
// The printed value is `out[j] * 1024` truncated to i32, not `out[j]` truncated: at 1024x it takes a
// relative error of only ~1e-3 to move a printed digit, where the bare `as i32` would swallow one of
// almost 10%. Every expected value below is derived from the scalar semantics of the loop — the
// columns are built from Pythagorean identities and exact-thirds sums so each result is a whole
// number in f32 (25 -> 5, 169 -> 13, 21/3 -> 7), never recorded from compiler output.
//
// No two columns of a kind share a result and the three kinds do not share a result *order*, so a
// defect that permutes lanes, drops the tail, swaps a row for another, or mixes two kinds' outputs
// shows up as a changed line rather than a changed total.
fn main() -> i32 {
    // ---- rms: out[j] = sqrt((x[0,j]^2 + x[1,j]^2) / 2), a [2, 11] matrix.
    // Each column is (p+q, |p-q|) for a Pythagorean (p, q, c), so the rms is exactly c.
    let x: [f32; 22] = [
        7.0, 14.0, 17.0, 23.0, 21.0, 28.0, 31.0, 41.0, 34.0, 42.0, 11.0, // row 0
        1.0, 2.0, 7.0, 7.0, 3.0, 4.0, 17.0, 1.0, 14.0, 6.0, 11.0, // row 1
    ];
    let mut rms: [f32; 11] = [0.0; 11];
    for j in 0..11 {
        let mut s: f32 = 0.0;
        for i in 0..2 {
            s = s + x[i * 11 + j] * x[i * 11 + j];
        }
        rms[j] = sqrt(s / 2.0);
    }

    // ---- l2: out[j] = sqrt(y[0,j]^2 + y[1,j]^2), a [2, 11] matrix of Pythagorean legs.
    // Deliberately a different result ORDER from rms above, so the two kinds cannot be confused.
    let y: [f32; 22] = [
        20.0, 5.0, 12.0, 0.0, 7.0, 3.0, 18.0, 9.0, 6.0, 10.0, 8.0, // row 0
        21.0, 12.0, 16.0, 11.0, 24.0, 4.0, 24.0, 12.0, 8.0, 24.0, 15.0, // row 1
    ];
    let mut l2: [f32; 11] = [0.0; 11];
    for j in 0..11 {
        let mut s: f32 = 0.0;
        for i in 0..2 {
            s = s + y[i * 11 + j] * y[i * 11 + j];
        }
        l2[j] = sqrt(s);
    }

    // ---- mean: out[j] = (Σ_i z[i,j]) / 3, a [3, 11] matrix. THREE rows, so the divisor is 3 and
    // not the 2 the other two kinds use — a finalize that reused the wrong row count would show.
    // Every column sum is an exact multiple of 3, so each mean is a whole f32.
    let z: [f32; 33] = [
        1.0, 5.0, 2.0, 12.0, 20.0, 30.0, 1.0, 40.0, 11.0, 50.0, 70.0, // row 0
        2.0, 0.0, 9.0, 8.0, 4.0, 6.0, 25.0, 2.0, 60.0, 7.0, 3.0, // row 1
        3.0, 10.0, 10.0, 13.0, 15.0, 15.0, 31.0, 27.0, 16.0, 36.0, 38.0, // row 2
    ];
    let mut mean: [f32; 11] = [0.0; 11];
    for j in 0..11 {
        let mut s: f32 = 0.0;
        for i in 0..3 {
            s = s + z[i * 11 + j];
        }
        mean[j] = s / 3.0;
    }

    // Every lane of every kind, scaled by 1024 (see the header).
    print((rms[0] * 1024.0) as i32); // sqrt((49+1)/2)      =  5 -> 5120
    print((rms[1] * 1024.0) as i32); // sqrt((196+4)/2)     = 10 -> 10240
    print((rms[2] * 1024.0) as i32); // sqrt((289+49)/2)    = 13 -> 13312
    print((rms[3] * 1024.0) as i32); // sqrt((529+49)/2)    = 17 -> 17408
    print((rms[4] * 1024.0) as i32); // sqrt((441+9)/2)     = 15 -> 15360
    print((rms[5] * 1024.0) as i32); // sqrt((784+16)/2)    = 20 -> 20480
    print((rms[6] * 1024.0) as i32); // sqrt((961+289)/2)   = 25 -> 25600
    print((rms[7] * 1024.0) as i32); // sqrt((1681+1)/2)    = 29 -> 29696
    print((rms[8] * 1024.0) as i32); // sqrt((1156+196)/2)  = 26 -> 26624  <- first tail column
    print((rms[9] * 1024.0) as i32); // sqrt((1764+36)/2)   = 30 -> 30720
    print((rms[10] * 1024.0) as i32); // sqrt((121+121)/2)  = 11 -> 11264
    print((l2[0] * 1024.0) as i32); // sqrt(400+441)        = 29 -> 29696
    print((l2[1] * 1024.0) as i32); // sqrt(25+144)         = 13 -> 13312
    print((l2[2] * 1024.0) as i32); // sqrt(144+256)        = 20 -> 20480
    print((l2[3] * 1024.0) as i32); // sqrt(0+121)          = 11 -> 11264
    print((l2[4] * 1024.0) as i32); // sqrt(49+576)         = 25 -> 25600
    print((l2[5] * 1024.0) as i32); // sqrt(9+16)           =  5 -> 5120
    print((l2[6] * 1024.0) as i32); // sqrt(324+576)        = 30 -> 30720
    print((l2[7] * 1024.0) as i32); // sqrt(81+144)         = 15 -> 15360
    print((l2[8] * 1024.0) as i32); // sqrt(36+64)          = 10 -> 10240  <- first tail column
    print((l2[9] * 1024.0) as i32); // sqrt(100+576)        = 26 -> 26624
    print((l2[10] * 1024.0) as i32); // sqrt(64+225)        = 17 -> 17408
    print((mean[0] * 1024.0) as i32); // (1+2+3)/3     =  2 -> 2048
    print((mean[1] * 1024.0) as i32); // (5+0+10)/3    =  5 -> 5120
    print((mean[2] * 1024.0) as i32); // (2+9+10)/3    =  7 -> 7168
    print((mean[3] * 1024.0) as i32); // (12+8+13)/3   = 11 -> 11264
    print((mean[4] * 1024.0) as i32); // (20+4+15)/3   = 13 -> 13312
    print((mean[5] * 1024.0) as i32); // (30+6+15)/3   = 17 -> 17408
    print((mean[6] * 1024.0) as i32); // (1+25+31)/3   = 19 -> 19456
    print((mean[7] * 1024.0) as i32); // (40+2+27)/3   = 23 -> 23552
    print((mean[8] * 1024.0) as i32); // (11+60+16)/3  = 29 -> 29696  <- first tail column
    print((mean[9] * 1024.0) as i32); // (50+7+36)/3   = 31 -> 31744
    print((mean[10] * 1024.0) as i32); // (70+3+38)/3  = 37 -> 37888
    return 0;
}
