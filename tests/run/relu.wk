// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 0
// EXPECT-OUT: 5
// EXPECT-OUT: 0
// EXPECT-OUT: 0
// EXPECT-OUT: 8
// EXPECT-OUT: 0
module tests.run.relu

/// ReLU activation kernel (out[i] = max(0, x[i])) with an array out-parameter — a real ML
/// elementwise op running end to end.
fn relu(x: [i32; 6], mut out: [i32; 6]) {
    let mut i: i32 = 0;
    while i < 6 {
        if x[i] > 0 {
            out[i] = x[i];
        } else {
            out[i] = 0;
        }
        i = i + 1;
    }
}

fn main() -> i32 {
    let x: [i32; 6] = [-3, 5, -1, 0, 8, -7];
    let mut out: [i32; 6] = [0, 0, 0, 0, 0, 0];
    relu(x, out);

    let mut k: i32 = 0;
    while k < 6 {
        print(out[k]);
        k = k + 1;
    }
    return 0;
}
