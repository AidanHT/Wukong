// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 0
// EXPECT-OUT: 1
// EXPECT-OUT: 2
// EXPECT-OUT: 3
// EXPECT-OUT: 4
// EXPECT-OUT: 5
// EXPECT-OUT: 6
// EXPECT-OUT: 7
// EXPECT-OUT: 8
// EXPECT-OUT: 9
// EXPECT-OUT: 10
// EXPECT-OUT: 11
// EXPECT-OUT: 12
// EXPECT-OUT: -1
// EXPECT-OUT: -1
// EXPECT-OUT: 0
// EXPECT-OUT: 0
// EXPECT-OUT: 2
// EXPECT-OUT: 3
// EXPECT-OUT: 3
// EXPECT-OUT: 3
// EXPECT-OUT: 3
// EXPECT-OUT: 7
// EXPECT-OUT: 7
// EXPECT-OUT: 7
// EXPECT-OUT: 10
// EXPECT-OUT: 10
// EXPECT-OUT: 10
// EXPECT-OUT: 4
// EXPECT-OUT: 5
// EXPECT-OUT: 5
// EXPECT-OUT: -1
// EXPECT-OUT: -1
// EXPECT-OUT: 1
// EXPECT-OUT: 1
// EXPECT-OUT: 3
// EXPECT-OUT: 3
// EXPECT-OUT: 3
// EXPECT-OUT: 6
// EXPECT-OUT: 7
// EXPECT-OUT: 7
module tests.run.vec_find_last

// FindLastIV — `if c { last = i }`, the counter of the LAST iteration whose condition held, or the
// start value when none did — over slices in `while` loops, which the general vectorizer now
// widens with per-lane "last counter" partials and an exit fold by iteration order.
//
// Every expected line is derived by hand from the scalar loop: a one-hot hit at every position
// 0..12 (13 = three 4-lane groups plus one epilogue iteration, so a hit lands in every lane of
// every group and in the epilogue), no hit at all, every prefix of a multi-hit buffer, a start
// value (5) that equals a real index (the fold must not mistake "never recorded" for a record),
// and the else-arm spelling over i32 data.
@unchecked
fn flast(x: []f32, n: i64, t: f32, init: i64) -> i64 {
    let mut last: i64 = init;
    let mut i: i64 = 0;
    while i < n {
        if x[i] > t {
            last = i;
        }
        i = i + 1;
    }
    return last;
}

// The update on the ELSE arm: the last index with y[i] >= t.
@unchecked
fn flast_else(y: []i32, n: i64, t: i32) -> i64 {
    let mut last: i64 = -1;
    let mut i: i64 = 0;
    while i < n {
        if y[i] < t {
        } else {
            last = i;
        }
        i = i + 1;
    }
    return last;
}

fn main() -> i32 {
    let mut x: []f32 = alloc_f32(13);
    // One-hot at every position: 0 1 2 .. 12.
    let mut p: i64 = 0;
    while p < 13 {
        let mut j: i64 = 0;
        while j < 13 { x[j] = 0.0; j = j + 1; }
        x[p] = 1.0;
        print(flast(x, 13, 0.5, -1));
        p = p + 1;
    }
    // No hit: -1.
    let mut j: i64 = 0;
    while j < 13 { x[j] = 0.0; j = j + 1; }
    print(flast(x, 13, 0.5, -1));

    // Hits at 0, 2, 3, 7, 10; every prefix: -1 0 0 2 3 3 3 3 7 7 7 10 10 10.
    x[0] = 1.0; x[2] = 1.0; x[3] = 1.0; x[7] = 1.0; x[10] = 1.0;
    let mut n: i64 = 0;
    while n <= 13 { print(flast(x, n, 0.5, -1)); n = n + 1; }

    // Start value 5: a hit only at 4 -> 4; no hit -> 5; a hit only at 5 -> 5.
    j = 0;
    while j < 13 { x[j] = 0.0; j = j + 1; }
    x[4] = 1.0;
    print(flast(x, 13, 0.5, 5));
    x[4] = 0.0;
    print(flast(x, 13, 0.5, 5));
    x[5] = 1.0;
    print(flast(x, 13, 0.5, 5));

    // y >= 5 at 1, 3, 6, 7; every prefix: -1 -1 1 1 3 3 3 6 7 7.
    let mut y: []i32 = alloc_i32(9);
    y[0] = 3; y[1] = 9; y[2] = -1; y[3] = 9; y[4] = 0; y[5] = 2; y[6] = 9; y[7] = 8; y[8] = 1;
    n = 0;
    while n <= 9 { print(flast_else(y, n, 5)); n = n + 1; }

    free(x); free(y);
    return 0;
}
