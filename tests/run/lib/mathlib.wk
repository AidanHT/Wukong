// Library imported by tests/run/import_multi.wk — NOT a standalone program (no `fn main`).
// The run/emit/exe harnesses scan tests/run/*.wk non-recursively, so files in this subdirectory
// are only ever compiled through the root that imports them.
module lib.mathlib

// Nothing here uses `lib.deep`: the import exists to close the A<->B cycle the fixture tests.
@allow(unused_imports)
import lib.deep;

pub struct Point {
    pub x: i32,
    pub y: i32,
}

pub const ANSWER: i32 = 42;

pub fn dot_self(p: Point) -> i32 {
    return p.x * p.x + p.y * p.y;
}

pub fn triple(a: i32) -> i32 {
    return a * 3;
}
