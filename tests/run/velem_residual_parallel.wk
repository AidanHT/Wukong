// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 10
// EXPECT-OUT: 15
// EXPECT-OUT: 17
// EXPECT-OUT: 71680
module tests.run.velem_residual_parallel

// A *mixed* `@parallel` function (a reduction plus an isolated residual-add loop, so it is not a
// single outlinable loop) dispatches its residual add `out[i] = x[i] + attn[i]` — the transformer
// layer's hot loop — to the multicore `wukong_velem_f32_parallel` streaming kernel instead of the
// serial `wukong_velem_f32`. The map is pure elementwise (no cross-chunk combine), so serial ==
// parallel bit-for-bit and the native `@parallel` path agrees with the interpreter oracle at every
// optimization level (checked by the run suite's differential + -O0==-O{1,2,3} gates). The
// sum-of-squares reduction (dispatched to `wukong_sreduce_f32_parallel`) is only there to make the
// body mixed so `parallel_fn` is set and the residual add takes the parallel arm.
//   x[i] = i % 8 (0..7 repeating), attn[i] = 10  ⇒  out[i] = (i % 8) + 10, in 10..17.
//     out[0]    = 0 + 10 = 10
//     out[5]    = 5 + 10 = 15
//     out[4095] = (4095 % 8 = 7) + 10 = 17
//   acc = Σ x[i]²  over one period (0²+…+7² = 140) × 512 periods = 71680.
@parallel
fn layer(x: [f32; 4096], attn: [f32; 4096], mut out: [f32; 4096], mut acc: [f32; 1]) {
    let mut s: f32 = 0.0;
    for i in 0..4096 {
        s = s + x[i] * x[i];
    }
    acc[0] = s;
    for i in 0..4096 {
        out[i] = x[i] + attn[i];
    }
}

fn main() -> i32 {
    let mut x: [f32; 4096] = [0.0; 4096];
    let mut attn: [f32; 4096] = [0.0; 4096];
    let mut out: [f32; 4096] = [0.0; 4096];
    let mut acc: [f32; 1] = [0.0; 1];
    for i in 0..4096 {
        x[i] = (i % 8) as f32;
        attn[i] = 10.0;
    }
    layer(x, attn, out, acc);
    print(out[0] as i32);
    print(out[5] as i32);
    print(out[4095] as i32);
    print(acc[0] as i32);
    return 0;
}
