// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT-VALUES: 0 10 20 304
// EXPECT-OUT-VALUES: 7 104 -500 3
// EXPECT-OUT-VALUES: 34 0
// EXPECT-OUT-VALUES: 0 14 123 21
// EXPECT-OUT-VALUES: 5 -1 2999 25 0
module tests.run.patterns_struct_binding_slice

// The pattern forms beyond literals, tuples and enum variants, each arm exercised, with the
// expected value worked out from the arm that must fire:
//
// * struct patterns — `Point { x: 0, y: 0 }`, `Point { x: 0, .. }`, `Point { x, y }` — in a
//   `match` and in a `let`;
// * `name @ sub` — the name binds the whole value the sub-pattern tests, also inside a tuple;
// * array patterns — `[first, .., last]`, a literal at each end, and a full `let [p, q, r] = a`;
// * `if let`, `while let` and `let … else`, which the parser rewrites into a `match`.

struct Point {
    x: i32,
    y: i32,
}

enum Cmd {
    Move(i32, i32),
    Stop,
}

// (0,0) -> 0; (0,5) -> 10; (7,0) -> 20; (3,4) -> 3*100 + 4 = 304.
fn quadrant(p: Point) -> i32 {
    return match p {
        Point { x: 0, y: 0 } => 0,
        Point { x: 0, .. } => 10,
        Point { y: 0, .. } => 20,
        Point { x, y } => x * 100 + y,
    };
}

// 7 -> 7; 42 -> 42/10 + 100 = 104; 500 -> -500; -3 -> 3.
fn bucket(n: i32) -> i32 {
    return match n {
        small @ 0..=9 => small,
        big @ 10..=99 => big / 10 + 100,
        other => -other,
    };
}

// (3, 4) -> 3*10 + 4 = 34; (9, 4) -> 0.
fn pair(n: i32, m: i32) -> i32 {
    return match (n, m) {
        (a @ 1..=5, b) => a * 10 + b,
        _ => 0,
    };
}

// [0, 5, 6, 0] -> 0; [1, 2, 3, 4] -> 1*10 + 4 = 14.
fn ends(a: [i32; 4]) -> i32 {
    return match a {
        [0, .., 0] => 0,
        [first, .., last] => first * 10 + last,
    };
}

// [1, 2, 3] -> 123.
fn exact(a: [i32; 3]) -> i32 {
    let [p, q, r] = a;
    return p * 100 + q * 10 + r;
}

// Point { x: 1, y: 2 } -> 2*10 + 1 = 21.
fn swap(p: Point) -> i32 {
    let Point { x: a, y: b } = p;
    return b * 10 + a;
}

// Move(2, 3) -> 5; Stop -> -1.
fn first_move(c: Cmd) -> i32 {
    if let Cmd::Move(dx, dy) = c {
        return dx + dy;
    } else {
        return -1;
    }
}

// k = 20 -> 13 -> 6 -> -1: three steps inside 1..=100, then the pattern fails; 3*1000 - 1 = 2999.
fn count_down(n: i32) -> i32 {
    let mut k = n;
    let mut steps = 0;
    while let 1..=100 = k {
        k = k - 7;
        steps += 1;
    }
    return steps * 1000 + k;
}

// Move(3, 4) -> 3*3 + 4*4 = 25; Stop -> 0 (the `else` returns).
fn move_len(c: Cmd) -> i32 {
    let Cmd::Move(dx, dy) = c else {
        return 0;
    };
    return dx * dx + dy * dy;
}

fn main() -> i32 {
    print(quadrant(Point { x: 0, y: 0 }));
    print(quadrant(Point { x: 0, y: 5 }));
    print(quadrant(Point { x: 7, y: 0 }));
    print(quadrant(Point { x: 3, y: 4 }));

    print(bucket(7));
    print(bucket(42));
    print(bucket(500));
    print(bucket(-3));

    print(pair(3, 4));
    print(pair(9, 4));

    print(ends([0, 5, 6, 0]));
    print(ends([1, 2, 3, 4]));
    print(exact([1, 2, 3]));
    print(swap(Point { x: 1, y: 2 }));

    print(first_move(Cmd::Move(2, 3)));
    print(first_move(Cmd::Stop));
    print(count_down(20));
    print(move_len(Cmd::Move(3, 4)));
    print(move_len(Cmd::Stop));
    return 0;
}
