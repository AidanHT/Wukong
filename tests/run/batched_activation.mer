// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 0
// EXPECT-OUT: 0
// EXPECT-OUT: 1762
module tests.run.batched_activation

// Batched activation `out[r*C + j] = silu(x[r*C + j])` (the real [tokens, hidden] FFN/attention
// shape) dispatches to one flat 256-bit `mercury_vmath_f32` over the whole [0, R*C) buffer — the same
// kernel the flat `for i in 0..N { out[i] = silu(x[i]) }` form uses, so the two are bit-identical
// element-for-element (the recognizer just restored the full 256-bit width the offset-indexed inner
// loop would otherwise lose to the 128-bit generic vectorizer). The mercury_bench / cranelift
// differential gate proves interp == native bit-for-bit through the dispatched kernel.

fn main() -> i32 {
    let mut x: [f32; 64] = [0.0; 64];
    for i in 0..64 { x[i] = (i as f32 - 32.0) * 0.25; } // -8.0 .. 7.75

    // Batched (nested) silu over an 8x8 = [R, C] matrix — the dispatched form.
    let mut batched: [f32; 64] = [0.0; 64];
    for r in 0..8 {
        for j in 0..8 {
            batched[r * 8 + j] = silu(x[r * 8 + j]);
        }
    }

    // Flat silu over the same data — the already-proven 256-bit dispatch.
    let mut flat: [f32; 64] = [0.0; 64];
    for i in 0..64 { flat[i] = silu(x[i]); }

    // The two must agree element-for-element (same kernel, same buffer).
    let mut mism: i32 = 0;
    for i in 0..64 { if batched[i] != flat[i] { mism = mism + 1; } }
    print(mism); // 0 — batched == flat

    // Spot values: x[32] = 0.0 → silu(0) = 0; x[40] = 2.0 → silu(2) = 2*sigmoid(2) ≈ 1.7616.
    print(round(batched[32] * 1000.0) as i32); // 0
    print(round(batched[40] * 1000.0) as i32); // ~1762
    return 0;
}
