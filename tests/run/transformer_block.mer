// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: -2527
// EXPECT-OUT: -7
// EXPECT-OUT: -2352
module tests.run.transformer_block

// A full pre-norm (Llama-style) transformer block in one function:
//   h   = x + Attention(RMSNorm(x))
//   out = h + FFN(RMSNorm(h))
// composing every Mercury win — three of the four matmul nests dispatch to the GEMM kernel (P·V and
// the two FFN linears), two RMSNorm reductions (sum-of-squares + rsqrt + scale), a row softmax
// (fmax reduction + vectorized exp + sum + normalize), a vectorized GELU, and residual adds. S=8
// tokens, D=8 model dim, H=16 FFN hidden. Self-attention here uses the normed input directly as
// Q/K/V, so the Q·Kᵀ nest has the *same* array on both sides — which the recognizer leaves as a
// plain loop (real attention projects Q/K/V to distinct tensors and dispatches all of them). Every
// path still runs, and the gate proves the whole block is bit-identical between the interpreter and
// native backends.
fn block(x: [f32; 64], w1: [f32; 128], w2: [f32; 128], out: [f32; 64]) {
    let mut n1: [f32; 64] = [0.0; 64];
    let mut scores: [f32; 64] = [0.0; 64];
    let mut attn: [f32; 64] = [0.0; 64];
    let mut h: [f32; 64] = [0.0; 64];
    let mut n2: [f32; 64] = [0.0; 64];
    let mut fh: [f32; 128] = [0.0; 128];
    let mut fout: [f32; 64] = [0.0; 64];

    // --- RMSNorm(x) per token (row) over D=8 ---
    for i in 0..8 {
        let mut ss: f32 = 0.0;
        for d in 0..8 {
            ss = ss + x[i * 8 + d] * x[i * 8 + d];
        }
        let inv: f32 = rsqrt(ss / 8.0 + 0.00001);
        for d in 0..8 {
            n1[i * 8 + d] = x[i * 8 + d] * inv;
        }
    }

    // --- Attention: scores = n1 · n1ᵀ ---
    for i in 0..8 {
        for j in 0..8 {
            let mut s: f32 = 0.0;
            for p in 0..8 {
                s = s + n1[i * 8 + p] * n1[j * 8 + p];
            }
            scores[i * 8 + j] = s;
        }
    }
    // row softmax
    for i in 0..8 {
        let mut m: f32 = scores[i * 8 + 0];
        for j in 0..8 {
            m = fmax(m, scores[i * 8 + j]);
        }
        let mut sm: f32 = 0.0;
        for j in 0..8 {
            let e: f32 = exp(scores[i * 8 + j] - m);
            scores[i * 8 + j] = e;
            sm = sm + e;
        }
        let inv: f32 = 1.0 / sm;
        for j in 0..8 {
            scores[i * 8 + j] = scores[i * 8 + j] * inv;
        }
    }
    // attn = softmax(scores) · n1
    for i in 0..8 {
        for j in 0..8 {
            let mut s: f32 = 0.0;
            for p in 0..8 {
                s = s + scores[i * 8 + p] * n1[p * 8 + j];
            }
            attn[i * 8 + j] = s;
        }
    }
    // residual: h = x + attn
    for i in 0..64 {
        h[i] = x[i] + attn[i];
    }

    // --- RMSNorm(h) ---
    for i in 0..8 {
        let mut ss: f32 = 0.0;
        for d in 0..8 {
            ss = ss + h[i * 8 + d] * h[i * 8 + d];
        }
        let inv: f32 = rsqrt(ss / 8.0 + 0.00001);
        for d in 0..8 {
            n2[i * 8 + d] = h[i * 8 + d] * inv;
        }
    }
    // FFN: fh = gelu(n2 · W1ᵀ), fout = fh · W2ᵀ
    for i in 0..8 {
        for j in 0..16 {
            let mut s: f32 = 0.0;
            for p in 0..8 {
                s = s + n2[i * 8 + p] * w1[j * 8 + p];
            }
            fh[i * 16 + j] = s;
        }
    }
    for i in 0..128 {
        let v: f32 = fh[i];
        let u: f32 = 0.7978845608 * (v + 0.044715 * v * v * v);
        let t: f32 = 1.0 - 2.0 / (exp(2.0 * u) + 1.0);
        fh[i] = 0.5 * v * (1.0 + t);
    }
    for i in 0..8 {
        for j in 0..8 {
            let mut s: f32 = 0.0;
            for p in 0..16 {
                s = s + fh[i * 16 + p] * w2[j * 16 + p];
            }
            fout[i * 8 + j] = s;
        }
    }
    // residual: out = h + fout
    for i in 0..64 {
        out[i] = h[i] + fout[i];
    }
}

fn main() -> i32 {
    let mut x: [f32; 64] = [0.0; 64];
    let w1: [f32; 128] = [0.05; 128];
    let w2: [f32; 128] = [0.05; 128];
    let mut out: [f32; 64] = [0.0; 64];
    for i in 0..64 {
        x[i] = ((i % 9) as f32) * 0.2 - 0.8;
    }
    block(x, w1, w2, out);
    print((out[0] * 1000.0) as i32);
    print((out[31] * 1000.0) as i32);
    print((out[63] * 1000.0) as i32);
    return 0;
}
