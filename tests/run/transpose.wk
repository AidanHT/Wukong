// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 1
// EXPECT-OUT: 4
// EXPECT-OUT: 7
// EXPECT-OUT: 2
// EXPECT-OUT: 5
// EXPECT-OUT: 8
// EXPECT-OUT: 3
// EXPECT-OUT: 6
// EXPECT-OUT: 9
module tests.run.transpose

/// Transpose a 3x3 matrix stored as a flat row-major array into a second array, using 2D-via-flat
/// addressing (t[j*n + i] = a[i*n + j]).
fn main() -> i32 {
    let a: [i32; 9] = [1, 2, 3, 4, 5, 6, 7, 8, 9];
    let mut t: [i32; 9] = [0, 0, 0, 0, 0, 0, 0, 0, 0];
    let n: i32 = 3;

    let mut i: i32 = 0;
    while i < n {
        let mut j: i32 = 0;
        while j < n {
            t[j * n + i] = a[i * n + j];
            j = j + 1;
        }
        i = i + 1;
    }

    let mut k: i32 = 0;
    while k < 9 {
        print(t[k]);
        k = k + 1;
    }
    return 0;
}
