// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT-VALUES: 4 7 10 13 16
// EXPECT-OUT-VALUES: 5 4 3 2 1
// EXPECT-OUT: 234
// EXPECT-OUT: 6
// EXPECT-OUT: 15
module tests.run.slice_bounds_in_range

// Checked slice accesses that are all in bounds must behave exactly as unchecked ones did, on every
// backend and at every -O level — including after `-O2`'s bounds-check elimination versions each
// loop on a guard computed once in its preheader. Each loop below is one index form that guard has
// to reason about, and every lane is printed:
//
// * `scale` — `for i in 0..x.len()`, index `i` into two slices (the stores are `i32`).
//   Expected 3*x + 1 for x = 1..5: 4 7 10 13 16.
// * `reverse_into` — index `n - 1 - i`, a countdown (coefficient -1 on the loop variable).
//   Expected 5 4 3 2 1.
// * `window` — index `start + i` with a loop-invariant offset. With start = 1, w = 3 it folds
//   2, 3, 4 into ((0*10 + 2)*10 + 3)*10 + 4 = 234.
// * `first_plus_last` — an `@unchecked` function (the explicit opt-out): 1 + 5 = 6.
// * `sum_while` — a `while` loop over `0..s.len()` with an early `break` never taken: 1+2+3+4+5 = 15.
//
// All data is `i32` and every loop body is a recurrence or an integer store, so no kernel
// recognizer fires: this is the scalar indexing path the check guards.

fn scale(mut out: []i32, x: []i32, k: i32) {
    for i in 0..x.len() {
        out[i] = x[i] * k + 1;
    }
}

fn reverse_into(mut out: []i32, x: []i32) {
    let n: i64 = x.len();
    for i in 0..n {
        out[i] = x[n - 1 - i];
    }
}

fn window(x: []i32, start: i64, w: i64) -> i32 {
    let mut t: i32 = 0;
    for i in 0..w {
        t = t * 10 + x[start + i];
    }
    return t;
}

@unchecked
fn first_plus_last(x: []i32) -> i32 {
    let n: i64 = x.len();
    return x[0] + x[n - 1];
}

fn sum_while(s: []i32) -> i32 {
    let mut t: i32 = 0;
    let mut i: i64 = 0;
    while i < s.len() {
        if t > 1000 {
            break;
        }
        t = t + s[i];
        i = i + 1;
    }
    return t;
}

fn main() -> i32 {
    let a: [i32; 5] = [1, 2, 3, 4, 5];
    let mut b: [i32; 5] = [0; 5];
    scale(b, a, 3);
    for i in 0..5 {
        print(b[i]);
    }
    let mut r: [i32; 5] = [0; 5];
    reverse_into(r, a);
    for i in 0..5 {
        print(r[i]);
    }
    print(window(a, 1, 3));
    print(first_plus_last(a));
    print(sum_while(a));
    return 0;
}
