module tests.run.cov4_rowkernels_wide

// P12.23: the softmax-backward, RoPE and cross-entropy (forward and backward) ROW kernels at 19 and
// 37 columns. These kernels process a row 8 lanes at a time; the corpus only ever ran them at 4-8
// columns, i.e. entirely inside one vector or entirely in the scalar tail. 19 = 2 x 8 + 3 and
// 37 = 4 x 8 + 5 cross the 8-wide seam two and four times and end in a ragged tail (for RoPE the
// width is the number of rotation PAIRS per row). Dispatch is proven with `--emit=mir -O2`:
// wukong_softmax_bwd_f32, wukong_rope_f32, wukong_xent_fwd_f32 and wukong_xent_bwd_f32, two calls
// each (tests/recognizer-census.txt).
//
// The inputs deliberately round (multiples of the f32 nearest 0.1, and an inv_freq table built by
// repeated `* 0.75`), so the kernels' 8-wide reassociated dots and their polynomial exp/log/sin/cos
// genuinely differ from a sequential evaluation. Every lane is therefore EXPECT-OUT-APPROX against an
// INDEPENDENT f64 reference -- the same formulas evaluated in f64 by a scratch script kept outside
// the repository, from the exact f32 values this program builds (mirrored with f32 arithmetic) --
// never from compiler output. Each lane's tolerance is the kernel's documented f64-reference bound
// (softmax_bwd.rs and rope.rs: 1e-4; xent.rs and xent_bwd.rs: 1e-5, each as |err| <= B * max(|ref|, 1))
// converted to a relative tolerance at that lane's magnitude and rounded up to a decade; see
// DECLARED_TOLERANCES in corpus_lint.rs. The data keeps every lane at |ref| >= 0.01.
//
// Inputs (r = row, j/i/k = column):
//   softmax backward: y = (((7j + 3r) % 13) + 1) * 0.1, dy = (((5j + r) % 11) - 20) * 0.1
//                     (dy - s stays near 20, so no lane cancels);
//   RoPE:             x = ((2r + 2k + 14) % 17) - 8.5 (chosen so no output lane cancels below 0.43),
//                     inv_freq[j] = 0.75^j (f32, sequential),
//                     theta = r * inv_freq[j], rows r = 0, 1, 2;
//   cross-entropy:    logits = ((3i + 5r) % 17) * 0.05, target[r] = (7r + 4) % width.
// Each input is built with ONE rounding f32 multiply (never `a * b + c`, which the compiler may
// contract into an fma), so the reference reproduces it exactly. The outputs are poisoned first.
// EVERY lane is printed (112 + 336 + 4 + 112).

fn smbwd_19(y: [f32; 38], dy: [f32; 38], mut dx: [f32; 38]) {
    for r in 0..2 {
        let mut s: f32 = 0.0;
        for j in 0..19 { s = s + y[r * 19 + j] * dy[r * 19 + j]; }
        for i in 0..19 { dx[r * 19 + i] = y[r * 19 + i] * (dy[r * 19 + i] - s); }
    }
}

fn rope_19(x: [f32; 114], inv_freq: [f32; 19], mut out: [f32; 114]) {
    for r in 0..3 {
        for j in 0..19 {
            let theta: f32 = (r as f32) * inv_freq[j];
            let c: f32 = cos(theta);
            let s: f32 = sin(theta);
            let a: f32 = x[r * 38 + j];
            let b: f32 = x[r * 38 + j + 19];
            out[r * 38 + j] = a * c - b * s;
            out[r * 38 + j + 19] = b * c + a * s;
        }
    }
}

fn xent_19(x: [f32; 38], target: [i32; 2], mut loss: [f32; 2]) {
    for r in 0..2 {
        let mut m: f32 = x[r * 19];
        for i in 0..19 { m = fmax(m, x[r * 19 + i]); }
        let mut s: f32 = 0.0;
        for i in 0..19 { s = s + exp(x[r * 19 + i] - m); }
        loss[r] = m + log(s) - x[r * 19 + target[r]];
    }
}

fn xent_bwd_19(x: [f32; 38], target: [i32; 2], mut dx: [f32; 38]) {
    for r in 0..2 {
        let mut m: f32 = x[r * 19];
        for i in 0..19 { m = fmax(m, x[r * 19 + i]); }
        let mut z: f32 = 0.0;
        for i in 0..19 { z = z + exp(x[r * 19 + i] - m); }
        let invz: f32 = 1.0 / z;
        for i in 0..19 { dx[r * 19 + i] = exp(x[r * 19 + i] - m) * invz; }
        dx[r * 19 + target[r]] = dx[r * 19 + target[r]] - 1.0;
    }
}

fn smbwd_37(y: [f32; 74], dy: [f32; 74], mut dx: [f32; 74]) {
    for r in 0..2 {
        let mut s: f32 = 0.0;
        for j in 0..37 { s = s + y[r * 37 + j] * dy[r * 37 + j]; }
        for i in 0..37 { dx[r * 37 + i] = y[r * 37 + i] * (dy[r * 37 + i] - s); }
    }
}

fn rope_37(x: [f32; 222], inv_freq: [f32; 37], mut out: [f32; 222]) {
    for r in 0..3 {
        for j in 0..37 {
            let theta: f32 = (r as f32) * inv_freq[j];
            let c: f32 = cos(theta);
            let s: f32 = sin(theta);
            let a: f32 = x[r * 74 + j];
            let b: f32 = x[r * 74 + j + 37];
            out[r * 74 + j] = a * c - b * s;
            out[r * 74 + j + 37] = b * c + a * s;
        }
    }
}

fn xent_37(x: [f32; 74], target: [i32; 2], mut loss: [f32; 2]) {
    for r in 0..2 {
        let mut m: f32 = x[r * 37];
        for i in 0..37 { m = fmax(m, x[r * 37 + i]); }
        let mut s: f32 = 0.0;
        for i in 0..37 { s = s + exp(x[r * 37 + i] - m); }
        loss[r] = m + log(s) - x[r * 37 + target[r]];
    }
}

fn xent_bwd_37(x: [f32; 74], target: [i32; 2], mut dx: [f32; 74]) {
    for r in 0..2 {
        let mut m: f32 = x[r * 37];
        for i in 0..37 { m = fmax(m, x[r * 37 + i]); }
        let mut z: f32 = 0.0;
        for i in 0..37 { z = z + exp(x[r * 37 + i] - m); }
        let invz: f32 = 1.0 / z;
        for i in 0..37 { dx[r * 37 + i] = exp(x[r * 37 + i] - m) * invz; }
        dx[r * 37 + target[r]] = dx[r * 37 + target[r]] - 1.0;
    }
}

fn main() -> i32 {
    // ---- width 19
    let mut y19: [f32; 38] = [0.0; 38];
    let mut dy19: [f32; 38] = [0.0; 38];
    let mut lg19: [f32; 38] = [0.0; 38];
    for r in 0..2 {
        for j in 0..19 {
            y19[r * 19 + j] = ((((j * 7 + r * 3) % 13) + 1) as f32) * 0.1;
            dy19[r * 19 + j] = ((((j * 5 + r) % 11) - 20) as f32) * 0.1;
            lg19[r * 19 + j] = (((j * 3 + r * 5) % 17) as f32) * 0.05;
        }
    }
    let mut t19: [i32; 2] = [0; 2];
    for r in 0..2 { t19[r] = (r * 7 + 4) % 19; }
    let mut rx19: [f32; 114] = [0.0; 114];
    for r in 0..3 {
        for k in 0..38 { rx19[r * 38 + k] = (((r * 2 + k * 2 + 14) % 17) as f32) - 8.5; }
    }
    let mut fr19: [f32; 19] = [0.0; 19];
    let mut f19: f32 = 1.0;
    for j in 0..19 {
        fr19[j] = f19;
        f19 = f19 * 0.75;
    }
    let mut sdx19: [f32; 38] = [-1000.0; 38];
    let mut ro19: [f32; 114] = [-1000.0; 114];
    let mut ls19: [f32; 2] = [-1000.0; 2];
    let mut xd19: [f32; 38] = [-1000.0; 38];
    smbwd_19(y19, dy19, sdx19);
    rope_19(rx19, fr19, ro19);
    xent_19(lg19, t19, ls19);
    xent_bwd_19(lg19, t19, xd19);
    // ---- width 37
    let mut y37: [f32; 74] = [0.0; 74];
    let mut dy37: [f32; 74] = [0.0; 74];
    let mut lg37: [f32; 74] = [0.0; 74];
    for r in 0..2 {
        for j in 0..37 {
            y37[r * 37 + j] = ((((j * 7 + r * 3) % 13) + 1) as f32) * 0.1;
            dy37[r * 37 + j] = ((((j * 5 + r) % 11) - 20) as f32) * 0.1;
            lg37[r * 37 + j] = (((j * 3 + r * 5) % 17) as f32) * 0.05;
        }
    }
    let mut t37: [i32; 2] = [0; 2];
    for r in 0..2 { t37[r] = (r * 7 + 4) % 37; }
    let mut rx37: [f32; 222] = [0.0; 222];
    for r in 0..3 {
        for k in 0..74 { rx37[r * 74 + k] = (((r * 2 + k * 2 + 14) % 17) as f32) - 8.5; }
    }
    let mut fr37: [f32; 37] = [0.0; 37];
    let mut f37: f32 = 1.0;
    for j in 0..37 {
        fr37[j] = f37;
        f37 = f37 * 0.75;
    }
    let mut sdx37: [f32; 74] = [-1000.0; 74];
    let mut ro37: [f32; 222] = [-1000.0; 222];
    let mut ls37: [f32; 2] = [-1000.0; 2];
    let mut xd37: [f32; 74] = [-1000.0; 74];
    smbwd_37(y37, dy37, sdx37);
    rope_37(rx37, fr37, ro37);
    xent_37(lg37, t37, ls37);
    xent_bwd_37(lg37, t37, xd37);
    for k in 0..38 { print(sdx19[k]); }
    for k in 0..74 { print(sdx37[k]); }
    for k in 0..114 { print(ro19[k]); }
    for k in 0..222 { print(ro37[k]); }
    for r in 0..2 { print(ls19[r]); }
    for r in 0..2 { print(ls37[r]); }
    for k in 0..38 { print(xd19[k]); }
    for k in 0..74 { print(xd37[k]); }
    return 0;
}
