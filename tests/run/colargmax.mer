// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 1
// EXPECT-OUT: 2
// EXPECT-OUT: 1
// EXPECT-OUT: 0
// EXPECT-OUT: 0
// EXPECT-OUT: 1
// EXPECT-OUT: 2
// EXPECT-OUT: 1
module tests.run.colargmax

// Per-COLUMN argmax / argmin returning the ROW index (axis-0 top-1): out[j] = {argmax,argmin}_i x[i,j],
// lowest row index wins on a value tie. The recognizer folds each [R=3,C=4] nest to one
// mercury_colarg{max,min}_i32 call — the STRIDED column-outer (value,index) scan gcc/rustc leave fully
// scalar (the column-reduction lever). A pure selection (no reassociation), so interp == native is
// bit-exact, and out is an i32 buffer of length C.
fn main() -> i32 {
    let x: [f32; 12] = [1.0, 5.0, 2.0, 8.0,   // row 0
                        4.0, 3.0, 9.0, 0.0,   // row 1
                        2.0, 7.0, 1.0, 6.0];  // row 2
    // col 0 [1,4,2]->max@1 min@0;  col 1 [5,3,7]->max@2 min@1;
    // col 2 [2,9,1]->max@1 min@2;  col 3 [8,0,6]->max@0 min@1
    let mut amax: [i32; 4] = [0; 4];
    let mut amin: [i32; 4] = [0; 4];

    for j in 0..4 {
        let mut bv: f32 = x[j];
        let mut bi: i32 = 0;
        for i in 1..3 { if x[i * 4 + j] > bv { bv = x[i * 4 + j]; bi = i; } }
        amax[j] = bi;
    }
    for j in 0..4 {
        let mut bv: f32 = x[j];
        let mut bi: i32 = 0;
        for i in 1..3 { if x[i * 4 + j] < bv { bv = x[i * 4 + j]; bi = i; } }
        amin[j] = bi;
    }
    for k in 0..4 { print(amax[k]); }
    for k in 0..4 { print(amin[k]); }
    return 0;
}
