// EXPECT-OUT: 18 24 30 36 42 48 54 60 66 72 78 84 90 96 102 108 114 120 126 132 138 144 150 156 162 168 174 180 186 192 -120 -114
// EXPECT-OUT: -108 -102 -96 -90 -84 -78 -72 -66 -60 -54 -48 -42 -36 -30 -24 -18 -12 -6 0 6 12 18 24 30 36 42 48 54 60 66 72 78
// EXPECT-OUT: 84 90 96 102 108
module tests.run.vec256_opt_aliased_reload

// A 256-bit kernel the optimizer builds (-O2) that stores two slices and then RELOADS the first,
// called once with the two slices the SAME buffer. `k` stores `o[i]`, then `p[i]`, then reads
// `o[i]` again. The optimizer cannot prove `o` and `p` apart, so the reload survives CSE and the
// loop is guarded at run time. The guard admits two EQUAL bases, because every access sits at one
// element. With `o` and `p` one buffer, the reload names the element `p[i]` just wrote, so it
// reads v + 1, and the machine code sees that by re-reading memory. The interpreter's reference
// evaluator used to serve the reload from `o`'s own earlier store. It printed 6v for every kernel
// lane of the second line below, where the scalar loop prints 3v + 3.
//
// `k` calls itself when `d > 0` (never, here), so the inliner keeps it out of `main` and its
// trip a runtime value. n = 2053: 256 kernel groups of 8, one 128-bit group of 4, one scalar
// lane. Every lane is printed, 32 to a line.
//
// v = (i % 53) - 20 throughout (small integers, so every f32 operation below is exact). Derived
// by hand from the scalar loop:
//   k(a, b, b, y):  b[i] = 2v, then b[i] = v + 1 (the same element), then y[i] = b[i] * 3.
//                   Printed: b -> v + 1, y -> 3v + 3.
//   k(a, o, p, z):  o[i] = 2v, p[i] = v + 1, z[i] = o[i] * 3.
//                   Printed: o -> 2v, p -> v + 1, z -> 6v.

@unchecked
fn k(x: []f32, mut o: []f32, mut p: []f32, mut y: []f32, n: i64, d: i64) {
    if d > 0 {
        k(x, o, p, y, n, d - 1);
        return;
    }
    let mut i: i64 = 0;
    while i < n {
        o[i] = x[i] * 2.0;
        p[i] = x[i] + 1.0;
        y[i] = o[i] * 3.0;
        i = i + 1;
    }
}

fn show(v: []f32, n: i64) {
    let mut i: i64 = 0;
    while i < n {
        print_raw(v[i] as i64);
        if (i + 1) % 32 == 0 || i + 1 == n {
            print_raw("\n");
        } else {
            print_raw(" ");
        }
        i = i + 1;
    }
}

fn main() -> i32 {
    let n: i64 = 2053;
    let mut a: []f32 = alloc_f32(n);
    let mut b: []f32 = alloc_f32(n);
    let mut y: []f32 = alloc_f32(n);
    let mut o: []f32 = alloc_f32(n);
    let mut p: []f32 = alloc_f32(n);
    let mut z: []f32 = alloc_f32(n);
    let mut i: i64 = 0;
    while i < n {
        a[i] = (i % 53 - 20) as f32;
        i = i + 1;
    }
    k(a, b, b, y, n, 0);
    k(a, o, p, z, n, 0);
    show(b, n);
    show(y, n);
    show(o, n);
    show(p, n);
    show(z, n);
    free(a);
    free(b);
    free(y);
    free(o);
    free(p);
    free(z);
    return 0;
}
