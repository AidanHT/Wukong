// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 155
// EXPECT-OUT: -100
module tests.run.parallel_reduce_minmax

// `@parallel` max/min reductions dispatch to the multicore deterministic reduction kernel
// (mercury_sreduce_f32_parallel, RED_MAX/RED_MIN): the per-tensor max/min that softmax stability and
// dynamic int8 quantization scale-computation need. The kernel folds by fmax/fmin over fixed chunks
// and the outer combine is a compare+select, so serial == parallel == interpreter bit-for-bit (the
// mercury_bench gate proves it); this pins the values and opt-invariance. Max/min pick an actual
// element, so the values are exact.

@parallel
fn maxv(x: [f32; 256], mut o: [f32; 1]) {
    let mut m: f32 = x[0];
    for k in 0..256 { m = fmax(m, x[k]); }
    o[0] = m;
}

@parallel
fn minv(x: [f32; 256], mut o: [f32; 1]) {
    let mut m: f32 = x[0];
    for k in 0..256 { m = fmin(m, x[k]); }
    o[0] = m;
}

fn main() -> i32 {
    let mut x: [f32; 256] = [0.0; 256];
    for i in 0..256 { x[i] = (i as f32) - 100.0; } // -100 .. 155
    let mut o: [f32; 1] = [0.0; 1];
    maxv(x, o); print((o[0]) as i32); // 155
    minv(x, o); print((o[0]) as i32); // -100
    return 0;
}
