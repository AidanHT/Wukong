// RUN: --run
// EXPECT-EXIT: 0
// RMSNorm x * rsqrt(ms), rows 0..2 (16 lanes per row)
// EXPECT-OUT-VALUES: 1.5 -1.5 1 1.5 -1 -1 -1 -0.5 -0.5 -0.5 -1 1 0.5 0.5 1 -1
// EXPECT-OUT-VALUES: -0.5 0.25 -1.75 0.25 1 -1 -0.5 1.75 1 -1.75 0.5 0.25 1 -0.25 0.5 -1.25
// EXPECT-OUT-VALUES: 0.875 -0.875 -0.875 1.125 -0.25 -1.75 -0.375 -0.625 0.25 -0.5 -0.25 -1.375 -0.375 -1.75 -1.75 -0.5
// affine RMSNorm x * rsqrt(ms) * g, rows 0..2
// EXPECT-OUT-VALUES: 1.5 -0.75 2 -1.5 -0.75 -0.25 -3 0.25 -0.625 -0.0625 2 1.5 0.5 -0.375 0.875 -4
// EXPECT-OUT-VALUES: -0.5 0.125 -3.5 -0.25 0.75 -0.25 -1.5 -0.875 1.25 -0.21875 -1 0.375 1 0.1875 0.4375 -5
// EXPECT-OUT-VALUES: 0.875 -0.4375 -1.75 -1.125 -0.1875 -0.4375 -1.125 0.3125 0.3125 -0.0625 0.5 -2.0625 -0.375 1.3125 -1.53125 -2
module tests.run.cov4_par_norm

// P12.4: wukong_norm_f32_parallel and wukong_norm_affine_f32_parallel. A `@parallel` function whose
// body is one batched-norm loop is intercepted before the generic outliner (`is_batched_norm_fn`)
// and lowered with `parallel_fn` set, so the batched RMSNorm arm emits the `_parallel` kernel; the
// learned per-column scale `g[i]` selects the affine twin (`--emit=mir -O2`, census).
//
// Shape [3, 16]: three rows so the forced-parallel lane forks over rows; 16 columns so the kernel's
// row mean `ss * (1/16)` is an exact power-of-two scale.
//
// Exactness by construction, from the scalar loop `inv = rsqrt(s / 16)` (no epsilon):
// row r is an integer vector with sum of squares 16 * 4^(r+1), so s / 16 = 4^(r+1) and
// inv = 2^-(r+1) EXACTLY
// (the kernel's `1/sqrt` of a power of four rounds nowhere either). Each lane is then x * inv, and
// x * inv * g with every g a short dyadic -- all exact in f32. The rows were drawn by a seeded search
// for NONZERO integer vectors with the required sum of squares; the property is easy to re-check by
// hand: row 0: sum of squares 64, row 1: 256, row 2: 1024. No entry is zero on purpose: the fused
// affine writeback is `fma(x * inv, g, +0.0)` when there is no beta, which turns the source loop's
// `0 * inv * g = -0` (for a negative g) into +0 -- a sign-of-zero divergence from the loop the
// recognizer replaced, reported separately with a reproducer rather than pinned here.
// EVERY lane is printed (2 x 48).

@parallel
fn rms(mut x: [f32; 48]) {
    for r in 0..3 {
        let mut s: f32 = 0.0;
        for i in 0..16 { s = s + x[r * 16 + i] * x[r * 16 + i]; }
        let inv: f32 = rsqrt(s / 16.0);
        for i in 0..16 { x[r * 16 + i] = x[r * 16 + i] * inv; }
    }
}

@parallel
fn rms_affine(mut x: [f32; 48], g: [f32; 16]) {
    for r in 0..3 {
        let mut s: f32 = 0.0;
        for i in 0..16 { s = s + x[r * 16 + i] * x[r * 16 + i]; }
        let inv: f32 = rsqrt(s / 16.0);
        for i in 0..16 { x[r * 16 + i] = x[r * 16 + i] * inv * g[i]; }
    }
}

fn main() -> i32 {
    let x0: [f32; 48] = [
        3.0, -3.0, 2.0, 3.0, -2.0, -2.0, -2.0, -1.0, -1.0, -1.0, -2.0, 2.0, 1.0, 1.0, 2.0, -2.0,
        -2.0, 1.0, -7.0, 1.0, 4.0, -4.0, -2.0, 7.0, 4.0, -7.0, 2.0, 1.0, 4.0, -1.0, 2.0, -5.0,
        7.0, -7.0, -7.0, 9.0, -2.0, -14.0, -3.0, -5.0, 2.0, -4.0, -2.0, -11.0, -3.0, -14.0, -14.0, -4.0,
    ];
    let g: [f32; 16] = [
        1.0, 0.5, 2.0, -1.0, 0.75, 0.25, 3.0, -0.5, 1.25, 0.125, -2.0, 1.5, 1.0, -0.75, 0.875, 4.0,
    ];
    let mut a: [f32; 48] = [0.0; 48];
    let mut b: [f32; 48] = [0.0; 48];
    for k in 0..48 { a[k] = x0[k]; b[k] = x0[k]; }
    rms(a);
    rms_affine(b, g);
    for k in 0..48 { print(a[k]); }
    for k in 0..48 { print(b[k]); }
    return 0;
}
