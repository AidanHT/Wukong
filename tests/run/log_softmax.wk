// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: -458
// EXPECT-OUT: -1458
// EXPECT-OUT: -15458
// EXPECT-OUT: 632
module tests.run.log_softmax

// Numerically-stable log-softmax — the cross-entropy / negative-log-likelihood primitive, the real
// reason to want a fast `log`. It composes every transcendental advantage in one pass:
//   logsoftmax(x)[i] = (x[i] - m) - log(sum_j exp(x[j] - m)),   m = max_j x[j]
// the fmax reduction, the vectorized exp, the sum reduction, one scalar log, and a vectorized
// subtract. The wukong_bench gate proves the whole chain matches the interpreter bit-for-bit.
fn main() -> i32 {
    let mut x: [f32; 16] = [0.0; 16];
    let mut out: [f32; 16] = [0.0; 16];
    for i in 0..16 {
        x[i] = (i as f32) - 8.0; // -8 .. 7
    }

    // 1) row max (fmax reduction, vectorized)
    let mut m: f32 = x[0];
    for i in 0..16 {
        m = fmax(m, x[i]);
    }

    // 2) sum of exp(x - m)  (vectorized exp + sum reduction)
    let mut s: f32 = 0.0;
    for i in 0..16 {
        s += exp(x[i] - m);
    }

    // 3) log-sum-exp, then log-softmax = (x - m) - log(s)   (one scalar log; vectorized subtract)
    let lse: f32 = log(s);
    for i in 0..16 {
        out[i] = (x[i] - m) - lse;
    }

    // log-prob of the max logit, and exp() of it == the softmax probability (cross-checks
    // softmax.wk's p(max) == 632). The least likely class is far more negative.
    print((out[15] * 1000.0) as i32); // log p(max)
    print((out[14] * 1000.0) as i32); // log p(2nd)
    print((out[0] * 1000.0) as i32); // log p(min), very negative
    print((exp(out[15]) * 1000.0) as i32); // p(max) ~ 632
    return 0;
}
