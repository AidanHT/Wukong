// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 0
// EXPECT-OUT: 0
// EXPECT-OUT: 1
// EXPECT-OUT: 1
// EXPECT-OUT: 2
// EXPECT-OUT: 2
// EXPECT-OUT: 3
// EXPECT-OUT: 6
// EXPECT-OUT: 9
// EXPECT-OUT: -2
// EXPECT-OUT: -1
// EXPECT-OUT: 0
// EXPECT-OUT: 1
// EXPECT-OUT: 2
// EXPECT-OUT: 1
// EXPECT-OUT: 11
// EXPECT-OUT: 21
// EXPECT-OUT: 0
// EXPECT-OUT: 3
// EXPECT-OUT: 4
// EXPECT-OUT: 5
module tests.run.closure_wide_counter

// A `for` counter whose end bound is wider than its start (`for i in 0..n` with `n: i64`) is
// stored at the wider type. A closure that captures it takes it at that width -- a copy of the
// wide value when it only reads it, a pointer to the wide slot when it writes it -- so it sees and
// changes the counter exactly as the loop body does. (A copy at the start's width was a call the
// MIR verifier rejected; a pointer at it stored 4 bytes into the 8-byte slot, so natively `i = -2`
// left 4294967294 in the counter while the interpreter printed -2.) Expectations by hand:
//   each pass of i in 0..3 runs the closure for j in 0..2: it prints i (0 0 1 1 2 2) and adds
//   (j + 1) * (i + 1) to hist[i], 1 * (i + 1) + 2 * (i + 1):                        3 6 9
//   a closure setting i = -2 once, in the first pass: the loop goes on from -2 -1 0 1 2
//   a `let`-bound closure copying i and printing i * 10 + 1 per pass:              1 11 21
//   a `let`-bound closure that jumps i from 1 to 3, for i in 0..6:                  0 3 4 5

fn each(f: fn(i32), n: i32) {
    for j in 0..n {
        f(j);
    }
}

fn main() -> i32 {
    let n: i64 = 3;

    let mut hist: [i32; 3] = [0; 3];
    for i in 0..n {
        each(|j| {
            print(i);
            let w = i;
            hist[w] += (j + 1) * (w + 1);
        }, 2);
    }
    for k in 0..3 {
        print(hist[k]);
    }

    let mut done = false;
    for i in 0..n {
        each(|_j| {
            if !done {
                done = true;
                i = -2;
            }
        }, 1);
        print(i);
    }

    for i in 0..n {
        let show = |j: i32| {
            let w = i;
            print(w * 10 + j);
        };
        show(1);
    }

    let six: i64 = 6;
    for i in 0..six {
        let jump = |_j: i32| {
            if i == 1 {
                i = 3;
            }
        };
        jump(0);
        print(i);
    }
    return 0;
}
