// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 6
// EXPECT-OUT: 6
// EXPECT-OUT: 12
// EXPECT-OUT: 6
// EXPECT-OUT: 12
// EXPECT-OUT: 6
// EXPECT-OUT: 12
// EXPECT-OUT: 6
// EXPECT-OUT: 2
// EXPECT-OUT: 2
// EXPECT-OUT: 6
// EXPECT-OUT: 6
// EXPECT-OUT: 6
// EXPECT-OUT: 6
// EXPECT-OUT: 6
// EXPECT-OUT: 6
// EXPECT-OUT: 4
// EXPECT-OUT: 2
// EXPECT-OUT: 6
// EXPECT-OUT: 2
// EXPECT-OUT: 2
// EXPECT-OUT: 2
// EXPECT-OUT: 2
// EXPECT-OUT: 2
module tests.run.alias_hoisted_coefficient

// The streaming elementwise kernels take their scale as a SCALAR evaluated once, ahead of the call,
// where the source loop re-reads it on every iteration. When that scalar is read from a buffer the
// loop writes, the first store changes what every later iteration reads, and a kernel holding the
// pre-loop value computes a different program -- on BOTH backends alike, so no differential gate can
// see it. The run-time overlap guard ranges buffer operands only, so such a read must keep the loop.
//
// Every expectation is the scalar loop by hand; all values are small integers, exact in f32.
//
//   head(x, out) with out = 2 everywhere, x = 3 1 2 1 2 1 2 1:
//     out[0] = 2*3 = 6 lands first, and every later lane scales by the NEW out[0]
//                                                   -> 6 6 12 6 12 6 12 6   (a hoisted 2 gives 6 2 4 2 ...)
//   scale(s, x, out) called scale(buf, x, buf), buf = 2 everywhere, x = 1 1 3 1 1 1 1 1:
//     lanes 0..2 read the old s[2] = 2; out[2] = 2*3 = 6 IS s[2], so lanes 3..7 read 6
//                                                   -> 2 2 6 6 6 6 6 6      (a hoisted 2 gives 2 2 6 2 2 ...)
//   scale(w, x2, o) on disjoint buffers, w = 2, x2 = 2 1 3 1 1 1 1 1 -> 4 2 6 2 2 2 2 2

fn head(x: [f32; 8], mut out: [f32; 8]) {
    for j in 0..8 {
        out[j] = out[0] * x[j];
    }
}

fn scale(s: [f32; 8], x: [f32; 8], mut out: [f32; 8]) {
    for j in 0..8 {
        out[j] = s[2] * x[j];
    }
}

fn main() -> i32 {
    let mut x: [f32; 8] = [1.0; 8];
    x[0] = 3.0;
    x[2] = 2.0;
    x[4] = 2.0;
    x[6] = 2.0;
    let mut out: [f32; 8] = [2.0; 8];
    head(x, out);
    for j in 0..8 {
        print(out[j] as i32);
    }

    let mut y: [f32; 8] = [1.0; 8];
    y[2] = 3.0;
    let mut buf: [f32; 8] = [2.0; 8];
    scale(buf, y, buf);
    for j in 0..8 {
        print(buf[j] as i32);
    }

    let mut w: [f32; 8] = [2.0; 8];
    let mut x2: [f32; 8] = [1.0; 8];
    x2[0] = 2.0;
    x2[2] = 3.0;
    let mut o: [f32; 8] = [0.0; 8];
    scale(w, x2, o);
    for j in 0..8 {
        print(o[j] as i32);
    }
    return 0;
}
