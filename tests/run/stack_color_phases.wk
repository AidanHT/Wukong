// EXPECT-OUT-VALUES: 1454 1453.5 1453 1452.5 1452 1451.5 1451 1450.5
// keep[i] = 3i + 1
// EXPECT-OUT-VALUES: 1 4 7 10 13 16 19 22
module tests.run.stack_color_phases

// Stack-slot coloring (N86): the native backend lets allocas whose lifetimes never overlap share
// one frame slot. This program has six arrays in four lifetime relations, so a coloring that
// shares the wrong pair corrupts lanes that are printed here, every one of them:
//
// - `keep` is written first and read last, so it is live across everything and shares with
//   nothing;
// - `a` (phase 1) and `b` (phase 2) are never live together, so they may share one slot;
// - `d` is dead once its lanes are printed, before `e` is filled, so those two may share;
// - `c` is filled from `b`, updated from `d` and read to fill `e`: it overlaps all three and must
//   stay apart.
//
// Expected values, from the scalar definition: a[i] = i/2, so s1 = (0 + ... + 63) / 2 = 1008;
// b[i] = 1008 - i; c[i] = b[63 - i] + 1 = 946 + i; d[i] = 2 * c[i] = 1892 + 2i; the updated
// c[i] = (946 + i) + d[63 - i] = 946 + i + 1892 + 126 - 2i = 2964 - i; e[i] = c[i] / 2 =
// 1482 - i/2. keep[i] = 3i + 1. Every value is exact in f32.
fn main() -> i32 {
    let mut keep: [i32; 8] = [0; 8];
    for i in 0..8 {
        keep[i] = i * 3 + 1;
    }

    let mut a: [f32; 64] = [0.0; 64];
    for i in 0..64 {
        a[i] = i as f32 * 0.5;
    }
    let mut s1: f32 = 0.0;
    for i in 0..64 {
        s1 = s1 + a[i];
    }

    let mut b: [f32; 64] = [0.0; 64];
    for i in 0..64 {
        b[i] = s1 - i as f32;
    }

    let mut c: [f32; 64] = [0.0; 64];
    for i in 0..64 {
        c[i] = b[63 - i] + 1.0;
    }
    let mut d: [f32; 64] = [0.0; 64];
    for i in 0..64 {
        d[i] = c[i] * 2.0;
    }
    for i in 0..64 {
        c[i] = c[i] + d[63 - i];
    }

    for i in 0..64 {
        print(c[i]);
    }
    for i in 0..64 {
        print(d[i]);
    }

    let mut e: [f32; 64] = [0.0; 64];
    for i in 0..64 {
        e[i] = c[i] * 0.5;
    }
    for i in 0..64 {
        print(e[i]);
    }
    for i in 0..8 {
        print(keep[i]);
    }
    return 0;
}
