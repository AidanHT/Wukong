// e[i] = 1482 - i/2
// EXPECT-OUT-VALUES: 1482 1481.5 1481 1480.5 1480 1479.5 1479 1478.5
// EXPECT-OUT-VALUES: 1478 1477.5 1477 1476.5 1476 1475.5 1475 1474.5
// EXPECT-OUT-VALUES: 1474 1473.5 1473 1472.5 1472 1471.5 1471 1470.5
