// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 40
// EXPECT-OUT: 80
// EXPECT-OUT: 120
module tests.run.gemv_f32

/// GEMV `y[3] = A[3,4]·x[4]` (matrix-times-vector — the decode-time attention/projection shape, batch
/// 1), written the idiomatic per-row dot way. The compiler recognizes the 2-deep nest and dispatches to
/// the `wukong_sgemv` microkernel; under `--run` the interpreter marshals its memory and calls that
/// same kernel, so this exercises the GEMV-dispatch path end-to-end and gates interp == native.
///
/// It used to print `y[0]` and `y[2]`, skipping `y[1]` — two of three outputs on a recognizer
/// fixture that no differential or invariance gate can inspect. All three are printed now, and they
/// are three distinct values, so a permuted or partially-written `y` fails.
///
/// WHERE THE EXPECTED VALUES COME FROM (scalar semantics, never a compiler run). A's rows are
/// [0, 0.5, 1.0, 1.5], [2.0, 2.5, 3.0, 3.5], [4.0, 4.5, 5.0, 5.5] and x is [-1, 0, 1, 2]. Every
/// product and partial sum is exact in f32, so the scale-by-10 print rounds nothing:
///   y[0] = 0·(-1) + 0.5·0 + 1.0·1 + 1.5·2  =  4.0 -> 40
///   y[1] = 2·(-1) + 2.5·0 + 3.0·1 + 3.5·2  =  8.0 -> 80
///   y[2] = 4·(-1) + 4.5·0 + 5.0·1 + 5.5·2  = 12.0 -> 120
fn main() -> i32 {
    let mut a: [f32; 12] = [0.0; 12];
    let mut x: [f32; 4] = [0.0; 4];
    let mut y: [f32; 3] = [0.0; 3];
    let mut i: i32 = 0;
    while i < 12 { a[i] = (i as f32) * 0.5; i = i + 1; }
    let mut j: i32 = 0;
    while j < 4 { x[j] = (j as f32) - 1.0; j = j + 1; }

    for ii in 0..3 {
        let mut s: f32 = 0.0;
        for jj in 0..4 { s = s + a[ii * 4 + jj] * x[jj]; }
        y[ii] = s;
    }

    print((y[0] * 10.0) as i32);
    print((y[1] * 10.0) as i32);
    print((y[2] * 10.0) as i32);
    return 0;
}
