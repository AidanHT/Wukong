// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 1024
// EXPECT-OUT: 300
// EXPECT-OUT: 1414
// EXPECT-OUT: 125
// EXPECT-OUT: 100
// EXPECT-OUT: 800
// EXPECT-OUT: 2700
module tests.run.pow

// pow(x, y) = exp(y * log(x)), composing the exp and log polynomials — so it vectorizes and is
// bit-identical across backends for free. Defined for x > 0. The gate proves native == interp.
fn main() -> i32 {
    // scalar
    print((pow(2.0, 10.0) + 0.5) as i32); // 2^10 = 1024
    print((pow(9.0, 0.5) * 100.0) as i32); // sqrt(9) = 3 -> 300
    print((pow(2.0, 0.5) * 1000.0) as i32); // sqrt(2) ~ 1.4142 -> 1414
    print((pow(5.0, 3.0) + 0.5) as i32); // 5^3 = 125

    // vectorized: out[i] = x[i]^3
    let mut x: [f32; 64] = [0.0; 64];
    let mut out: [f32; 64] = [0.0; 64];
    for i in 0..64 {
        x[i] = (i as f32) * 0.1 + 0.5; // 0.5 .. 6.8
    }
    for i in 0..64 {
        out[i] = pow(x[i], 3.0);
    }
    print((out[5] * 100.0) as i32); // 1.0^3 = 1 -> 100
    print((out[15] * 100.0) as i32); // 2.0^3 = 8 -> 800
    print((out[25] * 100.0) as i32); // 3.0^3 = 27 -> 2700
    return 0;
}
