// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 14401
// EXPECT-OUT: 16265
module tests.run.kd_loss

// Batched soft-label cross-entropy (knowledge-distillation loss) out[r] = Σ_i q[r,i]·(lse − x[r,i]),
// lse = m + log(Σexp(x[r,·]−m)) — the hard-label cross-entropy generalized to a full target
// distribution q. The recognizer folds the [R=2,C=4] nest to one wukong_kd_loss_f32 call (the
// expf/logf reductions gcc/rustc keep scalar). Reductions reassociate (documented exception); interp ==
// native holds.
fn main() -> i32 {
    let x: [f32; 8] = [1.0, 2.0, 3.0, 4.0, 2.0, 1.0, 0.0, 1.0];
    let q: [f32; 8] = [0.1, 0.2, 0.3, 0.4, 0.25, 0.25, 0.25, 0.25];
    let mut out: [f32; 2] = [0.0; 2];

    for r in 0..2 {
        let mut m: f32 = x[r * 4];
        for i in 0..4 { m = fmax(m, x[r * 4 + i]); }
        let mut z: f32 = 0.0;
        for i in 0..4 { z = z + exp(x[r * 4 + i] - m); }
        let lse: f32 = m + log(z);
        let mut s: f32 = 0.0;
        for i in 0..4 { s = s + q[r * 4 + i] * (lse - x[r * 4 + i]); }
        out[r] = s;
    }
    for k in 0..2 { print((out[k] * 10000.0) as i32); }
    return 0;
}
