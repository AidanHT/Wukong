// max, columns 0..39
// EXPECT-OUT-VALUES: -1 -1 -2 1 3 2 3 6 6 -4
// EXPECT-OUT-VALUES: -1 1 0 1 4 4 3 6 -1 -2
// EXPECT-OUT-VALUES: -1 2 2 1 4 6 5 -3 0 0
// EXPECT-OUT-VALUES: -1 2 4 3 4 7 -2 -3 0 2
