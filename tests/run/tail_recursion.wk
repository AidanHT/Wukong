// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 21
// EXPECT-OUT: 1
// EXPECT-OUT: 9
// EXPECT-OUT: 3628800
// EXPECT-OUT: -4442925868394654895
// EXPECT-OUT: 55
// EXPECT-OUT: 11
// EXPECT-OUT: 3
// EXPECT-OUT: 2
// EXPECT-OUT: 1
// EXPECT-OUT: 55
module tests.run.tail_recursion

// Tail calls and integer accumulator recursion, which `wukong_opt::tre` turns into loops from -O1:
// `gcd` and `countdown` call themselves in tail position (`countdown` is void and prints before its
// call, so the loop must keep the side effects in order); `fact`, `pw`, `sum` and `xors` return
// `op(self(..), x)` for an integer `*`, `+` or `^`, which the rewrite accumulates in a parameter
// (exact because wrapping integer `*`, `+` and `^` are associative and commutative -- `pw` wraps,
// and must wrap to the same value); `fib` keeps one real call and loops on the other. Every
// recursion stays within ten levels at -O0 so the program is safe on every backend's call stack.
//
// Expected values by hand:
//   gcd(1071, 462): 1071 = 2*462 + 147, 462 = 3*147 + 21, 147 = 7*21 -> 21
//   gcd(17, 5): 17 = 3*5 + 2, 5 = 2*2 + 1 -> 1;  gcd(0, 9) = gcd(9, 0) = 9
//   10! = 3628800
//   1000003^4 = 1000012000054000108000081, mod 2^64 read as i64 = -4442925868394654895
//   1 + 2 + .. + 10 = 55;  1 ^ 2 ^ .. ^ 10 = 11 (for n = 2 mod 4 the prefix xor is n + 1)
//   countdown(3) prints 3, 2, 1;  fib(10) = 55

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 {
        return a;
    }
    return gcd(b, a % b);
}

fn fact(n: i64) -> i64 {
    if n < 2 {
        return 1;
    }
    return n * fact(n - 1);
}

fn pw(b: i64, e: i64) -> i64 {
    if e == 0 {
        return 1;
    }
    return b * pw(b, e - 1);
}

fn sum(n: i64) -> i64 {
    if n == 0 {
        return 0;
    }
    return sum(n - 1) + n;
}

fn xors(n: i64) -> i64 {
    if n == 0 {
        return 0;
    }
    return n ^ xors(n - 1);
}

fn countdown(n: i32) {
    if n == 0 {
        return;
    }
    print(n);
    countdown(n - 1);
}

fn fib(n: i32) -> i32 {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn main() -> i32 {
    print(gcd(1071, 462));
    print(gcd(17, 5));
    print(gcd(0, 9));
    print(fact(10));
    print(pw(1000003, 4));
    print(sum(10));
    print(xors(10));
    countdown(3);
    print(fib(10));
    return 0;
}
