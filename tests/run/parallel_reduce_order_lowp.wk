// EXPECT-OUT: 1323437249
// EXPECT-OUT: 1323437249
// EXPECT-OUT: 1323437249
// EXPECT-OUT: 1237909504
// EXPECT-OUT: 1237909504
// EXPECT-OUT: 1242244032
// EXPECT-OUT: 1242244032
// EXPECT-OUT: 1242244032
// EXPECT-OUT: 1261115948
// EXPECT-OUT: 1261115948
// EXPECT-OUT: 1243587548
// EXPECT-OUT: 1243587548
module tests.run.parallel_reduce_order_lowp

// P13.7 for half-precision storage: a `@parallel` reduction over `bf16`/`f16` data has the value of
// the `f32` parallel reduction tree (tests/run/parallel_reduce_order.wk states it) applied to the
// exactly widened elements — whether it runs the half `_parallel` kernel (the `as f32` spelling),
// the compiler's chunk-buffer lowering (the uncast spelling, an `..=` range, a commuted product with
// a run-time offset), or the `f32` kernel over a widened copy. Before this, the half kernels had
// partitions of their own and the uncast spelling folded in source order, so the four columns of
// each group below were up to four different numbers.
//
// Every EXPECT-OUT is the `bits()` of a value evaluated by hand with an independent scalar model of
// the tree (exact rational arithmetic, one round-to-nearest-even per f32 operation) — never
// recorded from compiler output. A strict left fold of the same sums gives 383748896.0
// (1303837785) for bf16 and 2279654.0 (1242243992) for f16, against the tree's 383750944.0 and
// 2279664.0; at n = 100 the left fold is 2615542.75 against 2615543.0.
//
// Data (n = 20000, every value exact in its storage type — at most 8 significant bits for bf16, 11
// for f16, and in range):
//   xb[i] = s * ldexp((37i mod 101) + 0.5, (13i mod 29) - 14)   (bf16; s = -1 when 3 | i, else +1)
//   xf[i] = s * ldexp((37i mod 101) + 0.5, (13i mod 19) - 12)   (f16)
//   y[i]  = t * ldexp((11i mod 9) + 0.5, (7i mod 5) - 2)        (both; t = -1 when i mod 4 = 1)
// so the addends span 2^-15 .. 1.6e6 and the running sums round at every scale.

@parallel
fn bsum_kernel(x: []bf16, n: i64) -> f32 {
    let mut s: f32 = 0.5;
    for k in 0..n {
        s = s + (x[k] as f32);
    }
    return s;
}

@parallel
fn bsum_uncast(x: []bf16, n: i64) -> f32 {
    let mut s: f32 = 0.5;
    for k in 0..n {
        s = s + x[k];
    }
    return s;
}

@parallel
fn bsum_inclusive(x: []bf16, n: i64) -> f32 {
    let mut s: f32 = 0.5;
    for k in 0..=n - 1 {
        s += x[k] as f32;
    }
    return s;
}

@parallel
fn wsum(w: []f32, n: i64) -> f32 {
    let mut s: f32 = 0.5;
    for k in 0..n {
        s += w[k];
    }
    return s;
}

@parallel
fn bdot_kernel(x: []bf16, y: []bf16, n: i64) -> f32 {
    let mut s: f32 = 0.5;
    for k in 0..n {
        s = s + (x[k] as f32) * (y[k] as f32);
    }
    return s;
}

@parallel
fn bdot_commuted(x: []bf16, y: []bf16, n: i64, off: i64) -> f32 {
    let mut s: f32 = 0.5;
    for k in 0..n {
        s += (y[k] as f32) * (x[k + off] as f32);
    }
    return s;
}

@parallel
fn wdot(w: []f32, v: []f32, n: i64) -> f32 {
    let mut s: f32 = 0.5;
    for k in 0..n {
        s += w[k] * v[k];
    }
    return s;
}

@parallel
fn bmax_kernel(x: []bf16, n: i64) -> f32 {
    let mut m: f32 = -1.0e30;
    for k in 0..n {
        m = fmax(m, (x[k] as f32));
    }
    return m;
}

@parallel
fn bmax_inclusive(x: []bf16, n: i64) -> f32 {
    let mut m: f32 = -1.0e30;
    for k in 0..=n - 1 {
        m = fmax(m, (x[k] as f32));
    }
    return m;
}

@parallel
fn hsum_kernel(x: []f16, n: i64) -> f32 {
    let mut s: f32 = 0.5;
    for k in 0..n {
        s = s + (x[k] as f32);
    }
    return s;
}

@parallel
fn hsum_uncast(x: []f16, n: i64) -> f32 {
    let mut s: f32 = 0.5;
    for k in 0..n {
        s = s + x[k];
    }
    return s;
}

@parallel
fn hdot_kernel(x: []f16, y: []f16, n: i64) -> f32 {
    let mut s: f32 = 0.5;
    for k in 0..n {
        s = s + (x[k] as f32) * (y[k] as f32);
    }
    return s;
}

@parallel
fn hdot_commuted(x: []f16, y: []f16, n: i64, off: i64) -> f32 {
    let mut s: f32 = 0.5;
    for k in 0..n {
        s += (y[k] as f32) * (x[k + off] as f32);
    }
    return s;
}

fn main() -> i32 {
    let n: i64 = 20000;
    let mut xb: []bf16 = alloc_bf16(n);
    let mut yb: []bf16 = alloc_bf16(n);
    let mut xf: []f16 = alloc_f16(n);
    let mut yf: []f16 = alloc_f16(n);
    let mut wb: []f32 = alloc_f32(n);
    let mut vb: []f32 = alloc_f32(n);
    let mut wf: []f32 = alloc_f32(n);
    let mut i: i64 = 0;
    while i < n {
        let mut sgn: f32 = 1.0;
        if i % 3 == 0 {
            sgn = -1.0;
        }
        let m: f32 = (((i * 37) % 101) as f32) + 0.5;
        let eb: i32 = (((i * 13) % 29) - 14) as i32;
        let ef: i32 = (((i * 13) % 19) - 12) as i32;
        xb[i] = (sgn * ldexp(m, eb)) as bf16;
        xf[i] = (sgn * ldexp(m, ef)) as f16;
        let mut t: f32 = 1.0;
        if i % 4 == 1 {
            t = -1.0;
        }
        let yv: f32 = t * ldexp((((i * 11) % 9) as f32) + 0.5, (((i * 7) % 5) - 2) as i32);
        yb[i] = yv as bf16;
        yf[i] = yv as f16;
        wb[i] = xb[i] as f32;
        vb[i] = yb[i] as f32;
        wf[i] = xf[i] as f32;
        i = i + 1;
    }

    print(bits(bsum_kernel(xb, n)));
    print(bits(bsum_uncast(xb, n)));
    print(bits(bsum_inclusive(xb, n)));
    print(bits(wsum(wb, n)));

    print(bits(bdot_kernel(xb, yb, n)));
    print(bits(bdot_commuted(xb, yb, n, 0)));
    print(bits(wdot(wb, vb, n)));

    print(bits(bmax_kernel(xb, n)));
    print(bits(bmax_inclusive(xb, n)));

    print(bits(hsum_kernel(xf, n)));
    print(bits(hsum_uncast(xf, n)));
    print(bits(wsum(wf, n)));

    print(bits(hdot_kernel(xf, yf, n)));
    print(bits(hdot_commuted(xf, yf, n, 0)));

    // One chunk: the half kernel's former flat partition differed from the tree here.
    print(bits(bsum_kernel(xb, 100)));
    print(bits(bsum_uncast(xb, 100)));
    free(xb);
    free(yb);
    free(xf);
    free(yf);
    free(wb);
    free(vb);
    free(wf);
    return 0;
}
