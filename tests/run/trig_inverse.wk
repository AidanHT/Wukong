// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 1000
// EXPECT-OUT: 1000
// EXPECT-OUT: 1047
// EXPECT-OUT: 1047
// EXPECT-OUT: 311
module tests.run.trig_inverse

// `tan`/`asin`/`acos` complete the trig family (sin/cos/atan): geometry, 3D vision, graphics ML
// (rotations, NeRF/SLAM angles). All compose the shared sin/cos/atan kernels (tan = sin/cos;
// asin = atan(x/√(1−x²)); acos = π/2 − asin), so a dispatched `out[i] = f(x[i])` loop lowers to the
// 256-bit `wukong_vmath_f32` and agrees with the composed/scalar form — interp == native, -O0 == -O3.
// C/Rust call scalar libm tanf/asinf/acosf, which won't vectorize inside a loop.
fn main() -> i32 {
    // asin(sin(t)) = t and acos(cos(t)) = t for t in [-π/2, π/2] (round-trip identities).
    let t: f32 = 1.0;
    print((asin(sin(t)) * 1000.0 + 0.5) as i32); // 1.0 -> 1000
    print((acos(cos(t)) * 1000.0 + 0.5) as i32); // 1.0 -> 1000

    // tan(π/4) = 1; asin(0.5) = π/6 ≈ 0.5236; acos(0.5) = π/3 ≈ 1.0472.
    print((asin(0.5) * 2000.0 + 0.5) as i32); // π/6 * 2000 ≈ 1047
    print((acos(0.5) * 1000.0 + 0.5) as i32); // π/3 * 1000 ≈ 1047

    // Vectorized tan over an array dispatches to the kernel; checksum of tan(0..7 * 0.1).
    let mut xs: [f32; 8] = [0.0; 8];
    let mut i: i32 = 0;
    while i < 8 {
        xs[i] = (i as f32) * 0.1;
        i = i + 1;
    }
    let mut o: [f32; 8] = [0.0; 8];
    let mut k: i32 = 0;
    while k < 8 {
        o[k] = tan(xs[k]);
        k = k + 1;
    }
    let mut s: f32 = 0.0;
    let mut n: i32 = 0;
    while n < 8 {
        s = s + o[n];
        n = n + 1;
    }
    print((s * 100.0 + 0.5) as i32); // tan checksum -> 311
    return 0;
}
