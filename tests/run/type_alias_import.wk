// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 7.75
// EXPECT-OUT: 12
// EXPECT-OUT: 1.5
// EXPECT-OUT: 42
module tests.run.type_alias_import

// Aliases across an import: `Vec3` and `Pair` arrive through the glob import, `Real64` is also
// reachable module-qualified, and `twice` takes the module's PRIVATE alias `Hidden` (= i32), which
// the caller never names. Every value is printed; each expectation is worked in the comment.
import lib.alias_types;

fn main() -> i32 {
    let v: Vec3 = [1.5, 2.0, 4.25];
    print(sum3(v)); // 1.5 + 2.0 + 4.25 = 7.75
    let p: Pair<i64> = (3, 4);
    print(p.0 * p.1); // 3 * 4 = 12
    let s: alias_types.Real64 = 0.5;
    print(s * 3.0); // 0.5 * 3 = 1.5
    print(twice(21)); // 21 * 2 = 42
    return 0;
}
