// EXPECT-OUT-APPROX: 190.451492309570 7.63e-6
module tests.run.premise_gemm_64

// P12.24 - the recognition on/off premise for the GEMM family at a measurement size: a 64x64x64
// `C = A.B` nest (dispatched to `wukong_sgemm` with recognition on, at `--emit=mir -O2`; the plain
// loop nest with it off), printing EVERY one of the 4096 output lanes at full precision rather than
// an `as i32` truncation or a reduction of them. At K = 64 the kernel's KC = 384 block holds the whole
// contraction, so today both lowerings accumulate each lane in ascending k and agree to the bit
// (every product is exact here, so a fused and a separate multiply-add cannot be told apart); a
// kernel change that reassociates the K-dot (a smaller KC, a split-K) would show up as a last-bit
// move that `wukong_xbench compare` reports and this file still accepts within its bound.
//
// Inputs, all EXACT in f32, all positive (no cancellation), with every product A*B exact in f32 too
// (at most 21 fractional bits below a magnitude under 4):
//   A[i][k] = a_i + k * 2^-10,  a_i = 1 + i/64
//   B[k][j] = b_j - k * 2^-11,  b_j = 1 + j/128            (i, j, k = 0..63)
// so every lane has the exact closed form (S1 = sum k = 2016, S2 = sum k^2 = 85344):
//   C[i][j] = 64 a_i b_j + 2016 (a_i * (-2^-11) + b_j * 2^-10) + 85344 * (-2^-21)
// evaluated here in rational arithmetic and printed to 15 significant digits, row-major.
//
// TOLERANCE 7.63e-6 = c*sqrt(K)*eps rounded up, with K = 64, eps = 2^-23 and c = 8 (the in-tree
// reassociated-reduction convention, `p4_reduction_f64_reference` in
// crates/wukong_codegen_cranelift/src/tests.rs): 8 * 8 * 2^-23 = 2^-17 = 7.629e-6. At this K it is
// also a WORST-CASE bound: for a dot of 64 positive terms in ANY order, with or without FMA, the
// relative error is at most gamma_64 = 64u/(1-64u) = 3.81e-6 (u = 2^-24). Simulated in exact
// arithmetic over all 4096 lanes, the ascending-k order's worst lane sits at 4.6e-7; the printed
// shortest round-trip decimal can add up to half an f32 ulp (about 6e-8) on top.

fn mm(a: [f32; 4096], b: [f32; 4096], mut c: [f32; 4096]) {
    for i in 0..64 {
        for j in 0..64 {
            let mut s: f32 = 0.0;
            for k in 0..64 {
                s = s + a[i * 64 + k] * b[k * 64 + j];
            }
            c[i * 64 + j] = s;
        }
    }
}

fn main() -> i32 {
    let mut a: [f32; 4096] = [0.0; 4096];
    let mut b: [f32; 4096] = [0.0; 4096];
    let mut c: [f32; 4096] = [0.0; 4096];
    for r in 0..64 {
        for k in 0..64 {
            a[r * 64 + k] = 1.0 + (r as f32) * 0.015625 + (k as f32) * 0.0009765625;
            b[k * 64 + r] = 1.0 + (r as f32) * 0.0078125 - (k as f32) * 0.00048828125;
        }
    }
    mm(a, b, c);
    for t in 0..4096 {
        print(c[t]);
    }
    return 0;
}
