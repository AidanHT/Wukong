// RUN: --run
// EXPECT-EXIT: 0
// C = A^T B [5, 17], one row per line
// EXPECT-OUT-VALUES: -13 19 18 17 -17 -51 25 13 23 11 -45 -13 19 18 17 -17 -51
// EXPECT-OUT-VALUES: 22 23 -9 -41 -7 27 17 29 -47 -35 21 22 23 -9 -41 -7 27
// EXPECT-OUT-VALUES: -15 18 18 18 -15 -48 18 18 18 18 -48 -15 18 18 18 -15 -48
// EXPECT-OUT-VALUES: -7 -41 -9 23 22 21 -35 -47 29 17 27 -7 -41 -9 23 22 21
// EXPECT-OUT-VALUES: -17 17 18 19 -13 -45 11 23 13 25 -51 -17 17 18 19 -13 -45
// scaled GEMV scores[0..4]
// EXPECT-OUT-VALUES: 3.125 -2.25 3.75 -1.625 -5.375
// GEVM out[0..19]
// EXPECT-OUT-VALUES: -17.5 -6.25 9.25 20.5 -10.75 4.75 16 -15.25 -4 11.5
// EXPECT-OUT-VALUES: -11.25 -8.5 7 18.25 -13 -14.5 13.75 -17.5 -6.25 9.25
module tests.run.cov4_par_gemm

// P12.4: wukong_sgemm_tn_parallel, wukong_sgemv_alpha_parallel and wukong_sgevm_f32_parallel. The
// three nests sit in one multi-statement `@parallel` function, lowered whole with `parallel_fn` set,
// so each GEMM-family arm emits its `_parallel` twin (`--emit=mir -O2`, census).
//
// Shapes chosen so the forced-parallel lane (WUKONG_GEMM_PAR_MIN_MACS=1, WUKONG_PAR_MIN_WORK=1)
// really splits: the TN GEMM is [5, 17] (two 16-column blocks of the 2D grid), the GEMV has five
// rows (three two-row tasks), and the GEVM has 20 output columns (three 8-column stripes).
//
// Every input is a small integer (or, for the GEVM weights, a short dyadic), so each dot product is
// an exact small integer or dyadic whatever order the kernel accumulates in:
//   A[p, i] = ((3p + 5i) % 9) - 4 stored [6, 5], B[p, j] = ((7p + 2j) % 11) - 5 stored [6, 17],
//   C[i, j] = sum_p A[p, i] * B[p, j];
//   K[s, d] = ((4s + 3d) % 13) - 6, q[d] = ((5d) % 7) - 3, scores[s] = (sum_d K[s, d] * q[d]) / 8;
//   w = (1/2, -1, 2, 3/4), V[s, d] = ((9s + 5d) % 17) - 8, out[d] = sum_s w[s] * V[s, d].
// The expected lanes are those scalar loops evaluated in order. Outputs are poisoned first. EVERY
// lane is printed (85 + 5 + 20).

@parallel
fn g(a: [f32; 30], b: [f32; 102], k: [f32; 45], q: [f32; 9], w: [f32; 4], v: [f32; 80],
     mut c: [f32; 85], mut sc: [f32; 5], mut o: [f32; 20]) {
    for i in 0..5 {
        for j in 0..17 {
            let mut s: f32 = 0.0;
            for p in 0..6 { s = s + a[p * 5 + i] * b[p * 17 + j]; }
            c[i * 17 + j] = s;
        }
    }
    for s in 0..5 {
        let mut acc: f32 = 0.0;
        for d in 0..9 { acc = acc + k[s * 9 + d] * q[d]; }
        sc[s] = acc * 0.125;
    }
    for d in 0..20 {
        let mut acc: f32 = 0.0;
        for s in 0..4 { acc = acc + w[s] * v[s * 20 + d]; }
        o[d] = acc;
    }
}

fn main() -> i32 {
    let mut a: [f32; 30] = [0.0; 30];
    let mut b: [f32; 102] = [0.0; 102];
    for p in 0..6 {
        for i in 0..5 { a[p * 5 + i] = (((p * 3 + i * 5) % 9) as f32) - 4.0; }
        for j in 0..17 { b[p * 17 + j] = (((p * 7 + j * 2) % 11) as f32) - 5.0; }
    }
    let mut k: [f32; 45] = [0.0; 45];
    for s in 0..5 {
        for d in 0..9 { k[s * 9 + d] = (((s * 4 + d * 3) % 13) as f32) - 6.0; }
    }
    let mut q: [f32; 9] = [0.0; 9];
    for d in 0..9 { q[d] = (((d * 5) % 7) as f32) - 3.0; }
    let w: [f32; 4] = [0.5, -1.0, 2.0, 0.75];
    let mut v: [f32; 80] = [0.0; 80];
    for s in 0..4 {
        for d in 0..20 { v[s * 20 + d] = (((s * 9 + d * 5) % 17) as f32) - 8.0; }
    }
    let mut c: [f32; 85] = [-1000.0; 85];
    let mut sc: [f32; 5] = [-1000.0; 5];
    let mut o: [f32; 20] = [-1000.0; 20];
    g(a, b, k, q, w, v, c, sc, o);
    for x in 0..85 { print(c[x]); }
    for x in 0..5 { print(sc[x]); }
    for x in 0..20 { print(o[x]); }
    return 0;
}
