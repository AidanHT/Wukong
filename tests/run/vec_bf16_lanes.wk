// EXPECT-OUT: 32705 32768 0 32640 65408
module tests.run.vec_bf16_lanes

// bf16 loops widened by the general vectorizer (-O2) as `<4 x bf16>` - four bf16 lanes in an f32
// register - every lane printed as its raw bits (`bits`), so a payload, a sign, a flushed
// subnormal or a rounding tie cannot hide behind a decimal rendering. A bf16 value is computed in
// f32 and rounded to the bf16 grid at a load, a store, a constant and a cast (`fptrunc .. to
// bf16`, which follows every bf16 operation, and `fpext` out of bf16); the vector form keeps
// those four points lane by lane. n = 37: nine groups of four, then one scalar lane.
//
// Each kernel calls itself when `d > 0` (never, here), so the inliner keeps it out of `main` and
// its trip a runtime value.
//
// x[i] = X[i % 16], y[i] = Y[(5i + 3) % 16] (bf16 bits):
//   X = 7fc1 (qNaN), 8000 (-0), 0000, 7f80 (+inf), ff80 (-inf), 3fc0 (1.5), c010 (-2.25),
//       0001 (2^-133, the smallest subnormal), 7f7f (the largest finite), 3f81 (1.0078125),
//       4049 (3.140625), bf80 (-1), 3e80 (0.25), 4300 (128), 3f80 (1), 4120 (10)
//   Y = 3f80 (1), 4000 (2), 0000, 8000 (-0), 7f80 (+inf), 3f81, 3f7f (0.99609375), c040 (-3),
//       0080 (2^-126), 4b80 (2^24), 3f00 (0.5), 7f00 (2^127), be00 (-0.125), 41a0 (20),
//       3fff (1.9921875), 7fc2 (qNaN)
// Every expected lane is derived by hand under IEEE 754 binary32, the bf16 grid rule
// (round-to-nearest-even on the top 16 bits; a NaN keeps its top half with the quiet bit set) and
// x86's NaN rules (one NaN operand: that NaN; an invalid operation: the default NaN):
//   k1: o = bf16(fma(x, y, x))           - the contracted `x * y + x`, rounded once in f32
//   k2: o = x > y ? x : -y               - an ordered compare (false on NaN) and a negation
//   k3: o = bf16(x / y)                  - including 0/0, inf/inf, x/0 and the largest finite / 2^-126
//   k4: f = (x as f32) * 0.5             - an f32 output, printed as f32 bits
//   k5: o = (f * 3) as bf16              - f32 to bf16 rounding, ties to even
// Each bf16 array prints 16 lanes to a line, the f32 one 8.

fn pick(a: bf16, b: bf16) -> bf16 {
    if a > b {
        return a;
    }
    return -b;
}

@unchecked
fn k1(x: []bf16, y: []bf16, mut o: []bf16, n: i64, d: i64) {
    if d > 0 {
        k1(x, y, o, n, d - 1);
        return;
    }
    let mut i: i64 = 0;
    while i < n {
        o[i] = x[i] * y[i] + x[i];
        i = i + 1;
    }
}

@unchecked
fn k2(x: []bf16, y: []bf16, mut o: []bf16, n: i64, d: i64) {
    if d > 0 {
        k2(x, y, o, n, d - 1);
        return;
    }
    let mut i: i64 = 0;
    while i < n {
        o[i] = pick(x[i], y[i]);
        i = i + 1;
    }
}

@unchecked
fn k3(x: []bf16, y: []bf16, mut o: []bf16, n: i64, d: i64) {
    if d > 0 {
        k3(x, y, o, n, d - 1);
        return;
    }
    let mut i: i64 = 0;
    while i < n {
        o[i] = x[i] / y[i];
        i = i + 1;
    }
}

@unchecked
fn k4(x: []bf16, mut f: []f32, n: i64, d: i64) {
    if d > 0 {
        k4(x, f, n, d - 1);
        return;
    }
    let mut i: i64 = 0;
    while i < n {
        f[i] = x[i] as f32 * 0.5;
        i = i + 1;
    }
}

@unchecked
fn k5(f: []f32, mut o: []bf16, n: i64, d: i64) {
    if d > 0 {
        k5(f, o, n, d - 1);
        return;
    }
    let mut i: i64 = 0;
    while i < n {
        o[i] = (f[i] * 3.0) as bf16;
        i = i + 1;
    }
}

fn xs(r: i64) -> u16 {
    let t: [u16; 16] = [
        32705, 32768, 0, 32640, 65408, 16320, 49168, 1, 32639, 16257, 16457, 49024, 16000, 17152,
        16256, 16672,
    ];
    return t[r];
}

fn ys(r: i64) -> u16 {
    let t: [u16; 16] = [
        16256, 16384, 0, 32768, 32640, 16257, 16255, 49216, 128, 19328, 16128, 32512, 48640, 16800,
        16383, 32706,
    ];
    return t[r];
}

fn show(v: []bf16, n: i64) {
    let mut i: i64 = 0;
    while i < n {
        print_raw(bits(v[i]));
        if (i + 1) % 16 == 0 || i + 1 == n {
            print_raw("\n");
        } else {
            print_raw(" ");
        }
        i = i + 1;
    }
}

fn main() -> i32 {
    let n: i64 = 37;
    let mut x: []bf16 = alloc_bf16(n);
    let mut y: []bf16 = alloc_bf16(n);
    let mut o1: []bf16 = alloc_bf16(n);
    let mut o2: []bf16 = alloc_bf16(n);
    let mut o3: []bf16 = alloc_bf16(n);
    let mut o5: []bf16 = alloc_bf16(n);
    let mut f: []f32 = alloc_f32(n);
    let mut i: i64 = 0;
    while i < n {
        x[i] = bf16_from_bits(xs(i % 16));
        y[i] = bf16_from_bits(ys((5 * i + 3) % 16));
        i = i + 1;
    }
    k1(x, y, o1, n, 0);
    k2(x, y, o2, n, 0);
    k3(x, y, o3, n, 0);
    k4(x, f, n, 0);
    k5(f, o5, n, 0);
    show(o1, n);
    show(o2, n);
    show(o3, n);
    i = 0;
    while i < n {
        print_raw(bits(f[i]));
        if (i + 1) % 8 == 0 || i + 1 == n {
            print_raw("\n");
        } else {
            print_raw(" ");
        }
        i = i + 1;
    }
    show(o5, n);
    free(x);
    free(y);
    free(o1);
    free(o2);
    free(o3);
    free(o5);
    free(f);
    return 0;
}
