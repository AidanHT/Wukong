// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 0
// EXPECT-OUT: -5
// EXPECT-OUT: -4
// EXPECT-OUT: -184
module tests.run.parallel_head_loop

// The transformer per-head attention loop shape, spelled the natural way for independent
// iterations: the per-head scratch (qh/kh/scores) is declared INSIDE the loop body, so each
// iteration is private by construction, and each head writes a disjoint hh-sliced column band of
// `attn` (index i*D + hh*HD + j — the mixed-radix digit proof). Under `@parallel` the loop
// outlines into a wukong_parallel_for region (heads across cores, serial kernels per head); the
// serial twin below runs the identical per-iteration op sequence, so the elementwise comparison
// must report ZERO mismatches — the serial == @parallel bit-exactness gate, checked here across
// both backends and every opt level by the e2e runner.
// Serial twin: identical body, no @parallel.
fn heads_serial(q: [f32; 32], k: [f32; 32], v: [f32; 32], mut attn: [f32; 32]) {
    for hh in 0..2 {
        let mut qh: [f32; 16] = [0.0; 16];
        let mut kh: [f32; 16] = [0.0; 16];
        let mut scores: [f32; 16] = [0.0; 16];
        for i in 0..4 { for p in 0..4 { qh[i*4+p] = q[i*8 + hh*4 + p]; } }
        for i in 0..4 { for p in 0..4 { kh[i*4+p] = k[i*8 + hh*4 + p]; } }
        for i in 0..4 { for j in 0..4 {
            let mut acc: f32 = 0.0;
            for p in 0..4 { acc = acc + qh[i*4+p] * kh[j*4+p]; }
            scores[i*4+j] = acc;
        } }
        for i in 0..4 { for j in 0..4 { attn[i*8 + hh*4 + j] = scores[i*4+j] + v[i*8 + hh*4 + j]; } }
    }
}

@parallel
fn heads_par(q: [f32; 32], k: [f32; 32], v: [f32; 32], mut attn: [f32; 32], mut y: [f32; 32]) {
    for i in 0..32 { y[i] = q[i]; }
    for hh in 0..2 {
        let mut qh: [f32; 16] = [0.0; 16];
        let mut kh: [f32; 16] = [0.0; 16];
        let mut scores: [f32; 16] = [0.0; 16];
        for i in 0..4 { for p in 0..4 { qh[i*4+p] = q[i*8 + hh*4 + p]; } }
        for i in 0..4 { for p in 0..4 { kh[i*4+p] = k[i*8 + hh*4 + p]; } }
        for i in 0..4 { for j in 0..4 {
            let mut acc: f32 = 0.0;
            for p in 0..4 { acc = acc + qh[i*4+p] * kh[j*4+p]; }
            scores[i*4+j] = acc;
        } }
        for i in 0..4 { for j in 0..4 { attn[i*8 + hh*4 + j] = scores[i*4+j] + v[i*8 + hh*4 + j]; } }
    }
}

fn main() -> i32 {
    let mut q: [f32; 32] = [0.0; 32];
    let mut k: [f32; 32] = [0.0; 32];
    let mut v: [f32; 32] = [0.0; 32];
    for i in 0..32 {
        q[i] = (i as f32) * 0.25;
        k[i] = 8.0 - (i as f32) * 0.5;
        v[i] = (i as f32) - 16.0;
    }
    let mut a_serial: [f32; 32] = [0.0; 32];
    let mut a_par: [f32; 32] = [0.0; 32];
    let mut y: [f32; 32] = [0.0; 32];
    heads_serial(q, k, v, a_serial);
    heads_par(q, k, v, a_par, y);
    let mut bad: i32 = 0;
    for i in 0..32 { if a_par[i] != a_serial[i] { bad = bad + 1; } }
    print(bad);
    print(a_par[0] as i32);
    print(a_par[5] as i32);
    print(a_par[31] as i32);
    return 0;
}
