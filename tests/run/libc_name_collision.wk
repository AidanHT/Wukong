// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 42
// EXPECT-OUT: 3.5
// EXPECT-OUT: 1.5
// EXPECT-OUT: 10
// EXPECT-OUT: 0.1
module tests.run.libc_name_collision

// User functions named like C library symbols. A linked executable used to export every user
// function under its source name, so `fmod` here could capture the C library's `fmod` (which the
// runtime's float `%` calls) and `write` the one the runtime's printing reaches, depending on the
// OS linker. Executable objects now make every user function an internal, mangled symbol
// (`_WK4fmod`), so the program means the same thing everywhere (`crates/wukongc/tests/exe.rs`
// compares the executable with `--run`).
//
// Expected values from the scalar semantics: write(21) = 21 * 2 = 42; this fmod(1.5, 2.0) is
// 1.5 + 2.0 = 3.5; the language's float `%` is C's fmod: 7.5 - 3 * 2.0 = 1.5; memcpy(9) = 9 + 1 =
// 10; and the f32 0.1 prints as its shortest round-trip form, 0.1.
fn write(fd: i64) -> i64 {
    return fd * 2;
}

fn fmod(a: f64, b: f64) -> f64 {
    return a + b;
}

fn memcpy(n: i64) -> i64 {
    return n + 1;
}

fn main() -> i32 {
    print(write(21));
    print(fmod(1.5, 2.0));
    let a: f64 = 7.5;
    let b: f64 = 2.0;
    print(a % b);
    print(memcpy(9));
    let x: f32 = 0.1;
    print(x);
    return 0;
}
