// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 15
// EXPECT-OUT: 1
// EXPECT-OUT: 0
// EXPECT-OUT: pos
// EXPECT-OUT: neg
// EXPECT-OUT: 107
// EXPECT-OUT: 7
module tests.run.closure_str

// A closure whose parameter or return type is `str`. Sema erases every `str` it publishes to the
// `[]u8` slice it is laid out as, and the closure's own recorded types are what its lifted
// function's signature is built from, so they erase too (a `str` parameter used to reach MIR
// lowering and stop the compiler). A `str` is not captured by value; a pointer to one is.
// Expectations by hand:
//   "hello".len() + 10 = 15; "hello" == "hello" -> 1; "help" != "hello" -> 0;
//   1 > 0 -> "pos"; -1 > 0 is false -> "neg";
//   "wukong"[2] = 'k' = 107; "wukong".len() + 1 = 7.

fn apply_s(f: fn(str) -> i64, s: str) -> i64 {
    return f(s);
}

fn name_of(f: fn(i64) -> str, i: i64) -> str {
    return f(i);
}

fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    return f(x);
}

fn main() -> i32 {
    let s: str = "hello";
    let k: i64 = 10;
    print(apply_s(|t| t.len() + k, s));
    print(apply_s(|t: str| -> i64 { if t == "hello" { return 1; } return 0; }, s));
    let other: str = "help";
    print(apply_s(|t| (t == "hello") as i64, other));
    println(name_of(|i| -> str { if i > 0 { return "pos"; } return "neg"; }, 1));
    println(name_of(|i| -> str { if i > 0 { return "pos"; } return "neg"; }, -1));
    let w: str = "wukong";
    let pw = &w;
    print(apply(|i| (*pw)[i] as i64, 2));
    print(apply(|i| (*pw).len() + i, 1));
    return 0;
}
