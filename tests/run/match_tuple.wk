// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 1
// EXPECT-OUT: 2
// EXPECT-OUT: 10
// EXPECT-OUT: 4
// EXPECT-OUT: 9
// EXPECT-OUT: 8
// EXPECT-OUT: 1
// EXPECT-OUT: 0
module tests.run.match_tuple

// A `match` on a tuple scrutinee tests each field's sub-pattern (literals compare for equality,
// `_`/identifiers match anything, nested tuples recurse) and binds identifier sub-patterns to the
// tuple's fields. Previously the whole tuple pattern was treated as always-matching — a silent
// miscompile both backends shared; now the interpreter and native backend agree on the real
// per-field semantics.
fn classify(a: i32, b: i32) -> i32 {
    return match (a, b) {
        (0, 0) => 1,
        (0, _) => 2,
        (x, y) => x + y,
    };
}

fn nested(a: i32, b: i32, c: i32) -> i32 {
    return match ((a, b), c) {
        ((0, 0), 0) => 1,
        ((0, y), _) => y,
        ((x, _), z) => x + z,
    };
}

fn main() -> i32 {
    print(classify(0, 0));     // 1
    print(classify(0, 5));     // 2
    print(classify(7, 3));     // 10  (binding arm: x + y)
    print(classify(4, 0));     // 4

    print(nested(0, 9, 1));    // 9   (((0, y), _) binds y = 9)
    print(nested(3, 4, 5));    // 8   (((x, _), z) binds x = 3, z = 5)

    let g = match (5, 2) { (x, y) if x > y => 1, _ => 0 };
    print(g);                  // 1   (a tuple-pattern guard)
    let h = match (2, 5) { (x, y) if x > y => 1, _ => 0 };
    print(h);                  // 0
    return 0;
}
