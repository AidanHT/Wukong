// RUN: --train --grad-wrt=0 --train-steps=2 --train-lr=0.25 --train-seed=163
// EXPECT-EXIT: 0
// EXPECT-OUT: train: 2 step(s), lr=0.25, optimizer=sgd
// EXPECT-OUT: step    0: loss 0.024479
// EXPECT-OUT: step    1: loss 0.006120
// EXPECT-OUT: step    2: loss 0.001530
// EXPECT-OUT: loss 0.024479 -> 0.001530  (16.00x reduction)
module tests.run.autodiff_train_helper

// `--train` of a loss written as NESTED HELPER FUNCTIONS, at the default -O0 (autodiff floors it
// at -O1, where no inliner runs). The reverse pass is single-block, so a call on the gradient path
// used to be the refusal "no VJP rule for `call`"; the straight-line helpers are now spliced into
// the loss before it is differentiated (`wukong_autodiff::inline_calls`), bottom-up, so `norm2`'s
// own call to `sq` is flattened too. Every expected line is derived from scalar semantics:
//
// * The 2 initial weights come from `--train`'s documented deterministic init with seed 163 (the
//   LCG and f32 formula in tests/run/autodiff_train_sumsq.wk), computed independently in Python with
//   f32 rounding after every operation: w = [-0.14936581, 0.046571206] (one of each sign).
// * L = sq(w0) + sq(w1) = f32(f32(w0²) + f32(w1²)) = 0.024479022.
// * dL/dw = 2w (the product rule on `a * a`: g·a + g·a), so SGD with lr = 1/4 gives w - w/2 = w/2
//   EXACTLY in f32 and divides the loss by exactly 4 per step: 0.024479022 / 4^k, ratio 16. Each
//   printed value sits >= 200 ULPs from a six-decimal rounding boundary.
//
// `main` exercises the same loss for the differential gates, on exact values.

fn sq(a: f32) -> f32 {
    return a * a;
}

fn norm2(a: f32, b: f32) -> f32 {
    return sq(a) + sq(b);
}

fn loss(w: [f32; 2], mut out: [f32; 1]) -> f32 {
    let l: f32 = norm2(w[0], w[1]);
    out[0] = l;
    return l;
}

fn main() -> i32 {
    let w: [f32; 2] = [0.75, -1.25];
    let mut out: [f32; 1] = [0.0];
    let l: f32 = loss(w, out);
    // 0.5625 + 1.5625 = 2.125, exact in f32; × 16 = 34.
    print((l * 16.0) as i32);
    print((out[0] * 16.0) as i32);
    return 0;
}
