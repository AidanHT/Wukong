// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 500
// EXPECT-OUT: 3500
module tests.run.gemv_parallel

/// A `@parallel` whole-function GEMV `y[4] = A[4,4]·x[4]`. Intercepted before the elementwise outliner
/// and dispatched to `mercury_sgemv_parallel` — the independent rows map across cores. The parallel
/// kernel is bit-identical to the serial one the interpreter marshals (each row computed by the same
/// per-row routine, no cross-row combine), so -O0..-O3 and interp/native all agree.
@parallel
fn gemv(a: [f32; 16], x: [f32; 4], mut y: [f32; 4]) {
    for i in 0..4 {
        let mut s: f32 = 0.0;
        for j in 0..4 {
            s = s + a[i * 4 + j] * x[j];
        }
        y[i] = s;
    }
}

fn main() -> i32 {
    let mut a: [f32; 16] = [0.0; 16];
    let mut x: [f32; 4] = [0.0; 4];
    let mut y: [f32; 4] = [0.0; 4];
    let mut i: i32 = 0;
    while i < 16 { a[i] = (i as f32) * 0.25; i = i + 1; }
    let mut j: i32 = 0;
    while j < 4 { x[j] = (j as f32) + 1.0; j = j + 1; }
    gemv(a, x, y);
    print((y[0] * 100.0) as i32);
    print((y[3] * 100.0) as i32);
    return 0;
}
