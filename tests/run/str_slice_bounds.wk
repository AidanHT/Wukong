// RUN: --run
// EXPECT-EXIT: 1
// EXPECT-OUT: wu
// EXPECT-STDERR: index out of bounds: the len is 6 but the index is 9 at
// EXPECT-STDERR: str_slice_bounds.wk:22:13
module tests.run.str_slice_bounds

// A range index is checked at run time, `lo <= hi <= len`, on every backend and at every -O level
// — the same check, failure message and exit code as an element access out of bounds
// (`slice_bounds_oob.wk`). `s[..2]` is in bounds and prints "wu"; `s[2..end]` asks for bytes up to
// 9 of a 6-byte `str`, so the upper bound fails against the length: "the len is 6 but the index
// is 9", at line 22, column 13 — the start of `s[2..end]`. Nothing after it runs.
//
// The bound is a run-time value (`end` is read from a loop, not a literal) so that no constant
// folding could ever decide the check early; the check itself is a pair of unsigned `<=`
// comparisons that `wukong_opt::bce` deliberately does not match.
fn main() -> i32 {
    let s: str = "wukong";
    let mut end: i64 = 0;
    for _ in 0..9 { end = end + 1; }
    println(s[..2]);
    println(s[2..end]);
    println(s[..3]);
    return 0;
}
