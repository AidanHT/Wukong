// EXPECT-OUT-APPROX: 1.08427815594358 2.65e-5
module tests.run.premise_norm_wide

// P12.24 - the recognition on/off premise for the row-norm family at a measurement size: one
// 768-wide RMSNorm row (the GPT-2 hidden width) in the canonical in-place spelling, dispatched to
// `wukong_norm_f32(.., NORM_RMSNORM)` with recognition on (`--emit=mir -O2`), and lowered as written
// with it off. EVERY lane is printed at full precision. The two lowerings evaluate differently: the
// kernel folds the sum of squares over 8 accumulators x 64-element blocks and forms the mean as
// `ss * (1/768)` (two roundings), the loop accumulates in the generic vectorizer's order and divides
// once. On this data they happened to round to the same bits at landing; nothing guarantees that,
// which is why the lanes are held to a derived bound rather than to each other.
//
// Input, EXACT in f32: x[i] = 1 + i * 2^-12, i = 0..767; eps = 2^-16 (also exact, chosen so the
// closed form carries no decimal-to-binary rounding). With S1 = sum i = 294528 and
// S2 = sum i^2 = 767*768*1535/6 = 150700160:
//   sum x^2 = 768 + 2^-11 S1 + 2^-24 S2 = 920.794929504395      (exact rational)
//   out[i]  = x[i] / sqrt(sum x^2 / 768 + 2^-16)          (evaluated to 40 digits, printed to 15)
//
// TOLERANCE 2.65e-5 = c*sqrt(K)*eps rounded up, with K = 768, eps = 2^-23 and c = 8 (the in-tree
// reassociated-reduction convention, `p4_reduction_f64_reference` in
// crates/wukong_codegen_cranelift/src/tests.rs): 8 * 27.71 * 2^-23 = 2.643e-5. For this data it is
// also a WORST-CASE bound: the sum of 768 positive squares in any order is within
// gamma_768 = 4.58e-5 relative, the square root halves that, and the mean, eps add, sqrt, reciprocal
// and final multiply add at most 5u (u = 2^-24): 2.29e-5 + 3.0e-7 = 2.32e-5 < 2.643e-5. Simulated in
// exact arithmetic, the worst lane is 1.3e-7 for the kernel's partition and finalize and 2.0e-7
// for the sequential loop.

fn main() -> i32 {
    let mut x: [f32; 768] = [0.0; 768];
    for i in 0..768 {
        x[i] = 1.0 + (i as f32) * 0.000244140625; // 2^-12
    }
    let mut ss: f32 = 0.0;
    for i in 0..768 {
        ss = ss + x[i] * x[i];
    }
    let inv: f32 = rsqrt(ss / 768.0 + 0.0000152587890625); // eps = 2^-16
    for i in 0..768 {
        x[i] = x[i] * inv;
    }
    for i in 0..768 {
        print(x[i]);
    }
    return 0;
}
