// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 0
// EXPECT-OUT: 5.5
// EXPECT-OUT: 0
// EXPECT-OUT: 12.5
module tests.run.linear_bias_relu

// A fused nn.Linear layer: out = relu(x · Wᵀ + bias). The matmul nest and the following bias+ReLU
// loop fuse into one wukong_sgemm_nt_epi call (the epilogue folded into the GEMM C writeback).
// This fixture is `recognize.rs`'s sole KERNEL_WITNESS for wukong_sgemm_nt_epi — the shipped
// transformer projection kernel — so it is also the only place the cascade head that folds an
// epilogue into a GEMM is watched by name.
//
// THREE THINGS THAT USED TO MAKE A WRONG KERNEL PASS, all fixed here in 2026-09:
//
//   1. W was the 2x2 identity, so x·Wᵀ = x and a transposed or mis-strided W read produced the same
//      numbers. W is now [[2,-1],[0.5,3]], which is not symmetric.
//   2. The four lanes were printed through `as i32`, a TRUNCATING cast. An expectation of `1`
//      accepts anything in [1.0, 2.0) and `3` anything in [3.0, 4.0): a 33%-to-100% one-sided
//      tolerance nobody wrote down, on the witness for the projection kernel. Every value below is
//      exactly representable in f32 (the inputs are integers and halves, K = 2), so the four lanes
//      are printed RAW and compared as exact strings. There is no tolerance here at all now.
//   3. `out` was initialised to zeros and the two ReLU-clamped lanes were exactly the two lanes
//      whose expectation was 0, so the clamping half of the fused epilogue was only ever asserted
//      against the buffer's own initial contents — a kernel that declined and wrote nothing passed
//      those two lanes. `out` is now poisoned with -12345.0, so "wrote nothing" prints -12345 and
//      fails.
//
// None of the three was visible to any other gate: a recognizer fires identically on the
// interpreter and on native at every -O level (both call this same symbol), so
// native_matches_interpreter and both invariance gates pass whether the kernel is right or not.
//
// WHERE THE EXPECTED VALUES COME FROM (scalar semantics, never a compiler run):
//   x = [[1,2],[3,4]], W = [[2,-1],[0.5,3]], bias = [-10,-1]
//   x·Wᵀ row 0 = [1·2 + 2·(-1), 1·0.5 + 2·3] = [0, 6.5]
//   x·Wᵀ row 1 = [3·2 + 4·(-1), 3·0.5 + 4·3] = [2, 13.5]
//   + bias     = [-10, 5.5] and [-8, 12.5]
//   relu       = [0, 5.5] and [0, 12.5]
// Every product, sum and result is an integer or a half, exact in f32 under any accumulation
// order, so the printed decimals are the scalar answer and not a rounding of it.
fn linear(x: [f32; 4], w: [f32; 4], bias: [f32; 2], mut out: [f32; 4]) {
    for i in 0..2 {
        for j in 0..2 {
            let mut s: f32 = 0.0;
            for k in 0..2 {
                s = s + x[i * 2 + k] * w[j * 2 + k];
            }
            out[i * 2 + j] = s;
        }
    }
    for i in 0..2 {
        for j in 0..2 {
            out[i * 2 + j] = fmax(out[i * 2 + j] + bias[j], 0.0);
        }
    }
}

fn main() -> i32 {
    let x: [f32; 4] = [1.0, 2.0, 3.0, 4.0];
    let w: [f32; 4] = [2.0, -1.0, 0.5, 3.0];
    let bias: [f32; 2] = [-10.0, -1.0];
    let mut out: [f32; 4] = [-12345.0, -12345.0, -12345.0, -12345.0];
    linear(x, w, bias, out);
    print(out[0]);
    print(out[1]);
    print(out[2]);
    print(out[3]);
    return 0;
}
