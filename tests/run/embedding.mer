// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 20
// EXPECT-OUT: 21
// EXPECT-OUT: 22
// EXPECT-OUT: 0
// EXPECT-OUT: 1
// EXPECT-OUT: 2
// EXPECT-OUT: 30
// EXPECT-OUT: 31
// EXPECT-OUT: 32
// EXPECT-OUT: 0
// EXPECT-OUT: 1
// EXPECT-OUT: 2
module tests.run.embedding

// Embedding lookup — the first layer of every LLM: each token id selects one row of the embedding
// table. out[t,:] = weight[ids[t],:] over a [V=4, H=3] table and length-T=4 i32 ids. The recognizer
// folds the 2-deep nest to one `mercury_embedding_f32` call (the data-dependent row gather gcc/rustc
// keep scalar). Pure data movement (a row copy), so the kernel is bit-identical to the scalar gather
// on both backends — no float reassociation, the differential gate (interp == native) is trivial.
// ids hit row 0, the last row (V-1=3), and a repeat, so the gather is exercised across the table.
fn main() -> i32 {
    // weight[v*3 + d] = v*10 + d, so row v = [v*10, v*10+1, v*10+2].
    let weight: [f32; 12] = [ 0.0,  1.0,  2.0,    // row 0
                             10.0, 11.0, 12.0,    // row 1
                             20.0, 21.0, 22.0,    // row 2
                             30.0, 31.0, 32.0];   // row 3
    let ids: [i32; 4] = [2, 0, 3, 0];             // tokens: row 2, row 0, row 3 (last), row 0 (repeat)
    let mut out: [f32; 12] = [0.0; 12];           // [T=4, H=3]

    for t in 0..4 {
        for d in 0..3 {
            out[t * 3 + d] = weight[ids[t] * 3 + d];
        }
    }

    // out row 0 = [20,21,22], row 1 = [0,1,2], row 2 = [30,31,32], row 3 = [0,1,2].
    for k in 0..12 { print(out[k] as i32); }
    return 0;
}
