// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 28
// EXPECT-OUT: -24
// EXPECT-OUT: -2
// EXPECT-OUT: 64
// EXPECT-OUT: 45
// EXPECT-OUT: -16
// EXPECT-OUT: 128
// EXPECT-OUT: -81
// EXPECT-OUT: 40
// EXPECT-OUT: -24
// EXPECT-OUT: 11
// EXPECT-OUT: -22
// EXPECT-OUT: 33
// EXPECT-OUT: -44
// EXPECT-OUT: 24
// EXPECT-OUT: 12
// EXPECT-OUT: 36
// EXPECT-OUT: -8
// EXPECT-OUT: 16
// EXPECT-OUT: 8
// EXPECT-OUT: 0
// EXPECT-OUT: -8
// EXPECT-OUT: -16
// EXPECT-OUT: -24
// EXPECT-OUT: -32
// EXPECT-OUT: -40
module tests.run.vec5_slp_bundles

// Straight-line SLP (-O2): W stores in one block to consecutive elements of one object, computed by
// the same lane-wise operations, become one 128-bit vector store of one vector computation. No
// loop is involved; the bundles are hand-written `vec4`-style code, plus the eight stores a
// complete unroll leaves from a `step 2` loop (which the loop vectorizer declines for its step).
//
// Each kernel is kept OUT of line: the kernels and `again` call each other, so the inliner never
// splices them into `main` (where the arrays would be locals and fold away). `again` hands them
// fresh arrays rather than their own, so each destination's `@noalias` promise stays intact.
//
// Every expected line is derived by hand from the scalar statements. Float results are multiples
// of 1/8, printed as `(v * 8.0) as i64`:
//
//   fma4  (f32x4): o = a*s + b, a = [1.5, -2, 0.25, 3], b = [0.5, 1, -0.75, 2], s = 2
//                  -> [3.5, -3, -0.25, 8]                         -> 28 -24 -2 64
//   iarith (i32x4): o = (a + b) * (a - b), a = [7, -3, 12, 0], b = [2, 5, -4, 9]
//                  -> [9*5, 2*-8, 8*16, 9*-9]                       -> 45 -16 128 -81
//   dmul  (f64x2): o = a*b, a = [1.25, -0.5], b = [4, 6] -> [5, -3]  -> 40 -24
//   icopy (i32x4): o = a, a = [11, -22, 33, -44]                     -> 11 -22 33 -44
//   fsplat (f32x4): o = a + 2.5, a = [0.5, -1, 2, -3.5] -> [3, 1.5, 4.5, -1] -> 24 12 36 -8
//   step2 (2 x f32x4): o[k] = a[k]*s for k in 0..8 by twos, a[k] = k/2 - 1, s = -2
//                  -> [2, 1, 0, -1, -2, -3, -4, -5]                 -> 16 8 0 -8 -16 -24 -32 -40

fn fma4(@noalias mut o: [f32; 4], a: [f32; 4], b: [f32; 4], s: f32, d: i64) {
    if d > 0 {
        again(d - 1);
        return;
    }
    o[0] = a[0] * s + b[0];
    o[1] = a[1] * s + b[1];
    o[2] = a[2] * s + b[2];
    o[3] = a[3] * s + b[3];
}

fn iarith(@noalias mut o: [i32; 4], a: [i32; 4], b: [i32; 4], d: i64) {
    if d > 0 {
        again(d - 1);
        return;
    }
    o[0] = (a[0] + b[0]) * (a[0] - b[0]);
    o[1] = (a[1] + b[1]) * (a[1] - b[1]);
    o[2] = (a[2] + b[2]) * (a[2] - b[2]);
    o[3] = (a[3] + b[3]) * (a[3] - b[3]);
}

fn dmul(@noalias mut o: [f64; 2], a: [f64; 2], b: [f64; 2], d: i64) {
    if d > 0 {
        again(d - 1);
        return;
    }
    o[0] = a[0] * b[0];
    o[1] = a[1] * b[1];
}

fn icopy(@noalias mut o: [i32; 4], a: [i32; 4], d: i64) {
    if d > 0 {
        again(d - 1);
        return;
    }
    o[0] = a[0];
    o[1] = a[1];
    o[2] = a[2];
    o[3] = a[3];
}

fn fsplat(@noalias mut o: [f32; 4], a: [f32; 4], d: i64) {
    if d > 0 {
        again(d - 1);
        return;
    }
    o[0] = a[0] + 2.5;
    o[1] = a[1] + 2.5;
    o[2] = a[2] + 2.5;
    o[3] = a[3] + 2.5;
}

fn step2(@noalias mut o: [f32; 8], a: [f32; 8], s: f32, d: i64) {
    if d > 0 {
        again(d - 1);
        return;
    }
    for k in 0..8 step 2 {
        o[k] = a[k] * s;
        o[k + 1] = a[k + 1] * s;
    }
}

fn again(d: i64) {
    let mut f4: [f32; 4] = [0.0; 4];
    let g4: [f32; 4] = [0.0; 4];
    let mut i4: [i32; 4] = [0; 4];
    let j4: [i32; 4] = [0; 4];
    let mut d2: [f64; 2] = [0.0; 2];
    let e2: [f64; 2] = [0.0; 2];
    let mut f8: [f32; 8] = [0.0; 8];
    let g8: [f32; 8] = [0.0; 8];
    fma4(f4, g4, g4, 1.0, d);
    iarith(i4, j4, j4, d);
    dmul(d2, e2, e2, d);
    icopy(i4, j4, d);
    fsplat(f4, g4, d);
    step2(f8, g8, 1.0, d);
}

fn main() -> i32 {
    let fa: [f32; 4] = [1.5, -2.0, 0.25, 3.0];
    let fb: [f32; 4] = [0.5, 1.0, -0.75, 2.0];
    let mut fo: [f32; 4] = [0.0; 4];
    fma4(fo, fa, fb, 2.0, 0);
    let mut j: i64 = 0;
    while j < 4 {
        print((fo[j] * 8.0) as i64);
        j = j + 1;
    }

    let ia: [i32; 4] = [7, -3, 12, 0];
    let ib: [i32; 4] = [2, 5, -4, 9];
    let mut io: [i32; 4] = [0; 4];
    iarith(io, ia, ib, 0);
    j = 0;
    while j < 4 {
        print(io[j]);
        j = j + 1;
    }

    let da: [f64; 2] = [1.25, -0.5];
    let db: [f64; 2] = [4.0, 6.0];
    let mut dout: [f64; 2] = [0.0; 2];
    dmul(dout, da, db, 0);
    j = 0;
    while j < 2 {
        print((dout[j] * 8.0) as i64);
        j = j + 1;
    }

    let ca: [i32; 4] = [11, -22, 33, -44];
    let mut co: [i32; 4] = [0; 4];
    icopy(co, ca, 0);
    j = 0;
    while j < 4 {
        print(co[j]);
        j = j + 1;
    }

    let sa: [f32; 4] = [0.5, -1.0, 2.0, -3.5];
    let mut so: [f32; 4] = [0.0; 4];
    fsplat(so, sa, 0);
    j = 0;
    while j < 4 {
        print((so[j] * 8.0) as i64);
        j = j + 1;
    }

    let mut ta: [f32; 8] = [0.0; 8];
    j = 0;
    while j < 8 {
        ta[j] = (j as f32) * 0.5 - 1.0;
        j = j + 1;
    }
    let mut tout: [f32; 8] = [0.0; 8];
    step2(tout, ta, -2.0, 0);
    j = 0;
    while j < 8 {
        print((tout[j] * 8.0) as i64);
        j = j + 1;
    }
    return 0;
}
