module tests.run.vectorized_mixed_widths

// Loops whose element types differ in width, which the general loop vectorizer
// (`wukong_opt::vectorize`) now widens at the group width of the NARROWEST lane: sixteen
// iterations per vector iteration when an `i8`/`u8` stream is present, with every wider value
// split into parts (`<16 x i8>` bytes beside four `<4 x f32>` parts) and the conversions between
// them spelled with `widen`/`narrow` lane ops. Before, any lane-width-changing cast, any `i8`
// multiply and any vector shift kept the whole loop scalar.
//
// N = 37 = two 16-iteration groups and a 5-element scalar epilogue, so every kernel runs a vector
// part AND hands over to the scalar loop. Every lane is printed (never a checksum, except the two
// reductions, which are the point of their kernels), and every expectation was derived by hand
// from the scalar semantics of the loop:
//
//   normalize  o = px*0.25 - 3.0 printed as o*4 = px - 12, px = (29j + 7) mod 256.
//   quantize   q = (x*4) as i8, u = (x*4) as u8: truncate toward zero, then SATURATE to
//              [-128, 127] / [0, 255]; x = f32(f32(j - 18) * f32(2.9)) spans about +-52, so
//              x*4 crosses both bounds of both types.
//   dot8       sum of a*b in i32, a = (11j - 128) as i8, b = (127 - 13j) as i8 (both wrap).
//   shifts     x >> 3 (arithmetic) and x << 2 (wrapping) at i8, x = (7j - 120) as i8 -- negative
//              values included; the amount is the same in every lane, which is what the vector
//              shift takes.
//   mul8       x * y wrapping at i8, y = (5j + 3) as i8: x86 has no packed byte multiply, so the
//              vector form multiplies in i16 halves and truncates back.
//   sum64      an f32 stream accumulated in f64 (serial, never reassociated), x = j*0.5 - 4,
//              printed as 2*sum.
//   narrow16   (x*3 + 7) wrapping at i32, then truncated to i16, x = (j - 18)*4099.
//
// Re-check that the loops really widen (this fixture alone cannot see that -- interp and native
// agree whether or not they do):
//     wukongc --emit=mir -O2 tests/run/vectorized_mixed_widths.wk | grep -E "widen|narrow"

fn normalize(px: []u8, mut o: []f32, n: i64) {
    let mut i: i64 = 0;
    while i < n {
        o[i] = (px[i] as f32) * 0.25 - 3.0;
        i = i + 1;
    }
}

fn quantize(x: []f32, mut q: []i8, mut u: []u8, n: i64) {
    let mut i: i64 = 0;
    while i < n {
        q[i] = (x[i] * 4.0) as i8;
        u[i] = (x[i] * 4.0) as u8;
        i = i + 1;
    }
}

fn dot8(a: []i8, b: []i8, n: i64) -> i32 {
    let mut s: i32 = 0;
    let mut i: i64 = 0;
    while i < n {
        s = s + (a[i] as i32) * (b[i] as i32);
        i = i + 1;
    }
    return s;
}

fn shifts(x: []i8, mut a: []i8, mut b: []i8, n: i64) {
    let mut i: i64 = 0;
    while i < n {
        a[i] = x[i] >> (3 as i8);
        b[i] = x[i] << (2 as i8);
        i = i + 1;
    }
}

fn mul8(x: []i8, y: []i8, mut o: []i8, n: i64) {
    let mut i: i64 = 0;
    while i < n {
        o[i] = x[i] * y[i];
        i = i + 1;
    }
}

fn sum64(x: []f32, n: i64) -> f64 {
    let mut s: f64 = 0.0;
    let mut i: i64 = 0;
    while i < n {
        s = s + (x[i] as f64);
        i = i + 1;
    }
    return s;
}

fn narrow16(x: []i32, mut o: []i16, n: i64) {
    let mut i: i64 = 0;
    while i < n {
        o[i] = (x[i] * 3 + 7) as i16;
        i = i + 1;
    }
}

fn main() -> i32 {
    let n: i64 = 37;
    let mut px: []u8 = alloc_u8(n);
    let mut of: []f32 = alloc_f32(n);
    let mut xf: []f32 = alloc_f32(n);
    let mut q: []i8 = alloc_i8(n);
    let mut u: []u8 = alloc_u8(n);
    let mut a8: []i8 = alloc_i8(n);
    let mut b8: []i8 = alloc_i8(n);
    let mut x8: []i8 = alloc_i8(n);
    let mut y8: []i8 = alloc_i8(n);
    let mut r8: []i8 = alloc_i8(n);
    let mut s8: []i8 = alloc_i8(n);
    let mut h: []f32 = alloc_f32(n);
    let mut x32: []i32 = alloc_i32(n);
    let mut o16: []i16 = alloc_i16(n);
    let mut j: i64 = 0;
    while j < n {
        px[j] = (j * 29 + 7) as u8;
        xf[j] = ((j as f32) - 18.0) * 2.9;
        a8[j] = (j * 11 - 128) as i8;
        b8[j] = (127 - j * 13) as i8;
        x8[j] = (j * 7 - 120) as i8;
        y8[j] = (j * 5 + 3) as i8;
        h[j] = (j as f32) * 0.5 - 4.0;
        x32[j] = ((j - 18) * 4099) as i32;
        j = j + 1;
    }

    normalize(px, of, n);
    j = 0;
    while j < n {
        print((of[j] * 4.0) as i32);
        j = j + 1;
    }

    quantize(xf, q, u, n);
    j = 0;
    while j < n {
        print(q[j] as i32);
        print(u[j] as i32);
        j = j + 1;
    }

    print(dot8(a8, b8, n));

    shifts(x8, r8, s8, n);
    j = 0;
    while j < n {
        print(r8[j] as i32);
        print(s8[j] as i32);
        j = j + 1;
    }

    mul8(x8, y8, r8, n);
    j = 0;
    while j < n {
        print(r8[j] as i32);
        j = j + 1;
    }

    print((sum64(h, n) * 2.0) as i64);

    narrow16(x32, o16, n);
    j = 0;
    while j < n {
        print(o16[j] as i32);
        j = j + 1;
    }

    free(px);
    free(of);
    free(xf);
    free(q);
    free(u);
    free(a8);
    free(b8);
    free(x8);
    free(y8);
    free(r8);
    free(s8);
    free(h);
    free(x32);
    free(o16);
    return 0;
}
