// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 1
// EXPECT-OUT: 2
// EXPECT-OUT: 3
// EXPECT-OUT: 5
// EXPECT-OUT: 7
// EXPECT-OUT: 9
module tests.run.bubble_sort

/// In-place bubble sort over a fixed-size array: nested loops, conditional swaps via a temporary,
/// and indexed reads/writes. A real array-mutating algorithm running on the interpreter.
fn main() -> i32 {
    let mut a: [i32; 6] = [5, 2, 9, 1, 7, 3];
    let n: i32 = 6;

    let mut i: i32 = 0;
    while i < n {
        let mut j: i32 = 0;
        while j < n - 1 - i {
            if a[j] > a[j + 1] {
                let tmp: i32 = a[j];
                a[j] = a[j + 1];
                a[j + 1] = tmp;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    let mut k: i32 = 0;
    while k < n {
        print(a[k]);
        k = k + 1;
    }
    return 0;
}
