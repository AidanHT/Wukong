// RUN: --run
// EXPECT-EXIT: 1
// EXPECT-OUT-NONE
// EXPECT-STDERR: index out of bounds: the len is 4 but the index is 4 at
// EXPECT-STDERR: slice_bounds_oob.wk:25:21
module tests.run.slice_bounds_oob

// A slice access is checked against the length in the slice's own fat pointer, on every backend
// and at every -O level. Before the check existed this program read one element past the end of a
// 4-element array: the interpreter reported `load out of bounds` and the native backend read stack
// memory (or faulted) — undefined behaviour outside the differential contract.
//
// The loop runs i = 0, 1, 2, 3 in bounds and fails at i = 4 against len 4, so the diagnostic names
// both numbers and the access site (line 25, column 21 is the start of `s[i]`). At -O2 the bounds
// check eliminator versions this loop on `n <= s.len()`; the guard fails here, so the original,
// checked loop runs and stops at exactly the same iteration. The recurrence `t * 3 + s[i]` keeps
// every kernel recognizer away, so this is the scalar indexing path.
//
// Nothing is printed before the failure: the expectation is "exit 1, empty stdout, this message".

fn total(s: []i32, n: i64) -> i32 {
    let mut t: i32 = 0;
    let mut i: i64 = 0;
    while i < n {
        t = t * 3 + s[i];
        i = i + 1;
    }
    return t;
}

fn main() -> i32 {
    let a: [i32; 4] = [1, 2, 3, 4];
    return total(a, 5);
}
