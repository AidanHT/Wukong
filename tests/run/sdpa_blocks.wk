// EXPECT-OUT: 184
module tests.run.sdpa_blocks

// Fused attention `sdpa` past the shapes tests/run/sdpa.wk reaches: S = 33 query rows is two of
// the kernel's 32-row query blocks (the second holds one row), D = 9 is one 8-wide vector step
// plus a scalar tail, and both mask modes run — non-causal (all 33 keys) and causal (query i sees
// keys 0..=i). Every lane of both outputs is printed as round(100·out), 2 x 297 lines.
//
// Inputs, built from integer formulas so the scores are exact in f32:
//   q[i][c] = (((i + c) % 4) - 1) · 0.5,  k[j][c] = (((2j + c) % 5) - 2) · 0.25,
//   v[j][c] = ((j % 7) - 3) + 0.25·c,      scale = 1.
// Expectations: out[i][c] = sum_j p_ij · v[j][c] with p_i = softmax_j(scale · q_i·k_j) over the
// unmasked keys — the defining formula, evaluated in f64 independently of the kernel. Every
// expected lane is at least 4.7e-4 away from a rounding boundary, two orders of magnitude more
// than the kernel's f32 error at these sizes. Causal row 0 is v[0] itself: -3, -2.75, ..., -1.

fn main() -> i32 {
    let mut q: [f32; 297] = [0.0; 297];
    let mut k: [f32; 297] = [0.0; 297];
    let mut v: [f32; 297] = [0.0; 297];
    for i in 0..33 {
        for c in 0..9 {
            q[i * 9 + c] = (((i + c) % 4) as f32 - 1.0) * 0.5;
            k[i * 9 + c] = (((2 * i + c) % 5) as f32 - 2.0) * 0.25;
            v[i * 9 + c] = ((i % 7) as f32 - 3.0) + (c as f32) * 0.25;
        }
    }
    let mut out: [f32; 297] = [0.0; 297];
    sdpa(q, k, v, out, 33, 9, 1.0, 0);
    for t in 0..297 {
        print(round(out[t] * 100.0) as i32);
    }
    let mut causal: [f32; 297] = [0.0; 297];
    sdpa(q, k, v, causal, 33, 9, 1.0, 1);
    for t in 0..297 {
        print(round(causal[t] * 100.0) as i32);
    }
    return 0;
}
