// RUN: --run
// EXPECT-EXIT: 0
// gemv_bf16 y[0..16]
// EXPECT-OUT-VALUES: -1.5 -2.5 -0.5 11 -5 0 -1 1 -1 1 1.5 -4 -2 0.5 -6.5 3 2
// gemv_f16 z[0..16] (the f16 weight is w / 4)
// EXPECT-OUT-VALUES: -0.375 -0.625 -0.125 2.75 -1.25 0 -0.25 0.25 -0.25 0.25 0.375 -1 -0.5 0.125 -1.625 0.75 0.5
// gemv_q8_0 y8[0..16]
// EXPECT-OUT-VALUES: -953 731 -744 -659 -574 -333 -326 -46 -78 241 157 489 444 -953 731 -744 -659
// gemv_q4_0 y4[0..16]
// EXPECT-OUT-VALUES: -1071 800 646 552 398 229 150 -19 -68 -267 -316 -575 -564 -823 1048 -1071 800
// sdpa_kv out, 2 rows of stride 20 (4 heads x 4 lanes, then 4 pad lanes)
// EXPECT-OUT-VALUES: 10 11 12 13 20 21 22 23 110 111 112 113 100 101 102 103 -1 -1 -1 -1
// EXPECT-OUT-VALUES: 30 31 32 33 15 16 17 18 130 131 132 133 115 116 117 118 -1 -1 -1 -1
module tests.run.cov4_par_decode

// P12.4: the five decode-builtin `_parallel` twins -- wukong_sgemv_bf16_parallel,
// wukong_sgemv_f16_parallel, wukong_gemv_q8_0_f32_parallel, wukong_gemv_q4_0_f32_parallel and
// wukong_attention_kv_f32_parallel. `wukong_mir_build::decode_builtins` calls the multicore entry
// when the builtin sits in a `@parallel` function (`--emit=mir -O2`, census). These symbols are
// interned outside `wukong_mir_build/src/lib.rs`, which is why the emittable-surface census (which
// used to scan that one file) never listed them as uncovered.
//
// Shapes: the GEMVs have N = 17 output rows, i.e. three 8-row groups, and the attention call has
// 2 query rows x 4 heads = 8 independent rows, so the forced-parallel lane (WUKONG_PAR_MIN_WORK=1)
// really forks all five.
//
// Every expected lane is exact, from the builtins' defining formulas (the constructions of
// decode_gemv_half.wk, decode_gemv_quant.wk and decode_kv_attention.wk, re-derived for these
// shapes):
//   * gemv_bf16 / gemv_f16: y[j] = sum_p x[p] * w[j][p] with w[j][p] = (((7j + 3p + (jp mod 5))
//     mod 9) - 4) / 2 (the f16 weight is w / 4) and x[p] = (p mod 5) - 2: multiples of 1/8, exact
//     whatever the summation order;
//   * gemv_q8_0 / gemv_q4_0: every 32-element block of the weight and of x holds a value of the
//     format's largest magnitude (127, resp. -8), so every block scale is exactly 1, every quant is
//     the value itself, and y[j] is the exact integer sum_e w[j][e] * x[e];
//   * sdpa_kv: one-hot keys (KV head 0 holds e_j, KV head 1 holds e_(3-j)), values
//     V[j][g][c] = 10j + 100g + c, queries of 200 / 100 along chosen axes: a score gap of 100 or more
//     underflows exp, so each softmax weight is exactly 0 or 1, and a zero query weights its keys
//     exactly 1/4 each -- the outputs are the picked values (or their exact mean), and the four pad
//     lanes per row stay -1.
// EVERY lane is printed (4 x 17 + 40).

@parallel
fn decode(wb: [bf16; 221], wh: [f16; 221], x: [f32; 13], q8: [u8; 1156], q4: [u8; 612],
          xq: [f32; 40], q: [f32; 40], kc: [f32; 32], vc: [f32; 32], mut y: [f32; 17],
          mut z: [f32; 17], mut y8: [f32; 17], mut y4: [f32; 17], mut o: [f32; 40]) {
    gemv_bf16(wb, x, y);
    gemv_f16(wh, x, z);
    gemv_q8_0(q8, xq, y8);
    gemv_q4_0(q4, xq, y4);
    sdpa_kv(q, kc, vc, o, 2, 4, 4, 2, 4, 2, 20, 8, 1.0, 1);
}

fn main() -> i32 {
    let mut wb: [bf16; 221] = [0.0 as bf16; 221];
    let mut wh: [f16; 221] = [0.0 as f16; 221];
    let mut j: i64 = 0;
    while j < 17 {
        let mut p: i64 = 0;
        while p < 13 {
            let v: f32 = (((j * 7 + p * 3 + (j * p) % 5) % 9) as f32 - 4.0) * 0.5;
            wb[j * 13 + p] = v as bf16;
            wh[j * 13 + p] = (v * 0.25) as f16;
            p = p + 1;
        }
        j = j + 1;
    }
    let mut x: [f32; 13] = [0.0; 13];
    let mut i: i64 = 0;
    while i < 13 {
        x[i] = ((i % 5) - 2) as f32;
        i = i + 1;
    }
    let mut w8: [f32; 680] = [0.0; 680];
    let mut w4: [f32; 680] = [0.0; 680];
    j = 0;
    while j < 17 {
        let mut e: i64 = 0;
        while e < 40 {
            if e == 1 || e == 33 {
                w8[j * 40 + e] = 127.0;
                w4[j * 40 + e] = -8.0;
            } else {
                w8[j * 40 + e] = (((j * 7 + e * 3) % 13) - 6) as f32;
                w4[j * 40 + e] = (((j * 7 + e * 3) % 15) - 7) as f32;
            }
            e = e + 1;
        }
        j = j + 1;
    }
    let mut xq: [f32; 40] = [0.0; 40];
    i = 0;
    while i < 40 {
        if i == 0 || i == 32 {
            xq[i] = 127.0;
        } else {
            xq[i] = ((i % 9) - 4) as f32;
        }
        i = i + 1;
    }
    let mut q8: [u8; 1156] = [0; 1156];
    quantize_q8_0(w8, q8, 40);
    let mut q4: [u8; 612] = [0; 612];
    quantize_q4_0(w4, q4, 40);
    // A four-token KV cache, two KV heads of d = 4 per token row (stride 8).
    let mut kc: [f32; 32] = [0.0; 32];
    let mut vc: [f32; 32] = [0.0; 32];
    let mut t: i64 = 0;
    while t < 4 {
        let mut c: i64 = 0;
        while c < 4 {
            kc[t * 8 + c] = if c == t { 1.0 } else { 0.0 };
            kc[t * 8 + 4 + c] = if c == 3 - t { 1.0 } else { 0.0 };
            vc[t * 8 + c] = (10 * t + c) as f32;
            vc[t * 8 + 4 + c] = (10 * t + 100 + c) as f32;
            c = c + 1;
        }
        t = t + 1;
    }
    // Two query rows at positions 2 and 3 (stride 20, four pad lanes per row).
    let mut q: [f32; 40] = [0.0; 40];
    let mut r: i64 = 0;
    while r < 2 {
        let base = r * 20;
        q[base + 3] = 200.0;
        q[base + 1] = 100.0;
        q[base + 8] = 200.0;
        q[base + 10] = 100.0;
        r = r + 1;
    }
    q[6] = 200.0;
    q[15] = 200.0;
    let mut y: [f32; 17] = [7.0; 17];
    let mut z: [f32; 17] = [7.0; 17];
    let mut y8: [f32; 17] = [7.0; 17];
    let mut y4: [f32; 17] = [7.0; 17];
    let mut o: [f32; 40] = [-1.0; 40];
    decode(wb, wh, x, q8, q4, xq, q, kc, vc, y, z, y8, y4, o);
    for k in 0..17 { print(y[k]); }
    for k in 0..17 { print(z[k]); }
    for k in 0..17 { print(y8[k]); }
    for k in 0..17 { print(y4[k]); }
    for k in 0..40 { print(o[k]); }
    return 0;
}
