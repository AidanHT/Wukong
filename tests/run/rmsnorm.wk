// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 103
// EXPECT-OUT: 827
// EXPECT-OUT: 1654
module tests.run.rmsnorm

// RMSNorm — the normalization in Llama/Mistral/modern LLMs: y = x · rsqrt(mean(x²)+eps). It composes
// a sum-of-squares reduction (its addend FMA-contracts), a hardware rsqrt, and a scale. The compiler
// folds the canonical in-place form into one `wukong_norm_f32(.., NORM_RMSNORM)` call (each element
// loaded once + 256-bit AVX2/FMA). The differential gate proves the fused kernel matches the
// interpreter bit-for-bit; the opt-invariance gate proves -O0 == -O3. (Over this 16-wide group the
// reductions are exact integers, so the fused and generic lowerings agree to the bit here regardless.)
fn main() -> i32 {
    let mut x: [f32; 16] = [0.0; 16];
    for i in 0..16 {
        x[i] = (i as f32) + 1.0; // 1 .. 16
    }

    // sum of squares (reduction)
    let mut ss: f32 = 0.0;
    for i in 0..16 {
        ss = ss + x[i] * x[i];
    }
    // rsqrt(mean + eps)
    let inv: f32 = rsqrt(ss / 16.0 + 0.00001);
    // scale by inv, in place (vectorized)
    for i in 0..16 {
        x[i] = x[i] * inv;
    }

    // sum(x²) = 1+4+...+256 = 1496; mean = 93.5; inv = 1/sqrt(93.5) ~ 0.10342
    print((x[0] * 1000.0) as i32); // 1 * 0.10342
    print((x[7] * 1000.0) as i32); // 8 * 0.10342
    print((x[15] * 1000.0) as i32); // 16 * 0.10342
    return 0;
}
