// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 1
// EXPECT-OUT: 10
// EXPECT-OUT: 36
// EXPECT-OUT: 1
// EXPECT-OUT: 6
// EXPECT-OUT: 720
// EXPECT-OUT: 1
// EXPECT-OUT: 4
// EXPECT-OUT: 11
// EXPECT-OUT: 26
module tests.run.scan_1d

// Plain single-row / flat 1-D scans: an inclusive prefix sum (cumsum), prefix product (cumprod), and
// first-order linear recurrence (lrscan / SSM). Only the batched `for r { <scan over x[r*C+i]> }`
// form was recognized before; the flat form is not an outer loop, so it fell to fully-scalar code
// (the loop-carried recurrence also defeats the generic vectorizer). These now fold to
// `mercury_{cumsum,cumprod,lrscan}_f32(.., 1, N)` (serial; 1 row) — grep the `-O2` MIR for the symbol.
// cumsum reassociates (documented reduction exception, both backends run the identical kernel);
// cumprod and lrscan are bit-identical to the scalar nest. interp == native, -O0 == -O2.

fn main() -> i32 {
    // cumsum: x = [1..8], out[i] = sum_{k<=i} x[k]
    let mut x: [f32; 8] = [0.0; 8];
    for i in 0..8 { x[i] = (i as f32) + 1.0; }
    let mut cs: [f32; 8] = [0.0; 8];
    let mut acc: f32 = 0.0;
    for i in 0..8 { acc = acc + x[i]; cs[i] = acc; }
    print((cs[0]) as i32);  // 1
    print((cs[3]) as i32);  // 1+2+3+4 = 10
    print((cs[7]) as i32);  // 1+..+8 = 36

    // cumprod: y = [1..6], out[i] = prod_{k<=i} y[k]
    let mut y: [f32; 6] = [0.0; 6];
    for i in 0..6 { y[i] = (i as f32) + 1.0; }
    let mut cp: [f32; 6] = [0.0; 6];
    let mut p: f32 = 1.0;
    for i in 0..6 { p = p * y[i]; cp[i] = p; }
    print((cp[0]) as i32);  // 1
    print((cp[2]) as i32);  // 1*2*3 = 6
    print((cp[5]) as i32);  // 6! = 720

    // lrscan: a = 2, b = [1..4], h_t = a[t]*h_{t-1} + b[t]
    let mut a: [f32; 4] = [0.0; 4];
    let mut b: [f32; 4] = [0.0; 4];
    for i in 0..4 { a[i] = 2.0; b[i] = (i as f32) + 1.0; }
    let mut lr: [f32; 4] = [0.0; 4];
    let mut h: f32 = 0.0;
    for t in 0..4 { h = a[t] * h + b[t]; lr[t] = h; }
    print((lr[0]) as i32);  // 2*0 + 1 = 1
    print((lr[1]) as i32);  // 2*1 + 2 = 4
    print((lr[2]) as i32);  // 2*4 + 3 = 11
    print((lr[3]) as i32);  // 2*11 + 4 = 26

    return 0;
}
