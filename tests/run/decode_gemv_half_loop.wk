// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: -1.5
// EXPECT-OUT: -2.5
// EXPECT-OUT: -0.5
// EXPECT-OUT: 11
// EXPECT-OUT: -5
// EXPECT-OUT: 0
// EXPECT-OUT: -1
// EXPECT-OUT: 1
// EXPECT-OUT: -1
// EXPECT-OUT: 1
// EXPECT-OUT: 1.5
// EXPECT-OUT: -0.375
// EXPECT-OUT: -0.625
// EXPECT-OUT: -0.125
// EXPECT-OUT: 2.75
// EXPECT-OUT: -1.25
// EXPECT-OUT: 0
// EXPECT-OUT: -0.25
// EXPECT-OUT: 0.25
// EXPECT-OUT: -0.25
// EXPECT-OUT: 0.25
// EXPECT-OUT: 0.375
module tests.run.decode_gemv_half_loop

// The half-weight GEMV written as a loop nest, `for j { let s = 0.0; for p { s = s + x[p] *
// (w[j*K + p] as f32) }; y[j] = s }`, is recognized into `wukong_sgemv_bf16` (and the `s += (h[..]
// as f32) * x[p]` spelling over an f16 weight into `wukong_sgemv_f16`): the weight is streamed in
// its 2-byte storage instead of being widened element by element in a scalar loop. Same data as
// tests/run/decode_gemv_half.wk (the builtin spelling), so the same expected lines:
//
//   w[j][p] = (((7j + 3p + (j*p mod 5)) mod 9) - 4) * 0.5   (bf16), the f16 weight is w/4;
//   x[p]    = (p mod 5) - 2,   N = 11 rows, K = 13.
// Every product and partial sum is exact in f32, so the recognized kernel and the loop it replaces
// (WUKONG_NO_RECOGNIZE) print the same bytes, and those are the exact dot products evaluated by
// hand: -1.5 -2.5 -0.5 11 -5 0 -1 1 -1 1 1.5, then a quarter of each.

fn main() -> i32 {
    let mut wb: [bf16; 143] = [0.0 as bf16; 143];
    let mut wh: [f16; 143] = [0.0 as f16; 143];
    let mut j0: i64 = 0;
    while j0 < 11 {
        let mut p0: i64 = 0;
        while p0 < 13 {
            let v: f32 = (((j0 * 7 + p0 * 3 + (j0 * p0) % 5) % 9) as f32 - 4.0) * 0.5;
            wb[j0 * 13 + p0] = v as bf16;
            wh[j0 * 13 + p0] = (v * 0.25) as f16;
            p0 = p0 + 1;
        }
        j0 = j0 + 1;
    }
    let mut x: [f32; 13] = [0.0; 13];
    let mut i: i64 = 0;
    while i < 13 {
        x[i] = ((i % 5) - 2) as f32;
        i = i + 1;
    }
    let mut y: [f32; 11] = [7.0; 11];
    for j in 0..11 {
        let mut s: f32 = 0.0;
        for p in 0..13 {
            s = s + x[p] * (wb[j * 13 + p] as f32);
        }
        y[j] = s;
    }
    let mut z: [f32; 11] = [7.0; 11];
    for j in 0..11 {
        let mut s: f32 = 0.0;
        for p in 0..13 {
            s += (wh[j * 13 + p] as f32) * x[p];
        }
        z[j] = s;
    }
    let mut r: i64 = 0;
    while r < 11 {
        print(y[r]);
        r = r + 1;
    }
    r = 0;
    while r < 11 {
        print(z[r]);
        r = r + 1;
    }
    return 0;
}
