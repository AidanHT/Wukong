// RUN: --run
// Index-iterating a slice with `for i in 0..s.len()` (the canonical variable-length loop) must
// compile. Regression for an ICE: `s.len()` lowers to an i64 load but sema typed the method call
// `Unknown` → `expr_mir` defaulted it to i32, so the loop built an i32 counter and emitted
// `cmp.i32 i32, i64` against the i64 length — MIR the verifier rejected. `expr_mir` now reports i64
// for `<slice>.len()`, so the loop-bound widening drives the counter at i64 and it type-checks.
// EXPECT-EXIT: 0
// EXPECT-OUT: 11
// EXPECT-OUT: 30
fn fsum(s: []f32) -> f32 {
    let mut a: f32 = 0.0;
    for i in 0..s.len() { a = a + s[i]; }
    return a;
}
fn isum(s: []i32) -> i32 {
    let mut a: i32 = 0;
    for i in 0..s.len() { a = a + s[i]; }
    return a;
}
fn main() -> i32 {
    let fa: [f32; 4] = [1.5, 2.5, 3.0, 4.0];
    let fs: []f32 = fa;
    print(fsum(fs) as i32); // 1.5+2.5+3.0+4.0 = 11

    let ia: [i32; 4] = [3, 7, 9, 11];
    let is: []i32 = ia;
    print(isum(is));        // 3+7+9+11 = 30
    return 0;
}
