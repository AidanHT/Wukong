module tests.run.arith

/// Exercises the binary arithmetic operators through the interpreter.
fn main() -> i32 {
    print(2 + 3 * 4);
    print(20 / 3);
    print((2 + 3) * 8);
    print(17 % 5);
    return 0;
}
