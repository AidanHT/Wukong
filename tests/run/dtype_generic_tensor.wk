// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 12
// EXPECT-OUT: 24
// EXPECT-OUT: 36
// EXPECT-OUT: 48
// EXPECT-OUT: 4
// EXPECT-OUT: 7
// EXPECT-OUT: 13
// EXPECT-OUT: -9
// EXPECT-OUT: 13
// EXPECT-OUT: -13
// EXPECT-OUT: -199
// EXPECT-OUT: 12884901889
// EXPECT-OUT: -4294967296
// EXPECT-OUT: 4
// EXPECT-OUT: -1
module tests.run.dtype_generic_tensor

// One body, generic over the tensor ELEMENT type as well as its length: `Tensor[T, N]` was E0302
// ("a tensor element must be a scalar type") and every kernel had to be written once per dtype.
// Each call below instantiates `axpy` at a different element (`axpy$f32`, `axpy$f64`, `axpy$i32`,
// `axpy$i64`), and every lane is printed; the expected values are `a * x[i] + y[i]` computed
// lane by lane in that element type (the i64 lanes exceed 32 bits, so a narrowed instance shows).
fn axpy<T, N>(a: T, x: Tensor[T, N], mut y: Tensor[T, N]) {
    for i in 0..N {
        y[i] = a * x[i] + y[i];
    }
}

// `alloc::<T>(n)`: the generic heap allocator, a `[]T` per instance. Copies `x` into it and reads
// back the last element.
fn last_via_heap<T, N>(x: Tensor[T, N]) -> T {
    let mut buf = alloc::<T>(N);
    for i in 0..N {
        buf[i] = x[i];
    }
    let v = buf[N - 1];
    free(buf);
    return v;
}

fn main() -> i32 {
    let xf: [f32; 4] = [1.0, 2.0, 3.0, 4.0];
    let mut yf: [f32; 4] = [10.0, 20.0, 30.0, 40.0];
    axpy(2.0, xf, yf);
    for i in 0..4 {
        print(yf[i]); // 2*1+10, 2*2+20, 2*3+30, 2*4+40
    }

    let ad: f64 = 3.0;
    let xd: [f64; 3] = [1.0, 2.0, 4.0];
    let mut yd: [f64; 3] = [1.0, 1.0, 1.0];
    axpy(ad, xd, yd);
    for i in 0..3 {
        print(yd[i]); // 3*1+1, 3*2+1, 3*4+1
    }

    let xi: [i32; 4] = [5, -6, 7, 100];
    let mut yi: [i32; 4] = [1, 1, 1, 1];
    axpy(-2, xi, yi);
    for i in 0..4 {
        print(yi[i]); // -2*5+1, -2*-6+1, -2*7+1, -2*100+1
    }

    let al: i64 = 4294967296;
    let xl: [i64; 2] = [3, -1];
    let mut yl: [i64; 2] = [1, 0];
    axpy(al, xl, yl);
    for i in 0..2 {
        print(yl[i]); // 3*2^32+1, -2^32+0
    }

    print(last_via_heap(xf)); // 4
    print(last_via_heap(xl)); // -1
    return 0;
}
