// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 0
// EXPECT-OUT: 0
// EXPECT-OUT: 1
// EXPECT-OUT: 0
// EXPECT-OUT: 0
// EXPECT-OUT: 0
// EXPECT-OUT: 16777216
module tests.run.strict_fp

// `@strict_fp`: the function's float arithmetic is evaluated in source order with one IEEE
// rounding per operation — no FMA contraction, no reassociated reduction, no recognized kernel.
// `tests/run/fp_contract_rules.wk` is the default-mode twin (same inputs, contracted results), and
// `tests/run/strict_fp_cli.wk` is the program-wide `--fp=strict` spelling. Every expected value is
// derived by hand from IEEE-754 single precision:
//
//   x = -(1 + 2^-11),  y = z = 1 + 2^-12,  w = 1      (all exact in f32)
//   round(y*z) = 1 + 2^-11   (y*z = 1 + 2^-11 + 2^-24 exactly is a tie; the even neighbour wins)
//   x + round(y*z) = 0, while the contracted fma(y, z, x) = 2^-24.
// Results print as (r * 2^24) as i32, an exact scale: a fused value prints 1, a strict one 0.

// 1. `x + y*z` in a strict function: two roundings                                    -> 0
@strict_fp
fn strict_addend(x: f32, y: f32, z: f32) -> f32 {
    return x + y * z;
}

// 2. Two products, neither fused: round(y*z) + round(x*w) = (1 + 2^-11) + x = 0        -> 0
@strict_fp
fn strict_two_products(x: f32, y: f32, z: f32, w: f32) -> f32 {
    return y * z + x * w;
}

// 3. Strictness belongs to the function BODY, not to its callees: a fast callee keeps its
//    contraction even when it is inlined into this strict caller at -O2               -> 1
fn fast_addend(x: f32, y: f32, z: f32) -> f32 {
    return x + y * z;
}

@strict_fp
fn strict_calls_fast(x: f32, y: f32, z: f32) -> f32 {
    return fast_addend(x, y, z);
}

// 4. A strict elementwise loop still vectorizes lane-wise, but neither the vector body (lanes 0
//    and 7) nor the scalar remainder (lane 8) contracts                                -> 0 0 0
@strict_fp
fn strict_lanes(x: [f32; 9], y: [f32; 9], z: [f32; 9], mut o: [f32; 9]) {
    for i in 0..9 {
        o[i] = x[i] + y[i] * z[i];
    }
}

// 5. A strict float reduction keeps its sequential fold. s starts at 0; x[0] = 2^24 and the other
//    fifteen elements are 1. Left to right, every `2^24 + 1` is a tie between 2^24 (even) and
//    2^24 + 2, so it rounds back to 2^24 each time and the sum stays 16777216. A reassociated
//    tree adds the ones to each other first and lands above 2^24.                     -> 16777216
@strict_fp
fn strict_sum(x: [f32; 16]) -> f32 {
    let mut s: f32 = 0.0;
    for i in 0..16 {
        s = s + x[i];
    }
    return s;
}

fn main() -> i32 {
    let x: f32 = -1.00048828125;
    let y: f32 = 1.000244140625;
    let z: f32 = 1.000244140625;
    let w: f32 = 1.0;

    print((strict_addend(x, y, z) * 16777216.0) as i32); // 0
    print((strict_two_products(x, y, z, w) * 16777216.0) as i32); // 0
    print((strict_calls_fast(x, y, z) * 16777216.0) as i32); // 1

    let mut xs: [f32; 9] = [0.0; 9];
    let mut ys: [f32; 9] = [0.0; 9];
    let mut zs: [f32; 9] = [0.0; 9];
    let mut o: [f32; 9] = [0.0; 9];
    for c in 0..9 {
        xs[c] = x;
        ys[c] = y;
        zs[c] = z;
    }
    strict_lanes(xs, ys, zs, o);
    print((o[0] * 16777216.0) as i32); // 0
    print((o[7] * 16777216.0) as i32); // 0
    print((o[8] * 16777216.0) as i32); // 0

    let mut big: [f32; 16] = [1.0; 16];
    big[0] = 16777216.0;
    print(strict_sum(big) as i32); // 16777216
    return 0;
}
