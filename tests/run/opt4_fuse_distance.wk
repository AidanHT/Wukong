// EXPECT-OUT: 516
module tests.run.opt4_fuse_distance

// Adjacent loops over the same range where the second reads what the first stored some iterations
// EARLIER, which `wukong_opt::fuse` merges at -O2: in the fused loop that store has already run
// when the read does, at every distance d > 0 and at a non-unit stride. `ahead` reads one element
// the first loop writes one iteration LATER, so those two loops must stay apart -- its lanes would
// read the untouched initial values if they were fused. (Each body divides, which keeps the loops
// loops: the front end's elementwise vectorizer declines a division.)
//
// a[k] = k*k - 40; t starts at 1000 + k and o at -1 before every call; `/` truncates toward zero.
// Expected values from the scalar loops, for n = 0, 1, 2, 9, 32:
//   dist1   t[i] = a[i]/3 + 7       (1 <= i < n);  o[j] = t[j-1]/2 - t[j]     (1 <= j < n)
//   dist2   t[i] = a[i]/3 - i       (2 <= i < n);  o[j] = t[j-2]/2 + 3*t[j]   (2 <= j < n)
//   stride2 t[2i] = a[i]/3          (1 <= i < n);  o[j] = t[2j-2]/2 + j      (1 <= j < n)
//   ahead   t[i] = a[i]/5           (0 <= i < n);  o[j] = t[j+1]/2           (0 <= j < n)
// and every lane of o (32 per call) is printed.

fn dist1(a: [i32; 32], mut t: [i32; 64], mut o: [i32; 32], n: i32) {
    for i in 1..n {
        t[i] = a[i] / 3 + 7;
    }
    for j in 1..n {
        o[j] = t[j - 1] / 2 - t[j];
    }
}

fn dist2(a: [i32; 32], mut t: [i32; 64], mut o: [i32; 32], n: i32) {
    for i in 2..n {
        t[i] = a[i] / 3 - i;
    }
    for j in 2..n {
        o[j] = t[j - 2] / 2 + t[j] * 3;
    }
}

fn stride2(a: [i32; 32], mut t: [i32; 64], mut o: [i32; 32], n: i32) {
    for i in 1..n {
        t[i * 2] = a[i] / 3;
    }
    for j in 1..n {
        o[j] = t[j * 2 - 2] / 2 + j;
    }
}

fn ahead(a: [i32; 32], mut t: [i32; 64], mut o: [i32; 32], n: i32) {
    for i in 0..n {
        t[i] = a[i] / 5;
    }
    for j in 0..n {
        o[j] = t[j + 1] / 2;
    }
}

fn reset(mut t: [i32; 64], mut o: [i32; 32]) {
    for k in 0..64 {
        t[k] = 1000 + k;
    }
    for k in 0..32 {
        o[k] = 0 - 1;
    }
}

fn show(o: [i32; 32]) {
    for k in 0..32 {
        print(o[k]);
    }
}

fn main() -> i32 {
    let mut a: [i32; 32] = [0; 32];
    for k in 0..32 {
        a[k] = k * k - 40;
    }
    let mut t: [i32; 64] = [0; 64];
    let mut o: [i32; 32] = [0; 32];
    let ns: [i32; 5] = [0, 1, 2, 9, 32];
    for q in 0..5 {
        let n = ns[q];
        reset(t, o);
        dist1(a, t, o, n);
        show(o);
        reset(t, o);
        dist2(a, t, o, n);
        show(o);
        reset(t, o);
        stride2(a, t, o, n);
        show(o);
        reset(t, o);
        ahead(a, t, o, n);
        show(o);
    }
    return 0;
}
