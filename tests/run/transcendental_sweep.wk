// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 0
// EXPECT-OUT: 43836
module tests.run.transcendental_sweep

// A breadth sweep over the 2026-06 transcendental additions, exercising the paths that the
// per-function tests don't combine: a **fused multi-statement body** (several distinct activations
// over the same range → one `wukong_vmath_f32` call each, in source order) and an **@parallel**
// body (each thread's chunk dispatched). Every op composes the shared exp/log/sin/cos/atan/√, so the
// dispatched kernel, the scalar tail, and the inlined MIR all agree — this pins interp == native and
// -O0 == -O3 across the whole expanded set at once.
//
// TWO PRINTED LINES, read this before changing them.
//
// Line 1 (expected 0) is the real per-lane assertion for the @parallel dispatch arm. The parallel
// exp10/cbrt must equal a serial computation LANE FOR LANE: a chunk-boundary defect (a thread
// writing a neighbour's lane, a dropped tail chunk) that happened to preserve the folded checksum
// below would pass the checksum and fail here. The two serial sides are NOT the same kind of
// thing, and the difference matters when this line fails:
//   * cbrt: `cs` is its own single-statement loop, dispatched serially (`wukong_vmath_f32`, op 35),
//     so pc-vs-cs is parallel kernel vs serial kernel — elementwise, so bit-for-bit by construction.
//   * exp10: `e10` comes from the first fused body, which at -O2 is NOT dispatched (the census's
//     four serial `wukong_vmath_f32` calls are tan/asin/acos and the cbrt loop), so pe-vs-e10 is the
//     parallel kernel against the GENERIC inline lowering of exp10. It is 0 because the vmath kernel
//     and the scalar/inline composition are bit-exact by contract; a mismatch here can therefore be
//     a kernel-vs-twin divergence, not only a chunking defect.
//
// Line 2 (43836) is a FOLDED CHECKSUM over 576 results, kept only as a coarse CHANGE DETECTOR for
// the nine ops' dispatch, NOT a hand-derived value — a single f32 sum near 438 cannot localise
// which op moved and absorbs per-lane errors of order 1e-2, so it is not the oracle. The ops' math
// is proven by `wukong_runtime`'s `vmath.rs` f64-reference table, and the @parallel arm is proven
// per lane on line 1. If the checksum ever changes, DO NOT re-paste it to make the failure go away:
// find which op moved (that is what the per-function vmath tests are for) and record the ULP cause
// in the commit body.

@parallel
fn par_sweep(x: [f32; 64], mut a: [f32; 64], mut b: [f32; 64]) {
    for i in 0..64 { a[i] = exp10(x[i]); }
    for i in 0..64 { b[i] = cbrt(x[i]); }
}

fn checksum(v: [f32; 64]) -> f32 {
    let mut s: f32 = 0.0;
    for k in 0..64 { s = s + v[k]; }
    return s;
}

fn main() -> i32 {
    // x in [0, 0.63] — safe for every op below (asin/acos need |x|<1, tan off the poles, log10>0
    // via the +1.0 shift).
    let mut x: [f32; 64] = [0.0; 64];
    for i in 0..64 { x[i] = (i as f32) * 0.01; }

    // Fused multi-statement body: 4 distinct kernels dispatched over the same range, in order.
    let mut e10: [f32; 64] = [0.0; 64];
    let mut l10: [f32; 64] = [0.0; 64];
    let mut ss: [f32; 64] = [0.0; 64];
    let mut lsg: [f32; 64] = [0.0; 64];
    for i in 0..64 {
        e10[i] = exp10(x[i]);
        l10[i] = log10(x[i] + 1.0);
        ss[i] = softsign(x[i]);
        lsg[i] = logsigmoid(x[i]);
    }

    // Inverse trig (second fused body).
    let mut tn: [f32; 64] = [0.0; 64];
    let mut asn: [f32; 64] = [0.0; 64];
    let mut acs: [f32; 64] = [0.0; 64];
    for i in 0..64 {
        tn[i] = tan(x[i]);
        asn[i] = asin(x[i]);
        acs[i] = acos(x[i]);
    }

    // @parallel sweep (multicore × 256-bit) — must match the serial dispatch bit-for-bit.
    let mut pe: [f32; 64] = [0.0; 64];
    let mut pc: [f32; 64] = [0.0; 64];
    par_sweep(x, pe, pc);

    // Per-lane proof of the @parallel arm. pe[i] = exp10(x[i]) is compared with e10[i] from the first
    // fused body (generic inline lowering, not a dispatch — see the header); cbrt has no serial twin
    // above, so compute one here (this loop IS dispatched serially) and compare. A count of
    // inequalities is 0 iff every one of the 128 lanes matches — unlike the checksum it cannot be
    // passed by a chunk-boundary defect that preserves the total.
    let mut cs: [f32; 64] = [0.0; 64];
    for i in 0..64 { cs[i] = cbrt(x[i]); }
    let mut mism: i32 = 0;
    for i in 0..64 {
        if pe[i] != e10[i] { mism = mism + 1; }
        if pc[i] != cs[i] { mism = mism + 1; }
    }
    print(mism); // 0 — @parallel exp10/cbrt == serial dispatch, every one of the 128 lanes

    // One combined checksum (scaled) folds every result; a coarse change detector for the nine ops.
    let total = checksum(e10) + checksum(l10) + checksum(ss) + checksum(lsg)
        + checksum(tn) + checksum(asn) + checksum(acs) + checksum(pe) + checksum(pc);
    print((total * 100.0 + 0.5) as i32);
    return 0;
}
