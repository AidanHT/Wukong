// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 8
// EXPECT-OUT: 12
// EXPECT-OUT: 14
// EXPECT-OUT: 18
// EXPECT-OUT: 78
module tests.run.scatter_add

// Scatter-add — the embedding-gradient backward, the dual of the gather: each upstream-gradient row is
// routed back to the weight row its token came from and ACCUMULATED. grad_w[ids[t],:] += grad_out[t,:]
// over a [V=2, H=3] table and length-T=4 i32 ids. Colliding tokens (a row hit twice) sum — the whole
// point of an embedding gradient. The recognizer folds the 2-deep nest to one `wukong_scatter_add_f32`
// call (deriving V=2 from grad_w's [f32; 6] length / H=3); collisions fold in ascending token order
// (== the scalar nest), so the differential gate (interp == native) is bit-exact with no reassociation.
fn main() -> i32 {
    // grad_out[t*3 + d] = t*3 + d + 1, so row t = [3t+1, 3t+2, 3t+3].
    let mut grad_out: [f32; 12] = [0.0; 12];
    for i in 0..12 { grad_out[i] = (i as f32) + 1.0; }

    let ids: [i32; 4] = [0, 1, 0, 1]; // tokens 0,2 -> row 0; tokens 1,3 -> row 1 (each row hit twice)
    let mut grad_w: [f32; 6] = [0.0; 6]; // [V=2, H=3], pre-zeroed accumulator

    for t in 0..4 {
        for d in 0..3 {
            grad_w[ids[t] * 3 + d] += grad_out[t * 3 + d];
        }
    }

    // row 0 = grad_out[0] + grad_out[2] = [1,2,3] + [7,8,9]    = [8,10,12]
    // row 1 = grad_out[1] + grad_out[3] = [4,5,6] + [10,11,12] = [14,16,18]
    print(grad_w[0] as i32); // 8
    print(grad_w[2] as i32); // 12
    print(grad_w[3] as i32); // 14
    print(grad_w[5] as i32); // 18

    // Conservation: Σ grad_w == Σ grad_out = 1+2+...+12 = 78 (every token's gradient lands somewhere).
    let mut s: f32 = 0.0;
    for i in 0..6 { s = s + grad_w[i]; }
    print(s as i32); // 78
    return 0;
}
