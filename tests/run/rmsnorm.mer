// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 103
// EXPECT-OUT: 827
// EXPECT-OUT: 1654
module tests.run.rmsnorm

// RMSNorm — the normalization in Llama/Mistral/modern LLMs: y = x · rsqrt(mean(x²)+eps) · g. It
// composes a sum-of-squares reduction (Mercury reassociates it to lane accumulators), a hardware
// rsqrt, and a vectorized scale. Over a realistic feature group (here 16) the f32 sum is exact
// enough that it matches a serial sum; the gate proves native == interp bit-for-bit regardless.
fn main() -> i32 {
    let mut x: [f32; 16] = [0.0; 16];
    let g: [f32; 16] = [1.0; 16];
    let mut out: [f32; 16] = [0.0; 16];
    for i in 0..16 {
        x[i] = (i as f32) + 1.0; // 1 .. 16
    }

    // sum of squares (reduction)
    let mut ss: f32 = 0.0;
    for i in 0..16 {
        ss = ss + x[i] * x[i];
    }
    // rsqrt(mean + eps)
    let inv: f32 = rsqrt(ss / 16.0 + 0.00001);
    // scale by inv and the per-element gain (vectorized)
    for i in 0..16 {
        out[i] = x[i] * inv * g[i];
    }

    // sum(x²) = 1+4+...+256 = 1496; mean = 93.5; inv = 1/sqrt(93.5) ~ 0.10342
    print((out[0] * 1000.0) as i32); // 1 * 0.10342
    print((out[7] * 1000.0) as i32); // 8 * 0.10342
    print((out[15] * 1000.0) as i32); // 16 * 0.10342
    return 0;
}
