// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 0
// EXPECT-OUT: 1.5
// EXPECT-OUT: 5
// EXPECT-OUT: 12
// EXPECT-OUT: 12
// EXPECT-OUT: 34
// EXPECT-OUT: 56
// EXPECT-OUT: 1
// EXPECT-OUT: 3
// EXPECT-OUT: 5
// EXPECT-OUT: 103
// EXPECT-OUT: 406
// EXPECT-OUT: 123
// EXPECT-OUT: 456
// EXPECT-OUT: 30
// EXPECT-OUT: 56
// EXPECT-OUT: 90
// EXPECT-OUT: 0.5
// EXPECT-OUT: 1.5
// EXPECT-OUT: 2.5
// EXPECT-OUT: 4
// EXPECT-OUT: 11
// EXPECT-OUT: 29
// EXPECT-OUT: 10
// EXPECT-OUT: 30
// EXPECT-OUT: 105
// EXPECT-OUT: 111
// EXPECT-OUT: 1
// EXPECT-OUT: 2
// EXPECT-OUT: 3
// EXPECT-OUT: 4
// EXPECT-OUT: 12
// EXPECT-OUT: 64
module tests.run.for_destructure

// A destructuring `for` head over an array or a slice binds each element exactly as
// `let <pat> = a[i];` would: a scalar part is copied into a fresh slot, an aggregate part is bound
// by pointer. The pattern must be irrefutable by its form (tuples, structs, array patterns,
// `name @ sub`, `_`); a literal in it is E0442 (tests/fail/for_head_refutable.wk) and a range
// iterand is E0401 (tests/fail/for_range_destructure.wk).
//
// Expected values by hand:
//   (i, x) over (0, 0.5) (1, 1.5) (2, 2.5) (3, 4.0): i * x        -> 0 1.5 5 12
//   Point { x, y } over (1,2) (3,4) (5,6): 10x + y                -> 12 34 56
//   Point { x: px, .. }: px                                        -> 1 3 5
//   [a, .., z] over [1,2,3] [4,5,6]: 100a + z                      -> 103 406
//   ((a, b), c) over ((1,2),3) ((4,5),6): 100a + 10b + c           -> 123 456
//   (p, q) over the slice (5,6) (7,8) (9,10): p * q                -> 30 56 90
//   (_, v) over the first array: v                                 -> 0.5 1.5 2.5 4
//   w @ (a, b) over (2,3) (4,5): a + b + w.0 * w.1                 -> 2+3+6 = 11, 4+5+20 = 29
//   (k, v) over (1,10)..(5,50), skipping k = 2, stopping at k = 4  -> 10 30
//   (a, b) over (1,2) (3,4), a += 100 and b *= 2: a + b            -> 105 111
//     ... and the array is unchanged                               -> 1 2 3 4
//   (row, k) over ([1,2],10) ([3,4],20): row[0] * k + row[1]       -> 12 64

struct Point { x: i32, y: i32 }

fn products(s: [](i32, i32)) {
    for (p, q) in s {
        print(p * q);
    }
}

fn main() -> i32 {
    let pairs: [(i32, f32); 4] = [(0, 0.5), (1, 1.5), (2, 2.5), (3, 4.0)];
    for (i, x) in pairs {
        print((i as f32) * x);
    }

    let pts: [Point; 3] = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }, Point { x: 5, y: 6 }];
    for Point { x, y } in pts {
        print(x * 10 + y);
    }
    for Point { x: px, .. } in pts {
        print(px);
    }

    let rows: [[i32; 3]; 2] = [[1, 2, 3], [4, 5, 6]];
    for [a, .., z] in rows {
        print(a * 100 + z);
    }

    let nest: [((i32, i32), i32); 2] = [((1, 2), 3), ((4, 5), 6)];
    for ((a, b), c) in nest {
        print(a * 100 + b * 10 + c);
    }

    let s: [](i32, i32) = [(5, 6), (7, 8), (9, 10)];
    products(s);

    for (_, v) in pairs {
        print(v);
    }

    let ab: [(i32, i32); 2] = [(2, 3), (4, 5)];
    for w @ (a, b) in ab {
        print(a + b + w.0 * w.1);
    }

    let kv: [(i32, i32); 5] = [(1, 10), (2, 20), (3, 30), (4, 40), (5, 50)];
    for (k, v) in kv {
        if k == 2 {
            continue;
        }
        if k == 4 {
            break;
        }
        print(v);
    }

    // Mutating a destructured scalar changes the copy, never the element.
    let cells: [(i32, i32); 2] = [(1, 2), (3, 4)];
    for (a, b) in cells {
        a = a + 100;
        b = b * 2;
        print(a + b);
    }
    print(cells[0].0);
    print(cells[0].1);
    print(cells[1].0);
    print(cells[1].1);

    // An aggregate part is bound by pointer and indexed in place.
    let grid: [([i32; 2], i32); 2] = [([1, 2], 10), ([3, 4], 20)];
    for (row, k) in grid {
        print(row[0] * k + row[1]);
    }
    return 0;
}
