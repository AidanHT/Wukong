// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 6
// EXPECT-OUT: 8
// EXPECT-OUT: 8
// EXPECT-OUT: 10
module tests.run.matmul_f16_tn

// f16 mixed-precision C = Aᵀ·B — the dW = dYᵀ·X weight-gradient GEMM, in IEEE f16 (the F16C widen is
// exact for these small integers). Same transposed-A / normal-B nest as the bf16 twin; the recognizer
// dispatches to wukong_sgemm_f16_tn (lossless f16 widen prepass → the f32 wukong_sgemm_tn). The
// differential gate is bit-for-bit (interp == native, -O0 == -O3). A is stored [K=3, M=2], B is
// [K=3, N=3], C is [M=2, N=3].
fn main() -> i32 {
    // A stored [K=3, M=2] = [[1,2],[3,4],[5,6]] (so Aᵀ = [[1,3,5],[2,4,6]]).
    let mut a: [f16; 6] = [0.0 as f16; 6];
    for i in 0..6 {
        a[i] = ((i + 1) as f32) as f16; // 1 .. 6
    }
    // B stored [K=3, N=3] = [[1,1,0],[0,1,1],[1,0,1]].
    let mut b: [f16; 9] = [0.0 as f16; 9];
    b[0] = 1.0 as f16;
    b[1] = 1.0 as f16;
    b[4] = 1.0 as f16;
    b[5] = 1.0 as f16;
    b[6] = 1.0 as f16;
    b[8] = 1.0 as f16;
    let mut c: [f32; 6] = [0.0; 6];

    // C[i,j] = Σ_p Aᵀ[i,p]·B[p,j] = Σ_p a[p*M + i] · b[p*N + j]   (f16 reads widen to f32 via F16C)
    for i in 0..2 {
        for j in 0..3 {
            let mut s: f32 = 0.0;
            for p in 0..3 {
                s = s + (a[p * 2 + i] as f32) * (b[p * 3 + j] as f32);
            }
            c[i * 3 + j] = s;
        }
    }
    // C = Aᵀ·B = [[6,4,8],[8,6,10]].
    print(c[0] as i32); // 6
    print(c[2] as i32); // 8
    print(c[3] as i32); // 8
    print(c[5] as i32); // 10
    return 0;
}
