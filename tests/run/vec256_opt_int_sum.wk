module tests.run.vec256_opt_int_sum

// Integer sums the optimizer hands to a 256-bit REDUCTION kernel (-O2): `s = s + e(i)` over i32 and
// i64 slices, the loop the 128-bit vectorizer widens with lane-parallel partials, now folded for
// its whole register groups by the raw-AVX2 recipe (four accumulators of eight or four lanes) and
// the remainder by the 128-bit loop and the scalar tail. Integer addition wraps and is
// associative, so any grouping is the scalar loop's sum; the addends here overflow (`x * 3` in
// i32, `i * 4611686018427387` in i64) so a grouping or width mistake cannot cancel out.
//
// Each line is one trip n = 2040 .. 2064: below 2048 the kernel is skipped at run time and the
// 128-bit loop sums everything; from 2048 the kernel takes n rounded down to whole groups, and the
// remainder is every length from 0 to 16. Each sum is kept OUT of line (the sums and `again` call
// each other, so the inliner splices neither into `main`), so its trip is a runtime value.
//
// Expected values, derived by hand from the scalar loops with two's-complement wrapping:
//   x[i] = (i * 2654435761) % 2000000000, y[i] = (i * 40503) % 1000 - 500   (as i32)
//   z[i] = i * 4611686018427387 + 17                                        (i64, wrapping)
//   s32(n) = 7 + sum_{i<n} (3 * x[i] - y[i])  mod 2^32, printed signed
//   s64(n) = -5 + sum_{i<n} (z[i] - 9)        mod 2^64, printed signed

fn s32(x: []i32, y: []i32, n: i64, d: i64) -> i32 {
    if d > 0 {
        return again(d - 1) as i32;
    }
    let mut s: i32 = 7;
    let mut i: i64 = 0;
    while i < n {
        s = s + (x[i] * 3 - y[i]);
        i = i + 1;
    }
    return s;
}

fn s64(z: []i64, n: i64, d: i64) -> i64 {
    if d > 0 {
        return again(d - 1);
    }
    let mut s: i64 = -5;
    let mut i: i64 = 0;
    while i < n {
        s = s + (z[i] - 9);
        i = i + 1;
    }
    return s;
}

fn again(d: i64) -> i64 {
    let mut a: []i32 = alloc_i32(1);
    let mut b: []i64 = alloc_i64(1);
    return s32(a, a, 1, d) as i64 + s64(b, 1, d);
}

fn main() -> i32 {
    let m: i64 = 2064;
    let mut x: []i32 = alloc_i32(m);
    let mut y: []i32 = alloc_i32(m);
    let mut z: []i64 = alloc_i64(m);
    let mut i: i64 = 0;
    while i < m {
        x[i] = (i * 2654435761 % 2000000000) as i32;
        y[i] = (i * 40503 % 1000 - 500) as i32;
        z[i] = i * 4611686018427387 + 17;
        i = i + 1;
    }
    let mut n: i64 = 2040;
    while n <= m {
        print_raw(s32(x, y, n, 0));
        print_raw(" ");
        print_raw(s64(z, n, 0));
        print_raw("\n");
        n = n + 1;
    }
    free(x);
    free(y);
    free(z);
    return 0;
}
