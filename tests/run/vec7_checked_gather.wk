// EXPECT-EXIT: 0
// EXPECT-OUT: -2
// EXPECT-OUT: -19
// EXPECT-OUT: -4
// EXPECT-OUT: -7
// EXPECT-OUT: 2
// EXPECT-OUT: 3
// EXPECT-OUT: 16
// EXPECT-OUT: 11
// EXPECT-OUT: 38
// EXPECT-OUT: 27
// EXPECT-OUT: 8
// EXPECT-OUT: 51
// EXPECT-OUT: 26
// EXPECT-OUT: 42
// EXPECT-OUT: 17
// EXPECT-OUT: 25
// EXPECT-OUT: -3
// EXPECT-OUT: 71
// EXPECT-OUT: 10
// EXPECT-OUT: 39
// EXPECT-OUT: -10
// EXPECT-OUT: 58
// EXPECT-OUT: 33
// EXPECT-OUT: 41
// EXPECT-OUT: 13
// EXPECT-OUT: 87
module tests.run.vec7_checked_gather

// Checked gathers in widened loops (-O2). `t[q[i]]` over a `[]T` slice is bounds-checked, and its
// index is data: `bce` versions the loop but cannot prove that check, so the copy it keeps for the
// vector path still tests it on every iteration - a second loop exit the vectorizer used to refuse.
// Now the check is a lane test: the group's four indices are compared against the length at once,
// and a group with any failing lane leaves for the scalar loop at its first iteration, which stops
// at exactly the iteration, with exactly the message, it always did (vec7_checked_gather_trap.wk).
// Here no index fails, so every group stays in the vector loop. `gather_i32` gathers `[]i32`
// elements through `[]i64` indices: the test runs on two `<2 x i64>` parts per group of four.
//
// The kernels are kept OUT of line (they and `again` call each other). n = 13 is three groups of
// four and a scalar tail of one. Every expected line is the scalar loop's answer, by hand:
//
//   gather_f32: t[k] = k + 1/2 (k < 5), q[j] = 3j mod 5, x[j] = j - 4,
//               o[j] = t[q[j]] * x[j] + 1, printed as o[j] * 2.
//               j = 0: q = 0, t = 1/2, x = -4 -> -1, printed -2.
//   gather_i32: t = [9, -3, 14, 0, 7, -8, 21, 5], q[j] = (5j + 2) mod 8, x[j] = 2j,
//               o[j] = t[q[j]] * 3 + x[j].
//               j = 0: q = 2, t = 14 -> 42.

fn gather_f32(t: []f32, q: []i32, x: []f32, @noalias mut o: []f32, n: i64, z: i64) {
    if z > 0 {
        again(z - 1);
        return;
    }
    let mut i: i64 = 0;
    while i < n {
        o[i] = t[q[i] as i64] * x[i] + 1.0;
        i = i + 1;
    }
}

fn gather_i32(t: []i32, q: []i64, x: []i32, @noalias mut o: []i32, n: i64, z: i64) {
    if z > 0 {
        again(z - 1);
        return;
    }
    let mut i: i64 = 0;
    while i < n {
        o[i] = t[q[i]] * 3 + x[i];
        i = i + 1;
    }
}

fn again(z: i64) {
    let mut t: []f32 = alloc_f32(1);
    let mut u: []f32 = alloc_f32(1);
    let mut q: []i32 = alloc_i32(1);
    let mut v: []i32 = alloc_i32(1);
    let mut w: []i64 = alloc_i64(1);
    gather_f32(t, q, t, u, 1, z);
    gather_i32(q, w, q, v, 1, z);
}

fn main() -> i32 {
    let mut t: []f32 = alloc_f32(5);
    let mut q: []i32 = alloc_i32(13);
    let mut x: []f32 = alloc_f32(13);
    let mut o: []f32 = alloc_f32(13);
    let mut tt: []i32 = alloc_i32(8);
    let mut qt: []i64 = alloc_i64(13);
    let mut xt: []i32 = alloc_i32(13);
    let mut ot: []i32 = alloc_i32(13);
    let mut j: i64 = 0;
    while j < 5 {
        t[j] = (j as f32) + 0.5;
        j = j + 1;
    }
    tt[0] = 9;
    tt[1] = -3;
    tt[2] = 14;
    tt[3] = 0;
    tt[4] = 7;
    tt[5] = -8;
    tt[6] = 21;
    tt[7] = 5;
    j = 0;
    while j < 13 {
        q[j] = ((j * 3) % 5) as i32;
        x[j] = (j as f32) - 4.0;
        qt[j] = (j * 5 + 2) % 8;
        xt[j] = (j * 2) as i32;
        j = j + 1;
    }
    gather_f32(t, q, x, o, 13, 0);
    j = 0;
    while j < 13 {
        print((o[j] * 2.0) as i64);
        j = j + 1;
    }
    gather_i32(tt, qt, xt, ot, 13, 0);
    j = 0;
    while j < 13 {
        print(ot[j]);
        j = j + 1;
    }
    return 0;
}
