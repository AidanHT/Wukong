module tests.run.velem_modes_every_lane

/// EVERY LANE of each recognized `wukong_velem_f32` compute mode, over a length that crosses all
/// three code paths of the kernel: the x4 unrolled body (32 elements), the 8-wide tail, and the
/// scalar tail (41 = 32 + 8 + 1).
///
/// Recognized kernels are GATE-BLIND: the recognizer fires identically on interp and native at
/// every -O level, so neither the differential gate nor the opt-invariance gate can see whether the
/// kernel fired or whether it computed the right thing. This fixture is the only thing that can.
/// It exists because `velem_avx2` selects its body by compute MODE (identity-affine / one-input
/// affine / two-input affine / Hadamard / quotient) and by activation, and a mis-selected mode is
/// wrong on every lane of one mode while every other mode stays right — invisible to any fixture
/// that prints a reduction or a single lane.
///
/// The expected values are the scalar semantics of each loop, not a recording of compiler output:
/// x[i] = 2*(i-20) (so -40..40 step 2) and y[i] = 2, chosen so every result is a small exact
/// integer in f32 and can be read off by hand.
fn main() -> i32 {
    let mut x: [f32; 41] = [0.0; 41];
    for i in 0..41 { x[i] = (i as f32) * 2.0 - 40.0; }
    let y: [f32; 41] = [2.0; 41];
    let mut o: [f32; 41] = [0.0; 41];

    for i in 0..41 { o[i] = if x[i] > 0.0 { x[i] } else { 0.0 }; }
    for k in 0..41 { print(o[k] as i32); }

    for i in 0..41 { o[i] = if x[i] < 6.0 { if x[i] > 0.0 { x[i] } else { 0.0 } } else { 6.0 }; }
    for k in 0..41 { print(o[k] as i32); }

    for i in 0..41 { o[i] = 2.0 * x[i] + 1.0; }
    for k in 0..41 { print(o[k] as i32); }

    for i in 0..41 { o[i] = 2.0 * x[i] + y[i]; }
    for k in 0..41 { print(o[k] as i32); }

    for i in 0..41 { o[i] = x[i] * y[i]; }
    for k in 0..41 { print(o[k] as i32); }

    for i in 0..41 { o[i] = x[i] / y[i]; }
    for k in 0..41 { print(o[k] as i32); }

    return 0;
}
