module tests.run.vec4_argmax_last_ties

// Non-strict argmax / argmin (`x[i] >= m`, `m >= y[i]`) and a non-strict FindLastIV (`x[i] >= t`)
// over slices in `while` loops: a tie MOVES the recorded index, so the LAST maximal (minimal)
// element wins. The general vectorizer widens them with per-lane `(value, index)` partials whose
// index lanes start one below the first counter ("never updated") and an exit fold that takes the
// best value and, among equal values, the LATER index — a lane that tied the start value and moved
// must beat a lane that never moved.
//
// Every expected line is derived by hand from the scalar loop, at EVERY trip 0..len so the split
// between the vector loop and the scalar epilogue moves through every position. `-0.0 >= +0.0` and
// `+0.0 >= -0.0` are both true (one class), so the last zero wins and its sign is the maximum's; an
// ordered compare against NaN is false, so a NaN element never updates and a NaN start updates
// nothing.

// f32 argmax, last tie; the maximum comes back through out[0].
@unchecked
fn amax_last(x: []f32, n: i64, m0: f32, mut out: []f32) -> i64 {
    let mut m: f32 = m0;
    let mut at: i64 = -1;
    let mut i: i64 = 0;
    while i < n {
        if x[i] >= m {
            m = x[i];
            at = i;
        }
        i = i + 1;
    }
    out[0] = m;
    return at;
}

// i32 argmin with the accumulator on the LEFT (`m >= y[i]`), last tie.
@unchecked
fn amin_last(y: []i32, n: i64, m0: i32, mut out: []i32) -> i64 {
    let mut m: i32 = m0;
    let mut at: i64 = -1;
    let mut i: i64 = 0;
    while i < n {
        if m >= y[i] {
            m = y[i];
            at = i;
        }
        i = i + 1;
    }
    out[0] = m;
    return at;
}

// f64 argmax, last tie (two lanes).
@unchecked
fn amaxd_last(d: []f64, n: i64, m0: f64, mut out: []f64) -> i64 {
    let mut m: f64 = m0;
    let mut at: i64 = -1;
    let mut i: i64 = 0;
    while i < n {
        if d[i] >= m {
            m = d[i];
            at = i;
        }
        i = i + 1;
    }
    out[0] = m;
    return at;
}

// FindLastIV with a non-strict condition: the last index whose element is >= t.
@unchecked
fn flast_ge(x: []f32, n: i64, t: f32) -> i64 {
    let mut last: i64 = -1;
    let mut i: i64 = 0;
    while i < n {
        if x[i] >= t {
            last = i;
        }
        i = i + 1;
    }
    return last;
}

fn main() -> i32 {
    let mut x: []f32 = alloc_f32(13);
    let mut out: []f32 = alloc_f32(1);
    x[0] = 3.0; x[1] = 7.0; x[2] = 1.0; x[3] = 7.0; x[4] = 9.0; x[5] = 2.0; x[6] = 9.0;
    x[7] = 0.0; x[8] = 9.0; x[9] = 5.0; x[10] = 4.0; x[11] = 9.0; x[12] = 8.0;

    // From -100: (at, max) = (-1,-100) (0,3) (1,7) (1,7) (3,7) (4,9) (4,9) (6,9) (6,9) (8,9)
    // (8,9) (8,9) (11,9) (11,9). At n = 13 the groups leave 9@8 in lane 0, 9@6 in lane 2 and
    // 9@11 in lane 3: the fold must take the LATEST, 11.
    let mut n: i64 = 0;
    while n <= 13 {
        print(amax_last(x, n, -100.0, out));
        print(out[0] as i32);
        n = n + 1;
    }
    // From 9 — a start the maxima TIE: -1 up to n = 4, then 4 4 6 6 8 8 8 11 11. The un-updated
    // lanes hold 9 too, and must not win.
    n = 0;
    while n <= 13 {
        print(amax_last(x, n, 9.0, out));
        n = n + 1;
    }
    // From 10: nothing reaches it, -1 at every trip and the maximum stays 10.
    print(amax_last(x, 13, 10.0, out));
    print(out[0] as i32);

    // FindLastIV, x[i] >= 7: -1 -1 1 1 3 4 4 6 6 8 8 8 11 12.
    n = 0;
    while n <= 13 {
        print(flast_ge(x, n, 7.0));
        n = n + 1;
    }

    // z = [-0, +0, NaN, -1, +0, NaN, -0, -5, +0, -0, -9] from -1: every zero ties the running
    // maximum and moves it, sign included. (at, bits(max)): (-1, 3212836864) (0, 2147483648)
    // (1, 0) (1, 0) (1, 0) (4, 0) (4, 0) (6, 2147483648) (6, 2147483648) (8, 0)
    // (9, 2147483648) (9, 2147483648).
    let negz: f32 = f32_from_bits(0x80000000 as u32);
    let nan: f32 = f32_from_bits(0x7fc00000 as u32);
    let mut z: []f32 = alloc_f32(11);
    z[0] = negz; z[1] = 0.0; z[2] = nan; z[3] = -1.0; z[4] = 0.0; z[5] = nan; z[6] = negz;
    z[7] = -5.0; z[8] = 0.0; z[9] = negz; z[10] = -9.0;
    n = 0;
    while n <= 11 {
        print(amax_last(z, n, -1.0, out));
        print(bits(out[0]));
        n = n + 1;
    }
    // A NaN start: nothing compares >= it. -1, and the maximum keeps the NaN's bits.
    print(amax_last(z, 11, nan, out));
    print(bits(out[0]));

    // y from 1000, argmin last tie: (at, min) = (-1,1000) (0,5) (1,-2) (1,-2) (3,-2) (4,-7)
    // (4,-7) (6,-7) (7,-7) (7,-7) (7,-7) (10,-7) (10,-7) (10,-7) (10,-7) (14,-7) (14,-7) (14,-7).
    let mut y: []i32 = alloc_i32(17);
    let mut iout: []i32 = alloc_i32(1);
    y[0] = 5; y[1] = -2; y[2] = 8; y[3] = -2; y[4] = -7; y[5] = 3; y[6] = -7; y[7] = -7;
    y[8] = 0; y[9] = 1; y[10] = -7; y[11] = 6; y[12] = -3; y[13] = 2; y[14] = -7; y[15] = 9;
    y[16] = 4;
    n = 0;
    while n <= 17 {
        print(amin_last(y, n, 1000, iout));
        print(iout[0]);
        n = n + 1;
    }
    // From -7 (ties every -7): -1 -1 -1 -1 -1 4 4 6 7 7 7 10 10 10 10 14 14 14.
    n = 0;
    while n <= 17 {
        print(amin_last(y, n, -7, iout));
        n = n + 1;
    }
    // From -100: nothing is <= it.
    print(amin_last(y, 17, -100, iout));
    print(iout[0]);

    // f64 d = [1, 4, 4, 2, NaN, 4, 3] from -1: (at, max) = (-1,-1) (0,1) (1,4) (2,4) (2,4)
    // (2,4) (5,4) (5,4).
    let mut d: []f64 = alloc_f64(7);
    let mut dout: []f64 = alloc_f64(1);
    d[0] = 1.0; d[1] = 4.0; d[2] = 4.0; d[3] = 2.0;
    d[4] = f64_from_bits(0x7ff8000000000000 as u64); d[5] = 4.0; d[6] = 3.0;
    n = 0;
    while n <= 7 {
        print(amaxd_last(d, n, -1.0, dout));
        print(dout[0] as i32);
        n = n + 1;
    }

    free(x); free(out); free(z); free(y); free(iout); free(d); free(dout);
    return 0;
}
