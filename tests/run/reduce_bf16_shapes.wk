// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 36
// EXPECT-OUT: 72
// EXPECT-OUT: 41
// EXPECT-OUT: 82
// EXPECT-OUT: 160
// EXPECT-OUT: 320
// EXPECT-OUT: 636
// EXPECT-OUT: 1272
// EXPECT-OUT: 640
// EXPECT-OUT: 1280
// EXPECT-OUT: 641
// EXPECT-OUT: 1282
module tests.run.reduce_bf16_shapes

// Every partial-step shape of the bf16 mixed-precision reductions (wukong_sum_bf16 /
// wukong_dot_bf16). Those kernels process 16 elements per 256-bit load, 4 loads per accumulator
// sub-block and (for `sum`) 4 sub-blocks per unrolled step, so the sizes below are chosen to land
// on each boundary: 15 = pure scalar tail, no vector step at all; 17 = one group + a 1-element
// tail; 64 = exactly one sub-block; 255 / 256 / 257 = one element short of, exactly, and one past a
// full unrolled step. A recognizer is gate-blind — no differential or opt-invariance gate can see
// whether it fired or whether the kernel walked off the end of a partial block — so this fixture is
// the corpus-level proof that every shape still reduces the whole array and nothing else.
//
// The elements cycle 1, 2, 3, 4 and y is all 2: every value and every partial sum is a small
// integer, exactly representable in bf16 AND in f32, so the expected numbers below are the plain
// scalar semantics of the loop and are independent of the order the kernel accumulates in. (The
// *order*-sensitive proof — that the SIMD lane partition matches its scalar twin bit-for-bit, and
// that it beats a sequential f32 accumulator against an f64 reference — lives in wukong_runtime's
// `simd_equals_scalar_twin_bit_for_bit` and `lowp_reductions_beat_the_sequential_f32_sum`, because
// an inexact expectation here would have no order-independent right answer to record.)
//
// Σ over n = 4q + r elements is 10q + r(r+1)/2; the dot against the all-2 vector is twice that.

fn run15(x: [bf16; 15], y: [bf16; 15]) {
    let mut s: f32 = 0.0;
    for k in 0..15 { s = s + (x[k] as f32); }
    print(s as i32); // 10*3 + 6 = 36
    let mut d: f32 = 0.0;
    for k in 0..15 { d = d + (x[k] as f32) * (y[k] as f32); }
    print(d as i32); // 72
}

fn run17(x: [bf16; 17], y: [bf16; 17]) {
    let mut s: f32 = 0.0;
    for k in 0..17 { s = s + (x[k] as f32); }
    print(s as i32); // 10*4 + 1 = 41
    let mut d: f32 = 0.0;
    for k in 0..17 { d = d + (x[k] as f32) * (y[k] as f32); }
    print(d as i32); // 82
}

fn run64(x: [bf16; 64], y: [bf16; 64]) {
    let mut s: f32 = 0.0;
    for k in 0..64 { s = s + (x[k] as f32); }
    print(s as i32); // 10*16 = 160
    let mut d: f32 = 0.0;
    for k in 0..64 { d = d + (x[k] as f32) * (y[k] as f32); }
    print(d as i32); // 320
}

fn run255(x: [bf16; 255], y: [bf16; 255]) {
    let mut s: f32 = 0.0;
    for k in 0..255 { s = s + (x[k] as f32); }
    print(s as i32); // 10*63 + 6 = 636
    let mut d: f32 = 0.0;
    for k in 0..255 { d = d + (x[k] as f32) * (y[k] as f32); }
    print(d as i32); // 1272
}

fn run256(x: [bf16; 256], y: [bf16; 256]) {
    let mut s: f32 = 0.0;
    for k in 0..256 { s = s + (x[k] as f32); }
    print(s as i32); // 10*64 = 640
    let mut d: f32 = 0.0;
    for k in 0..256 { d = d + (x[k] as f32) * (y[k] as f32); }
    print(d as i32); // 1280
}

fn run257(x: [bf16; 257], y: [bf16; 257]) {
    let mut s: f32 = 0.0;
    for k in 0..257 { s = s + (x[k] as f32); }
    print(s as i32); // 10*64 + 1 = 641
    let mut d: f32 = 0.0;
    for k in 0..257 { d = d + (x[k] as f32) * (y[k] as f32); }
    print(d as i32); // 1282
}

fn main() -> i32 {
    let mut x15: [bf16; 15] = [0.0 as bf16; 15];
    let mut y15: [bf16; 15] = [0.0 as bf16; 15];
    for i in 0..15 { x15[i] = ((i % 4 + 1) as f32) as bf16; y15[i] = 2.0 as bf16; }
    run15(x15, y15);

    let mut x17: [bf16; 17] = [0.0 as bf16; 17];
    let mut y17: [bf16; 17] = [0.0 as bf16; 17];
    for i in 0..17 { x17[i] = ((i % 4 + 1) as f32) as bf16; y17[i] = 2.0 as bf16; }
    run17(x17, y17);

    let mut x64: [bf16; 64] = [0.0 as bf16; 64];
    let mut y64: [bf16; 64] = [0.0 as bf16; 64];
    for i in 0..64 { x64[i] = ((i % 4 + 1) as f32) as bf16; y64[i] = 2.0 as bf16; }
    run64(x64, y64);

    let mut x255: [bf16; 255] = [0.0 as bf16; 255];
    let mut y255: [bf16; 255] = [0.0 as bf16; 255];
    for i in 0..255 { x255[i] = ((i % 4 + 1) as f32) as bf16; y255[i] = 2.0 as bf16; }
    run255(x255, y255);

    let mut x256: [bf16; 256] = [0.0 as bf16; 256];
    let mut y256: [bf16; 256] = [0.0 as bf16; 256];
    for i in 0..256 { x256[i] = ((i % 4 + 1) as f32) as bf16; y256[i] = 2.0 as bf16; }
    run256(x256, y256);

    let mut x257: [bf16; 257] = [0.0 as bf16; 257];
    let mut y257: [bf16; 257] = [0.0 as bf16; 257];
    for i in 0..257 { x257[i] = ((i % 4 + 1) as f32) as bf16; y257[i] = 2.0 as bf16; }
    run257(x257, y257);
    return 0;
}
