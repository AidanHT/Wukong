// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 30
// EXPECT-OUT: 40
// EXPECT-OUT: 10
// EXPECT-OUT: -1
// EXPECT-OUT: 7
// EXPECT-OUT: 8
// EXPECT-OUT: 0
// EXPECT-OUT: 203
// EXPECT-OUT: 5
// EXPECT-OUT: 9
// EXPECT-OUT: 12
// EXPECT-OUT: 34
// EXPECT-OUT: 0
// EXPECT-OUT: 6
// EXPECT-OUT: 8
// EXPECT-OUT: 99
// EXPECT-OUT: 99
// EXPECT-OUT: 3
// EXPECT-OUT: 5
// EXPECT-OUT: 0
// EXPECT-OUT: 2.5
// EXPECT-OUT: 4.5
// EXPECT-OUT: 70
// EXPECT-OUT: 80
// EXPECT-OUT: 1
// EXPECT-OUT: 2
// EXPECT-OUT: 5
// EXPECT-OUT: 6
// EXPECT-OUT: 7
// EXPECT-OUT: 0
// EXPECT-OUT: 53
// EXPECT-OUT: 0
// EXPECT-OUT: 82
// EXPECT-OUT: 0
// EXPECT-OUT: 6
module tests.run.or_pattern_bindings

// Names bound inside an or-pattern. Every alternative binds the same names at the same types
// (E0423, E0424), and the arm reads each name from whichever alternative matched — the FIRST that
// matches, left to right, as in Rust. A `match` guard is tried with each alternative that matches,
// in turn, again as in Rust; an `if let` chain's `&&` is no guard and does not retry. An aggregate
// name binds in place, like any aggregate binding.

enum Shape {
    Circle(i32),
    Square(i32),
    Rect(i32, i32),
    Empty,
}

struct P {
    x: i32,
    y: i32,
}

enum Wrap {
    A(P),
    B(P),
    C,
}

enum Reading {
    Raw(f32, i32),
    Scaled(i32, f32),
}

fn size(s: Shape) -> i32 {
    return match s {
        Shape::Circle(r) | Shape::Square(r) => r * 10,
        Shape::Rect(w, h) => w * h,
        Shape::Empty => -1,
    };
}

// Both alternatives match `(0, 0)`, and `(5, 1)` matches the first as `v = 5` and the second as
// `v = 1`: the first alternative decides.
fn pick(t: (i32, i32)) -> i32 {
    return match t {
        (0, v) | (v, 0) => v,
        (v, 1) | (_, v) if v > 4 => v,
        (a, b) => a * 100 + b,
    };
}

// An aggregate binding: the payload struct, by address.
fn wsum(w: Wrap) -> i32 {
    return match w {
        Wrap::A(p) | Wrap::B(p) => p.x * 10 + p.y,
        Wrap::C => 0,
    };
}

// An or-pattern nested in a tuple, under a guard that reads its binding.
fn nested(x: (Shape, i32)) -> i32 {
    return match x {
        (Shape::Circle(r) | Shape::Rect(r, _), k) if k > 0 => r + k,
        _ => 99,
    };
}

// A guard is tried with each alternative that matches, in order: `(2, 5)` binds `v = 2` from the
// first alternative, fails `v > 4`, and is tried again as `v = 5` from the second.
fn later(t: (i32, i32)) -> i32 {
    return match t {
        (v, _) | (_, v) if v > 4 => v,
        _ => 0,
    };
}

// Two binding or-patterns: the leftmost varies slowest. `((5, 9), (7, 3))` tries (a, b) = (5, 7),
// which fails `a > b`, then (5, 3), which passes — before (9, 7) is ever tried.
fn pairs(t: ((i32, i32), (i32, i32))) -> i32 {
    return match t {
        ((a, _) | (_, a), (b, _) | (_, b)) if a > b => a * 10 + b,
        _ => 0,
    };
}

// The `&&` of an `if let` chain is not a guard: it reads the first alternative that matched and
// nothing retries, so `(2, 5)` binds `v = 2` and the chain fails.
fn chained(t: (i32, i32)) -> i32 {
    if let (v, _) | (_, v) = t && v > 4 {
        return v;
    }
    return 0;
}

// Alternatives over a slice, of different lengths.
fn ends(s: []i32) -> i32 {
    return match s {
        [9, a, ..] | [.., a] => a,
        [] => 0,
    };
}

// Two names, bound at the payload positions each variant keeps them in.
fn reading(r: Reading) -> f32 {
    return match r {
        Reading::Raw(v, n) | Reading::Scaled(n, v) => v * (n as f32),
    };
}

fn main() -> i32 {
    println(size(Shape::Circle(3)));
    println(size(Shape::Square(4)));
    println(size(Shape::Rect(2, 5)));
    println(size(Shape::Empty));
    println(pick((0, 7)));
    println(pick((8, 0)));
    println(pick((0, 0)));
    println(pick((2, 3)));
    println(pick((5, 1)));
    println(pick((3, 9)));
    println(wsum(Wrap::A(P { x: 1, y: 2 })));
    println(wsum(Wrap::B(P { x: 3, y: 4 })));
    println(wsum(Wrap::C));
    println(nested((Shape::Circle(5), 1)));
    println(nested((Shape::Rect(6, 1), 2)));
    println(nested((Shape::Square(6), 2)));
    println(nested((Shape::Circle(5), 0)));
    let a: [i32; 3] = [1, 2, 3];
    let b: [i32; 3] = [9, 5, 7];
    let e: [i32; 0] = [];
    println(ends(a));
    println(ends(b));
    println(ends(e));
    println(reading(Reading::Raw(1.25, 2)));
    println(reading(Reading::Scaled(3, 1.5)));

    // `if let` and `let` take or-patterns with bindings too.
    let t: (i32, i32) = (70, 0);
    if let (v, 0) | (0, v) = t {
        println(v);
    }
    let (w, _) | (_, w) = (80, 1);
    println(w);
    let mut k: i32 = 0;
    while let 0 | 1 = k {
        k = k + 1;
        println(k);
    }

    // A guard retries the alternatives; an `if let` chain does not.
    println(later((2, 5)));
    println(later((6, 1)));
    println(later((7, 9)));
    println(later((1, 2)));
    println(pairs(((5, 9), (7, 3))));
    println(pairs(((1, 2), (3, 4))));
    println(pairs(((8, 1), (2, 9))));
    println(chained((2, 5)));
    println(chained((6, 1)));
    return 0;
}
