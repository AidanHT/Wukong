// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 150
// EXPECT-OUT: -400
// EXPECT-OUT: 1050
// EXPECT-OUT: -125
// EXPECT-OUT: 75
// EXPECT-OUT: -200
// EXPECT-OUT: 525
// EXPECT-OUT: -62
module tests.run.gevm_f32

/// Vector·matrix product `out = wᵀ·V` — the single-token KV-decode attention read-out
/// `out[d] = Σ_s scores[s]·v[s*D+d]` (a weighted sum of the rows of V), written the idiomatic
/// column-outer way. The j-outer source reads `v` column-strided (the access gcc/rustc leave
/// scalar); the compiler dispatches it to `mercury_sgevm_f32`, which restructures to i-outer and
/// streams `v` row-major while keeping the identical per-element ascending-i FMA chain — bit-exact,
/// no reassociation. `--run` marshals that same kernel through the interpreter, gating
/// interp == native and -O0 == -O3. Inputs are exactly-representable halves/quarters, so the
/// printed values are pinned.
///
/// w = [0.5, -1, 2]; V rows [1,-2,3,0.5] / [2,1,-1,4] / [1.5,-1,4,1.25] ⇒
///   out = 0.5·row0 − row1 + 2·row2 = [1.5, -4, 10.5, -1.25] (exact per column).
fn weighted_rows(w: [f32; 3], v: [f32; 12], mut out: [f32; 4]) {
    for d in 0..4 {
        let mut acc: f32 = 0.0;
        for s in 0..3 {
            acc = acc + w[s] * v[s * 4 + d];
        }
        out[d] = acc;
    }
}

/// The α-scaled store `out[d] = acc * c` dispatches too — the scale is applied by the kernel
/// exactly once per output element after its full fold (the same single multiply the scalar store
/// performs). ×0.5 ⇒ [0.75, -2, 5.25, -0.625].
fn weighted_rows_scaled(w: [f32; 3], v: [f32; 12], mut out: [f32; 4]) {
    for d in 0..4 {
        let mut acc: f32 = 0.0;
        for s in 0..3 {
            acc = acc + w[s] * v[s * 4 + d];
        }
        out[d] = acc * 0.5;
    }
}

fn main() -> i32 {
    let w: [f32; 3] = [0.5, -1.0, 2.0];
    let v: [f32; 12] = [1.0, -2.0, 3.0, 0.5, 2.0, 1.0, -1.0, 4.0, 1.5, -1.0, 4.0, 1.25];
    let mut o1: [f32; 4] = [0.0; 4];
    weighted_rows(w, v, o1);
    print((o1[0] * 100.0) as i32); // 1.5   -> 150
    print((o1[1] * 100.0) as i32); // -4    -> -400
    print((o1[2] * 100.0) as i32); // 10.5  -> 1050
    print((o1[3] * 100.0) as i32); // -1.25 -> -125
    let mut o2: [f32; 4] = [0.0; 4];
    weighted_rows_scaled(w, v, o2);
    print((o2[0] * 100.0) as i32); // 0.75   -> 75
    print((o2[1] * 100.0) as i32); // -2     -> -200
    print((o2[2] * 100.0) as i32); // 5.25   -> 525
    print((o2[3] * 100.0) as i32); // -0.625 -> -62
    return 0;
}
