// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 6
// EXPECT-OUT: 8
// EXPECT-OUT: 8
// EXPECT-OUT: 10
module tests.run.matmul_bf16_tn

// bf16 mixed-precision C = Aᵀ·B — the dW = dYᵀ·X weight-gradient GEMM of a training backward pass,
// in bf16 (the standard mixed-precision training layout: activations/gradients in bf16, accumulate in
// f32). A is stored [K, M] (the contraction K is the OUTER index of A's storage), B is [K, N], C is
// [M, N]. The recognizer detects `(a[p*M + i] as f32) * (b[p*N + j] as f32)` — transposed A, normal B —
// and dispatches to mercury_sgemm_bf16_tn: a lossless bf16 widen prepass feeding the f32 mercury_sgemm_tn
// (transpose A once + the tuned NN kernel). gcc/rustc lose twice on the naive nest — the inline widen
// won't vectorize AND A's column-strided reads defeat it. Small integers are bf16-exact, so the result
// is exact and the differential gate is bit-for-bit (interp == native, -O0 == -O3). M=2, K=3, N=3.
fn main() -> i32 {
    // A stored [K=3, M=2] = [[1,2],[3,4],[5,6]] (so Aᵀ = [[1,3,5],[2,4,6]]).
    let mut a: [bf16; 6] = [0.0 as bf16; 6];
    for i in 0..6 {
        a[i] = ((i + 1) as f32) as bf16; // 1 .. 6
    }
    // B stored [K=3, N=3] = [[1,1,0],[0,1,1],[1,0,1]].
    let mut b: [bf16; 9] = [0.0 as bf16; 9];
    b[0] = 1.0 as bf16;
    b[1] = 1.0 as bf16;
    b[4] = 1.0 as bf16;
    b[5] = 1.0 as bf16;
    b[6] = 1.0 as bf16;
    b[8] = 1.0 as bf16;
    let mut c: [f32; 6] = [0.0; 6];

    // C[i,j] = Σ_p Aᵀ[i,p]·B[p,j] = Σ_p a[p*M + i] · b[p*N + j]   (bf16 reads widen to f32)
    for i in 0..2 {
        for j in 0..3 {
            let mut s: f32 = 0.0;
            for p in 0..3 {
                s = s + (a[p * 2 + i] as f32) * (b[p * 3 + j] as f32);
            }
            c[i * 3 + j] = s;
        }
    }
    // C = Aᵀ·B = [[6,4,8],[8,6,10]].
    print(c[0] as i32); // C[0,0] = 1·1 + 3·0 + 5·1 = 6
    print(c[2] as i32); // C[0,2] = 1·0 + 3·1 + 5·1 = 8
    print(c[3] as i32); // C[1,0] = 2·1 + 4·0 + 6·1 = 8
    print(c[5] as i32); // C[1,2] = 2·0 + 4·1 + 6·1 = 10
    return 0;
}
