module tests.run.causal_mask_split

// Guards on a loop's induction variable and on a loop-invariant flag, each storing in one arm only
// (the shape the vectorizer refuses: "the two arms do not store the same number of times"). At -O2
// `wukong_opt::unswitch` splits each counted `j` loop at the iteration where its guard changes -- a
// copy with the guard decided one way runs first and hands its state to the original, decided the
// other way -- and unswitches `flag_fill` on its invariant `on`. Every lane is pinned, including
// invariants before, inside and past the range (`from_k` with k = -3, 4, 20).
//
// Expected values by hand, with every buffer initialized to its own index t (t = 5i + j):
//   causal       t when j <= i, else -1        (the strictly upper triangle masked)
//   lower_strict t when j >= i, else -2        (the strictly lower triangle masked)
//   diag_band    t + 100 when j <= i, else t   (read-modify-write in one arm)
//   from_k(k)    j when j < k, else 7          (k = -3: all 7; k = 4: 0 1 2 3 then 7s; k = 20: 0..9)
//   flag_fill    3j when on, else -j

fn causal(mut s: [i32; 25]) {
    for i in 0..5 {
        for j in 0..5 {
            if j > i {
                s[i * 5 + j] = 0 - 1;
            }
        }
    }
}

fn lower_strict(mut s: [i32; 25]) {
    for i in 0..5 {
        for j in 0..5 {
            if j < i {
                s[i * 5 + j] = 0 - 2;
            }
        }
    }
}

fn diag_band(mut s: [i32; 25]) {
    for i in 0..5 {
        for j in 0..5 {
            if j <= i {
                s[i * 5 + j] = s[i * 5 + j] + 100;
            }
        }
    }
}

fn from_k(mut s: [i32; 10], k: i32) {
    for j in 0..10 {
        if j >= k {
            s[j] = 7;
        }
    }
}

fn flag_fill(mut s: [i32; 8], on: bool) {
    for j in 0..8 {
        if on {
            s[j] = j * 3;
        } else {
            s[j] = 0 - j;
        }
    }
}

fn main() -> i32 {
    let mut a: [i32; 25] = [0; 25];
    let mut b: [i32; 25] = [0; 25];
    let mut c: [i32; 25] = [0; 25];
    for t in 0..25 {
        a[t] = t;
        b[t] = t;
        c[t] = t;
    }
    causal(a);
    lower_strict(b);
    diag_band(c);
    for t in 0..25 {
        print(a[t]);
    }
    for t in 0..25 {
        print(b[t]);
    }
    for t in 0..25 {
        print(c[t]);
    }
    let mut d: [i32; 10] = [0; 10];
    let mut e: [i32; 10] = [0; 10];
    let mut g: [i32; 10] = [0; 10];
    for j in 0..10 {
        d[j] = j;
        e[j] = j;
        g[j] = j;
    }
    from_k(d, 0 - 3);
    from_k(e, 4);
    from_k(g, 20);
    for j in 0..10 {
        print(d[j]);
    }
    for j in 0..10 {
        print(e[j]);
    }
    for j in 0..10 {
        print(g[j]);
    }
    let mut p: [i32; 8] = [0; 8];
    let mut q: [i32; 8] = [0; 8];
    flag_fill(p, true);
    flag_fill(q, false);
    for j in 0..8 {
        print(p[j]);
    }
    for j in 0..8 {
        print(q[j]);
    }
    return 0;
}
