// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 12
// EXPECT-OUT: 99
// EXPECT-OUT: 30
// EXPECT-OUT: 42
// EXPECT-OUT: 5
module tests.run.deref_field_access

// Field / element access through an EXPLICIT pointer deref: `(*p).field`, `(*p)[i]`, `(*p).0`,
// `&mut (*p).field`. The base of the access is `*p`; lowering `*p` as a value would LOAD the whole
// aggregate buffer, and GEPing a field off that loaded value is `gep base [N x i8]` — invalid MIR the
// verifier rejects (interp / native-O{1,2,3} all errored, but native-O0 codegen'd the wild gep into a
// SIGSEGV). The base is now lowered as a place (the pointer itself), so the explicit `(*p).f` spelling
// lowers like the implicit auto-deref `p.f`, on both backends at every opt level.

struct S { a: i32, b: i32 }

fn read_fields(p: *mut S) -> i32 {
    return (*p).a + (*p).b; // (*p).field read
}
fn write_field(p: *mut S) {
    (*p).a = 99; // (*p).field write
}
fn elem(p: *mut [i32; 4]) -> i32 {
    return (*p)[2]; // (*p)[i] on a *mut array
}
fn via_ref(p: *mut S) {
    let q = &mut (*p).a; // &mut (*p).field
    *q = 42;
}
fn tuple_first(p: *mut (i32, i32)) -> i32 {
    return (*p).0; // explicit deref of a tuple pointer
}

fn main() -> i32 {
    let mut s: S = S { a: 7, b: 5 };
    print(read_fields(&mut s)); // 7 + 5 = 12

    write_field(&mut s);
    print(s.a); // 99

    let mut xs: [i32; 4] = [10, 20, 30, 40];
    print(elem(&mut xs)); // 30

    let mut s2: S = S { a: 0, b: 0 };
    via_ref(&mut s2);
    print(s2.a); // 42

    let mut t: (i32, i32) = (5, 6);
    print(tuple_first(&mut t)); // 5
    return 0;
}
