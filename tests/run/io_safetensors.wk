// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 113
// EXPECT-OUT: 141
// EXPECT-OUT: 6
// EXPECT-OUT: 1000
// EXPECT-OUT: -2000
// EXPECT-OUT: 500
// EXPECT-OUT: 3000
// EXPECT-OUT: 156
// EXPECT-OUT: -750
// EXPECT-OUT: 6
// EXPECT-OUT: 1000
// EXPECT-OUT: -2000
// EXPECT-OUT: 500
// EXPECT-OUT: 3000
// EXPECT-OUT: 15625
// EXPECT-OUT: -750
// EXPECT-OUT: 4
// EXPECT-OUT: -1
// EXPECT-OUT: 2
// EXPECT-OUT: 300
// EXPECT-OUT: -32768
// EXPECT-OUT: -4
// EXPECT-OUT: 9
// EXPECT-OUT: -4
// EXPECT-OUT: -3
// EXPECT-OUT: -5
// EXPECT-OUT: -1
// EXPECT-OUT: 8
// EXPECT-OUT: -6
module tests.run.io_safetensors

// `st_read_<T>(path, name, buf)` loads one named tensor of a safetensors file — an 8-byte
// little-endian header length, a JSON header mapping each name to its dtype, shape and byte range,
// then the payload — and checks it against the destination at load time. The file is assembled
// byte by byte here (nothing is recorded from a backend), so every expected value is the payload's
// own definition:
//   w: BF16 [2, 3] = bits 3F80 C000 3F00 4040 3E20 BF40 = 1.0 -2.0 0.5 3.0 0.15625 -0.75
//   n: I16  [4]    = -1 2 300 -32768
// The header is 113 bytes, so the file is 8 + 113 + 20 = 141 bytes.
//  1. w into a `Tensor[f32, 2, 3]` parameter: the BF16 payload WIDENS exactly into f32 (printed
//     times 1000 and truncated: 0.15625 -> 156), and the file's shape [2, 3] matches the tensor's.
//  2. w verbatim into a `[bf16; 6]` array (0.15625 printed times 100000 = 15625, exact).
//  3. n into an `[i16; 4]` array: every lane sign-extended, -32768 included.
//  4. Load-time shape safety: the same w into a `Tensor[f32, 3, 2]` is -4 (shape mismatch) and
//     the destination is untouched (9 stays 9) — the same element count does not make [2, 3] a
//     [3, 2].
//  5. A flat 5-element destination: the count must be exact, -4.
//  6. An I16 tensor into an i32 buffer: -3 (only bf16/f16 -> f32 widens).
//  7. A missing name -5, a missing file -1, and a header whose length prefix runs past the end of
//     an 8-byte file -6.

// Copy the NUL-terminated string `s` into `buf` from byte `at`; returns its length.
fn put_str(mut buf: []u8, at: i64, s: *u8) -> i64 {
    let mut i: i64 = 0;
    while s[i] != 0 {
        buf[at + i] = s[i];
        i = i + 1;
    }
    return i;
}

// Store the low `n` bytes of `v` little-endian from byte `at`.
fn put_le(mut buf: []u8, at: i64, v: i64, n: i64) {
    let mut x: i64 = v;
    let mut k: i64 = 0;
    while k < n {
        buf[at + k] = (x & 255) as u8;
        x = x >> 8;
        k = k + 1;
    }
}

fn load_w(path: *u8, mut t: Tensor[f32, 2, 3]) -> i64 {
    return st_read_f32(path, "w", t);
}

fn load_w_as_3x2(path: *u8, mut t: Tensor[f32, 3, 2]) -> i64 {
    return st_read_f32(path, "w", t);
}

fn main() -> i32 {
    let path: *u8 = "io_test_st.bin";
    let header: *u8 = "{\"w\":{\"dtype\":\"BF16\",\"shape\":[2,3],\"data_offsets\":[0,12]},\"n\":{\"dtype\":\"I16\",\"shape\":[4],\"data_offsets\":[12,20]}}";
    let mut file: []u8 = alloc_u8(141);
    let h: i64 = put_str(file, 8, header);
    print(h);
    put_le(file, 0, h, 8);
    let base: i64 = 8 + h;
    put_le(file, base, 0x3F80, 2);
    put_le(file, base + 2, 0xC000, 2);
    put_le(file, base + 4, 0x3F00, 2);
    put_le(file, base + 6, 0x4040, 2);
    put_le(file, base + 8, 0x3E20, 2);
    put_le(file, base + 10, 0xBF40, 2);
    put_le(file, base + 12, -1, 2);
    put_le(file, base + 14, 2, 2);
    put_le(file, base + 16, 300, 2);
    put_le(file, base + 18, -32768, 2);
    print(write_u8(path, file));

    let mut w: [f32; 6] = [0.0; 6];
    print(load_w(path, w));
    for i in 0..6 {
        print((w[i] * 1000.0) as i32);
    }

    let mut wb: [bf16; 6] = [0.0 as bf16; 6];
    print(st_read_bf16(path, "w", wb));
    for i in 0..4 {
        print((wb[i] as f32 * 1000.0) as i32);
    }
    print((wb[4] as f32 * 100000.0) as i32);
    print((wb[5] as f32 * 1000.0) as i32);

    let mut n: [i16; 4] = [0; 4];
    print(st_read_i16(path, "n", n));
    for i in 0..4 {
        print(n[i]);
    }

    let mut wt: [f32; 6] = [9.0; 6];
    print(load_w_as_3x2(path, wt));
    print(wt[0] as i32);

    let mut five: []f32 = alloc_f32(5);
    print(st_read_f32(path, "w", five));

    let mut ni: [i32; 4] = [0; 4];
    print(st_read_i32(path, "n", ni));

    print(st_read_f32(path, "missing", w));
    print(st_read_f32("io_test_st_absent_zz.bin", "w", w));
    let mut bad: []u8 = alloc_u8(8);
    put_le(bad, 0, 1000, 8);
    print(write_u8("io_test_st_bad.bin", bad));
    print(st_read_f32("io_test_st_bad.bin", "w", w));

    free(file);
    free(five);
    free(bad);
    return 0;
}
