// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 3
// EXPECT-OUT: 4
// EXPECT-OUT: 8
// EXPECT-OUT: 9
// EXPECT-OUT: 14
// EXPECT-OUT: 23
module tests.run.prefix_sum

/// Inclusive prefix sum (scan) of an array into a second array with a loop-carried accumulator.
fn main() -> i32 {
    let src: [i32; 6] = [3, 1, 4, 1, 5, 9];
    let mut scan: [i32; 6] = [0, 0, 0, 0, 0, 0];

    let mut acc: i32 = 0;
    let mut i: i32 = 0;
    while i < 6 {
        acc = acc + src[i];
        scan[i] = acc;
        i = i + 1;
    }

    let mut k: i32 = 0;
    while k < 6 {
        print(scan[k]);
        k = k + 1;
    }
    return 0;
}
