// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 45
// EXPECT-OUT: 196
// EXPECT-OUT: 1000
// EXPECT-OUT: 196
// EXPECT-OUT: 104
// EXPECT-OUT: 45
// EXPECT-OUT: 470
// EXPECT-OUT: 470
// EXPECT-OUT: 9
// EXPECT-OUT: 419
// EXPECT-OUT: 4000
// EXPECT-OUT: 419
// EXPECT-OUT: 70
// EXPECT-OUT: 9
// EXPECT-OUT: 1572
// EXPECT-OUT: 1572
module tests.run.gate_backward

// The foundational gate gradients sigmoid_backward(x,dy)=dy·σ(x)(1−σ(x)) and tanh_backward(x,dy)=
// dy·(1−tanh²(x)) — the backward through every LSTM/GRU/attention gate. Both fold an expf (in
// sigmoid/tanh) C/Rust keep scalar, so each elementwise loop folds to one 256-bit mercury_vmath2_f32
// call. Pure elementwise (no reduction) → bit-identical lane-for-lane, so the differential gate
// (interp == native, -O0 == -O3) is trivial. Frozen deterministic kernel output (×1000, truncated).
fn main() -> i32 {
    let x: [f32; 8] = [-3.0, -1.0, 0.0, 1.0, 2.0, 3.0, 0.5, -0.5];
    let dy: [f32; 8] = [1.0, 1.0, 4.0, 1.0, 1.0, 1.0, 2.0, 2.0];
    let mut ds: [f32; 8] = [0.0; 8];
    let mut dt: [f32; 8] = [0.0; 8];

    // Each recognized → mercury_vmath2_f32(x, dy, _, 8, VM2_{SIGMOID,TANH}_BWD).
    for i in 0..8 {
        ds[i] = sigmoid_backward(x[i], dy[i]);
    }
    for i in 0..8 {
        dt[i] = tanh_backward(x[i], dy[i]);
    }

    for k in 0..8 {
        print((ds[k] * 1000.0) as i32);
    }
    for k in 0..8 {
        print((dt[k] * 1000.0) as i32);
    }
    return 0;
}
