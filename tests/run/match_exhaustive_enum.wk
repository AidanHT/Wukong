// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 1
// EXPECT-OUT: 2
// EXPECT-OUT: 3
// EXPECT-OUT: 0
module tests.run.match_exhaustive_enum

enum Color { Red, Green, Blue }

// An EXHAUSTIVE enum `match` with NO `_` catch-all. Sema proves it exhaustive, so mir_build tests
// every arm but the last (`Blue`), which is taken untested: a value that fails the `Red` and `Green`
// tests can only be `Blue`. No "no arm matched" fallthrough block is emitted at all. (A match sema
// cannot prove keeps every test and ends that fallthrough in `Unreachable`, never a zero default; a
// *non*-exhaustive value match is rejected at compile time by sema, E0405 — see
// tests/fail/match_nonexhaustive.wk.) Also covers an exhaustive `bool` match (both cases, no `_`),
// which is one test.
fn rank(c: Color) -> i32 {
    return match c {
        Color::Red => 1,
        Color::Green => 2,
        Color::Blue => 3,
    };
}

fn pick(b: bool) -> i32 {
    return match b {
        true => 1,
        false => 0,
    };
}

fn main() -> i32 {
    print(rank(Color::Red));   // 1
    print(rank(Color::Green)); // 2
    print(rank(Color::Blue));  // 3
    print(pick(false));        // 0
    return 0;
}
