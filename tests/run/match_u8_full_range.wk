// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT-VALUES: 1 1 2 2 3 3 4
// EXPECT-OUT-VALUES: -1 -1 0 1 1
// EXPECT-OUT-VALUES: 3 2 1 0
module tests.run.match_u8_full_range

// Matches that cover their scrutinee's whole domain with no `_` arm are exhaustive. Integer ranges
// that tile `0..=255` (or `-128..=127`) were a false E0405 — any integer match needed a catch-all —
// and a tuple scrutinee was never checked at all. Pattern usefulness splits each integer column at
// every bound the arms name and finds no gap, and expands `(bool, bool)` into its four values.
//
// Every arm is exercised at both of its endpoints; the expected values are the arm bodies.

fn band(x: u8) -> i32 {
    return match x {
        0..=63 => 1,
        64..=127 => 2,
        128..=254 => 3,
        255 => 4,
    };
}

fn sign(x: i8) -> i32 {
    return match x {
        -128..=-1 => -1,
        0 => 0,
        1..=127 => 1,
    };
}

fn both(p: bool, q: bool) -> i32 {
    return match (p, q) {
        (true, true) => 3,
        (true, false) => 2,
        (false, true) => 1,
        (false, false) => 0,
    };
}

fn main() -> i32 {
    print(band(0));
    print(band(63));
    print(band(64));
    print(band(127));
    print(band(128));
    print(band(254));
    print(band(255));

    print(sign(-128));
    print(sign(-1));
    print(sign(0));
    print(sign(1));
    print(sign(127));

    print(both(true, true));
    print(both(true, false));
    print(both(false, true));
    print(both(false, false));
    return 0;
}
