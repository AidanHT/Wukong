// EXPECT-OUT: 255 255 254 255 254
module tests.run.f8_code_round_trip

// Every one of the 256 codes of both 8-bit floats through the type: `f8e4m3_from_bits(c)` widened
// to `f64` and narrowed back, and stored into and reloaded from an `[f8; 256]` array, then `bits`.
// Each line is `c`, then the code the E4M3FN and E5M2 values hold as after the `f64` round trip,
// then the same after the array round trip.
//
// The expected codes follow from the formats alone (`docs/language-guide.md`, "8-bit floats"):
// widening is exact and every finite value and infinity converts back to its own code (signed zeros
// included), so a code holds as itself. A NaN holds as its format's canonical NaN with its sign:
// E4M3FN has only `S.1111.111` (0x7F, 0xFF), so it too holds as itself; E5M2's three NaN codes per
// sign (0x7D, 0x7E, 0x7F) all hold as 0x7E (and 0xFD..0xFF as 0xFE).
fn main() -> i32 {
    let mut m4: [f8e4m3; 256] = [0.0; 256];
    let mut m5: [f8e5m2; 256] = [0.0; 256];
    for i in 0..256 {
        let c: u8 = i as u8;
        m4[i] = f8e4m3_from_bits(c);
        m5[i] = f8e5m2_from_bits(c);
    }
    for i in 0..256 {
        let c: u8 = i as u8;
        let r4 = (f8e4m3_from_bits(c) as f64) as f8e4m3;
        let r5 = (f8e5m2_from_bits(c) as f64) as f8e5m2;
        printf("{} {} {} {} {}\n", c, bits(r4), bits(r5), bits(m4[i]), bits(m5[i]));
    }
    return 0;
}
