// RUN: --run
// EXPECT-EXIT: 31
// EXPECT-OUT: 4
// EXPECT-OUT: 30
// EXPECT-OUT: 1
// EXPECT-OUT: 100
module tests.run.structs

// A struct value is lowered exactly like a tuple — a flat padded byte buffer whose local value is the
// base pointer — but with named fields resolved through the declared layout (sema's DefKind::Struct).
// `Name { … }` constructs into the buffer (fields may appear out of declaration order, each routed to
// its named offset), and `s.f` GEPs to that field's byte offset for a typed load/store. No backend
// change; Cranelift writes the real packed layout and the interpreter indexes the offset as a slot.
struct Point { x: f32, y: f32 }
struct Mixed { a: i32, b: f32, c: i32 } // heterogeneous: `b` sits at a padded offset between two i32s

fn main() -> i32 {
    let p = Point { x: 1.5, y: 2.5 };
    print((p.x + p.y) as i32);          // 4
    let mut m = Mixed { a: 10, b: 3.5, c: 20 };
    m.a = m.a + m.c;                    // field read + assignment
    print(m.a);                         // 30
    let q = Point { y: 100.0, x: 1.0 }; // fields out of declaration order
    print(q.x as i32);                  // 1
    print(q.y as i32);                  // 100
    return m.a + (p.x as i32);          // 30 + 1 = 31
}
