// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 0
// EXPECT-OUT: 1954
// EXPECT-OUT: -45
// EXPECT-OUT: 3499
// EXPECT-OUT: 0
module tests.run.gelu

// GELU (tanh approximation) over a fixed vector, in the supported subset. tanh is built from
// exp: tanh(z) = 1 - 2/(exp(2z)+1), so the whole body is one vectorizable elementwise loop
// (cube polynomial + exp + divide). The wukong_bench gate proves it matches the interpreter
// bit-for-bit.
fn main() -> i32 {
    let mut x: [f32; 16] = [0.0; 16];
    let mut out: [f32; 16] = [0.0; 16];
    for i in 0..16 {
        x[i] = (i as f32) * 0.5 - 4.0; // -4 .. 3.5
    }

    // out[i] = 0.5*x*(1 + tanh(0.7978845608*(x + 0.044715*x^3)))
    for i in 0..16 {
        let u: f32 = 0.7978845608 * (x[i] + 0.044715 * x[i] * x[i] * x[i]);
        let t: f32 = 1.0 - 2.0 / (exp(2.0 * u) + 1.0);
        out[i] = 0.5 * x[i] * (1.0 + t);
    }

    print((out[8] * 1000.0) as i32); // gelu(0) = 0
    print((out[12] * 1000.0) as i32); // gelu(2) ~ 1.954k
    print((out[4] * 1000.0) as i32); // gelu(-2) ~ -0.045k
    print((out[15] * 1000.0) as i32); // gelu(3.5)
    print((out[0] * 1000.0) as i32); // gelu(-4)
    return 0;
}
