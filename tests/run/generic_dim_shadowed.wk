// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 2
// EXPECT-OUT: 5
// EXPECT-OUT: 10
// EXPECT-OUT: 20
// EXPECT-OUT: 30
// EXPECT-OUT: 40
// EXPECT-OUT: 50
// EXPECT-OUT: 2
// EXPECT-OUT: 3
// EXPECT-OUT: 40
// EXPECT-OUT: 50
// EXPECT-OUT: 60
module tests.run.generic_dim_shadowed

// A local may take the name of a generic dimension (`let N = 2;` in `fn f<N>(..)`): the NAME `N` in
// an expression is then the local, but a TYPE's `N` is still the generic — sema resolves
// `Tensor[i32, N]` to the dimension whatever is in scope. Lowering read the type's `N` by name, so
// after the `let` every extent and bound of `a` was 2: `a.dim(0)` printed 2 and the loop stopped
// after two elements. Expected values: the local `N` (2), the extent 5, all five elements; then, in
// `last_row`, the local (2), the extent 3 and the last row of a 2x3 view of 10..60 (40 50 60), where
// the shadowed stride of 2 read only 30 40.

fn all<N>(a: Tensor[i32, N]) {
    let N = 2;
    print(N);
    print(a.dim(0));
    for j in 0..a.dim(0) {
        print(a[j]);
    }
}

fn last_row<R, C>(m: Tensor[i32, R, C]) {
    let C = 2;
    print(C);
    print(m.dim(1));
    for j in 0..m.dim(1) {
        print(m[R - 1, j]);
    }
}

fn main() -> i32 {
    let a: [i32; 5] = [10, 20, 30, 40, 50];
    all(a);
    let m: [i32; 6] = [10, 20, 30, 40, 50, 60];
    last_row::<2, 3>(m);
    return 0;
}
