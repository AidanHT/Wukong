// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: -1.5
// EXPECT-OUT: -2.5
// EXPECT-OUT: -0.5
// EXPECT-OUT: 11
// EXPECT-OUT: -5
// EXPECT-OUT: 0
// EXPECT-OUT: -1
// EXPECT-OUT: 1
// EXPECT-OUT: -1
// EXPECT-OUT: 1
// EXPECT-OUT: 1.5
// EXPECT-OUT: -0.375
// EXPECT-OUT: -0.625
// EXPECT-OUT: -0.125
// EXPECT-OUT: 2.75
// EXPECT-OUT: -1.25
// EXPECT-OUT: 0
// EXPECT-OUT: -0.25
// EXPECT-OUT: 0.25
// EXPECT-OUT: -0.25
// EXPECT-OUT: 0.25
// EXPECT-OUT: 0.375
module tests.run.decode_gemv_half

// The half-precision-weight GEMV builtins `gemv_bf16(w, x, y)` / `gemv_f16(w, x, y)`:
// y[j] = sum_p x[p] * w[j*K + p] with the weight kept in its 2-byte storage (the kernel transposes
// and widens eight weight rows in registers; it never materializes an f32 copy). N = 11 rows is one
// 8-row vector group plus a 3-row scalar tail, and K = 13 is one 8-wide step plus a 5-element tail,
// so every path of the kernel runs and every output lane is printed.
//
//   w[j][p] = (((7j + 3p + (j*p mod 5)) mod 9) - 4) * 0.5   (bf16), the f16 weight is w/4;
//   x[p]    = (p mod 5) - 2.
// Every weight is a small multiple of 1/8, exact in both half formats, and every product and partial
// sum is exact in f32, so the result is the exact dot product whatever the summation order. The
// expected lines are that sum evaluated by hand from the definitions above: the bf16 run gives
// -1.5 -2.5 -0.5 11 -5 0 -1 1 -1 1 1.5, the f16 run a quarter of each. Dispatch: one
// `wukong_sgemv_bf16` and one `wukong_sgemv_f16` call (the census pins both).

fn main() -> i32 {
    let mut wb: [bf16; 143] = [0.0 as bf16; 143];
    let mut wh: [f16; 143] = [0.0 as f16; 143];
    let mut j: i64 = 0;
    while j < 11 {
        let mut p: i64 = 0;
        while p < 13 {
            let v: f32 = (((j * 7 + p * 3 + (j * p) % 5) % 9) as f32 - 4.0) * 0.5;
            wb[j * 13 + p] = v as bf16;
            wh[j * 13 + p] = (v * 0.25) as f16;
            p = p + 1;
        }
        j = j + 1;
    }
    let mut x: [f32; 13] = [0.0; 13];
    let mut i: i64 = 0;
    while i < 13 {
        x[i] = ((i % 5) - 2) as f32;
        i = i + 1;
    }
    let mut y: [f32; 11] = [7.0; 11];
    gemv_bf16(wb, x, y);
    let mut z: [f32; 11] = [7.0; 11];
    gemv_f16(wh, x, z);
    let mut r: i64 = 0;
    while r < 11 {
        print(y[r]);
        r = r + 1;
    }
    r = 0;
    while r < 11 {
        print(z[r]);
        r = r + 1;
    }
    return 0;
}
