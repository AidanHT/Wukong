// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 80
// EXPECT-OUT: 110
// EXPECT-OUT: 160
// EXPECT-OUT: 270
// EXPECT-OUT: 240
// EXPECT-OUT: 430
module tests.run.matmul_f32

/// A small f32 matmul C[3,2] = A[3,4]·B[4,2]. The compiler recognizes the nest and lowers it to the
/// `wukong_sgemm` microkernel; under `--run` the interpreter executes that same kernel (marshalling
/// its memory), so this exercises the GEMM-dispatch path end-to-end through the real binary.
///
/// It used to print `c[0]` and `c[5]` — two of six — so a permutation, a partial write or a wrong
/// row stride in four of the six outputs was invisible, and a recognizer fixture is gate-blind to
/// every differential and invariance gate by construction (the same symbol runs on both backends at
/// every `-O` level). All six are printed now.
///
/// The B data also changed, from `b[j] = j - 3` to `b[j] = j - 2`, and that is load-bearing rather
/// than cosmetic: with the old data B's first column was [-3, -1, 1, 3], which sums to zero, and
/// since A's rows are arithmetic progressions in k that made C[i,0] = 5.0 for all three rows.
/// Printing every lane of a column that is constant down i would have been coverage in appearance
/// only — a row permutation would still have passed. With `j - 2` the six outputs are six distinct
/// values, so any permutation of C is detectable.
///
/// WHERE THE EXPECTED VALUES COME FROM (scalar semantics, never a compiler run). A's rows are
/// [0, 0.5, 1.0, 1.5], [2.0, 2.5, 3.0, 3.5], [4.0, 4.5, 5.0, 5.5]; B's rows are [-2, -1], [0, 1],
/// [2, 3], [4, 5]. Every value is a multiple of 0.5 against an integer, so every product and every
/// partial sum is exact in f32 and the scale-by-10 print rounds nothing:
///   C[0,0] = 0·(-2) + 0.5·0 + 1.0·2 + 1.5·4  =  8.0 -> 80
///   C[0,1] = 0·(-1) + 0.5·1 + 1.0·3 + 1.5·5  = 11.0 -> 110
///   C[1,0] = 2·(-2) + 2.5·0 + 3.0·2 + 3.5·4  = 16.0 -> 160
///   C[1,1] = 2·(-1) + 2.5·1 + 3.0·3 + 3.5·5  = 27.0 -> 270
///   C[2,0] = 4·(-2) + 4.5·0 + 5.0·2 + 5.5·4  = 24.0 -> 240
///   C[2,1] = 4·(-1) + 4.5·1 + 5.0·3 + 5.5·5  = 43.0 -> 430
fn main() -> i32 {
    let mut a: [f32; 12] = [0.0; 12];
    let mut b: [f32; 8] = [0.0; 8];
    let mut c: [f32; 6] = [0.0; 6];
    let mut i: i32 = 0;
    while i < 12 { a[i] = (i as f32) * 0.5; i = i + 1; }
    let mut j: i32 = 0;
    while j < 8 { b[j] = (j as f32) - 2.0; j = j + 1; }

    for ii in 0..3 {
        for jj0 in 0..2 { c[ii * 2 + jj0] = 0.0; }
        for kk in 0..4 {
            let aik: f32 = a[ii * 4 + kk];
            for jj in 0..2 { c[ii * 2 + jj] = c[ii * 2 + jj] + aik * b[kk * 2 + jj]; }
        }
    }

    print((c[0] * 10.0) as i32);
    print((c[1] * 10.0) as i32);
    print((c[2] * 10.0) as i32);
    print((c[3] * 10.0) as i32);
    print((c[4] * 10.0) as i32);
    print((c[5] * 10.0) as i32);
    return 0;
}
