// EXPECT-EXIT: 0
// EXPECT-OUT: 90625
// EXPECT-OUT: 19433
module tests.run.bf16_loop_carried

// Loop-carried bf16/f16 scalar arithmetic must round to the half grid at EVERY iteration and at
// every opt level. The rounding must live at the VALUE (an FpTrunc on the op result), not only in
// the store: mem2reg promotes the scalar's slot and forwards the raw f32 past the deleted store,
// which made -O2 accumulate in full f32 (90234/19443) while -O0 stepped on the bf16/f16 grid
// (90625/19433). The literal/const twin lives in bf16_literal_grid.mer; this covers the runtime,
// non-const-foldable loop-carried form for both an add chain (bf16) and a mul chain (f16).

fn main() -> i32 {
    let mut acc: bf16 = 0.0;
    let stepv: bf16 = 0.1;
    let mut i = 0;
    while i < 9 {
        acc = acc + stepv;
        i = i + 1;
    }
    print((acc as f32 * 100000.0) as i32); // 90625 (bf16-stepped), not 90234 (f32-accumulated)

    let mut m: f16 = 1.1;
    let f: f16 = 1.1;
    let mut j = 0;
    while j < 6 {
        m = m * f;
        j = j + 1;
    }
    print((m as f32 * 10000.0) as i32); // 19433 (f16-stepped), not 19443
    return 0;
}
