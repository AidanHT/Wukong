module tests.run.vec256_opt_specials

// A 256-bit kernel the optimizer builds (-O2) over NaN, both zeros, both infinities and the
// smallest subnormal, every lane printed as its raw IEEE bits (`bits`), so a payload, a sign or a
// flushed subnormal cannot hide behind a decimal rendering. The loop calls helpers the front end's
// vectorizer cannot capture; after inlining its body is one recipe: a negation (a sign flip, even
// of a NaN), a compare-and-blend, a square root feeding a fused multiply-add, and an unordered `!=`
// (true on NaN) choosing a subtraction. n = 2053: 256 kernel groups of 8 lanes, one 128-bit group
// of 4, one scalar lane - and each output is a cycle of 8, so every lane of the kernel, the 128-bit
// remainder and the scalar tail is compared against the same hand-derived row.
//
// x[i] = S[i % 8], y[i] = S[(3i + 5) % 8], with S = [qNaN payload 1 (0x7fc00001), -0, +0, +inf,
// -inf, 1.5, -2.25, 2^-149 (0x00000001)]. Per residue r = i % 8, (x, y) is
// (NaN, 1.5), (-0, NaN), (+0, +inf), (+inf, -2.25), (-inf, -0), (1.5, -inf), (-2.25, 2^-149),
// (2^-149, +0). Three kernels compute the four outputs, derived by hand under IEEE 754 binary32
// with x86's NaN rules (an operation with one NaN operand returns that NaN; an invalid operation
// returns the default NaN 0xffc00000):
//   o = -x                       : 0xffc00001 +0 -0 -inf +inf -1.5 2.25 -2^-149
//   p = x > y ? x : y            : 1.5 NaN1 +inf +inf -0 1.5 2^-149 2^-149   (NaN compares false)
//   q = fma(sqrt(x), 2, y)       : NaN1 NaN1 +inf +inf 0xffc00000 -inf 0xffc00000 0x1ab504f3
//                                  (sqrt(-inf), sqrt(-2.25): default NaN; sqrt(2^-149) =
//                                  2^-75 * sqrt(2) = 0x1a3504f3, doubled exactly)
//   w = x != 1.5 ? y - x : 7     : NaN1 NaN1 +inf -inf +inf 7 2.25 -2^-149
//                                  (2^-149 + 2.25 rounds to 2.25)
// Each array prints 8 lanes - one cycle - to a line.

fn pmax(a: f32, b: f32) -> f32 {
    if a > b {
        return a;
    }
    return b;
}

fn ne_sub(a: f32, b: f32) -> f32 {
    if a != 1.5 {
        return b - a;
    }
    return 7.0;
}

// Three loops, because the 128-bit plan the kernel restates if-converts one branch per body.
@unchecked
fn kern_neg_fma(x: []f32, y: []f32, mut o: []f32, mut q: []f32, n: i64, d: i64) {
    if d > 0 {
        kern_neg_fma(x, y, o, q, n, d - 1);
        return;
    }
    let mut i: i64 = 0;
    while i < n {
        o[i] = -x[i];
        q[i] = sqrt(x[i]) * 2.0 + y[i];
        i = i + 1;
    }
}

@unchecked
fn kern_max(x: []f32, y: []f32, mut p: []f32, n: i64, d: i64) {
    if d > 0 {
        kern_max(x, y, p, n, d - 1);
        return;
    }
    let mut i: i64 = 0;
    while i < n {
        p[i] = pmax(x[i], y[i]);
        i = i + 1;
    }
}

@unchecked
fn kern_ne(x: []f32, y: []f32, mut w: []f32, n: i64, d: i64) {
    if d > 0 {
        kern_ne(x, y, w, n, d - 1);
        return;
    }
    let mut i: i64 = 0;
    while i < n {
        w[i] = ne_sub(x[i], y[i]);
        i = i + 1;
    }
}

fn special(r: i64) -> f32 {
    if r == 0 {
        return f32_from_bits(2143289345 as u32);
    }
    if r == 1 {
        return f32_from_bits(2147483648 as u32);
    }
    if r == 2 {
        return f32_from_bits(0 as u32);
    }
    if r == 3 {
        return f32_from_bits(2139095040 as u32);
    }
    if r == 4 {
        return f32_from_bits(4286578688 as u32);
    }
    if r == 5 {
        return 1.5;
    }
    if r == 6 {
        return -2.25;
    }
    return f32_from_bits(1 as u32);
}

fn show(v: []f32, n: i64) {
    let mut i: i64 = 0;
    while i < n {
        print_raw(bits(v[i]));
        if (i + 1) % 8 == 0 || i + 1 == n {
            print_raw("\n");
        } else {
            print_raw(" ");
        }
        i = i + 1;
    }
}

fn main() -> i32 {
    let n: i64 = 2053;
    let mut x: []f32 = alloc_f32(n);
    let mut y: []f32 = alloc_f32(n);
    let mut o: []f32 = alloc_f32(n);
    let mut p: []f32 = alloc_f32(n);
    let mut q: []f32 = alloc_f32(n);
    let mut w: []f32 = alloc_f32(n);
    let mut i: i64 = 0;
    while i < n {
        x[i] = special(i % 8);
        y[i] = special((3 * i + 5) % 8);
        i = i + 1;
    }
    kern_neg_fma(x, y, o, q, n, 0);
    kern_max(x, y, p, n, 0);
    kern_ne(x, y, w, n, 0);
    show(o, n);
    show(p, n);
    show(q, n);
    show(w, n);
    free(x);
    free(y);
    free(o);
    free(p);
    free(q);
    free(w);
    return 0;
}
