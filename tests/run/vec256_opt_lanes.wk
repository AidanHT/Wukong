module tests.run.vec256_opt_lanes

// 256-bit kernels the OPTIMIZER builds (-O2), for loops the front end's own vectorizer leaves
// scalar: each body calls a helper, which `mir_build`'s recipe path cannot capture and the inliner
// splices in before `wukong_opt::vectorize` runs. The widened loop's body is then a raw-AVX2
// recipe (`veckernel #` in `--emit=mir -O2`, on a Win64 AVX2 host), called for the whole
// multiple-of-lanes part of a trip of at least 2048, with the original loop as its remainder: one
// 128-bit group, then the scalar tail. Below 2048 the kernel is skipped at run time and the 128-bit
// loop does everything. Every lane of every buffer is printed, 32 (16 for i32) per line.
//
// Each kernel calls itself when `d > 0` (never, here), so the inliner - which takes leaf functions
// only - keeps it out of `main` and its trip a runtime value.
//
// Every expected line is the scalar loop's answer, derived by hand from the loops below:
//   kf: x[i] = (i % 61) / 4 - 4, o = x * 2 + 1/2 = (i % 61) / 2 - 15/2, printed as o * 2 =
//       (i % 61) - 15. Run at n = 2053 (256 kernel groups of 8, one group of 4, one scalar lane)
//       and at n = 2047 (below the gate: 511 groups of 4, three scalar lanes).
//   ki: a = (i % 23 - 11) * 10^8, b = (i % 17 - 8) * 5 * 10^7, c = a < b ? a * 3 - b : -a,
//       wrapping at 32 bits (a * 3 reaches 3.3 * 10^9). n = 2053.
//   kd: a = (i % 29) / 8, e = a * 3 - 1, printed as e * 8 = 3 * (i % 29) - 8. n = 2053.

fn axpb(v: f32, s: f32) -> f32 {
    return v * s + 0.5;
}

fn kf(x: []f32, mut o: []f32, s: f32, n: i64, d: i64) {
    if d > 0 {
        kf(x, o, s, n, d - 1);
        return;
    }
    let mut i: i64 = 0;
    while i < n {
        o[i] = axpb(x[i], s);
        i = i + 1;
    }
}

fn isel(a: i32, b: i32) -> i32 {
    if a < b {
        return a * 3 - b;
    }
    return -a;
}

@unchecked
fn ki(a: []i32, b: []i32, mut c: []i32, n: i64, d: i64) {
    if d > 0 {
        ki(a, b, c, n, d - 1);
        return;
    }
    let mut i: i64 = 0;
    while i < n {
        c[i] = isel(a[i], b[i]);
        i = i + 1;
    }
}

fn affd(v: f64, s: f64) -> f64 {
    return v * s - 1.0;
}

fn kd(a: []f64, mut e: []f64, s: f64, n: i64, d: i64) {
    if d > 0 {
        kd(a, e, s, n, d - 1);
        return;
    }
    let mut i: i64 = 0;
    while i < n {
        e[i] = affd(a[i], s);
        i = i + 1;
    }
}

// `per` values to a line, separated by single spaces.
fn sep(i: i64, n: i64, per: i64) {
    if (i + 1) % per == 0 || i + 1 == n {
        print_raw("\n");
    } else {
        print_raw(" ");
    }
}

fn main() -> i32 {
    let n: i64 = 2053;
    let short: i64 = 2047;
    let mut x: []f32 = alloc_f32(n);
    let mut o: []f32 = alloc_f32(n);
    let mut o2: []f32 = alloc_f32(n);
    let mut a: []i32 = alloc_i32(n);
    let mut b: []i32 = alloc_i32(n);
    let mut c: []i32 = alloc_i32(n);
    let mut ad: []f64 = alloc_f64(n);
    let mut e: []f64 = alloc_f64(n);
    let mut i: i64 = 0;
    while i < n {
        x[i] = (i % 61) as f32 * 0.25 - 4.0;
        a[i] = ((i % 23 - 11) * 100000000) as i32;
        b[i] = ((i % 17 - 8) * 50000000) as i32;
        ad[i] = (i % 29) as f64 * 0.125;
        i = i + 1;
    }
    kf(x, o, 2.0, n, 0);
    kf(x, o2, 2.0, short, 0);
    ki(a, b, c, n, 0);
    kd(ad, e, 3.0, n, 0);
    i = 0;
    while i < n {
        print_raw((o[i] * 2.0) as i64);
        sep(i, n, 32);
        i = i + 1;
    }
    i = 0;
    while i < short {
        print_raw((o2[i] * 2.0) as i64);
        sep(i, short, 32);
        i = i + 1;
    }
    i = 0;
    while i < n {
        print_raw(c[i]);
        sep(i, n, 16);
        i = i + 1;
    }
    i = 0;
    while i < n {
        print_raw((e[i] * 8.0) as i64);
        sep(i, n, 32);
        i = i + 1;
    }
    free(x);
    free(o);
    free(o2);
    free(a);
    free(b);
    free(c);
    free(ad);
    free(e);
    return 0;
}
