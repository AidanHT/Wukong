// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 1.6487212181091309
// EXPECT-OUT: 1.6487212181091309
module tests.run.transcendental_kernel

// An `out[i] = exp(x[i])` loop dispatches to the 256-bit `mercury_vmath_f32` microkernel (the same
// symbol on both backends — the differential gate is bit-exact). It also exercises `--emit=exe`
// linking the `mercury_runtime` kernels: this program links to a runnable executable whose output
// matches `--run` (see the `exe.rs` gate).
fn main() -> i32 {
    let n: i32 = 16;
    let x = [0.5; 16];
    let y = [0.0; 16];
    for i in 0..n {
        y[i] = exp(x[i]);
    }
    print(y[0]);
    print(y[15]);
    return 0;
}
