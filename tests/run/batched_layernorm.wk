// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: -1342
// EXPECT-OUT: 0
// EXPECT-OUT: -577
module tests.run.batched_layernorm

// Batched LayerNorm over a flat [R, C] matrix: each row r is normalized by its own mean/variance,
// x[r*C+i] = (x[r*C+i] - mean_r) / sqrt(var_r + eps). The `for r { ...row r... }` outer loop dispatches
// to the fused single-pass norm kernel with rows = R (each row independent) — the real transformer
// shape (LayerNorm over [batch*seq, hidden]). The mercury_bench gate proves interp == native.

fn layernorm_batch(mut x: [f32; 12]) { // R = 3 rows, C = 4 cols
    for r in 0..3 {
        let mut s: f32 = 0.0;
        for i in 0..4 { s = s + x[r*4+i]; }
        let mean: f32 = s / 4.0;
        let mut v: f32 = 0.0;
        for i in 0..4 { v = v + (x[r*4+i] - mean) * (x[r*4+i] - mean); }
        let inv: f32 = rsqrt(v / 4.0 + 0.00001);
        for i in 0..4 { x[r*4+i] = (x[r*4+i] - mean) * inv; }
    }
}

fn main() -> i32 {
    let mut x: [f32; 12] = [0.0; 12];
    x[0]=1.0; x[1]=2.0; x[2]=3.0; x[3]=4.0;     // row 0
    x[4]=2.0; x[5]=2.0; x[6]=2.0; x[7]=2.0;     // row 1 (uniform → var 0 → all 0)
    x[8]=0.0; x[9]=0.0; x[10]=0.0; x[11]=4.0;   // row 2
    layernorm_batch(x);

    // row 0: mean 2.5, var 1.25, (1-2.5)/sqrt(1.25) ≈ -1.3416
    print(round(x[0] * 1000.0) as i32);  // -1342
    // row 1 uniform: var 0, (2-2)/sqrt(eps) = 0
    print(round(x[4] * 1000.0) as i32);  // 0
    // row 2: mean 1, var 3, (0-1)/sqrt(3) ≈ -0.5773
    print(round(x[8] * 1000.0) as i32);  // -577
    return 0;
}
