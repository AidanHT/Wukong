// EXPECT-OUT: -16
module tests.run.vec5_scatter

// Replicated per-lane scatters (-O2). A store through a data-dependent index, `o[q[i]] = v`, is a
// scatter: no lane offset is known, but every lane can do its own scalar store. The vectorizer
// widens everything around it and emits the W stores in lane order, which is iteration order, so of
// two iterations writing one element the later one lands last - exactly the scalar loop. That is
// only sound when nothing else in the loop touches the scattered object, which `@noalias` (or a
// local table nothing outside `main` can name) lets `loop_info::dependence` prove.
//
// Each kernel is kept OUT of line: the kernels and `again` call each other, so the inliner never
// splices them into `main`, where the destinations would lose their promise. `again` hands the
// kernels fresh buffers rather than their own: passing a promised slice to a call would let its
// storage escape. n = 37 is nine groups of four plus a scalar tail of one. Every index pattern
// repeats an index inside one group AND across groups, and leaves some slots unwritten.
//
// Every expected line is the scalar loop's answer, derived by hand from the loops below: the slot's
// last writer in iteration order, or its initial value if nothing writes it. Values are multiples
// of 1/8, printed as `(v * 8.0) as i64`.
//
//   scatter_f32: q[j] = (j / 2) % 13, x[j] = j/4 - 3, o = x*2 + 1 over -9.0 (16 slots; 13..15
//                unwritten). Slot 0's writers are j = 0, 1, 26, 27; slot 5's are 10, 11 and 36,
//                the scalar tail.
//   scatter_i32: q[j] = (j*j) % 10, y[j] = 5j - 40, o = y*3 - 7 over -1 (10 slots; 2, 3, 7, 8
//                unwritten). Groups 1 and 2 hit one slot twice (lanes 0 and 2; lanes 1 and 3).
//   scatter_f64: q[j] = (3j / 4) % 9, z[j] = j/4 - 9/2, o = z/2 + 1/4 over 100.0 (10 slots; 9
//                unwritten). f64 values are two <2 x f64> parts per group of four i32 indices.
//   main's table: q[j] = (j / 2) % 7, x as above, t = x*4 - 1/2 over -2.0 (8 slots; 7 unwritten).

@unchecked
fn scatter_f32(@noalias mut o: []f32, x: []f32, q: []i32, n: i64, d: i64) {
    if d > 0 {
        again(d - 1);
        return;
    }
    let mut i: i64 = 0;
    while i < n {
        o[q[i] as i64] = x[i] * 2.0 + 1.0;
        i = i + 1;
    }
}

@unchecked
fn scatter_i32(@noalias mut o: []i32, y: []i32, q: []i32, n: i64, d: i64) {
    if d > 0 {
        again(d - 1);
        return;
    }
    let mut i: i64 = 0;
    while i < n {
        o[q[i] as i64] = y[i] * 3 - 7;
        i = i + 1;
    }
}

@unchecked
fn scatter_f64(@noalias mut o: []f64, z: []f64, q: []i32, n: i64, d: i64) {
    if d > 0 {
        again(d - 1);
        return;
    }
    let mut i: i64 = 0;
    while i < n {
        o[q[i] as i64] = z[i] * 0.5 + 0.25;
        i = i + 1;
    }
}

fn again(d: i64) {
    let mut a: []f32 = alloc_f32(1);
    let mut b: []f32 = alloc_f32(1);
    let mut c: []i32 = alloc_i32(1);
    let mut e: []i32 = alloc_i32(1);
    let mut g: []f64 = alloc_f64(1);
    let mut h: []f64 = alloc_f64(1);
    scatter_f32(a, b, c, 0, d);
    scatter_i32(c, e, e, 0, d);
    scatter_f64(g, h, c, 0, d);
    free(a);
    free(b);
    free(c);
    free(e);
    free(g);
    free(h);
}

@unchecked
fn main() -> i32 {
    let mut x: []f32 = alloc_f32(37);
    let mut y: []i32 = alloc_i32(37);
    let mut z: []f64 = alloc_f64(37);
    let mut qa: []i32 = alloc_i32(37);
    let mut qb: []i32 = alloc_i32(37);
    let mut qc: []i32 = alloc_i32(37);
    let mut qd: []i32 = alloc_i32(37);
    let mut j: i64 = 0;
    while j < 37 {
        x[j] = (j as f32) * 0.25 - 3.0;
        y[j] = (j as i32) * 5 - 40;
        z[j] = (j as f64) * 0.25 - 4.5;
        qa[j] = ((j / 2) % 13) as i32;
        qb[j] = ((j * j) % 10) as i32;
        qc[j] = (((j * 3) / 4) % 9) as i32;
        qd[j] = ((j / 2) % 7) as i32;
        j = j + 1;
    }

    let mut of: []f32 = alloc_f32(16);
    j = 0;
    while j < 16 {
        of[j] = -9.0;
        j = j + 1;
    }
    scatter_f32(of, x, qa, 37, 0);
    j = 0;
    while j < 16 {
        print((of[j] * 8.0) as i64);
        j = j + 1;
    }

    let mut oi: []i32 = alloc_i32(10);
    j = 0;
    while j < 10 {
        oi[j] = -1;
        j = j + 1;
    }
    scatter_i32(oi, y, qb, 37, 0);
    j = 0;
    while j < 10 {
        print(oi[j]);
        j = j + 1;
    }

    let mut od: []f64 = alloc_f64(10);
    j = 0;
    while j < 10 {
        od[j] = 100.0;
        j = j + 1;
    }
    scatter_f64(od, z, qc, 37, 0);
    j = 0;
    while j < 10 {
        print((od[j] * 8.0) as i64);
        j = j + 1;
    }

    // A local table needs no promise: nothing the loop reads can be a stack slot whose address
    // never escapes.
    let mut t: [f32; 8] = [-2.0; 8];
    j = 0;
    while j < 37 {
        t[qd[j] as i64] = x[j] * 4.0 - 0.5;
        j = j + 1;
    }
    j = 0;
    while j < 8 {
        print((t[j] * 8.0) as i64);
        j = j + 1;
    }

    free(x);
    free(y);
    free(z);
    free(qa);
    free(qb);
    free(qc);
    free(qd);
    free(of);
    free(oi);
    free(od);
    return 0;
}
