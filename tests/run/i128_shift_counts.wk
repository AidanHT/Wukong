// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 8
// EXPECT-OUT: -8
// EXPECT-OUT: 16
// EXPECT-OUT: 8
// EXPECT-OUT: 8
// EXPECT-OUT: 32
// EXPECT-OUT: 3
// EXPECT-OUT: 13835058055282163712
// EXPECT-OUT: 3
// EXPECT-OUT: 13835058055282163712
// EXPECT-OUT: 2147483648
module tests.run.i128_shift_counts

// A shift or rotate count is taken modulo the width of the value it shifts, which only the count's
// low bits decide — so a 128-bit count narrows to that width by TRUNCATION. It used to go through the
// conversion that clamps a 128-bit index or extent into `i64`'s range, so any count at or past 2^63
// became i64::MAX (a shift by 63) on a 64-bit place, while a 32-bit or 8-bit place truncated: the
// same count shifted by different amounts depending on the width, on both backends alike.
//
// Expected values, by hand. n = 2^64 + 3 (low 64 bits: 3); big = 2^63 + 5 (low 64 bits, read as
// i64: i64::MIN + 5, whose count modulo 64 is 5); k = 2^64 + 1 (low bits: 1); neg = -2^64 - 1 (low
// 64 bits all ones, i.e. -1: modulo 64 that is 63; modulo 32, 31).
//   1i64 <<= n   -> 1 << 3 = 8           -64i64 >>= n -> -64 >> 3 = -8 (arithmetic)
//   0x80u64 >>= n -> 128 >> 3 = 16       1u32 <<= n   -> 1 << ((2^64 + 3) mod 32 = 3) = 8
//   1i8 <<= n    -> 1 << 3 = 8           1i64 <<= big -> 1 << 5 = 32
//   p = 0x8000000000000001 (u64): rotl(p, k) rotates left by 1 -> 0x3 = 3;
//   rotr(p, k) rotates right by 1 -> 0xC000000000000000 = 13835058055282163712;
//   q = 0x80000001 (u32): rotl(q, k) -> by (2^64 + 1) mod 32 = 1 -> 3;
//   rotl(p, neg) -> by 63, i.e. right by 1 -> 13835058055282163712;
//   rotl(1u32, neg) -> the low 32 bits of neg are all ones too, -1 mod 32 = 31: 2^31 = 2147483648.
fn shifts(n: i128, big: i128, k: u128, neg: i128) {
    let mut a: i64 = 1;
    a <<= n;
    println(a);
    let mut b: i64 = -64;
    b >>= n;
    println(b);
    let mut c: u64 = 0x80;
    c >>= n;
    println(c);
    let mut d: u32 = 1;
    d <<= n;
    println(d);
    let mut e: i8 = 1;
    e <<= n;
    println(e);
    let mut f: i64 = 1;
    f <<= big;
    println(f);

    let p: u64 = 0x8000000000000001;
    println(rotl(p, k));
    println(rotr(p, k));
    let q: u32 = 0x80000001;
    println(rotl(q, k));
    println(rotl(p, neg));
    let one: u32 = 1;
    println(rotl(one, neg));
}

fn main() -> i32 {
    shifts(
        18446744073709551619,
        9223372036854775813,
        18446744073709551617,
        -18446744073709551617,
    );
    return 0;
}
