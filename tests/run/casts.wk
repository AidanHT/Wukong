// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: -2
// EXPECT-OUT: -3
// EXPECT-OUT: -1
// EXPECT-OUT: 25
// EXPECT-OUT: 48
// EXPECT-OUT: 5
// EXPECT-OUT: 7
// EXPECT-OUT: 3.5
// EXPECT-OUT: 15
module tests.run.casts

/// Negatives, signed modulo, shifts, and int/float casts — checked at -O0 and (via the
/// invariance test) every higher optimization level.
fn main() -> i32 {
    print(-5 + 3); // -2
    print(7 - 10); // -3
    print(-7 % 3); // -1
    print(100 >> 2); // 25
    print(3 << 4); // 48

    let a: i64 = 5;
    print(a as i32); // 5

    let f: f32 = 7.0;
    print(f as i32); // 7

    let m: i32 = 3;
    print(m as f32 + 0.5); // 3.5

    print(255 & 15); // 15
    return 0;
}
