// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 10
// EXPECT-OUT: 6
// EXPECT-OUT: 3.5
// EXPECT-OUT: 1
// EXPECT-OUT: 0
// EXPECT-OUT: 3
// EXPECT-OUT: 0
// EXPECT-OUT: 3
// EXPECT-OUT: 26
// EXPECT-OUT: 6
// EXPECT-OUT: 5
// EXPECT-OUT: 1.5
// EXPECT-OUT: 6.5
// EXPECT-OUT: 8.5
// EXPECT-OUT: 1
// EXPECT-OUT: 100
// EXPECT-OUT: 18
// EXPECT-OUT: 4
// EXPECT-OUT: -2
// EXPECT-OUT: 20
// EXPECT-OUT: 4
// EXPECT-OUT: 300307
module tests.run.closures

// Closure literals passed to function-typed parameters. Each literal is lifted to a top-level
// function whose leading parameters are its captures (copied by value when the call evaluates
// the argument), and the callee is specialized per closure (`apply$main$closure$0`), so a call
// through `f` is a direct call with the captures as ordinary scalar arguments. Expectations by
// hand, with scale = 2.5, k = 3.0:
//   apply(|x| x * scale, 4)                  = 4 * 2.5                       = 10
//   twice(|x| x + scale, 1)                  = 1 + 2.5 + 2.5                 = 6
//   compose(|x| x * k, |y| y - scale, 2)     = (2 * 3) - 2.5                 = 3.5
//   map_into(relu with lo = 0) over [1, -2, 3, -4]                          = 1 0 3 0
//   count_if(|v| v > t) over [1, 2, 3, 4, 5, 0], t = 2 (3, 4, 5)            = 3
//   fold3(|a, b| a + b + off, 1, 2, 3), off = 10: (1 + 2 + 10) + 3 + 10     = 26
//   sum over i in 0..3 of bump(|z| z + i) = (1 + 0) + (1 + 1) + (1 + 2)     = 6
//   writing through a captured pointer: 5, then 1.5, leaving total = 0 + 5 + 1.5 = 6.5
//   apply(|x| apply(|y| y * k, x) + scale, 2) = 2 * 3 + 2.5                 = 8.5
//   the capture is copied when the argument is evaluated: c = 1 is captured, then the next
//   argument sets c = 100 and evaluates to 0, so the closure returns 0 + 1   = 1, then c = 100
//   scaled_sum over [1, 2, 3] with n = N = 3: (1 + 2 + 3) * 3                = 18
//   a block body with an early `return`: |-4|                                = 4
//   a captured bool: neg = true, so 0 - 2                                    = -2
//   a parameterless closure: off * 2                                         = 20
//   a deferred call copies its captures when it runs: dc = 3 by then, 1 + 3  = 4
//   mutual(|x| x + 7, 2), where one instance binds BOTH parameters of `pair` to the same
//   literal with different captures (c = 1 from the literal, c = 2 forwarded):
//     mutual(p, 2) = pair(L[c=2], p, 2) = 200 * 1000 + 7 + mutual(L[c=2], 1)
//     mutual(L[c=2], 1) = pair(L[c=1], L[c=2], 1) = 100 * 1000 + 200 + mutual(L[c=1], 0)
//     mutual(L[c=1], 0) = L[c=1](0) = 100
//   so 200007 + 100200 + 100                                                = 300307

fn apply(f: fn(f32) -> f32, x: f32) -> f32 {
    return f(x);
}

fn twice(f: fn(f32) -> f32, x: f32) -> f32 {
    return apply(f, apply(f, x));
}

fn compose(f: fn(f32) -> f32, g: fn(f32) -> f32, x: f32) -> f32 {
    return g(f(x));
}

fn map_into(f: fn(f32) -> f32, x: [f32; 4], mut out: [f32; 4]) {
    for i in 0..4 {
        out[i] = f(x[i]);
    }
}

fn count_if(p: fn(i32) -> bool, xs: [i32; 6]) -> i32 {
    let mut n = 0;
    for i in 0..6 {
        if p(xs[i]) {
            n += 1;
        }
    }
    return n;
}

fn fold3<T>(f: fn(T, T) -> T, a: T, b: T, c: T) -> T {
    return f(f(a, b), c);
}

fn bump(f: fn(i64) -> i64) -> i64 {
    return f(1);
}

fn call0(f: fn() -> i32) -> i32 {
    return f();
}

fn set_and_zero(p: *mut f32) -> f32 {
    *p = 100.0;
    return 0.0;
}

fn mutual(p: fn(i32) -> i32, n: i32) -> i32 {
    if n == 0 {
        return p(0);
    }
    let c = n;
    return pair(|x| x + c * 100, p, n);
}

fn pair(f: fn(i32) -> i32, g: fn(i32) -> i32, n: i32) -> i32 {
    return f(0) * 1000 + g(0) + mutual(f, n - 1);
}

fn scaled_sum<N>(a: [f32; N]) -> f32 {
    let n = N as f32;
    let mut s = 0.0;
    for i in 0..N {
        s = s + apply(|x| x * n, a[i]);
    }
    return s;
}

fn main() -> i32 {
    let scale = 2.5;
    let k = 3.0;
    print(apply(|x| x * scale, 4.0));
    print(twice(|x| x + scale, 1.0));
    print(compose(|x| x * k, |y| y - scale, 2.0));

    let lo = 0.0;
    let xs: [f32; 4] = [1.0, -2.0, 3.0, -4.0];
    let mut ys: [f32; 4] = [0.0; 4];
    map_into(|v| if v > lo { v } else { lo }, xs, ys);
    for i in 0..4 {
        print(ys[i]);
    }

    let t = 2;
    print(count_if(|v: i32| v > t, [1, 2, 3, 4, 5, 0]));

    let off = 10;
    print(fold3(|a: i32, b: i32| a + b + off, 1, 2, 3));

    let mut acc: i64 = 0;
    for i in 0..3 {
        acc += bump(|z| z + (i as i64));
    }
    print(acc);

    let mut total = 0.0;
    let pt = &mut total;
    print(apply(|x| {
        *pt = *pt + x;
        x
    }, 5.0));
    print(apply(|x| {
        *pt = *pt + x;
        x
    }, 1.5));
    print(total);

    print(apply(|x| apply(|y| y * k, x) + scale, 2.0));

    let mut c = 1.0;
    print(apply(|x| x + c, set_and_zero(&mut c)));
    print(c);

    let a: [f32; 3] = [1.0, 2.0, 3.0];
    print(scaled_sum(a));

    print(apply(|x| -> f32 {
        if x < 0.0 {
            return 0.0 - x;
        }
        x
    }, -4.0));

    let neg = true;
    print(apply(|x| if neg { 0.0 - x } else { x }, 2.0));

    print(call0(|| off * 2));

    let mut dc = 1.0;
    {
        defer print(apply(|x| x + dc, 1.0));
        dc = 3.0;
    }

    print(mutual(|x| x + 7, 2));
    return 0;
}
