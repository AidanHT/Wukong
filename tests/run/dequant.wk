// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 1
// EXPECT-OUT: 2
// EXPECT-OUT: 4
// EXPECT-OUT: 7
// EXPECT-OUT: 0
// EXPECT-OUT: 0
// EXPECT-OUT: 2
// EXPECT-OUT: 6
module tests.run.dequant

// Int-input dequantization — out[j] = act((q[j] as f32) * scale) — the ubiquitous boundary of the
// quantized dataflow (an [i8]/[u8]/[i32] quantized weight/activation/accumulator decoded back to f32).
// The compiler recognizes the streaming widen+scale map and lowers it to one wukong_dequant_f32 call
// (256-bit cvt+mul; the widening the scalar path leaves one-element-per-instruction). Integer→f32 is
// exact, so the kernel equals the scalar loop bit-for-bit; both backends marshal the identical kernel,
// so the differential gate is exact and -O0 == -O3. Powers-of-two scales keep the printed values exact.
fn main() -> i32 {
    // Pure i32 accumulator dequant: out[j] = (q[j] as f32) * 0.25.
    let mut q: [i32; 32] = [0; 32];
    let mut out: [f32; 32] = [0.0; 32];
    for j in 0..32 {
        q[j] = j as i32;
    }
    let scale: f32 = 0.25;
    for j in 0..32 {
        out[j] = (q[j] as f32) * scale;
    }
    print(round(out[4]) as i32); // 4 * 0.25 = 1
    print(round(out[8]) as i32); // 8 * 0.25 = 2
    print(round(out[16]) as i32); // 16 * 0.25 = 4
    print(round(out[28]) as i32); // 28 * 0.25 = 7

    // int8 weight dequant with a fused ReLU: out2[j] = max((q2[j] as f32) * 0.5, 0).
    let mut q2: [i8; 32] = [0 as i8; 32];
    let mut out2: [f32; 32] = [0.0; 32];
    for j in 0..32 {
        q2[j] = ((j as i32) - 16) as i8; // -16 .. 15
    }
    let scale2: f32 = 0.5;
    for j in 0..32 {
        out2[j] = fmax((q2[j] as f32) * scale2, 0.0);
    }
    print(round(out2[0]) as i32); // max(-16*0.5,0) = 0
    print(round(out2[16]) as i32); // max(0*0.5,0)  = 0
    print(round(out2[20]) as i32); // max(4*0.5,0)  = 2
    print(round(out2[28]) as i32); // max(12*0.5,0) = 6
    return 0;
}
