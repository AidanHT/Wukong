// RUN: --run
// EXPECT-EXIT: 0
// EXPECT-OUT: 11
// EXPECT-OUT: 0
// EXPECT-OUT: 36
// EXPECT-OUT: 0
module tests.run.linear_bf16_ffn

// bf16 mixed-precision fused FFN projection: C = relu(A·Bᵀ + bias) — a bf16 nn.Linear matmul
// immediately followed by its bias-add + activation loop over the same C. The compiler fuses the two
// into one mercury_sgemm_bf16_nt_epi call: the lossless bf16 widen prepass feeds the tuned f32 GEMM,
// which folds the bias + ReLU into the C writeback (C is written once — no separate epilogue pass).
// Small integers are bf16-exact, so the result is exact and the differential gate is bit-for-bit
// (interp == native, -O0 == -O3). A is [2,3], B is [4,3] (rows are weight vectors), C is [2,4],
// bias is [4]. The two outputs that clip to 0 exercise the fused ReLU.
fn main() -> i32 {
    let mut a: [bf16; 6] = [0.0 as bf16; 6];
    let mut b: [bf16; 12] = [0.0 as bf16; 12];
    let mut c: [f32; 8] = [0.0; 8];
    let bias: [f32; 4] = [10.0, 20.0, 30.0, 4.0];
    for i in 0..6 {
        a[i] = ((i + 1) as f32) as bf16; // A = [[1,2,3],[4,5,6]]
    }
    // B rows (the weight vectors): e0, e1, e2, and -1·ones — so C = A·Bᵀ reads back columns of A in
    // the first three outputs and the negated row-sum in the fourth.
    b[0] = 1.0 as bf16;
    b[4] = 1.0 as bf16;
    b[8] = 1.0 as bf16;
    b[9] = -1.0 as bf16;
    b[10] = -1.0 as bf16;
    b[11] = -1.0 as bf16;

    // C = A·Bᵀ   (bf16 reads widen to f32; products + sums accumulate in f32)
    for i in 0..2 {
        for j in 0..4 {
            let mut s: f32 = 0.0;
            for k in 0..3 {
                s = s + (a[i * 3 + k] as f32) * (b[j * 3 + k] as f32);
            }
            c[i * 4 + j] = s;
        }
    }
    // Fused epilogue: C = relu(C + bias).
    for i in 0..2 {
        for j in 0..4 {
            c[i * 4 + j] = fmax(c[i * 4 + j] + bias[j], 0.0);
        }
    }

    print(c[0] as i32); // relu(1 + 10)   = 11
    print(c[3] as i32); // relu(-6 + 4)   = relu(-2)  = 0
    print(c[6] as i32); // relu(6 + 30)   = 36
    print(c[7] as i32); // relu(-15 + 4)  = relu(-11) = 0
    return 0;
}
