module tests.run.cov4_par_rope

// P12.4: wukong_rope_f32_parallel and wukong_rope_bwd_f32_parallel. Both rotation nests sit in one
// multi-statement `@parallel` function, lowered whole with `parallel_fn` set, so the RoPE arm emits
// the `_parallel` forward and backward kernels (`--emit=mir -O2`, census).
//
// Shape: 4 rows (positions 0..3) of 9 rotation pairs (row width 18): four rows so the forced-parallel
// lane forks over rows, nine pairs so the kernel's 8-pair sin/cos block runs once and then a 1-pair
// tail.
//
// The kernels evaluate sin/cos with a ~1-ULP f32 polynomial, so every lane is EXPECT-OUT-APPROX
// against an INDEPENDENT f64 reference of the rotation, out = (a cos t - b sin t, b cos t + a sin t)
// (backward: the transpose rotation, (a cos t + b sin t, b cos t - a sin t)), computed by a scratch
// script outside the repository from the exact f32 inputs. The tolerance is the kernels' documented
// f64-reference bound (rope.rs / rope_bwd.rs: absolute 1e-4 at unit scale) converted to a relative
// tolerance at each lane's magnitude and rounded up to a decade; see DECLARED_TOLERANCES.
//
// Inputs: x[r, k] = ((5r + 6k + 1) % 11) - 4.5 (half-integers, never 0; the pattern was chosen so
// no output lane cancels below 0.38), inv_freq[j] = 2^-j, and
// theta = r * inv_freq[j] is an exact f32 product. Row 0 (theta = 0) is the identity rotation.
// The outputs are poisoned first. EVERY lane is printed (2 x 72).

@parallel
fn ropes(x: [f32; 72], inv_freq: [f32; 9], mut out: [f32; 72], mut dx: [f32; 72]) {
    for r in 0..4 {
        for j in 0..9 {
            let theta: f32 = (r as f32) * inv_freq[j];
            let c: f32 = cos(theta);
            let s: f32 = sin(theta);
            let a: f32 = x[r * 18 + j];
            let b: f32 = x[r * 18 + j + 9];
            out[r * 18 + j] = a * c - b * s;
            out[r * 18 + j + 9] = b * c + a * s;
        }
    }
    for r in 0..4 {
        for j in 0..9 {
            let theta: f32 = (r as f32) * inv_freq[j];
            let c: f32 = cos(theta);
            let s: f32 = sin(theta);
            let a: f32 = x[r * 18 + j];
            let b: f32 = x[r * 18 + j + 9];
            dx[r * 18 + j] = a * c + b * s;
            dx[r * 18 + j + 9] = b * c - a * s;
        }
    }
}

fn main() -> i32 {
    let mut x: [f32; 72] = [0.0; 72];
    for r in 0..4 {
        for k in 0..18 {
            x[r * 18 + k] = (((r * 5 + k * 6 + 1) % 11) as f32) - 4.5;
        }
    }
    let mut inv_freq: [f32; 9] = [0.0; 9];
    let mut f: f32 = 1.0;
    for j in 0..9 {
        inv_freq[j] = f;
        f = f * 0.5;
    }
    let mut out: [f32; 72] = [-1000.0; 72];
    let mut dx: [f32; 72] = [-1000.0; 72];
    ropes(x, inv_freq, out, dx);
    for k in 0..72 { print(out[k]); }
    for k in 0..72 { print(dx[k]); }
    return 0;
}
