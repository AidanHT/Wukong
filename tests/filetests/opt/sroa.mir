; RUN: wukongc --emit=mir --passes=sroa %s | filecheck %s
; RUN: wukongc --emit=mir --passes=sroa,mem2reg %s | filecheck %s --check-prefix=PROMOTED
;
; `sroa` splits a local array whose every access goes through a constant-index `gep` into one
; scalar slot per element, so `mem2reg` can then promote each. A slot reached through a variable
; index is left whole.

; CHECK-LABEL: fn pair(
; CHECK-NOT:     alloca [2 x f32]
; CHECK-DAG:     [[A:v[0-9]+]] = alloca f32
; CHECK-DAG:     [[B:v[0-9]+]] = alloca f32
; CHECK-DAG:     store v0, [[A]]
; CHECK-DAG:     store v1, [[B]]
; CHECK-NOT:     gep
; CHECK:         fadd
;
; PROMOTED-LABEL: fn pair(
; PROMOTED-NEXT:    bb0(v0 f32, v1 f32):
; PROMOTED-NOT:     alloca
; PROMOTED-NOT:     load
; PROMOTED:         [[SUM:v[0-9]+]] = fadd v0, v1
; PROMOTED-NEXT:    ret [[SUM]]
fn pair(v0 f32, v1 f32) -> f32 {
  bb0(v0 f32, v1 f32):
    v2: ptr = alloca [2 x f32]
    v3: i64 = const.i64 0
    v4: ptr = gep v2, v3 : f32
    store v0, v4
    v5: i64 = const.i64 1
    v6: ptr = gep v2, v5 : f32
    store v1, v6
    v7: f32 = load f32 v4
    v8: f32 = load f32 v6
    v9: f32 = fadd v7, v8
    ret v9
}

; CHECK-LABEL: fn dynamic_index(
; CHECK:         alloca [2 x f32]
; CHECK:         gep {{v[0-9]+}}, v1 : f32
;
; PROMOTED-LABEL: fn dynamic_index(
; PROMOTED:         alloca [2 x f32]
; PROMOTED:         load f32
fn dynamic_index(v0 f32, v1 i64) -> f32 {
  bb0(v0 f32, v1 i64):
    v2: ptr = alloca [2 x f32]
    v3: ptr = gep v2, v1 : f32
    store v0, v3
    v4: i64 = const.i64 0
    v5: ptr = gep v2, v4 : f32
    v6: f32 = load f32 v5
    ret v6
}
