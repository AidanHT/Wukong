; RUN: wukongc --emit=mir --passes=simplify-cfg %s | filecheck %s
;
; `simplify-cfg` folds a branch on a constant to a jump, deletes the arm that became unreachable,
; and merges a block into its only predecessor when that predecessor only jumps to it.

; The condition is the constant true: only the `add` arm survives, merged into the entry block.
; CHECK-LABEL: fn const_branch(
; CHECK-NEXT:    bb0(v0 i32):
; CHECK-NOT:     cond_br
; CHECK-NOT:     mul
; CHECK:         [[R:v[0-9]+]] = add v0,
; CHECK-NEXT:    ret [[R]]
; CHECK-NOT:     bb1
fn const_branch(v0 i32) -> i32 {
  bb0(v0 i32):
    v1: i1 = const.i1 1
    cond_br v1, bb1, bb2
  bb1:
    v2: i32 = const.i32 1
    v3: i32 = add v0, v2
    br bb3(v3)
  bb2:
    v4: i32 = const.i32 2
    v5: i32 = mul v0, v4
    br bb3(v5)
  bb3(v6 i32):
    ret v6
}

; A chain of unconditional jumps is one block.
; CHECK-LABEL: fn straight(
; CHECK-NEXT:    bb0(v0 i32):
; CHECK-NEXT:    [[C:v[0-9]+]] = const.i32 3
; CHECK-NEXT:    [[S:v[0-9]+]] = add v0, [[C]]
; CHECK-NEXT:    ret [[S]]
; CHECK-NEXT:  }
fn straight(v0 i32) -> i32 {
  bb0(v0 i32):
    br bb1
  bb1:
    v1: i32 = const.i32 3
    br bb2
  bb2:
    v2: i32 = add v0, v1
    ret v2
}
