; RUN: wukongc --emit=mir --passes=simplify-phis %s | filecheck %s
;
; `simplify-phis` drops a block parameter every edge feeds the same value (it is that value) and a
; parameter nothing reads; the join's uses read the value directly.

; CHECK-LABEL: fn trivial_param(
; CHECK:       bb1:
; CHECK-NEXT:    br bb3{{$}}
; CHECK:       bb2:
; CHECK-NEXT:    br bb3{{$}}
; CHECK:       bb3:
; CHECK-NEXT:    add v0, v0
fn trivial_param(v0 i32, v1 i1) -> i32 {
  bb0(v0 i32, v1 i1):
    cond_br v1, bb1, bb2
  bb1:
    br bb3(v0, v0)
  bb2:
    br bb3(v0, v0)
  bb3(v2 i32, v3 i32):
    v4: i32 = add v2, v3
    ret v4
}

; The second parameter differs per edge but nothing reads it.
; CHECK-LABEL: fn unused_param(
; CHECK:       bb1:
; CHECK-NEXT:    br bb3(v0)
; CHECK:       bb2:
; CHECK-NEXT:    br bb3(v1)
; CHECK:       bb3([[P:v[0-9]+]] i32):
; CHECK-NEXT:    ret [[P]]
fn unused_param(v0 i32, v1 i32, v2 i1) -> i32 {
  bb0(v0 i32, v1 i32, v2 i1):
    cond_br v2, bb1, bb2
  bb1:
    br bb3(v0, v1)
  bb2:
    br bb3(v1, v0)
  bb3(v3 i32, v4 i32):
    ret v3
}
