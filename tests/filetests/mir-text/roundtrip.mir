; wukong mir text v1
; RUN: wukongc --emit=mir-text --passes= %s > %t.once.mir
; RUN: wukongc --emit=mir-text --passes= %t.once.mir > %t.twice.mir
; RUN: diff %t.once.mir %t.twice.mir
; RUN: filecheck %s --input-file=%t.once.mir
; RUN: wukongc --emit=mir --passes= %s | filecheck %s --check-prefix=UNTYPED
;
; The typed textual MIR reads back to the same program: printing what was parsed reproduces
; every line below, and parsing that again changes nothing. It carries what the plain --emit=mir
; dump drops: the extern's C signedness, the static's bytes, the parameter promises (noalias,
; slice, extent), a non-zero entry block, the value arena's length, every result's type and each
; float constant's exact bits (a NaN payload included).

; CHECK:      ; wukong mir text v1
; CHECK-NEXT: declare extern "C" fn labs(i64 signed) -> i64 signed
; CHECK-NEXT: static greeting = hex 68690a00
; CHECK-EMPTY:
; CHECK-NEXT: fn kernel(v0 ptr noalias extent=8x4, v1 ptr slice, v2 f32) -> f32 {
; CHECK-NEXT:   entry bb1
; CHECK-NEXT:   values 20
; CHECK-NEXT:   bb0:
; CHECK-NEXT:     v3: f32 = const.f32 0x3ff8000000000000
; CHECK-NEXT:     ret v3
; CHECK-NEXT:   bb1(v0 ptr, v1 ptr, v2 f32):
; CHECK-NEXT:     v4: <4 x f32> = load <4 x f32> v0
; CHECK-NEXT:     v5: <4 x f32> = splat v2
; CHECK-NEXT:     v6: <4 x f32> = fmul v4, v5
; CHECK-NEXT:     store v6, v0
; CHECK-NEXT:     v7: f32 = extractlane v6, 3
; CHECK-NEXT:     v8: f32 = const.f32 0x7ff8000000000001
; CHECK-NEXT:     v9: f32 = fadd v7, v8
; CHECK-NEXT:     v10: ptr = global_addr greeting
; CHECK-NEXT:     v11: i64 = const.i64 -5
; CHECK-NEXT:     v12: i64 = call labs(v11)
; CHECK-NEXT:     ret v9
; CHECK-NEXT: }
;
; The plain dump is a debugging view: no static, no signedness or promises beyond `noalias`, no
; result types, floats in decimal (the NaN's payload is gone).
; UNTYPED:      declare extern "C" fn labs(i64) -> i64
; UNTYPED-NOT:  static
; UNTYPED:      fn kernel(v0 ptr noalias, v1 ptr, v2 f32) -> f32 {
; UNTYPED-NEXT:   bb0:
; UNTYPED-NEXT:     v3 = const.f32 1.5
; UNTYPED:          v8 = const.f32 NaN

declare extern "C" fn labs(i64 signed) -> i64 signed
static greeting = hex 68690a00

fn kernel(v0 ptr noalias extent=8x4, v1 ptr slice, v2 f32) -> f32 {
  entry bb1
  values 20
  bb0:
    v3: f32 = const.f32 0x3ff8000000000000
    ret v3
  bb1(v0 ptr, v1 ptr, v2 f32):
    v4: <4 x f32> = load <4 x f32> v0
    v5: <4 x f32> = splat v2
    v6: <4 x f32> = fmul v4, v5
    store v6, v0
    v7: f32 = extractlane v6, 3
    v8: f32 = const.f32 0x7ff8000000000001
    v9: f32 = fadd v7, v8
    v10: ptr = global_addr greeting
    v11: i64 = const.i64 -5
    v12: i64 = call labs(v11)
    ret v9
}
