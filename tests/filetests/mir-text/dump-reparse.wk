// RUN: wukongc --emit=mir-text -O2 --target-cpu=x86-64-v2 %s > %t.mir
// RUN: filecheck %s --input-file=%t.mir
// RUN: wukongc --emit=mir-text --target-cpu=x86-64-v2 --passes= %t.mir > %t.again
// RUN: diff %t.mir %t.again
// RUN: wukongc --emit=mir --target-cpu=x86-64-v2 --passes= %t.mir > %t.from-dump
// RUN: wukongc --emit=mir -O2 --target-cpu=x86-64-v2 %s > %t.direct
// RUN: diff %t.from-dump %t.direct
// RUN: wukongc --emit=mir-text -O0 --target-cpu=x86-64-v2 %s > %t.o0.mir
// RUN: wukongc --emit=mir -O2 --target-cpu=x86-64-v2 %t.o0.mir > %t.o2-of-dump
// RUN: diff %t.o2-of-dump %t.direct
//
// A typed dump (--emit=mir-text) is a reproducer: reading it back and printing it changes
// nothing, its plain dump is the source's plain dump, and -O2 of the unoptimized dump is -O2 of
// the source -- so an optimizer bug can be carried as a `.mir` file and a pass list, with no front
// end in the way.

// The dump spells out what the plain form leaves implicit.
// CHECK:       ; wukong mir text v1
// CHECK:       static wukong$loc$0 = hex
// CHECK-LABEL: fn first(v0 ptr slice, v1 f32) -> f32 {
// CHECK:         {{v[0-9]+}}: f32 = const.f32 0x3ff8000000000000
// CHECK:         call wukong_rt_bounds_fail(
fn first(xs: []f32, k: f32) -> f32 {
    return xs[0] * k + 1.5;
}

// CHECK-LABEL: fn sum(v0 ptr slice, v1 i64) -> i64 {
// CHECK:         {{v[0-9]+}}: <2 x i64> = load <2 x i64>
fn sum(xs: []i64, n: i64) -> i64 {
    let mut s: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        s = s + xs[i];
        i = i + 1;
    }
    return s;
}
