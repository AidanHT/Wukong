; RUN: not wukongc --emit=mir --verify-each %s 2>&1 | filecheck %s
;
; A call is checked against its callee's definition: argument count and every argument's type.

; CHECK: internal compiler error (MIR verify): call argument 0 to {{.*}}: v0 has type i64 but expected i32
fn g(v0 i32) -> i32 {
  bb0(v0 i32):
    ret v0
}

fn f(v0 i64) -> i32 {
  bb0(v0 i64):
    v1: i32 = call g(v0)
    ret v1
}
