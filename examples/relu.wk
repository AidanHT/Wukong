// EXPECT-EXIT: 0
// EXPECT-OUT-VALUES: 0 5 0 0 8 0
module examples.relu

//! ReLU over fixed-size arrays. The examples in these doc comments run under
//! `wukongc --doctest examples/relu.wk`.
//!
//! An array's length is part of its type, so passing a buffer of the wrong length is a compile
//! error, not a run-time crash:
//!
//! ```wk,compile_fail,E0501
//! let x: [i32; 5] = [1, 2, 3, 4, 5];
//! let mut out: [i32; 6] = [0, 0, 0, 0, 0, 0];
//! relu(x, out);
//! ```

/// ReLU activation over a fixed-size array: out[i] = max(0, x[i]).
/// A reusable kernel with an array out-parameter.
/// Run: wukongc --run examples/relu.wk    (prints 0 5 0 0 8 0)
///
/// Every lane of `out` is written, the negative and zero ones included:
///
/// ```wk
/// let x: [i32; 6] = [-2, 4, 0, -9, 1, 3];
/// let mut out: [i32; 6] = [7, 7, 7, 7, 7, 7];
/// relu(x, out);
/// assert(out[0] == 0);
/// assert(out[1] == 4);
/// assert(out[2] == 0);
/// assert(out[3] == 0);
/// assert(out[4] == 1);
/// assert(out[5] == 3);
/// ```
fn relu(x: [i32; 6], mut out: [i32; 6]) {
    let mut i: i32 = 0;
    while i < 6 {
        if x[i] > 0 {
            out[i] = x[i];
        } else {
            out[i] = 0;
        }
        i = i + 1;
    }
}

fn main() -> i32 {
    let x: [i32; 6] = [-3, 5, -1, 0, 8, -7];
    let mut out: [i32; 6] = [0, 0, 0, 0, 0, 0];
    relu(x, out);

    let mut k: i32 = 0;
    while k < 6 {
        print(out[k]);
        k = k + 1;
    }
    return 0;
}
