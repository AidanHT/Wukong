module examples.gemm

// Runnable f32 matmul C[2,2] = A[2,3] · B[3,2], written as the textbook `ikj` nest over flat arrays.
//
// The compiler RECOGNIZES this loop nest and lowers the whole thing to its tuned, register-blocked,
// cache-tiled, packed AVX2/FMA GEMM microkernel (`wukong_sgemm`) — the way XLA/TVM/oneDNN lower a
// matmul op, not the naive triple loop gcc/rustc would emit. Under `--run` the interpreter executes
// that *same* kernel (marshalling its memory), so what you run here is the real fast path.
//
//   cargo run -p wukongc -- --run        examples/gemm.wk     # -> 4 5 10 11
//   cargo run -p wukongc -- --emit=mir   examples/gemm.wk     # see the `call wukong_sgemm`
//
//   A = [1 2 3]      B = [1 0]            C = A·B = [ 4  5]
//       [4 5 6]          [0 1]                      [10 11]
//                        [1 1]
fn main() -> i32 {
    let mut a: [f32; 6] = [0.0; 6];
    let mut b: [f32; 6] = [0.0; 6];
    let mut c: [f32; 4] = [0.0; 4];

    a[0] = 1.0; a[1] = 2.0; a[2] = 3.0;
    a[3] = 4.0; a[4] = 5.0; a[5] = 6.0;
    b[0] = 1.0; b[1] = 0.0;
    b[2] = 0.0; b[3] = 1.0;
    b[4] = 1.0; b[5] = 1.0;

    // C = A·B : the recognized nest (per-row zero-init => overwrite/beta=0, then accumulate over k).
    for i in 0..2 {
        for j0 in 0..2 { c[i * 2 + j0] = 0.0; }
        for k in 0..3 {
            let aik: f32 = a[i * 3 + k];
            for j in 0..2 { c[i * 2 + j] = c[i * 2 + j] + aik * b[k * 2 + j]; }
        }
    }

    print(c[0] as i32); // 4
    print(c[1] as i32); // 5
    print(c[2] as i32); // 10
    print(c[3] as i32); // 11
    return 0;
}
