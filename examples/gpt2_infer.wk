module examples.gpt2_infer

// =====================================================================================
// GPT-2 124M inference — the full pretrained model, in the Wukong language.
// =====================================================================================
//
// Loads the REAL HuggingFace GPT-2 small weights (exported to one flat little-endian f32 blob
// by tools/export_gpt2.py) and the prompt token ids from disk, runs the exact GPT-2 forward
// pass, writes the [SEQ, VOCAB] logits back to disk, and prints the argmax of the last position
// (the model's next-token prediction). For the frozen prompt "Hello, my name is" that argmax is
// 1757 (" John") — matching HuggingFace. tools/verify_gpt2.py cross-checks the written logits
// against the authoritative HF reference (rel <= 1e-3).
//
// Pipeline (pre-LayerNorm decoder, learned positional embeddings, tanh-GELU, biases on every
// projection, tied LM head) — identical math to examples/gpt2_infer_small.wk, which proves it
// bit-exact interp==native at the reduced config. This full model is native-only: the ~500 MB
// weight blob and 124M-element compute are far past what the interpreter's slot memory can hold,
// so run it with `--run --backend=native` from the repo root (relative data/ paths).
//
// The weight blob layout + every offset come from examples.gpt2_config (generated by the
// exporter). Index arithmetic stays i64 (token id cast to i64 before *D; offsets are i64 consts).

import gpt2_config;

fn main() -> i32 {
    // ---- 1. token ids (small; read FIRST so a missing-data run — e.g. the interpreter in the
    //         examples gate — exits identically on both backends BEFORE the ~500 MB weight alloc) ----
    let mut ids: []i32 = alloc_i32(GPT2_SEQ);
    let ngot: i64 = read_i32("data/gpt2/gpt2_tokens.bin", ids);
    if ngot != GPT2_SEQ {
        print(-1);                 // tokens not loaded (data absent / wrong CWD)
        free(ids);
        return 1;
    }

    // ---- 2. weights: one flat []f32 blob ----
    let mut w: []f32 = alloc_f32(GPT2_TOTAL_WEIGHTS);
    let wgot: i64 = read_f32("data/gpt2/gpt2_124m_weights.bin", w);
    if wgot != GPT2_TOTAL_WEIGHTS {
        print(-2);                 // weights not loaded / wrong size
        free(w); free(ids);
        return 1;
    }

    // ---- 3. scratch ----
    let mut x:      []f32 = alloc_f32(GPT2_SEQ * GPT2_D);       // running hidden state [SEQ, D]
    let mut nrm:    []f32 = alloc_f32(GPT2_SEQ * GPT2_D);       // LayerNorm output [SEQ, D]
    let mut q:      []f32 = alloc_f32(GPT2_SEQ * GPT2_D);
    let mut k:      []f32 = alloc_f32(GPT2_SEQ * GPT2_D);
    let mut v:      []f32 = alloc_f32(GPT2_SEQ * GPT2_D);
    let mut scores: []f32 = alloc_f32(GPT2_SEQ * GPT2_SEQ);     // per-head attention [SEQ, SEQ]
    let mut attn:   []f32 = alloc_f32(GPT2_SEQ * GPT2_D);       // concat head outputs [SEQ, D]
    let mut a:      []f32 = alloc_f32(GPT2_SEQ * GPT2_D);       // residual stream after attention
    let mut ff:     []f32 = alloc_f32(GPT2_SEQ * GPT2_DFF);     // MLP hidden [SEQ, DFF]
    let mut logits: []f32 = alloc_f32(GPT2_SEQ * GPT2_VOCAB);   // [SEQ, VOCAB]

    // ---- 4. embed:  x[s,d] = wte[ids[s], d] + wpe[s, d]  (learned positional embeddings) ----
    for s in 0..GPT2_SEQ {
        let id: i64 = ids[s] as i64;
        for d in 0..GPT2_D {
            x[s * GPT2_D + d] =
                w[GPT2_OFF_WTE + id * GPT2_D + d] + w[GPT2_OFF_WPE + s * GPT2_D + d];
        }
    }

    // ---- 5. decoder blocks ----
    for l in 0..GPT2_LAYERS {
        let base: i64 = GPT2_OFF_LAYER0 + l * GPT2_LAYER_STRIDE;

        // LN1(x) -> nrm  (mean-subtract, population variance over D=768, eps 1e-5, affine)
        for r in 0..GPT2_SEQ {
            let mut sm: f32 = 0.0;
            for i in 0..GPT2_D { sm = sm + x[r * GPT2_D + i]; }
            let mean: f32 = sm / 768.0;
            let mut vv: f32 = 0.0;
            for i in 0..GPT2_D { vv = vv + (x[r * GPT2_D + i] - mean) * (x[r * GPT2_D + i] - mean); }
            let inv: f32 = rsqrt(vv / 768.0 + 0.00001);
            for i in 0..GPT2_D {
                nrm[r * GPT2_D + i] = (x[r * GPT2_D + i] - mean) * inv * w[base + GPT2_REL_LN1G + i]
                    + w[base + GPT2_REL_LN1B + i];
            }
        }

        // Q/K/V projections + bias:  q[i,j] = bq[j] + sum_p nrm[i,p]*wq[j,p]  (wq is [D,D] row=neuron)
        for i in 0..GPT2_SEQ { for j in 0..GPT2_D {
            let mut s: f32 = 0.0;
            for p in 0..GPT2_D { s = s + nrm[i * GPT2_D + p] * w[base + GPT2_REL_WQ + j * GPT2_D + p]; }
            q[i * GPT2_D + j] = w[base + GPT2_REL_BQ + j] + s;
        } }
        for i in 0..GPT2_SEQ { for j in 0..GPT2_D {
            let mut s: f32 = 0.0;
            for p in 0..GPT2_D { s = s + nrm[i * GPT2_D + p] * w[base + GPT2_REL_WK + j * GPT2_D + p]; }
            k[i * GPT2_D + j] = w[base + GPT2_REL_BK + j] + s;
        } }
        for i in 0..GPT2_SEQ { for j in 0..GPT2_D {
            let mut s: f32 = 0.0;
            for p in 0..GPT2_D { s = s + nrm[i * GPT2_D + p] * w[base + GPT2_REL_WV + j * GPT2_D + p]; }
            v[i * GPT2_D + j] = w[base + GPT2_REL_BV + j] + s;
        } }

        // multi-head causal attention:  H=12 heads, hd=64, scale 1/sqrt(64)=0.125
        for h in 0..GPT2_H {
            for i in 0..GPT2_SEQ { for j in 0..GPT2_SEQ {
                let mut s: f32 = 0.0;
                for p in 0..GPT2_HD {
                    s = s + q[i * GPT2_D + h * GPT2_HD + p] * k[j * GPT2_D + h * GPT2_HD + p];
                }
                scores[i * GPT2_SEQ + j] = s * 0.125;
            } }
            for i in 0..GPT2_SEQ {
                for j in 0..GPT2_SEQ { if j > i { scores[i * GPT2_SEQ + j] = -1.0e30; } }
                let mut m: f32 = scores[i * GPT2_SEQ + 0];
                for j in 0..GPT2_SEQ { m = fmax(m, scores[i * GPT2_SEQ + j]); }
                let mut den: f32 = 0.0;
                for j in 0..GPT2_SEQ {
                    let e: f32 = exp(scores[i * GPT2_SEQ + j] - m);
                    scores[i * GPT2_SEQ + j] = e;
                    den = den + e;
                }
                let dinv: f32 = 1.0 / den;
                for j in 0..GPT2_SEQ { scores[i * GPT2_SEQ + j] = scores[i * GPT2_SEQ + j] * dinv; }
            }
            for i in 0..GPT2_SEQ { for d in 0..GPT2_HD {
                let mut s: f32 = 0.0;
                for j in 0..GPT2_SEQ {
                    s = s + scores[i * GPT2_SEQ + j] * v[j * GPT2_D + h * GPT2_HD + d];
                }
                attn[i * GPT2_D + h * GPT2_HD + d] = s;
            } }
        }

        // output projection + bias (fused nn.Linear → wukong_sgemm_nt_epi), then the residual as a
        // separate streaming add — the same split gpt2.wk documents ("keeps each piece on its
        // recognized fast path"). Math is identical: a = attn·Woᵀ + bo, then a = x + a.
        for i in 0..GPT2_SEQ { for j in 0..GPT2_D {
            let mut s: f32 = 0.0;
            for p in 0..GPT2_D { s = s + attn[i * GPT2_D + p] * w[base + GPT2_REL_WO + j * GPT2_D + p]; }
            a[i * GPT2_D + j] = w[base + GPT2_REL_BO + j] + s;
        } }
        for i in 0..GPT2_SEQ * GPT2_D { a[i] = x[i] + a[i]; }

        // LN2(a) -> nrm
        for r in 0..GPT2_SEQ {
            let mut sm: f32 = 0.0;
            for i in 0..GPT2_D { sm = sm + a[r * GPT2_D + i]; }
            let mean: f32 = sm / 768.0;
            let mut vv: f32 = 0.0;
            for i in 0..GPT2_D { vv = vv + (a[r * GPT2_D + i] - mean) * (a[r * GPT2_D + i] - mean); }
            let inv: f32 = rsqrt(vv / 768.0 + 0.00001);
            for i in 0..GPT2_D {
                nrm[r * GPT2_D + i] = (a[r * GPT2_D + i] - mean) * inv * w[base + GPT2_REL_LN2G + i]
                    + w[base + GPT2_REL_LN2B + i];
            }
        }

        // MLP up-projection + bias:  ff[i,j] = b1[j] + sum_p nrm[i,p]*w1[j,p]   (w1 is [DFF,D])
        for i in 0..GPT2_SEQ { for j in 0..GPT2_DFF {
            let mut s: f32 = 0.0;
            for p in 0..GPT2_D { s = s + nrm[i * GPT2_D + p] * w[base + GPT2_REL_W1 + j * GPT2_D + p]; }
            ff[i * GPT2_DFF + j] = w[base + GPT2_REL_B1 + j] + s;
        } }
        // tanh-GELU (gelu_new) in place:  0.5*x*(1 + tanh(sqrt(2/pi)*(x + 0.044715*x^3)))
        for i in 0..GPT2_SEQ * GPT2_DFF {
            let u: f32 = 0.7978845608 * (ff[i] + 0.044715 * ff[i] * ff[i] * ff[i]);
            let t: f32 = 1.0 - 2.0 / (exp(2.0 * u) + 1.0);
            ff[i] = 0.5 * ff[i] * (1.0 + t);
        }
        // MLP down-projection + bias (fused → wukong_sgemm_nt_epi), then residual as a streaming add
        // (gpt2.wk's idiom). Math identical: x = ff·W2ᵀ + b2, then x = a + x. The old x (this block's
        // input residual) is dead here — `a` already carries it — so overwriting x with the projection
        // then adding `a` reproduces a + b2 + dot exactly.
        for i in 0..GPT2_SEQ { for j in 0..GPT2_D {
            let mut s: f32 = 0.0;
            for p in 0..GPT2_DFF { s = s + ff[i * GPT2_DFF + p] * w[base + GPT2_REL_W2 + j * GPT2_DFF + p]; }
            x[i * GPT2_D + j] = w[base + GPT2_REL_B2 + j] + s;
        } }
        for i in 0..GPT2_SEQ * GPT2_D { x[i] = a[i] + x[i]; }
    }

    // ---- 6. final LayerNorm (in place over x) ----
    for r in 0..GPT2_SEQ {
        let mut sm: f32 = 0.0;
        for i in 0..GPT2_D { sm = sm + x[r * GPT2_D + i]; }
        let mean: f32 = sm / 768.0;
        let mut vv: f32 = 0.0;
        for i in 0..GPT2_D { vv = vv + (x[r * GPT2_D + i] - mean) * (x[r * GPT2_D + i] - mean); }
        let inv: f32 = rsqrt(vv / 768.0 + 0.00001);
        for i in 0..GPT2_D {
            x[r * GPT2_D + i] = (x[r * GPT2_D + i] - mean) * inv * w[GPT2_OFF_LNFG + i] + w[GPT2_OFF_LNFB + i];
        }
    }

    // ---- 7. tied LM head:  logits[s,vv] = sum_d x[s,d] * wte[vv,d]  (wte as [VOCAB,D], no bias) ----
    for s in 0..GPT2_SEQ { for vv in 0..GPT2_VOCAB {
        let mut acc: f32 = 0.0;
        for d in 0..GPT2_D { acc = acc + x[s * GPT2_D + d] * w[GPT2_OFF_WTE + vv * GPT2_D + d]; }
        logits[s * GPT2_VOCAB + vv] = acc;
    } }

    // ---- 8. write logits + report argmax of the last position ----
    let nwrote: i64 = write_f32("data/gpt2/gpt2_wuk_logits.bin", logits);

    let last: i64 = (GPT2_SEQ - 1) * GPT2_VOCAB;
    let mut best: f32 = logits[last + 0];
    let mut bi: i64 = 0;
    for vv in 0i64..GPT2_VOCAB {
        let val: f32 = logits[last + vv];
        if val > best { best = val; bi = vv; }
    }
    print(bi as i32);                                   // argmax(last) — expect 1757 (" John")
    print(round(logits[last + bi] * 1000.0) as i32);    // signature: top logit * 1000
    print(round(logits[0] * 1000.0) as i32);            // signature: logits[0,0] * 1000
    print(nwrote as i32);                               // elements written (= SEQ*VOCAB = 251285)

    free(w); free(ids); free(x); free(nrm); free(q); free(k); free(v);
    free(scores); free(attn); free(a); free(ff); free(logits);
    return 0;
}
