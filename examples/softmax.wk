module examples.softmax

/// Row-wise, numerically-stable softmax over the last dim of an [R, C] tensor, in place.
/// Shape types tie the row pointer to C; @parallel runs rows concurrently.
fn softmax_rows<R, C>(x: Tensor[f32, R, C]) {
    @parallel
    for r in 0..R {
        let row = x.row_ptr(r);
        let n = C;

        // 1) row max for numerical stability
        let mut m = -1.0e38;
        let mut i: usize = 0;
        while i < n {
            m = fmax(m, row[i]);
            i += 1;
        }

        // 2) exp(x - m) and accumulate the sum
        let mut s = 0.0;
        i = 0;
        while i < n {
            let e = exp(row[i] - m);
            row[i] = e;
            s += e;
            i += 1;
        }

        // 3) normalize
        let inv = 1.0 / s;
        i = 0;
        while i < n {
            row[i] = row[i] * inv;
            i += 1;
        }
    }
}
