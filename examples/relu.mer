module examples.relu

/// ReLU activation over a fixed-size array: out[i] = max(0, x[i]).
/// A reusable kernel with an array out-parameter.
/// Run: mercuryc --run examples/relu.mer    (prints 0 5 0 0 8 0)
fn relu(x: [i32; 6], mut out: [i32; 6]) {
    let mut i: i32 = 0;
    while i < 6 {
        if x[i] > 0 {
            out[i] = x[i];
        } else {
            out[i] = 0;
        }
        i = i + 1;
    }
}

fn main() -> i32 {
    let x: [i32; 6] = [-3, 5, -1, 0, 8, -7];
    let mut out: [i32; 6] = [0, 0, 0, 0, 0, 0];
    relu(x, out);

    let mut k: i32 = 0;
    while k < 6 {
        print(out[k]);
        k = k + 1;
    }
    return 0;
}
