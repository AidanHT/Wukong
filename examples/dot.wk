module examples.dot

/// Dot product of two length-8 vectors over fixed-size arrays.
/// Run: mercuryc --run examples/dot.mer    (prints 120)
fn main() -> i32 {
    let x: [i32; 8] = [1, 2, 3, 4, 5, 6, 7, 8];
    let y: [i32; 8] = [8, 7, 6, 5, 4, 3, 2, 1];

    let mut acc: i32 = 0;
    let mut i: i32 = 0;
    while i < 8 {
        acc = acc + x[i] * y[i];
        i = i + 1;
    }
    print(acc); // 1*8 + 2*7 + ... + 8*1 = 120
    return 0;
}
