# Rust build artifacts
/target
**/target
# Alternate Cargo target dirs (e.g. CARGO_TARGET_DIR=target-gpucheck for feature-gated builds)
/target-*
**/*.rs.bk

# Claude Code local working dir (agent git worktrees, etc.)
.claude/

# Session/prompt notes (kept local, not committed)
prompts/*.md

# Mercury / native build outputs
*.exe
*.obj
*.o
*.ll
*.s
*.pdb
a.out

# Local LLVM install (if placed inside the repo)
/llvm
/.llvm

# Local CUDA redistributables (NVRTC + cuBLAS DLLs) for the GPU peer benchmarks.
# Pulled via `pip install --target tools/cuda-redist nvidia-cuda-nvrtc-cu12 nvidia-cublas-cu12`
# so the Tier-A (NVRTC CUDA-C) and Tier-B (cuBLAS) peers are measurable without a full toolkit.
# Hundreds of MB of vendor binaries — never committed; reproduced by the pip command above.
/tools/cuda-redist

# Local CUDA PyTorch venv for the Tier-C (PyTorch) GPU peer benchmark.
# Created via `python -m venv tools/torch-venv` + `pip install torch --index-url
# https://download.pytorch.org/whl/cu124` — ~2.5 GB of wheels; never committed.
/tools/torch-venv
/tools/torch-cuda-venv

# Python bytecode cache (from the bench/pytorch peer harness).
__pycache__/
*.pyc

# Editor / OS noise
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
scratch_*.mer
*.o
*_rt.c
